{
  "name": "verowellness",
  "version": "0.1.0",
  "private": true,
  "description": "Veronica Wellness / The Layer Method™ — sitio web (Astro 7, estático)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src scripts webflow tests",
    "format": "prettier --write src scripts docs tests webflow/puente.ts README.md",
    "format:check": "prettier --check src scripts docs tests webflow/puente.ts README.md",
    "capturas": "node scripts/capturas.mjs",
    "empaquetar": "node scripts/empaquetar.mjs",
    "verificar:entrega": "node scripts/verificar-entrega.mjs",
    "entrega": "npm run build && npm run empaquetar && npm run verificar:entrega",
    "verify": "npm run lint && npm run format:check && npm run check && npm test && npm run build",
    "vw": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import ./scripts/vw/cargador/registrar.ts scripts/vw/cli.ts",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "astro": "7.3.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "puppeteer-core": "24.43.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
