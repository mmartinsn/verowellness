---
/**
 * A full-screen insight, after lusion.co/about (Mari, 2026-09-23): the screen holds while you
 * scroll, one sentence split across opposite corners, its words lighting up in reading order.
 * No imagery — the sentence is the scene. Reduced motion: no pinning, every word lit.
 */
interface Props {
  /** First half, top left. */
  a: string;
  /** Second half, bottom right, in italic clay. */
  b: string;
  id?: string;
}
const { a, b, id } = Astro.props;

const pa = a.split(' ');
const pb = b.split(' ');
const total = pa.length + pb.length;
---

<section class="insight" id={id} data-insight>
  <div class="escena">
    <span class="cruz x1" aria-hidden="true"></span>
    <span class="cruz x2" aria-hidden="true"></span>
    <span class="cruz x3" aria-hidden="true"></span>
    <h2 class="frase">
      <span class="mitad ma">
        {
          pa.map((w, i) => (
            <span class="w" style={`--k:${i / total}`}>
              {w}
            </span>
          ))
        }
      </span>
      <em class="mitad mb">
        {
          pb.map((w, i) => (
            <span class="w" style={`--k:${(pa.length + i) / total}`}>
              {w}
            </span>
          ))
        }
      </em>
    </h2>
  </div>
</section>

<style>
  /* A slim band, not a full screen: it holds centred in the viewport while the words light up. */
  .insight {
    --alto: clamp(300px, 48vh, 440px);
    position: relative;
    height: calc(var(--alto) + 42vh);
    color: var(--color-bone);
  }
  .escena {
    position: sticky;
    top: calc(50vh - var(--alto) / 2);
    height: var(--alto);
    overflow: hidden;
    /* The glow warms up with the sentence. */
    background:
      radial-gradient(
        ellipse calc(50% + var(--lp, 0) * 40%) calc(40% + var(--lp, 0) * 30%) at 50% 50%,
        rgb(214 154 124 / calc(0.05 + var(--lp, 0) * 0.16)),
        transparent 70%
      ),
      #161512;
  }
  /* Both halves in one centred block, still on a diagonal but close together. */
  .frase {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 32px clamp(20px, 6vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(14px, 3vh, 36px);
    font-weight: 400;
  }
  .mitad {
    display: block;
    max-width: min(760px, 86vw);
    font-family: var(--font-serif);
    font-size: clamp(32px, 4.4vw, 66px);
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .ma {
    align-self: flex-start;
    color: var(--color-bone);
  }
  .mb {
    align-self: flex-end;
    text-align: right;
    font-style: italic;
    color: var(--color-clay);
  }
  /* Each word goes from a ghost to full as the reading line passes it. */
  /* Each word rises out of a blur as the reading line passes it; the line runs ahead of the
     scroll (× 1.45) so the sentence is complete well before the screen lets go. */
  .w {
    --v: clamp(0, calc((var(--lp, 0) * 1.45 - var(--k)) * 6), 1);
    display: inline-block;
    margin-right: 0.26em;
    opacity: calc(0.1 + var(--v) * 0.9);
    transform: translateY(calc((1 - var(--v)) * 0.5em));
    filter: blur(calc((1 - var(--v)) * 8px));
    transition:
      opacity 0.35s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.5s cubic-bezier(0.19, 1, 0.22, 1),
      filter 0.35s ease;
  }
  /* The two halves drift in from opposite sides. */
  .ma {
    translate: calc((1 - min(1, var(--lp, 0) * 1.6)) * -6vw) 0;
  }
  .mb {
    translate: calc((1 - min(1, max(0, var(--lp, 0) * 1.8 - 0.45))) * 6vw) 0;
  }

  .cruz {
    position: absolute;
    width: 11px;
    height: 11px;
    opacity: 0.3;
  }
  .cruz::before,
  .cruz::after {
    content: '';
    position: absolute;
    background: var(--color-bone);
  }
  .cruz::before {
    left: 5px;
    width: 1px;
    height: 11px;
  }
  .cruz::after {
    top: 5px;
    height: 1px;
    width: 11px;
  }
  .x1 {
    left: 50%;
    top: 22%;
  }
  .x2 {
    left: 18%;
    bottom: 26%;
  }
  .x3 {
    right: 16%;
    top: 46%;
  }

  @media (prefers-reduced-motion: reduce) {
    .insight {
      height: auto;
    }
    .escena {
      position: relative;
      height: auto;
      padding: 110px clamp(20px, 6vw, 96px);
    }
    .frase {
      position: static;
      padding: 0;
    }
    .mb {
      margin-top: 48px;
      margin-left: auto;
    }
    .w {
      opacity: 1;
      transform: none;
      filter: none;
    }
    .ma,
    .mb {
      translate: none;
    }
  }
</style>

<script>
  // Progress of the pinned stretch → --lp (0 → 1) on every insight on the page.
  const insights = [...document.querySelectorAll<HTMLElement>('[data-insight]')];
  if (insights.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pendiente = false;
    const actualizar = () => {
      pendiente = false;
      for (const s of insights) {
        const r = s.getBoundingClientRect();
        const banda = s.firstElementChild as HTMLElement;
        const fijo = (window.innerHeight - banda.offsetHeight) / 2; // sticky top
        const recorrido = r.height - banda.offsetHeight;
        // Start a little before pinning so the first words are already waking up.
        const antes = window.innerHeight * 0.35;
        const p = (fijo + antes - r.top) / (recorrido + antes);
        s.style.setProperty('--lp', Math.min(1, Math.max(0, p)).toFixed(3));
      }
    };
    const pedir = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(actualizar);
      }
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    actualizar();
  }
</script>
