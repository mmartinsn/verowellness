---
import BloquePrecios from '../BloquePrecios.astro';
---

<section id="precios" class="precios">
  <div class="wrap">
    <div class="cabeza reveal">
      <span class="eyebrow">La oferta completa</span>
      <h2>Tu ciclo, a tu ritmo.</h2>
      <p class="lead">
        Empieza con una cita o con un ciclo completo de dos. Cuando completas tu primer ciclo,
        seguimos avanzando sin empezar de cero: usamos el contexto ya construido, a tu ritmo.
      </p>
    </div>
    <div class="bloque reveal">
      <BloquePrecios />
    </div>
  </div>
</section>

<style>
  .precios {
    padding: 72px 0 64px;
  }
  @media (max-width: 760px) {
    .precios {
      padding: 40px 0 36px;
    }
  }
  .cabeza {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
  }
  .lead {
    font-size: 18px;
    line-height: 1.6;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
    margin-top: 14px;
  }
  .bloque {
    max-width: 1040px;
    margin: 40px auto 0;
  }
</style>
