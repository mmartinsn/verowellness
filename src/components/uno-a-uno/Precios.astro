---
/**
 * "La oferta completa — Tu ciclo, a tu ritmo." The same price block as the home and Mi método:
 * 1 consulta left, 2 consultas right, and the private invitation for patients (change 35).
 */
import BloquePrecios from '../oferta/BloquePrecios.astro';
---

<section class="reveal">
  <div class="wrap">
    <span class="eyebrow">La oferta completa</span>
    <h2>Elige tu asesoría.</h2>
    <p class="lead">
      Tu primer ciclo te da el mapa; el siguiente te permite seguir avanzando. No empezamos desde
      cero: usamos el contexto ya construido, a tu ritmo, sin membresía ni programa a largo plazo.
    </p>
    <div class="bloque">
      <BloquePrecios />
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 36px 0;
    }
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
  }
  .lead {
    font-size: 18px;
    line-height: 1.6;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
    max-width: 640px;
    margin-top: 14px;
  }
  .bloque {
    margin-top: 40px;
  }
</style>
