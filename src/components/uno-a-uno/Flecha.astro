---
/**
 * The bobbing down-arrow that links one section of the 1:1 story to the next.
 */
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<div class="wrap flecha reveal" aria-hidden="true">
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
  >
    <path d="M12 4v16M6 14l6 6 6-6"></path>
  </svg>
</div>

<style>
  .flecha {
    display: flex;
    justify-content: center;
    padding: 8px 0 0;
    color: var(--color-charcoal);
  }
  .flecha svg {
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
</style>
