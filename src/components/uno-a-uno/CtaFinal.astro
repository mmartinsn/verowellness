---
/**
 * Closing dark block: «el siguiente paso», now both offers side by side (1 consulta, 2 consultas),
 * each with its price and the site's button into its checkout (Verónica, change 35).
 */
import { listaCiclos, checkoutPath, precioCard } from '../../data/oferta';
import { href } from '../../lib/url';
import { cta } from '../../data/site';
---

<section id="final-cta-section" class="reveal">
  <div class="wrap" id="cta">
    <div class="final-cta">
      <h2>Deja de perseguir cada pieza por separado.</h2>
      <p>
        Empieza por entender tu mapa, definir tus prioridades y construir una estrategia con
        dirección.
      </p>
      <div class="fc-divider" aria-hidden="true"></div>
      <div class="fc-bottom">
        {
          listaCiclos.map((c) => (
            <div class:list={['fc-opcion', { destacada: c.id === 'INITIAL_LAYER_CYCLE' }]}>
              <span class="fc-offer-meta">{c.consultas}</span>
              <span class="fc-offer-label">{c.nombre}</span>
              <span class="fc-offer-price">{precioCard(c)}</span>
              <a class="btn btn-primary btn-block" href={href(checkoutPath(c))}>
                {cta.label}
              </a>
            </div>
          ))
        }
      </div>
      <small
        >El siguiente paso te mostrará exactamente qué incluye tu ciclo antes de realizar el pago.</small
      >
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 36px 0 0;
    }
  }
  .final-cta {
    background: var(--color-charcoal);
    border-radius: var(--radius-lg);
    padding: 64px 56px;
    text-align: center;
    color: var(--color-bone);
  }
  @media (max-width: 640px) {
    .final-cta {
      padding: 44px 26px;
    }
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
    color: var(--color-bone);
    max-width: 640px;
    margin: 0 auto;
  }
  p {
    color: rgb(251 250 246 / 0.72);
    max-width: 480px;
    margin: 16px auto 0;
    font-size: 17px;
    font-weight: 500;
  }
  .fc-divider {
    height: 1px;
    background: rgb(251 250 246 / 0.14);
    max-width: 520px;
    margin: 40px auto;
  }
  .fc-bottom {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 300px));
    justify-content: center;
    gap: 18px;
  }
  @media (max-width: 640px) {
    .fc-bottom {
      grid-template-columns: 1fr;
    }
  }
  .fc-opcion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 26px 22px;
    border-radius: 24px;
    border: 1px solid rgb(251 250 246 / 0.14);
    background: rgb(251 250 246 / 0.04);
  }
  .fc-opcion.destacada {
    border-color: var(--color-clay);
    background: rgb(231 183 160 / 0.1);
  }
  .fc-opcion .btn {
    margin-top: 10px;
  }
  .fc-offer-label {
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .fc-offer-meta {
    font-weight: 700;
    font-size: 14px;
    color: rgb(251 250 246 / 0.55);
  }
  .fc-offer-price {
    font-weight: 800;
    font-size: 32px;
    color: var(--color-bone);
  }
  small {
    display: block;
    margin: 26px auto 0;
    font-size: 12.5px;
    color: rgb(251 250 246 / 0.5);
    font-weight: 600;
    max-width: 440px;
  }
</style>
