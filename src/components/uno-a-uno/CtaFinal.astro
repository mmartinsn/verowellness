---
import { checkoutPath, listaCiclos, precioCard, rotuloCitas } from '../../data/oferta';
import { cta } from '../../data/site';
import { href } from '../../lib/url';

const duracion = (citas: number) => (citas === 1 ? '90 min' : `${citas} × 90 min`);
---

<section id="final-cta-section" class="reveal">
  <div class="wrap" id="cta">
    <div class="final-cta">
      <h2>Deja de perseguir cada pieza por separado.</h2>
      <p class="bajada">
        Empieza por entender tu mapa, definir tus prioridades y construir una estrategia con
        dirección.
      </p>

      <div class="opciones">
        {
          listaCiclos.map((c) => (
            <article class:list={['opcion', { destacada: c.destacado }]}>
              <span class="op-citas">{rotuloCitas(c)}</span>
              <h3 class="op-nombre">{c.nombre}</h3>
              <p class="op-meta">
                <span class="op-precio">{precioCard(c)}</span>
                <span class="op-dur">{duracion(c.citas)}</span>
              </p>
              <a class="btn btn-primary op-btn" href={href(checkoutPath(c))}>
                {cta.label}
              </a>
            </article>
          ))
        }
      </div>

      <p class="aviso">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="4" y="10" width="16" height="11" rx="2.5"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        El siguiente paso te mostrará exactamente qué incluye tu cita o tu ciclo antes de realizar el
        pago.
      </p>
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 36px 0 0;
    }
  }
  .final-cta {
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(231 183 160 / 0.18), transparent 60%),
      radial-gradient(60% 80% at 0% 100%, rgb(207 215 196 / 0.12), transparent 60%),
      var(--color-charcoal);
    border-radius: var(--radius-lg);
    padding: 64px 56px;
    text-align: center;
    color: var(--color-bone);
  }
  @media (max-width: 640px) {
    .final-cta {
      padding: 44px 20px;
    }
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
    color: var(--color-bone);
    max-width: 640px;
    margin: 0 auto;
  }
  .bajada {
    color: rgb(251 250 246 / 0.72);
    max-width: 480px;
    margin: 16px auto 0;
    font-size: 17px;
    font-weight: 500;
  }
  .opciones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 760px;
    margin: 40px auto 0;
  }
  @media (max-width: 700px) {
    .opciones {
      grid-template-columns: 1fr;
    }
  }
  .opcion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 28px 24px 26px;
    border-radius: 20px;
    background: rgb(251 250 246 / 0.06);
    border: 1px solid rgb(251 250 246 / 0.14);
    transition:
      transform 0.45s var(--ease-out-soft),
      background 0.45s ease,
      border-color 0.45s ease;
  }
  .opcion:hover {
    transform: translateY(-4px);
    background: rgb(251 250 246 / 0.1);
  }
  .opcion.destacada {
    border-color: rgb(231 183 160 / 0.6);
    background: rgb(231 183 160 / 0.1);
  }
  .op-citas {
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(251 250 246 / 0.1);
    color: var(--color-clay);
  }
  .op-nombre {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.15;
    color: var(--color-bone);
  }
  .op-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .op-precio {
    font-weight: 800;
    font-size: 26px;
    color: var(--color-bone);
  }
  .op-dur {
    font-weight: 700;
    font-size: 14px;
    color: rgb(251 250 246 / 0.6);
  }
  .op-btn {
    margin-top: 8px;
    width: 100%;
  }
  .aviso {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 30px auto 0;
    padding: 12px 20px;
    border-radius: 999px;
    background: rgb(251 250 246 / 0.08);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.45;
    color: rgb(251 250 246 / 0.86);
    max-width: 720px;
    text-align: left;
  }
  .aviso svg {
    flex: 0 0 auto;
    color: var(--color-clay);
  }
  @media (max-width: 640px) {
    .aviso {
      border-radius: 18px;
      font-size: 13.5px;
    }
  }
</style>
