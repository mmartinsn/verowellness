---
/**
 * "Cómo funciona — Initial Layer Cycle": the four-step stepper (Antes · Sesión 01 · Entre
 * sesiones · Sesión 02) and the Layer Assessment™ panel with its topic chips.
 */
const pasos = [
  {
    snum: 'Antes',
    titulo: 'The Layer Assessment™',
    texto: 'Organizas tu contexto antes de la cita.',
    cls: 's1',
  },
  {
    snum: 'Sesión 01 · 90 min',
    titulo: 'Mapear + Priorizar',
    texto: 'Mapeamos tus Layers y definimos qué merece atención primero.',
    cls: 's2',
  },
  {
    snum: 'Entre sesiones',
    titulo: 'Implementar',
    texto: 'Pones en marcha tu Layer Plan™ y observas la respuesta.',
    cls: 's3',
  },
  {
    snum: 'Sesión 02 · 90 min',
    titulo: 'Revisar + Ajustar',
    texto: 'Revisamos qué cambió y actualizamos la estrategia.',
    cls: 's4',
  },
];

const temas = [
  'Objetivos',
  'Historia de salud y bienestar',
  'Alimentación',
  'Lifestyle',
  'Síntomas y preocupaciones',
  'Suplementación actual',
  'Fotos iniciales',
  'Laboratorios relevantes',
];
---

<section id="proceso" class="reveal">
  <div class="wrap">
    <span class="eyebrow">Cómo funciona</span>
    <h2 class="upcase">Initial Layer Cycle</h2>
    <p class="lead">
      Para nuevos clientes. Es el punto de partida para aplicar The Layer Method™ a tu contexto
      individual — no una consulta aislada, sino un ciclo completo con estructura.
    </p>

    <div class="stepper reveal-stagger reveal">
      {
        pasos.map((p, i) => (
          <>
            {i > 0 && (
              <div class="step-arrow" aria-hidden="true">
                →
              </div>
            )}
            <div class:list={['step', p.cls]}>
              <div class="snum">{p.snum}</div>
              <h4>{p.titulo}</h4>
              <p>{p.texto}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>

<section class="reveal">
  <div class="wrap">
    <div class="panel">
      <div class="assess-copy">
        <span class="eyebrow">Antes de la sesión 01</span>
        <h3>The Layer Assessment™</h3>
        <p>
          Antes de tu primera sesión completas una evaluación estructurada que nos ayuda a organizar
          el contexto relevante con anticipación. Puede incluir información sobre:
        </p>
        <div class="assess-list">
          {temas.map((t, i) => <span class:list={['chip', `c${i + 1}`]}>{t}</span>)}
        </div>
        <div class="assess-quote">
          Llegar a la cita con contexto — no pasar la sesión completa recopilando información
          básica.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 36px 0;
    }
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
  }
  .upcase {
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.18;
  }
  .lead {
    font-size: 19px;
    line-height: 1.65;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
    max-width: 620px;
    margin-top: 16px;
  }

  .stepper {
    display: flex;
    align-items: stretch;
    margin-top: 44px;
  }
  @media (max-width: 820px) {
    .stepper {
      flex-direction: column;
      gap: 18px;
    }
  }
  .step {
    flex: 1;
    background: var(--color-ivory);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    border-top: 5px solid var(--color-charcoal);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .step:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgb(48 47 42 / 0.08);
  }
  .s1 {
    border-top-color: var(--color-clay-deep);
  }
  .s2 {
    border-top-color: var(--color-sage-deep);
  }
  .s3 {
    border-top-color: var(--color-rose-deep);
  }
  .s4 {
    border-top-color: var(--color-olive);
  }
  .snum {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: rgb(48 47 42 / 0.45);
    text-transform: uppercase;
  }
  .step h4 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    margin-top: 10px;
    line-height: 1.2;
  }
  .step p {
    font-size: 14px;
    margin-top: 8px;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
  }
  .step-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    color: rgb(48 47 42 / 0.45);
    flex: 0 0 auto;
  }
  @media (max-width: 820px) {
    .step-arrow {
      transform: rotate(90deg);
      padding: 2px 0;
    }
  }

  .panel {
    background: var(--color-ivory);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .assess-copy {
    padding: 48px;
    max-width: 760px;
  }
  @media (max-width: 640px) {
    .assess-copy {
      padding: 30px 24px;
    }
  }
  .assess-copy p {
    font-size: 17px;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
    margin-top: 14px;
    max-width: 620px;
  }
  .assess-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .chip {
    font-weight: 800;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    color: var(--color-charcoal);
    transition: transform 0.2s ease;
  }
  .chip:hover {
    transform: translateY(-2px);
  }
  .c1 {
    background: var(--color-clay);
  }
  .c2 {
    background: var(--color-sage);
  }
  .c3 {
    background: var(--color-rose);
  }
  .c4 {
    background: var(--color-sand);
  }
  .c5 {
    background: var(--color-olive);
    color: var(--color-bone);
  }
  .c6 {
    background: var(--color-clay-deep);
    color: var(--color-bone);
  }
  .c7 {
    background: var(--color-sage-deep);
  }
  .c8 {
    background: var(--color-rose-deep);
    color: var(--color-bone);
  }
  .assess-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 3.2vw, 34px);
    line-height: 1.35;
    border-left: 3px solid var(--color-clay-deep);
    padding-left: 22px;
    margin-top: 30px;
  }
</style>
