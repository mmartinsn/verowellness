---
import { Image } from 'astro:assets';
import retrato from '../../assets/fotos/veronica-laptop-de-pie.jpg';
import { cta, marca } from '../../data/site';
---

<section class="tight reveal">
  <div class="wrap">
    <div class="hero-demo">
      <div class="hero-content">
        <span class="eyebrow">Asesorías · The Layer Method</span>
        <h1>Tu salud tiene capas.<br />Tu estrategia también debería tenerlas.</h1>
        <p class="italic-lede">
          Un proceso individual y personalizado para organizar tu contexto, identificar prioridades
          y construir una estrategia personalizada utilizando The Layer Method.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#cta">{cta.label}</a>
        </div>
      </div>
      <div class="hero-photo">
        <Image
          src={retrato}
          alt={marca.creadora}
          widths={[520, 960]}
          sizes="(min-width: 900px) 480px, 100vw"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 48px 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 32px 0;
    }
  }
  .hero-demo {
    background: var(--color-ivory);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .hero-demo {
      grid-template-columns: 1fr;
    }
  }
  .hero-content {
    position: relative;
    padding: 64px 52px;
    z-index: 2;
  }
  @media (max-width: 760px) {
    .hero-content {
      padding: 40px 24px 32px;
    }
  }
  .eyebrow {
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin-top: 6px;
  }
  .italic-lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: rgb(48 47 42 / 0.72);
    max-width: 560px;
    margin-top: 18px;
  }
  .btn-row {
    margin-top: 30px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-photo {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    background: var(--color-sand);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.2s var(--ease-out-soft);
  }
  .hero-demo:hover .hero-photo :global(img) {
    transform: scale(1.04);
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(48 47 42 / 0) 60%, rgb(48 47 42 / 0.12) 100%);
  }
  @media (max-width: 900px) {
    .hero-photo {
      min-height: 280px;
      order: -1;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
</style>
