---
/**
 * 1:1 hero: the ivory panel with title, italic lede and CTA beside the horizontal portrait,
 * then the teaser that invites to scroll ("¿De qué va este plan?").
 */
import { Image } from 'astro:assets';
import retrato from '../../assets/fotos/veronica-bata-horizontal.jpg';
import { href } from '../../lib/url';
import { marca } from '../../data/site';
---

<section class="tight reveal">
  <div class="wrap">
    <div class="hero-demo">
      <div class="hero-content">
        <span class="eyebrow">The Layer Method™ 1:1</span>
        <h1>Tu salud tiene capas.<br />Tu estrategia también debería tenerlas.</h1>
        <p class="italic-lede">
          Un proceso 1:1 para organizar tu contexto, identificar prioridades y construir una
          estrategia personalizada utilizando The Layer Method™.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#cta">Agenda conmigo</a>
        </div>
      </div>
      <div class="hero-photo">
        <Image
          src={retrato}
          alt={marca.creadora}
          widths={[520, 1036]}
          sizes="(min-width: 900px) 480px, 100vw"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <div class="wrap teaser reveal">
    <a class="teaser-link" href={href('/1-1#proceso')}>
      <span class="teaser-text">¿De qué va este plan?</span>
      <span class="teaser-sub">Sigue bajando para ver qué incluye y cómo es la experiencia</span>
      <svg
        class="teaser-arrow"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <path d="M12 4v16M6 14l6 6 6-6"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  section {
    padding: 48px 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 32px 0;
    }
  }
  .hero-demo {
    background: var(--color-ivory);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .hero-demo {
      grid-template-columns: 1fr;
    }
  }
  .hero-content {
    position: relative;
    padding: 64px 52px;
    z-index: 2;
  }
  @media (max-width: 760px) {
    .hero-content {
      padding: 40px 24px 32px;
    }
  }
  .eyebrow {
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(40px, 7vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin-top: 6px;
  }
  .italic-lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: rgb(48 47 42 / 0.72);
    max-width: 560px;
    margin-top: 18px;
  }
  .btn-row {
    margin-top: 30px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-photo {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    background: var(--color-sand);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.2s var(--ease-out-soft);
  }
  .hero-demo:hover .hero-photo :global(img) {
    transform: scale(1.04);
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(48 47 42 / 0) 60%, rgb(48 47 42 / 0.12) 100%);
  }
  @media (max-width: 900px) {
    .hero-photo {
      min-height: 280px;
      order: -1;
    }
  }
  .teaser {
    display: flex;
    justify-content: center;
    padding: 56px 0 12px;
  }
  .teaser-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    color: var(--color-charcoal);
  }
  .teaser-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
  }
  .teaser-sub {
    font-weight: 600;
    font-size: 17px;
    color: rgb(48 47 42 / 0.45);
    margin-top: 10px;
    max-width: 440px;
    line-height: 1.5;
  }
  .teaser-arrow {
    margin-top: 22px;
    width: 34px;
    height: 34px;
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
</style>
