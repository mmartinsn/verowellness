---
/**
 * "Lo que The Layer Method™ 1:1 no es" as one slim band before the closing CTA — the expectations
 * that protect the client, kept; the "Para quién es" list is dropped because it repeated the
 * recognition questions at the top of the page (Mari, 2026-09-23).
 */
const noEs = [
  'No es atención médica de emergencia.',
  'No sustituye un diagnóstico o tratamiento médico.',
  'No es una promesa de curar una enfermedad.',
  'No es un protocolo rígido aplicado igual a todos.',
];
---

<section class="reveal">
  <div class="wrap">
    <div class="no-es">
      <div class="no-es-head">
        <span class="eyebrow">Para tener expectativas claras</span>
        <h2>Lo que The Layer Method™ 1:1 no es</h2>
      </div>
      <ul>
        {noEs.map((n) => <li>{n}</li>)}
      </ul>
      <p class="nota">
        Si algo requiere evaluación médica, se te orientará a buscar el profesional adecuado.
      </p>
    </div>
  </div>
</section>

<style>
  section {
    padding: 24px 0 8px;
  }
  .no-es {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px 48px;
    padding: clamp(26px, 3vw, 38px) clamp(24px, 3.4vw, 44px);
    border-radius: var(--radius-lg);
    border: 1px solid rgb(48 47 42 / 0.12);
  }
  @media (min-width: 900px) {
    .no-es {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
    }
  }
  .eyebrow {
    margin-bottom: 10px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.15;
    text-wrap: balance;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px 28px;
  }
  @media (min-width: 640px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.5;
    font-weight: 600;
    color: rgb(48 47 42 / 0.78);
  }
  li::before {
    content: '×';
    position: absolute;
    left: 0;
    top: -1px;
    font-weight: 800;
    color: var(--color-clay-deep);
  }
  .nota {
    grid-column: 1 / -1;
    font-size: 13.5px;
    color: rgb(48 47 42 / 0.6);
  }
</style>
