---
/**
 * Who this is for / what this is not — two panels for clear expectations.
 */
const paraQuien = [
  'Tienes varias preocupaciones de bienestar y no sabes qué priorizar.',
  'Has probado distintas estrategias sin un marco coherente.',
  'Quieres una estrategia de nutrición y bienestar personalizada.',
  'Quieres entender cómo se conectan las diferentes piezas de tu contexto.',
  'Valoras la implementación y el ajuste, no solo una lista estática de recomendaciones.',
];
const noEs = [
  'No es atención médica de emergencia.',
  'No sustituye un diagnóstico o tratamiento médico.',
  'No es una promesa de curar una enfermedad.',
  'No es un protocolo rígido aplicado igual a todos.',
];
---

<section class="reveal">
  <div class="wrap two-col">
    <div class="fit-panel for-panel">
      <span class="eyebrow muted">Para quién es</span>
      <h3>Es un buen momento para The Layer Method 1:1 si...</h3>
      <ul class="simple-list">
        {paraQuien.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div class="fit-panel not-panel">
      <span class="eyebrow">Para tener expectativas claras</span>
      <h3>Lo que The Layer Method 1:1 no es</h3>
      <ul class="not-list">
        {noEs.map((n) => <li>{n}</li>)}
      </ul>
      <p class="not-note">
        Si algo requiere evaluación médica, se te orientará a buscar el profesional adecuado.
      </p>
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 36px 0;
    }
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 820px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  .fit-panel {
    border-radius: var(--radius-lg);
    padding: 44px;
  }
  @media (max-width: 640px) {
    .fit-panel {
      padding: 30px 26px;
    }
  }
  .for-panel {
    background: var(--color-sage);
  }
  .not-panel {
    background: var(--color-ivory);
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  .eyebrow.muted {
    color: rgb(48 47 42 / 0.72);
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(26px, 3.2vw, 34px);
    line-height: 1.18;
    margin-bottom: 24px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .simple-list li {
    font-weight: 700;
    font-size: 17px;
    color: var(--color-charcoal);
    position: relative;
    padding-left: 30px;
    margin-bottom: 18px;
    line-height: 1.5;
  }
  .simple-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 800;
  }
  .not-list li {
    font-weight: 700;
    font-size: 16px;
    color: rgb(48 47 42 / 0.72);
    position: relative;
    padding-left: 28px;
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .not-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: rgb(48 47 42 / 0.45);
    font-weight: 800;
  }
  .not-note {
    margin-top: 20px;
    font-size: 14px;
    font-weight: 500;
    color: rgb(48 47 42 / 0.45);
  }
</style>
