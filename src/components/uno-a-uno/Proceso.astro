---
/**
 * "Cómo funciona — Initial Layer Cycle": the whole cycle told once, in four steps, each with its
 * detail inline. Replaces the stepper + Assessment panel + Sesión 01 + Entre sesiones + Sesión 02
 * sections, which told the same process twice (Mari, 2026-09-23: "la sección 1:1 es demasiado
 * larga"). Copy is the existing copy, trimmed of repetitions. Drawn as a vertical route (Mari,
 * same day): a centre line that draws itself on scroll, steps alternating left and right; on
 * phones the line runs down the left.
 */
const temas = [
  'Objetivos',
  'Historia de salud y bienestar',
  'Alimentación',
  'Lifestyle',
  'Síntomas y preocupaciones',
  'Suplementación actual',
  'Fotos iniciales',
  'Laboratorios relevantes',
];

// The four stops of the cycle, in order.
const pasos = [
  {
    snum: 'Antes de la sesión 01',
    titulo: 'The Layer Assessment™',
    texto:
      'Completas una evaluación estructurada para no pasar la sesión recopilando información básica. Puede incluir:',
    chips: true,
    tono: 'clay-deep',
  },
  {
    snum: 'Sesión 01 · 90 min',
    titulo: 'Mapear + Priorizar',
    texto:
      'Revisamos tu contexto a través de las cinco Layers. El objetivo no es abordar todo a la vez — es determinar qué merece atención ahora y qué puede estar conectado.',
    nota: 'Sales con tu Layer Map™, tus Top 3 Priorities y tu Layer Plan™.',
    tono: 'sage-deep',
  },
  {
    snum: 'Entre sesiones · ~30 días',
    titulo: 'Implementar + Observar',
    texto:
      'Pones en marcha tu Layer Plan™ y observas respuesta, tolerancia, cambios y obstáculos. Este período es parte del Método — no es simplemente "esperar la próxima cita".',
    nota: 'Acompañamiento por correo una vez a la semana para resolver tus dudas.',
    tono: 'rose-deep',
  },
  {
    snum: 'Sesión 02 · 90 min',
    titulo: 'Revisar + Ajustar',
    cita: 'Ahora tenemos algo que la primera sesión no tenía: respuesta.',
    texto:
      'Revisamos qué cambió, qué fue difícil y si las prioridades se movieron. Sales con <strong>The Layer Review™</strong> — tu Layer Plan™ ajustado con base en tu respuesta real.',
    tono: 'olive',
  },
];
---

<section id="proceso" class="reveal">
  <div class="wrap">
    <span class="eyebrow">Cómo funciona</span>
    <h2 class="upcase">Initial Layer Cycle</h2>
    <p class="lead">
      Para nuevos clientes. Es el punto de partida para aplicar The Layer Method™ a tu contexto
      individual — no una consulta aislada, sino un ciclo completo con estructura.
    </p>

    <div class="ruta">
      <ol class="paradas reveal-stagger reveal">
        {
          pasos.map((p, i) => (
            <li class="parada" style={`--tono:var(--color-${p.tono});`}>
              <div class="hito" aria-hidden="true">
                <span class="marca">{`0${i + 1}`}</span>
              </div>
              <div class="texto">
                <span class="snum">{p.snum}</span>
                <h3>{p.titulo}</h3>
                {p.cita && <p class="cita">{p.cita}</p>}
                <p set:html={p.texto} />
                {p.chips && (
                  <div class="chips">
                    {temas.map((t) => (
                      <span class="chip">{t}</span>
                    ))}
                  </div>
                )}
                {p.nota && <p class="nota">{p.nota}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0;
  }
  @media (max-width: 760px) {
    section {
      padding: 36px 0;
    }
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
  }
  .upcase {
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .lead {
    font-size: 19px;
    line-height: 1.65;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
    max-width: 620px;
    margin-top: 16px;
  }

  /* ── The route ── */
  .ruta {
    position: relative;
    margin-top: 48px;
  }
  .paradas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .marca {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-bone);
    border: 2px solid var(--tono);
    box-shadow:
      0 0 0 6px rgb(251 250 246 / 0.9),
      0 10px 24px rgb(48 47 42 / 0.12);
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--color-charcoal);
    transition:
      background 0.35s ease,
      color 0.35s ease,
      transform 0.45s var(--ease-spring);
  }
  .parada:hover .marca {
    background: var(--tono);
    color: var(--color-bone);
    transform: scale(1.12);
  }
  .snum {
    display: block;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tono);
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(23px, 2.1vw, 28px);
    line-height: 1.15;
    margin-top: 8px;
  }
  .texto p {
    font-size: 15.5px;
    line-height: 1.6;
    font-weight: 500;
    color: rgb(48 47 42 / 0.75);
    margin-top: 10px;
  }
  .texto .cita {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.35;
    color: var(--color-charcoal);
  }
  .texto .nota {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tono) 12%, transparent);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }
  .chip {
    font-weight: 700;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(214 154 124 / 0.2);
    color: var(--color-charcoal);
  }

  /* Phones and tablets: a vertical track down the left, a stop beside each step. */
  @media (max-width: 999px) {
    .parada {
      position: relative;
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 20px;
      padding-bottom: 36px;
    }
    .parada::before {
      content: '';
      position: absolute;
      left: 22px;
      top: 46px;
      bottom: 0;
      border-left: 2px dashed rgb(48 47 42 / 0.18);
    }
    .parada:last-child {
      padding-bottom: 0;
    }
    .parada:last-child::before {
      display: none;
    }
    .texto {
      padding-top: 10px;
    }
  }

  /* Desktop: the line down the centre, steps alternating left and right of it. */
  @media (min-width: 1000px) {
    .paradas {
      position: relative;
      max-width: 1040px;
      margin: 0 auto;
      gap: 0;
    }
    .paradas::before,
    .paradas::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 23px;
      bottom: 23px;
      translate: -50% 0;
    }
    .paradas::before {
      border-left: 2px dashed rgb(48 47 42 / 0.16);
    }
    .paradas::after {
      width: 3px;
      border-radius: 3px;
      background: linear-gradient(
        180deg,
        var(--color-clay-deep),
        var(--color-sage-deep) 36%,
        var(--color-rose-deep) 64%,
        var(--color-olive)
      );
      transform-origin: top;
    }
    .parada {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr);
      column-gap: 44px;
      position: relative;
      z-index: 1;
    }
    /* Pull each step up beside the previous one so the zig-zag stays compact. */
    .parada + .parada {
      margin-top: -64px;
    }
    .hito {
      grid-column: 2;
      grid-row: 1;
    }
    .texto {
      grid-row: 1;
      padding-top: 10px;
    }
    .parada:nth-child(odd) .texto {
      grid-column: 1;
      text-align: right;
    }
    .parada:nth-child(odd) .chips {
      justify-content: flex-end;
    }
    .parada:nth-child(even) .texto {
      grid-column: 3;
    }
  }

  /* The centre line draws itself, top to bottom, as the route scrolls by. */
  @supports (animation-timeline: view()) {
    @media (min-width: 1000px) and (prefers-reduced-motion: no-preference) {
      .paradas::after {
        animation: dibujar linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 70%;
      }
      @keyframes dibujar {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }
    }
  }
</style>
