---
const temas = [
  'Objetivos',
  'Historia de salud y bienestar',
  'Alimentación',
  'Lifestyle',
  'Síntomas y preocupaciones',
  'Suplementación actual',
  'Fotos iniciales',
  'Laboratorios relevantes',
];

interface Paso {
  snum: string;
  titulo: string;
  parrafos: string[];
  cita?: string;
  chips?: boolean;
  nota?: string;
  tono: string;
}

const pasos: Paso[] = [
  {
    snum: 'Antes de la sesión 01',
    titulo: 'The Layer Assessment',
    parrafos: [
      'Completas una evaluación estructurada para no pasar la sesión recopilando información básica. Puede incluir:',
    ],
    chips: true,
    tono: 'clay-deep',
  },
  {
    snum: 'Sesión 01 · 90 min',
    titulo: 'Mapear + Priorizar',
    parrafos: [
      'Revisamos tu contexto a través de las cinco Layers. Se crea un plan de acción por fases para trabajar las capas según prioridad, y ese será tu Layer Map.',
      'El objetivo no es abordar todo a la vez. Es determinar qué merece atención ahora y qué puede estar conectado.',
    ],
    nota: 'Sales con tu Layer Map, tus Top 3 Priorities y tu Layer Plan.',
    tono: 'sage-deep',
  },
  {
    snum: 'Entre sesiones · 30–60 días',
    titulo: 'Implementar + Observar',
    parrafos: [
      'Pones en marcha tu Layer Plan y observas respuesta, tolerancia, cambios y obstáculos. Este período es parte del Método. No es simplemente "esperar la próxima cita".',
    ],
    nota: 'Acompañamiento por correo una vez a la semana para resolver tus dudas.',
    tono: 'rose-deep',
  },
  {
    snum: 'Sesión 02 · 90 min',
    titulo: 'Revisar + Ajustar',
    cita: 'Ahora tenemos algo que la primera sesión no tenía: respuesta.',
    parrafos: [
      'Revisamos qué cambió, qué fue difícil y si las prioridades se movieron. Sales con <strong>The Layer Review</strong>: tu Layer Plan ajustado con base en tu respuesta real.',
    ],
    tono: 'olive',
  },
  {
    snum: 'Siguiente paso',
    titulo: 'Next Layer Cycle',
    parrafos: [
      'Agenda tu próximo paquete de asesorías para continuar trabajando las capas del plan establecido en tu Layer Map.',
    ],
    tono: 'charcoal',
  },
];

const luces = [
  { tono: 'clay', x: '78%', y: '6%' },
  { tono: 'sage', x: '6%', y: '34%' },
  { tono: 'rose', x: '88%', y: '58%' },
  { tono: 'sage-deep', x: '18%', y: '84%' },
];
---

<section id="proceso" class="proceso">
  <div class="fondo" aria-hidden="true">
    {
      luces.map((l, i) => (
        <span class="luz" style={`--tono:var(--color-${l.tono});--x:${l.x};--y:${l.y};--i:${i};`} />
      ))
    }
  </div>
  <div class="wrap">
    <div class="cabeza reveal">
      <span class="eyebrow">Cómo funciona</span>
      <h2 class="upcase">Initial Layer Cycle</h2>
      <p class="lead">
        Para nuevos clientes. Es el punto de partida para aplicar The Layer Method a tu contexto
        individual: no una consulta aislada, sino un ciclo completo con estructura.
      </p>
    </div>

    <div class="ruta">
      <ol class="paradas">
        {
          pasos.map((p, i) => (
            <li
              class:list={['parada', i % 2 === 0 ? 'reveal-left' : 'reveal-right']}
              style={`--tono:var(--color-${p.tono});`}
            >
              <div class="hito" aria-hidden="true">
                <span class="marca">{`0${i + 1}`}</span>
              </div>
              <div class="texto">
                <span class="snum">{p.snum}</span>
                <h3>{p.titulo}</h3>
                {p.cita && <p class="cita">{p.cita}</p>}
                {p.parrafos.map((t) => (
                  <p set:html={t} />
                ))}
                {p.chips && (
                  <div class="chips">
                    {temas.map((t) => (
                      <span class="chip">{t}</span>
                    ))}
                  </div>
                )}
                {p.nota && <p class="nota">{p.nota}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .proceso {
    position: relative;
    overflow: hidden;
    padding: 72px 0;
  }
  @media (max-width: 760px) {
    .proceso {
      padding: 40px 0;
    }
  }
  .fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .luz {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: clamp(320px, 42vw, 620px);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--tono) 0%, transparent 68%);
    opacity: 0.55;
    animation: deriva calc(26s + var(--i) * 6s) ease-in-out infinite alternate;
  }
  .luz:nth-child(even) {
    animation-direction: alternate-reverse;
  }
  @keyframes deriva {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(6vw, -4vh) scale(1.12);
    }
    100% {
      transform: translate(-5vw, 5vh) scale(0.94);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .luz {
      animation: none;
    }
  }
  .wrap {
    position: relative;
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
  }
  .upcase {
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .lead {
    font-size: 19px;
    line-height: 1.65;
    font-weight: 500;
    color: rgb(48 47 42 / 0.72);
    max-width: 620px;
    margin-top: 16px;
  }
  .ruta {
    position: relative;
    margin-top: 48px;
  }
  .paradas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .marca {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-bone);
    border: 2px solid var(--tono);
    box-shadow:
      0 0 0 6px rgb(251 250 246 / 0.9),
      0 10px 24px rgb(48 47 42 / 0.12);
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--color-charcoal);
    transition:
      background 0.35s ease,
      color 0.35s ease,
      transform 0.45s var(--ease-spring);
  }
  .parada:hover .marca {
    background: var(--tono);
    color: var(--color-bone);
    transform: scale(1.12);
  }
  .texto {
    padding: 22px 24px 24px;
    border-radius: 20px;
    background: rgb(251 250 246 / 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid rgb(48 47 42 / 0.07);
    box-shadow: 0 16px 36px -26px rgb(48 47 42 / 0.4);
  }
  .snum {
    display: block;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tono);
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(23px, 2.1vw, 28px);
    line-height: 1.15;
    margin-top: 8px;
  }
  .texto p {
    font-size: 15.5px;
    line-height: 1.6;
    font-weight: 500;
    color: rgb(48 47 42 / 0.75);
    margin-top: 10px;
  }
  .texto .cita {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.35;
    color: var(--color-charcoal);
  }
  .texto .nota {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tono) 14%, transparent);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }
  .chip {
    font-weight: 700;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(214 154 124 / 0.2);
    color: var(--color-charcoal);
  }

  @media (max-width: 999px) {
    .parada {
      position: relative;
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 16px;
      padding-bottom: 28px;
    }
    .parada::before {
      content: '';
      position: absolute;
      left: 22px;
      top: 46px;
      bottom: 0;
      border-left: 2px dashed rgb(48 47 42 / 0.18);
    }
    .parada:last-child {
      padding-bottom: 0;
    }
    .parada:last-child::before {
      display: none;
    }
    .texto {
      padding: 18px 18px 20px;
    }
  }

  @media (min-width: 1000px) {
    .paradas {
      position: relative;
      max-width: 1040px;
      margin: 0 auto;
      gap: 0;
    }
    .paradas::before,
    .paradas::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 23px;
      bottom: 23px;
      translate: -50% 0;
    }
    .paradas::before {
      border-left: 2px dashed rgb(48 47 42 / 0.16);
    }
    .paradas::after {
      width: 3px;
      border-radius: 3px;
      background: linear-gradient(
        180deg,
        var(--color-clay-deep),
        var(--color-sage-deep) 28%,
        var(--color-rose-deep) 52%,
        var(--color-olive) 76%,
        var(--color-charcoal)
      );
      transform-origin: top;
    }
    .parada {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr);
      column-gap: 40px;
      position: relative;
      z-index: 1;
    }
    .parada + .parada {
      margin-top: -48px;
    }
    .hito {
      grid-column: 2;
      grid-row: 1;
    }
    .texto {
      grid-row: 1;
    }
    .parada:nth-child(odd) .texto {
      grid-column: 1;
      text-align: right;
    }
    .parada:nth-child(odd) .chips {
      justify-content: flex-end;
    }
    .parada:nth-child(even) .texto {
      grid-column: 3;
    }
  }

  @supports (animation-timeline: view()) {
    @media (min-width: 1000px) and (prefers-reduced-motion: no-preference) {
      .paradas::after {
        animation: dibujar linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 70%;
      }
      @keyframes dibujar {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }
    }
  }
</style>
