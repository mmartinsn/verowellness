---
import { Image } from 'astro:assets';
import manosLaptop from '../../assets/fotos/veronica-manos-laptop.jpg';

const tiers = ['Alta prioridad', 'Prioridad secundaria', 'Mantenimiento'];
const planTags = [
  'Nutrición',
  'Hábitos',
  'Lifestyle',
  'Suplementación',
  'Educación',
  'Laboratorios',
];
const planExtra = [
  '+1 guía adicional según el caso',
  'Estrategias nuevas y vanguardistas para optimizar tu salud',
];
---

<section class="entregables">
  <div class="wrap">
    <div class="partido">
      <div class="info">
        <div class="reveal">
          <span class="eyebrow">Lo que recibes al salir de la sesión 01</span>
          <h2>Tres piezas, construidas para ti.</h2>
        </div>

        <div class="list">
          <article class="deliverable reveal">
            <div class="dnum" aria-hidden="true">01</div>
            <div class="dbody">
              <span class="dtag">Propietario</span>
              <h3>The Layer Map</h3>
              <p>
                La organización personalizada de tus Layers relevantes y de cómo se conectan las
                diferentes piezas de tu contexto de bienestar.
              </p>
              <div class="priority-tiers">
                {tiers.map((t) => <span class="tier">{t}</span>)}
              </div>
            </div>
          </article>

          <article class="deliverable d-sage reveal">
            <div class="dnum" aria-hidden="true">02</div>
            <div class="dbody">
              <span class="dtag">Enfoque</span>
              <h3>Top 3 Priorities</h3>
              <p>
                Tres prioridades claramente definidas para tu etapa actual. No veinte cosas que
                cambiar al mismo tiempo: las que realmente mueven la aguja ahora.
              </p>
            </div>
          </article>

          <article class="deliverable d-rose reveal">
            <div class="dnum" aria-hidden="true">03</div>
            <div class="dbody">
              <span class="dtag">Estrategia</span>
              <h3>The Layer Plan</h3>
              <p>
                Un plan de acción personalizado, organizado por fases, para trabajar tus capas de
                salud y sus conexiones, con prioridades claras para avanzar hacia tus objetivos.
              </p>
              <div class="plan-tags">
                {planTags.map((t) => <span>{t}</span>)}
                {planExtra.map((t) => <span class="hl">{t}</span>)}
              </div>
            </div>
          </article>
        </div>
      </div>

      <figure class="foto reveal-right">
        <div class="marco">
          <Image
            src={manosLaptop}
            alt="Manos sobre una laptop durante una asesoría online"
            widths={[880]}
            sizes="(min-width: 1000px) 880px, 100vw"
          />
        </div>
        <figcaption class="sello">
          <span class="sello-num">3</span>
          <span class="sello-txt">piezas hechas a tu medida</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .entregables {
    padding: 64px 0;
  }
  @media (max-width: 760px) {
    .entregables {
      padding: 36px 0;
    }
  }
  .partido {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 999px) {
    .partido {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .foto {
      order: -1;
    }
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.1;
  }
  .list {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .deliverable {
    display: flex;
    gap: 24px;
    background: var(--color-ivory);
    border-radius: var(--radius-lg);
    padding: 30px 32px;
    border-left: 5px solid var(--color-clay-deep);
    transition:
      opacity 0.9s var(--ease-out-soft),
      transform 0.45s var(--ease-out-soft),
      box-shadow 0.45s var(--ease-out-soft);
  }
  .deliverable.reveal:nth-child(2) {
    transition-delay: 0.08s;
  }
  .deliverable.reveal:nth-child(3) {
    transition-delay: 0.16s;
  }
  .deliverable:hover {
    transform: translateY(-4px) translateX(4px);
    box-shadow: 0 18px 34px rgb(48 47 42 / 0.08);
  }
  .d-sage {
    border-left-color: var(--color-sage-deep);
  }
  .d-rose {
    border-left-color: var(--color-rose-deep);
  }
  @media (max-width: 700px) {
    .deliverable {
      flex-direction: column;
      gap: 10px;
      padding: 24px 22px;
    }
  }
  .dnum {
    font-family: var(--font-serif);
    font-size: 46px;
    font-weight: 500;
    color: rgb(48 47 42 / 0.12);
    line-height: 1;
    flex: 0 0 auto;
    width: 58px;
    transition:
      color 0.45s ease,
      transform 0.45s var(--ease-out-soft);
  }
  .deliverable:hover .dnum {
    color: var(--color-clay-deep);
    transform: translateY(-3px);
  }
  .d-sage:hover .dnum {
    color: var(--color-sage-deep);
  }
  .d-rose:hover .dnum {
    color: var(--color-rose-deep);
  }
  @media (max-width: 700px) {
    .dnum {
      font-size: 34px;
      width: auto;
    }
  }
  .dtag {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-clay-deep);
    margin-bottom: 8px;
    display: block;
  }
  .d-sage .dtag {
    color: var(--color-sage-deep);
  }
  .d-rose .dtag {
    color: var(--color-rose-deep);
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.18;
    margin-bottom: 8px;
  }
  .dbody p {
    font-size: 15.5px;
    line-height: 1.6;
    font-weight: 500;
    color: rgb(48 47 42 / 0.75);
  }
  .priority-tiers,
  .plan-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .tier,
  .plan-tags span {
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.05em;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-bone);
    color: rgb(48 47 42 / 0.72);
  }
  .plan-tags span {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0;
  }
  .plan-tags span.hl {
    background: var(--color-rose-deep);
    color: var(--color-bone);
  }

  .foto {
    position: sticky;
    top: 110px;
    margin: 0;
  }
  @media (max-width: 999px) {
    .foto {
      position: relative;
      top: 0;
    }
  }
  .marco {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 1 / 1;
    background: var(--color-sand);
    box-shadow: 0 30px 60px -36px rgb(48 47 42 / 0.5);
  }
  @media (max-width: 999px) {
    .marco {
      aspect-ratio: 3 / 2;
    }
  }
  .marco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 0%;
    transform: scale(1.03);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .marco :global(img) {
        animation: acercar linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      @keyframes acercar {
        from {
          transform: scale(1.1) translateY(-2%);
        }
        to {
          transform: scale(1) translateY(0);
        }
      }
    }
  }
  .marco::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(48 47 42 / 0.18));
    pointer-events: none;
  }
  .sello {
    position: absolute;
    left: -18px;
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 12px;
    border-radius: 999px;
    background: rgb(251 250 246 / 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 34px -18px rgb(48 47 42 / 0.45);
    animation: flotar 6s ease-in-out infinite;
  }
  @media (max-width: 999px) {
    .sello {
      left: 14px;
      bottom: 14px;
    }
  }
  @keyframes flotar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sello {
      animation: none;
    }
  }
  .sello-num {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-clay);
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--color-charcoal);
  }
  .sello-txt {
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-charcoal);
  }
</style>
