---
/**
 * «Paga en cuotas con Klarna»: one slim, elegant strip for buyers in the US (Mari, 2026-10-21: «que
 * no tome tanto espacio, elegante, creativo, que capte la atención»). Klarna only shows in the
 * checkout when the country is «Estados Unidos» (comercio.klarna, decision 57). The four segments
 * fill one after another (Pay in 4, without dates: when Klarna charges the first one varies by its
 * own pages). `monto` is the price, the 7 % already included since 2026-10-21; the strip prints a
 * quarter of it. Copy from Codex (Mari's split of 2026-10-03); `acento` is the italic part.
 */
import { comercio } from '../../data/site';

interface Props {
  titulo: string;
  acento?: string;
  detalles: string[];
  monto?: number;
  boton: { label: string; href: string };
  nota: string;
  /** Inside a block that already has its column (above the price cards): no own `.wrap`, less air. */
  incrustada?: boolean;
}

const { titulo, acento, detalles, monto, boton, nota, incrustada = false } = Astro.props;
const [antes, despues] = acento && titulo.includes(acento) ? titulo.split(acento) : [titulo, ''];
const cuota = monto === undefined ? null : `$${(Math.round((monto * 100) / 4) / 100).toFixed(2)}`;
---

{
  comercio.klarna && (
    <section class:list={['klarna', { incrustada }]} aria-label="Pago en cuotas con Klarna">
      <div class:list={{ wrap: !incrustada }}>
        <a class="cinta reveal" href={boton.href} aria-label={`${titulo} ${boton.label}`}>
          <span class="marca">Klarna.</span>
          <span class="texto">
            <span class="titulo">
              {antes}
              {acento && <em>{acento}</em>}
              {despues}
            </span>
            <span class="detalles">
              {detalles.map((d) => (
                <span>{d}</span>
              ))}
            </span>
          </span>
          <span class="cuotas" aria-hidden="true">
            <span class="segmentos">
              <i />
              <i />
              <i />
              <i />
            </span>
            <span class="monto">{cuota ? `4 × ${cuota}` : '4 pagos'}</span>
          </span>
          <span class="flecha" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
        <p class="nota">{nota}</p>
      </div>
    </section>
  )
}

<style>
  .klarna {
    --klarna: #ffa8cd;
    --klarna-hondo: #d9668f;
    --tinta: #1d1a17;
    padding: 36px 0 44px;
  }
  .klarna.incrustada {
    padding: 0 0 36px;
  }
  .cinta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 22px;
    max-width: 1060px;
    margin: 0 auto;
    padding: 14px 14px 14px 16px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgb(217 102 143 / 0.22);
    box-shadow:
      0 24px 48px -32px rgb(217 102 143 / 0.55),
      0 1px 0 rgb(29 26 23 / 0.03);
    color: var(--tinta);
    text-decoration: none;
    transition:
      transform 0.4s var(--ease-out-soft),
      box-shadow 0.4s var(--ease-out-soft),
      border-color 0.4s;
  }
  /* One pink sheen across the strip when it comes into view. */
  .cinta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgb(255 168 205 / 0.35) 50%,
      transparent 70%
    );
    transform: translateX(-110%);
  }
  .cinta.in::before {
    transition: transform 1.6s var(--ease-out-soft) 0.3s;
    transform: translateX(110%);
  }
  .cinta:hover {
    transform: translateY(-2px);
    border-color: rgb(217 102 143 / 0.45);
    box-shadow:
      0 30px 56px -30px rgb(217 102 143 / 0.65),
      0 1px 0 rgb(29 26 23 / 0.03);
  }
  .marca {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--tinta);
    background: var(--klarna);
    padding: 12px 18px 13px;
    border-radius: 999px;
  }
  .texto {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(20px, 2.1vw, 25px);
    line-height: 1.15;
  }
  .titulo em {
    font-style: italic;
    color: var(--klarna-hondo);
  }
  .detalles {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(29 26 23 / 0.5);
  }
  .detalles span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .detalles span::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--klarna-hondo);
  }
  .cuotas {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    padding-left: 22px;
    border-left: 1px solid rgb(29 26 23 / 0.08);
  }
  .segmentos {
    display: flex;
    gap: 4px;
  }
  .segmentos i {
    width: 22px;
    height: 5px;
    border-radius: 999px;
    background: rgb(29 26 23 / 0.1);
    background-image: linear-gradient(var(--klarna-hondo), var(--klarna-hondo));
    background-repeat: no-repeat;
    background-size: 0 100%;
    animation: llenar 4.8s ease-in-out infinite;
  }
  .segmentos i:nth-child(2) {
    animation-delay: 0.6s;
  }
  .segmentos i:nth-child(3) {
    animation-delay: 1.2s;
  }
  .segmentos i:nth-child(4) {
    animation-delay: 1.8s;
  }
  @keyframes llenar {
    0% {
      background-size: 0 100%;
    }
    12%,
    78% {
      background-size: 100% 100%;
    }
    92%,
    100% {
      background-size: 0 100%;
    }
  }
  .monto {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }
  .flecha {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--tinta);
    color: #fff;
    transition: transform 0.4s var(--ease-out-soft);
  }
  .cinta:hover .flecha {
    transform: translateX(3px);
  }
  .nota {
    margin: 12px auto 0;
    max-width: 760px;
    text-align: center;
    font-size: 11.5px;
    line-height: 1.5;
    color: inherit;
    opacity: 0.6;
  }
  @media (max-width: 760px) {
    .cinta {
      flex-wrap: wrap;
      gap: 14px 14px;
      padding: 18px 18px 16px;
      border-radius: 26px;
    }
    .marca {
      padding: 8px 14px 9px;
      font-size: 15px;
    }
    .texto {
      flex-basis: calc(100% - 110px);
    }
    .cuotas {
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0 0;
      border-left: 0;
      border-top: 1px solid rgb(29 26 23 / 0.08);
    }
    .flecha {
      width: 40px;
      height: 40px;
      margin-top: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .segmentos i {
      animation: none;
      background-size: 100% 100%;
    }
    .cinta.in::before {
      transition: none;
    }
  }
</style>
