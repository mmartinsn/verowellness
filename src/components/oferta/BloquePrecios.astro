---
/**
 * The two public prices (Layer Session left, Initial Layer Cycle right, with its bonus) and, under
 * both, the private invitation for existing patients as a membership strip with a card. Shared by the home offer, Mi método
 * and Asesorías. Everything comes from data/oferta.
 */
import { ciclos, checkoutPath, continuidad, precioCard } from '../../data/oferta';
import { href } from '../../lib/url';
import { cta } from '../../data/site';

const session = ciclos.LAYER_SESSION;
const initial = ciclos.INITIAL_LAYER_CYCLE;

const check =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
---

<div class="precios reveal">
  <article class="tier spot tilt-card">
    <div>
      <span class="ptag ptag-sand">{session.etiqueta}</span>
      <h3 class="pname">{session.nombre}</h3>
      <span class="pval"
        >{precioCard(session)} <small class="pcitas">{session.consultas}</small></span
      >
      <p class="pdesc">{session.descripcion}</p>
      <ul class="incluye">
        {
          session.incluye.map((item) => (
            <li>
              <Fragment set:html={check} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <a
      class="btn btn-outline btn-block"
      href={href(checkoutPath(session))}
      aria-label={`Reservar ${session.nombre}`}>{cta.label}</a
    >
  </article>

  <article class="tier destacado grad-ring tilt-card">
    <span class="recomendada">Recomendada</span>
    <div>
      <span class="ptag">{initial.etiqueta}</span>
      <h3 class="pname">{initial.nombre}</h3>
      <span class="pval"
        >{precioCard(initial)} <small class="pcitas">{initial.consultas}</small></span
      >
      <p class="pnota">{initial.etiquetaNota}</p>
      <p class="pdesc">{initial.descripcion}</p>
      <ul class="incluye">
        {
          initial.incluye.map((item) => (
            <li>
              <Fragment set:html={check} />
              {item}
            </li>
          ))
        }
      </ul>
      {
        initial.bonus && (
          <p class="bonus">
            <span class="bonus-tag">Bonus</span>
            {initial.bonus}
          </p>
        )
      }
    </div>
    <a
      class="btn btn-primary btn-block"
      href={href(checkoutPath(initial))}
      aria-label={`Reservar ${initial.nombre}`}>{cta.label}</a
    >
  </article>
</div>

<!-- Existing patients: a membership strip, not a footnote (Mari, 2026-10-03: «no resalta»). -->
<aside class="membresia reveal">
  <div class="carnet-zona" aria-hidden="true">
    <div class="carnet">
      <span class="carnet-brillo"></span>
      <div class="carnet-top">
        <span class="carnet-marca">VERONICA WELLNESS</span>
        <span class="carnet-chip"></span>
      </div>
      <p class="carnet-nivel">Next Layer Cycle</p>
      <div class="carnet-pie">
        <span>Solo pacientes</span>
        <span class="carnet-capas"><i></i><i></i><i></i><i></i><i></i></span>
      </div>
    </div>
  </div>
  <div class="membresia-texto">
    <span class="membresia-tag">{continuidad.etiqueta}</span>
    <p class="membresia-titulo">{continuidad.titulo}</p>
    <p class="membresia-sub">{continuidad.texto}</p>
    <a class="membresia-btn" href={continuidad.url} target="_blank" rel="noopener">
      {continuidad.boton}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<style>
  .precios {
    color: var(--color-charcoal);
    text-align: left;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    max-width: 1060px;
    margin: 0 auto;
  }
  @media (min-width: 860px) {
    .precios {
      grid-template-columns: 0.95fr 1.05fr;
      align-items: stretch;
    }
  }
  .tier {
    border-radius: 32px;
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    border: 1px solid rgb(35 34 30 / 0.12);
    background: var(--color-white);
    box-shadow: 0 16px 40px rgb(35 34 30 / 0.06);
    transform-style: preserve-3d;
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.3s ease;
  }
  @media (max-width: 520px) {
    .tier {
      padding: 36px 26px;
    }
  }
  .tier:hover {
    box-shadow: 0 24px 60px rgb(35 34 30 / 0.12);
  }
  .tier.destacado {
    background:
      radial-gradient(circle at 90% 10%, rgb(255 255 255 / 0.45) 0%, transparent 60%),
      var(--color-clay);
    border-color: rgb(35 34 30 / 0.15);
    box-shadow: 0 20px 50px rgb(214 154 124 / 0.3);
  }
  .ptag {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    background: rgb(255 255 255 / 0.6);
    border-radius: var(--radius-pill);
    margin-bottom: 12px;
  }
  .ptag-sand {
    background: var(--color-sand);
  }
  .pname {
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-charcoal);
    font-size: clamp(28px, 3.4vw, 36px);
    margin-bottom: 8px;
  }
  .pval {
    display: block;
    font-size: 38px;
    font-weight: 800;
    color: var(--color-charcoal);
    margin-bottom: 14px;
  }
  .pcitas {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    vertical-align: middle;
    margin-left: 8px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.6);
    color: rgb(35 34 30 / 0.75);
  }

  /* The featured card's button is dark on every page (the editorial theme's primary is clay,
     which would vanish on the clay card). */
  /* «Recomendada» on the top edge of the new-patient cycle (Verónica, 2026-10-03: a visual nudge
     towards the two appointments). */
  .destacado {
    position: relative;
    overflow: visible;
  }
  .recomendada {
    position: absolute;
    top: -13px;
    left: 50%;
    translate: -50% 0;
    z-index: 2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-clay);
    white-space: nowrap;
    box-shadow: 0 10px 22px -12px rgb(35 34 30 / 0.6);
  }
  .destacado .btn {
    background: var(--color-charcoal);
    color: var(--color-bone);
    border-color: var(--color-charcoal);
  }
  /* ── Membership strip for existing patients ── */
  .membresia {
    max-width: 1060px;
    margin: 28px auto 0;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(28px, 4vw, 48px);
    border-radius: 32px;
    background:
      radial-gradient(60% 90% at 0% 50%, rgb(214 154 124 / 0.28), transparent 70%),
      linear-gradient(160deg, #2b2a25, #1a1916);
    color: var(--color-bone);
    text-align: left;
    box-shadow: 0 30px 70px -45px rgb(0 0 0 / 0.7);
    border: 1px solid rgb(248 246 241 / 0.1);
  }
  .carnet-zona {
    display: flex;
    justify-content: center;
    perspective: 900px;
  }
  .carnet {
    position: relative;
    overflow: hidden;
    width: min(340px, 100%);
    aspect-ratio: 1.586;
    padding: 22px 24px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(231 183 160 / 0.35), transparent 55%),
      linear-gradient(145deg, #3a3832, #191814 70%);
    box-shadow:
      0 0 0 1px rgb(231 183 160 / 0.55),
      0 30px 50px -24px rgb(0 0 0 / 0.8);
    transform: rotate(-6deg) rotateY(8deg);
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .membresia:hover .carnet {
    transform: rotate(0deg) rotateY(0deg) translateY(-4px);
  }
  /* A sheen crossing the card now and then, like a premium card. */
  .carnet-brillo {
    position: absolute;
    inset: -40% -60%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgb(255 255 255 / 0.18) 50%,
      transparent 60%
    );
    animation: brillo 5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes brillo {
    0%,
    55% {
      transform: translateX(-60%);
    }
    100% {
      transform: translateX(60%);
    }
  }
  .carnet-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .carnet-marca {
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: 0.22em;
    color: rgb(248 246 241 / 0.85);
  }
  .carnet-chip {
    width: 38px;
    height: 28px;
    border-radius: 6px;
    background: linear-gradient(135deg, #f0c4ae, var(--color-clay-deep));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }
  .carnet-nivel {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(26px, 2.6vw, 32px);
    color: var(--color-bone);
  }
  .carnet-pie {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .carnet-capas {
    display: grid;
    gap: 3px;
    justify-items: end;
  }
  .carnet-capas i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--color-clay);
    opacity: 0.85;
  }
  .carnet-capas i:nth-child(1) {
    width: 34px;
  }
  .carnet-capas i:nth-child(2) {
    width: 28px;
    opacity: 0.7;
  }
  .carnet-capas i:nth-child(3) {
    width: 22px;
    opacity: 0.55;
  }
  .carnet-capas i:nth-child(4) {
    width: 16px;
    opacity: 0.4;
  }
  .carnet-capas i:nth-child(5) {
    width: 10px;
    opacity: 0.3;
  }
  .membresia-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(231 183 160 / 0.6);
    color: var(--color-clay);
  }
  .membresia-titulo {
    margin: 16px 0 10px;
    font-family: var(--font-serif);
    font-size: clamp(32px, 3.6vw, 46px);
    line-height: 1.05;
    color: var(--color-bone);
  }
  .membresia-sub {
    margin: 0 0 24px;
    max-width: 440px;
    font-size: 16px;
    line-height: 1.6;
    color: rgb(248 246 241 / 0.75);
  }
  .membresia-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 26px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f0c4ae, var(--color-clay-deep));
    color: var(--color-charcoal);
    font-weight: 800;
    font-size: 14.5px;
    text-decoration: none;
    box-shadow: 0 14px 30px -14px rgb(231 183 160 / 0.7);
    transition: transform 0.25s;
  }
  .membresia-btn:hover {
    transform: translateY(-2px);
  }
  .membresia-btn span {
    transition: transform 0.25s;
  }
  .membresia-btn:hover span {
    transform: translateX(4px);
  }
  @media (max-width: 760px) {
    .membresia {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .membresia-sub {
      margin-inline: auto;
    }
    .carnet {
      width: min(280px, 86%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carnet-brillo {
      animation: none;
    }
  }

  .pnota {
    font-size: 13.5px;
    line-height: 1.5;
    color: rgb(35 34 30 / 0.7);
    font-style: italic;
  }
  .pdesc {
    margin: 20px 0 24px;
    font-weight: 600;
  }
  .pdesc.pdesc-nota {
    font-size: 14.5px;
    font-weight: 450;
    color: rgb(35 34 30 / 0.7);
    font-style: italic;
  }
  .incluye {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    padding: 0;
  }
  .incluye li {
    font-size: 16px;
    font-weight: 650;
    color: var(--color-charcoal);
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .bonus {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 22px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.55);
    border: 1px dashed rgb(35 34 30 / 0.25);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-charcoal);
  }
  .bonus-tag {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .incluye li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
