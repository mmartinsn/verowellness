---
/**
 * The two public prices (Layer Session left, Initial Layer Cycle right, with its bonus) and, under
 * the first, the private invitation for existing patients. Shared by the home offer, Mi método
 * and Asesorías. Everything comes from data/oferta.
 */
import { ciclos, checkoutPath, continuidad, precioCard } from '../../data/oferta';
import { href } from '../../lib/url';
import { cta } from '../../data/site';

const session = ciclos.LAYER_SESSION;
const initial = ciclos.INITIAL_LAYER_CYCLE;

const check =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
---

<div class="precios reveal">
  <div class="col-izq">
    <article class="tier spot tilt-card">
      <div>
        <span class="ptag ptag-sand">{session.etiqueta}</span>
        <h3 class="pname">{session.nombre}</h3>
        <span class="pval"
          >{precioCard(session)} <small class="pcitas">{session.consultas}</small></span
        >
        <p class="pdesc">{session.descripcion}</p>
        <ul class="incluye">
          {
            session.incluye.map((item) => (
              <li>
                <Fragment set:html={check} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <a
        class="btn btn-outline btn-block"
        href={href(checkoutPath(session))}
        aria-label={`Reservar ${session.nombre}`}>{cta.label}</a
      >
    </article>
    <aside class="exclusivo">
      <span class="exclusivo-tag">{continuidad.etiqueta}</span>
      <div>
        <p class="exclusivo-titulo">{continuidad.titulo}</p>
        <p class="exclusivo-texto">{continuidad.texto}</p>
      </div>
      <a class="exclusivo-link" href={continuidad.url} target="_blank" rel="noopener"
        >{continuidad.boton} →</a
      >
    </aside>
  </div>

  <article class="tier destacado grad-ring tilt-card">
    <span class="recomendada">Recomendada</span>
    <div>
      <span class="ptag">{initial.etiqueta}</span>
      <h3 class="pname">{initial.nombre}</h3>
      <span class="pval"
        >{precioCard(initial)} <small class="pcitas">{initial.consultas}</small></span
      >
      <p class="pnota">{initial.etiquetaNota}</p>
      <p class="pdesc">{initial.descripcion}</p>
      <ul class="incluye">
        {
          initial.incluye.map((item) => (
            <li>
              <Fragment set:html={check} />
              {item}
            </li>
          ))
        }
      </ul>
      {
        initial.bonus && (
          <p class="bonus">
            <span class="bonus-tag">Bonus</span>
            {initial.bonus}
          </p>
        )
      }
    </div>
    <a
      class="btn btn-primary btn-block"
      href={href(checkoutPath(initial))}
      aria-label={`Reservar ${initial.nombre}`}>{cta.label}</a
    >
  </article>
</div>

<style>
  .precios {
    color: var(--color-charcoal);
    text-align: left;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    max-width: 1060px;
    margin: 0 auto;
  }
  @media (min-width: 860px) {
    .precios {
      grid-template-columns: 0.95fr 1.05fr;
      align-items: stretch;
    }
  }
  .tier {
    border-radius: 32px;
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    border: 1px solid rgb(35 34 30 / 0.12);
    background: var(--color-white);
    box-shadow: 0 16px 40px rgb(35 34 30 / 0.06);
    transform-style: preserve-3d;
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.3s ease;
  }
  @media (max-width: 520px) {
    .tier {
      padding: 36px 26px;
    }
  }
  .tier:hover {
    box-shadow: 0 24px 60px rgb(35 34 30 / 0.12);
  }
  .tier.destacado {
    background:
      radial-gradient(circle at 90% 10%, rgb(255 255 255 / 0.45) 0%, transparent 60%),
      var(--color-clay);
    border-color: rgb(35 34 30 / 0.15);
    box-shadow: 0 20px 50px rgb(214 154 124 / 0.3);
  }
  .ptag {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    background: rgb(255 255 255 / 0.6);
    border-radius: var(--radius-pill);
    margin-bottom: 12px;
  }
  .ptag-sand {
    background: var(--color-sand);
  }
  .pname {
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-charcoal);
    font-size: clamp(28px, 3.4vw, 36px);
    margin-bottom: 8px;
  }
  .pval {
    display: block;
    font-size: 38px;
    font-weight: 800;
    color: var(--color-charcoal);
    margin-bottom: 14px;
  }
  .pcitas {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    vertical-align: middle;
    margin-left: 8px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.6);
    color: rgb(35 34 30 / 0.75);
  }

  /* The featured card's button is dark on every page (the editorial theme's primary is clay,
     which would vanish on the clay card). */
  /* «Recomendada» on the top edge of the new-patient cycle (Verónica, 2026-10-03: a visual nudge
     towards the two appointments). */
  .destacado {
    position: relative;
    overflow: visible;
  }
  .recomendada {
    position: absolute;
    top: -13px;
    left: 50%;
    translate: -50% 0;
    z-index: 2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-clay);
    white-space: nowrap;
    box-shadow: 0 10px 22px -12px rgb(35 34 30 / 0.6);
  }
  .destacado .btn {
    background: var(--color-charcoal);
    color: var(--color-bone);
    border-color: var(--color-charcoal);
  }
  .col-izq {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .col-izq .tier {
    flex: 1;
  }
  /* Phones: the cards stack, and the private invitation goes after both prices. */
  @media (max-width: 859px) {
    .col-izq {
      display: contents;
    }
    .exclusivo {
      order: 3;
    }
  }
  /* Existing patients: no public price, a private invitation instead. */
  .exclusivo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    background: linear-gradient(160deg, #2b2a25, #1e1d1a);
    color: var(--color-bone);
    border-radius: 28px;
    border: 1px solid rgb(248 246 241 / 0.12);
    padding: 26px 30px;
    box-shadow: 0 24px 50px -30px rgb(35 34 30 / 0.6);
  }
  .exclusivo-tag {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-charcoal);
    background: var(--color-clay);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    white-space: nowrap;
  }
  .exclusivo-titulo {
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.1;
    color: var(--color-bone);
    margin: 0 0 4px;
  }
  .exclusivo-texto {
    font-size: 14.5px;
    color: rgb(251 250 246 / 0.75);
    margin: 0;
  }
  .exclusivo-link {
    font-weight: 700;
    font-size: 14.5px;
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .pnota {
    font-size: 13.5px;
    line-height: 1.5;
    color: rgb(35 34 30 / 0.7);
    font-style: italic;
  }
  .pdesc {
    margin: 20px 0 24px;
    font-weight: 600;
  }
  .pdesc.pdesc-nota {
    font-size: 14.5px;
    font-weight: 450;
    color: rgb(35 34 30 / 0.7);
    font-style: italic;
  }
  .incluye {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    padding: 0;
  }
  .incluye li {
    font-size: 16px;
    font-weight: 650;
    color: var(--color-charcoal);
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .bonus {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 22px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.55);
    border: 1px dashed rgb(35 34 30 / 0.25);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-charcoal);
  }
  .bonus-tag {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .incluye li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
