---
import { href } from '../lib/url';
import { cta } from '../data/site';

interface Props {
  label?: string;
  path?: string;
}
const { label = cta.label, path = cta.path } = Astro.props;
---

<div class="sticky-cta-bar">
  <a href={href(path)} class="btn btn-primary btn-block sticky-cta-btn">{label}</a>
</div>

<style>
  .sticky-cta-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    background: rgb(251 250 246 / 0.94);
    backdrop-filter: blur(6px);
    border-top: 1px solid rgb(48 47 42 / 0.1);
    padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
  }
  /* Exámenes and Tienda have their own basket bar: while it shows, it is the call to action. */
  :global(body:has([data-dock]:not([hidden]), #tiendaSeleccion.con-items)) .sticky-cta-bar {
    display: none;
  }
  @media (min-width: 1024px) {
    .sticky-cta-bar {
      left: auto;
      right: 28px;
      bottom: 28px;
      background: none;
      backdrop-filter: none;
      border-top: 0;
      padding: 0;
    }
    .sticky-cta-btn {
      width: auto;
      padding-inline: 40px;
      box-shadow: 0 14px 34px -12px rgb(48 47 42 / 0.45);
    }
  }
</style>
