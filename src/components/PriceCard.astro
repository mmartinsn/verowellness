---
/**
 * Price card for one cycle (Initial / Next). Used on the editorial home and the 1:1 page.
 * Everything printed comes from data/oferta; the button leads to that cycle's checkout.
 */
import Icon from './Icon.astro';
import { checkoutPath, precioCard, type Ciclo } from '../data/oferta';
import { href } from '../lib/url';

interface Props {
  ciclo: Ciclo;
  /** The featured card gets the clay background. */
  featured?: boolean;
  ctaLabel?: string;
}
const { ciclo, featured = false, ctaLabel = 'Reservar' } = Astro.props;
---

<article class:list={['price-card', { featured }]}>
  <span class="ptag">{ciclo.etiqueta}</span>
  {ciclo.etiquetaNota && <p class="pnote">{ciclo.etiquetaNota}</p>}
  <h3 class="pname">{ciclo.nombre}</h3>
  <span class="pval">{precioCard(ciclo)}</span>
  <p class="pdesc">{ciclo.descripcion}</p>
  {
    ciclo.notaPie && (
      <>
        <div class="pdivider" aria-hidden="true" />
        <p class="pnote">{ciclo.notaPie}</p>
      </>
    )
  }
  <ul class="pchecklist">
    {
      ciclo.incluye.map((item) => (
        <li>
          <Icon name="check" size={14} stroke={2.5} class="pcheck" />
          {item}
        </li>
      ))
    }
  </ul>
  <a class="btn btn-outline btn-block pbtn" href={href(checkoutPath(ciclo))}>{ctaLabel}</a>
</article>

<style>
  .price-card {
    border-radius: var(--radius-lg);
    padding: 40px 32px;
    background: var(--color-ivory);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      transform 0.45s var(--ease-out-soft),
      box-shadow 0.45s var(--ease-out-soft);
  }
  .price-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }
  @media (max-width: 640px) {
    .price-card {
      padding: 32px 26px;
    }
  }
  .price-card.featured {
    background: var(--color-clay);
  }
  .price-card.featured:hover {
    box-shadow: var(--shadow-lift-warm);
  }
  .pchecklist li {
    transition: transform 0.3s var(--ease-out-soft);
  }
  .price-card:hover .pchecklist li {
    transform: translateX(3px);
  }
  .price-card:hover .pchecklist li:nth-child(2) {
    transition-delay: 0.04s;
  }
  .price-card:hover .pchecklist li:nth-child(3) {
    transition-delay: 0.08s;
  }
  .price-card:hover .pchecklist li:nth-child(4) {
    transition-delay: 0.12s;
  }
  .price-card:hover .pchecklist li:nth-child(5) {
    transition-delay: 0.16s;
  }
  .ptag {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(48 47 42 / 0.85);
  }
  .pnote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: rgb(48 47 42 / 0.72);
  }
  .featured .pnote {
    color: rgb(48 47 42 / 0.8);
  }
  .pname {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3vw, 34px);
    line-height: 1.15;
    margin-top: 6px;
  }
  .pval {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(24px, 2.6vw, 30px);
    color: var(--color-charcoal);
  }
  .pdesc {
    font-size: 16.5px;
    line-height: 1.6;
    font-weight: 600;
    color: rgb(48 47 42 / 0.85);
  }
  .pdivider {
    height: 1px;
    background: rgb(48 47 42 / 0.12);
    margin: 8px 0;
  }
  .pchecklist {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pchecklist li {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-charcoal);
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .pcheck {
    flex-shrink: 0;
    margin-top: 4px;
    color: rgb(48 47 42 / 0.72);
  }
  .pbtn {
    margin-top: auto;
    padding-top: 18px;
    padding-bottom: 18px;
  }
</style>
