---
/**
 * The brand symbol: a dot over two stacked chevrons — "the layers". Inline SVG so it inherits
 * `currentColor`; size in CSS pixels.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="12" cy="4" r="2" fill="currentColor"></circle>
  <path
    d="M4 10L12 15L20 10"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M4 16L12 21L20 16"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
