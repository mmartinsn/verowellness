---
/**
 * Testimonials (data/testimonios) as a wall of quote cards (Mari, 2026-10-03: the photos come
 * from chat screenshots and pixelate when large). The words lead: her sentence set large, a short
 * excerpt with «Leer más», and at the foot a small round photo (or initial) with name, place and
 * reason. Masonry columns on wide screens, a sideways swipe on phones. Cards alternate soft
 * tones of the palette. Used on Sobre mí and Asesorías.
 */
import { Image } from 'astro:assets';
import { testimonios } from '../data/testimonios';

interface Props {
  titulo?: string;
  eyebrow?: string;
  /** Show only these ids (default: all). */
  ids?: string[];
  /** Open with her numbers (+5.000 casos, +8 años) as the proof the voices back up. */
  cifras?: boolean;
}
const {
  titulo = 'Lo que dicen quienes ya empezaron.',
  eyebrow = 'Testimonios',
  ids,
  cifras = false,
} = Astro.props;
const lista = (ids ? testimonios.filter((t) => ids.includes(t.id)) : testimonios)
  .slice()
  .sort((a, b) => a.prioridad - b.prioridad);
const inicial = (n: string) => n.trim().charAt(0).toUpperCase();
/** Three columns filled left to right, so the top row holds the three most powerful. */
const columnas = [0, 1, 2]
  .map((c) => lista.map((t, i) => ({ t, i })).filter(({ i }) => i % 3 === c))
  .filter((col) => col.length > 0);
/** The excerpt: the first paragraph, cut at a sentence end near 220 characters. */
const extracto = (p = '') => {
  if (p.length <= 240) return { corto: p, cortado: false };
  const corte = p.slice(0, 240).lastIndexOf('. ');
  const fin = corte > 120 ? corte + 1 : p.slice(0, 220).lastIndexOf(' ');
  return { corto: `${p.slice(0, fin).trim()}…`, cortado: true };
};
---

{
  lista.length > 0 && (
    <section class="testimonios">
      <div class="wrap">
        <div class="t-cab reveal">
          <span class="eyebrow">{eyebrow}</span>
          {cifras && (
            <div class="cifras" data-cifras>
              <p class="cifra">
                <strong>
                  +<span data-cuenta="5000">5.000</span>
                </strong>
                <span>casos acompañados</span>
              </p>
              <span class="cifra-sep" aria-hidden="true" />
              <p class="cifra">
                <strong>
                  +<span data-cuenta="8">8</span>
                </strong>
                <span>años de experiencia</span>
              </p>
            </div>
          )}
          <h2 class:list={{ 'con-cifras': cifras }}>{titulo}</h2>
        </div>
        <div class="muro">
          {columnas.map((col) => (
            <div class="col">
              {col.map(({ t, i }) => {
                const ex = extracto(t.texto[0]);
                const hayMas = ex.cortado || t.texto.length > 1;
                return (
                  <article class:list={['t-card', 'reveal', `tono-${i % 4}`]} style={`order:${i}`}>
                    <span class="t-comillas" aria-hidden="true">
                      “
                    </span>
                    <blockquote class="t-destacado">{t.destacado}</blockquote>
                    {t.texto.length > 0 &&
                      (hayMas ? (
                        <details class="t-mas">
                          <summary>
                            <span class="t-texto t-corto">{ex.corto}</span>
                            <span class="t-leer">
                              <span class="abrir">Leer más</span>
                              <span class="cerrar">Leer menos</span>
                            </span>
                          </summary>
                          {t.texto.map((p) => (
                            <p class="t-texto">{p}</p>
                          ))}
                        </details>
                      ) : (
                        <p class="t-texto">{t.texto[0]}</p>
                      ))}
                    <footer class="t-pie">
                      <span class="t-avatar">
                        {t.foto ? (
                          <Image src={t.foto} alt="" widths={[56, 112]} sizes="56px" />
                        ) : (
                          <span class="t-inicial">{inicial(t.nombre)}</span>
                        )}
                      </span>
                      <span class="t-quien">
                        <strong>{t.nombre}</strong>
                        {t.lugar && <small>{t.lugar}</small>}
                      </span>
                    </footer>
                    {t.motivo.length > 0 && (
                      <ul class="t-motivo">
                        {t.motivo.map((m) => (
                          <li>{m}</li>
                        ))}
                      </ul>
                    )}
                  </article>
                );
              })}
            </div>
          ))}
        </div>
        {lista.length > 1 && (
          <p class="t-desliza" aria-hidden="true">
            Desliza para ver más →
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .testimonios {
    padding: clamp(56px, 7vw, 100px) 0 0;
  }
  .cifras {
    margin-top: 16px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 34px;
  }
  .cifra {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .cifra strong {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(64px, 9vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .cifra strong::first-letter {
    color: var(--color-clay-rich);
  }
  .cifra > span {
    max-width: 120px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    color: rgb(35 34 30 / 0.65);
  }
  .cifra-sep {
    width: 1px;
    height: 70px;
    background: rgb(35 34 30 / 0.15);
  }
  @media (max-width: 640px) {
    .cifra-sep {
      display: none;
    }
  }
  .t-cab h2.con-cifras {
    font-style: italic;
    font-size: clamp(26px, 3vw, 38px);
    color: var(--color-clay-rich);
    margin-top: 22px;
  }
  .t-cab h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1.05;
    margin: 14px 0 0;
  }

  /* Masonry: cards keep their natural height and fill three columns. */
  .muro {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: start;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  @media (max-width: 1000px) and (min-width: 701px) {
    .muro {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .t-card {
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 26px 26px 22px;
    border-radius: 28px;
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.06);
    box-shadow: 0 22px 50px -40px rgb(35 34 30 / 0.5);
    transition:
      transform 0.35s cubic-bezier(0.19, 1, 0.22, 1),
      box-shadow 0.35s;
  }
  .t-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -40px rgb(35 34 30 / 0.55);
  }
  /* Soft tones of the palette, alternating, so the wall has rhythm and no card is singled out. */
  .tono-0 {
    background: color-mix(in srgb, var(--color-sage) 38%, white);
  }
  .tono-1 {
    background: color-mix(in srgb, var(--color-sand) 70%, white);
  }
  .tono-2 {
    background: color-mix(in srgb, var(--color-rose) 30%, white);
  }
  .tono-3 {
    background: var(--color-white);
  }
  .t-comillas {
    display: block;
    font-family: var(--font-serif);
    font-size: 80px;
    line-height: 0.55;
    height: 30px;
    color: var(--color-clay);
  }
  .t-destacado {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2vw, 27px);
    line-height: 1.25;
    color: var(--color-charcoal);
  }
  .t-texto {
    display: block;
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.65;
    color: rgb(35 34 30 / 0.78);
  }
  .t-mas summary {
    list-style: none;
    cursor: pointer;
  }
  .t-mas summary::-webkit-details-marker {
    display: none;
  }
  .t-mas[open] .t-corto {
    display: none;
  }
  .t-mas[open] summary {
    order: 9;
  }
  .t-mas[open] {
    display: flex;
    flex-direction: column;
  }
  .t-leer {
    display: inline-block;
    font-size: 13px;
    font-weight: 800;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(35 34 30 / 0.3);
  }
  .t-mas .cerrar,
  .t-mas[open] .abrir {
    display: none;
  }
  .t-mas[open] .cerrar {
    display: inline;
  }
  .t-pie {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgb(35 34 30 / 0.08);
  }
  .t-avatar {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-sand);
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.9);
  }
  .t-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .t-inicial {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--color-clay-rich);
  }
  .t-quien {
    display: flex;
    flex-direction: column;
  }
  .t-quien strong {
    font-size: 15px;
    color: var(--color-charcoal);
  }
  .t-quien small {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.55);
  }
  .t-motivo {
    list-style: none;
    margin: -4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .t-motivo li {
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.75);
    border: 1px solid rgb(35 34 30 / 0.08);
  }

  .t-desliza {
    display: none;
  }
  /* Phones: one row that slides sideways. */
  @media (max-width: 700px) {
    .col {
      display: contents;
    }
    .muro {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -16px;
      padding: 4px 16px 14px;
      scrollbar-width: none;
      align-items: start;
    }
    .muro::-webkit-scrollbar {
      display: none;
    }
    .t-card {
      margin: 0;
      scroll-snap-align: start;
    }
    .t-desliza {
      display: block;
      margin: 4px 0 0;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(35 34 30 / 0.5);
    }
  }
</style>

<script>
  // Her numbers count up once when they come into view; the final number is already in the HTML.
  const caja = document.querySelector<HTMLElement>('[data-cifras]');
  if (caja && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const nums = [...caja.querySelectorAll<HTMLElement>('[data-cuenta]')];
    const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    nums.forEach((el) => (el.textContent = '0'));
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1600);
        const ease = 1 - Math.pow(1 - k, 3);
        nums.forEach((el) => (el.textContent = fmt(Math.round(Number(el.dataset.cuenta) * ease))));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }).observe(caja);
  }
</script>
