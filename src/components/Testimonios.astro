---
/**
 * Testimonials (data/testimonios): each one as a large card, the patient's photo and name on one
 * side, a sentence of hers set large on the other, then her full words behind «Leer su historia
 * completa». With more than one, the cards slide sideways with arrows. Used on Sobre mí and
 * Asesorías.
 */
import { Image } from 'astro:assets';
import { testimonios } from '../data/testimonios';

interface Props {
  titulo?: string;
  eyebrow?: string;
  /** Show only these ids (default: all). */
  ids?: string[];
}
const { titulo = 'Lo que dicen quienes ya empezaron.', eyebrow = 'Testimonios', ids } = Astro.props;
const lista = (ids ? testimonios.filter((t) => ids.includes(t.id)) : testimonios)
  .slice()
  .sort((a, b) => a.prioridad - b.prioridad);
const inicial = (n: string) => n.trim().charAt(0).toUpperCase();
---

{
  lista.length > 0 && (
    <section class="testimonios" data-testimonios>
      <div class="wrap">
        <div class="t-cab reveal">
          <span class="eyebrow">{eyebrow}</span>
          <h2>{titulo}</h2>
        </div>
        <div class="t-carril" data-carril>
          {lista.map((t) => (
            <article class="t-card reveal">
              <div class="t-persona">
                <div class="t-foto">
                  {t.foto ? (
                    <Image src={t.foto} alt={t.nombre} widths={[220, 440]} sizes="220px" />
                  ) : (
                    <span class="t-inicial">{inicial(t.nombre)}</span>
                  )}
                </div>
                <p class="t-nombre">{t.nombre}</p>
                {t.lugar && <p class="t-lugar">{t.lugar}</p>}
                {t.motivo.length > 0 && (
                  <ul class="t-motivo">
                    {t.motivo.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div class="t-voz">
                <span class="t-comillas" aria-hidden="true">
                  “
                </span>
                <blockquote class="t-destacado">{t.destacado}</blockquote>
                {t.texto[0] && <p class="t-texto">{t.texto[0]}</p>}
                {t.texto.length > 1 && (
                  <details class="t-mas">
                    <summary>
                      <span class="abrir">Leer su historia completa</span>
                      <span class="cerrar">Mostrar menos</span>
                    </summary>
                    {t.texto.slice(1).map((p) => (
                      <p class="t-texto">{p}</p>
                    ))}
                  </details>
                )}
              </div>
            </article>
          ))}
        </div>
        {lista.length > 1 && (
          <div class="t-flechas">
            <button type="button" data-t-mover="-1" aria-label="Testimonio anterior">
              ←
            </button>
            <span class="t-contador" data-t-contador aria-live="polite">
              1 / {lista.length}
            </span>
            <button type="button" data-t-mover="1" aria-label="Siguiente testimonio">
              →
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .testimonios {
    padding: clamp(56px, 7vw, 100px) 0 0;
  }
  .t-cab h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1.05;
    margin: 14px 0 0;
  }
  .t-carril {
    margin-top: 30px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .t-carril::-webkit-scrollbar {
    display: none;
  }
  .t-card {
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(26px, 4vw, 52px);
    border-radius: 36px;
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(231 183 160 / 0.35), transparent 65%),
      var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.06);
    box-shadow: 0 30px 70px -50px rgb(35 34 30 / 0.5);
  }
  .t-persona {
    text-align: center;
  }
  .t-foto {
    width: min(220px, 70%);
    aspect-ratio: 1;
    margin: 0 auto 16px;
    border-radius: 50%;
    overflow: hidden;
    outline: 8px solid color-mix(in srgb, var(--color-clay) 35%, white);
    background: var(--color-sand);
  }
  .t-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    display: block;
  }
  .t-inicial {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-serif);
    font-size: 72px;
    color: var(--color-clay-rich);
  }
  .t-nombre {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--color-charcoal);
  }
  .t-lugar {
    margin: 2px 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.55);
  }
  .t-motivo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .t-motivo li {
    font-size: 12.5px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-sage) 50%, white);
  }
  .t-voz {
    position: relative;
  }
  .t-comillas {
    display: block;
    font-family: var(--font-serif);
    font-size: 120px;
    line-height: 0.6;
    height: 44px;
    color: var(--color-clay);
  }
  .t-destacado {
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(26px, 2.8vw, 38px);
    line-height: 1.2;
    color: var(--color-charcoal);
  }
  .t-texto {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.7;
    color: rgb(35 34 30 / 0.8);
  }
  .t-mas summary {
    display: inline-block;
    cursor: pointer;
    list-style: none;
    margin-bottom: 14px;
    font-size: 14px;
    font-weight: 800;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(35 34 30 / 0.3);
  }
  .t-mas summary::-webkit-details-marker {
    display: none;
  }
  .t-mas .cerrar,
  .t-mas[open] .abrir {
    display: none;
  }
  .t-mas[open] .cerrar {
    display: inline;
  }
  .t-mas[open] summary {
    order: 9;
  }
  .t-mas[open] {
    display: flex;
    flex-direction: column;
    animation: abrir 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .t-mas[open] summary {
    align-self: flex-start;
  }
  @keyframes abrir {
    from {
      opacity: 0.4;
    }
  }
  .t-flechas {
    margin-top: 18px;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .t-contador {
    align-self: center;
    min-width: 56px;
    text-align: center;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: rgb(35 34 30 / 0.6);
  }
  .t-flechas button {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--color-charcoal);
    background: transparent;
    font-size: 18px;
    cursor: pointer;
  }
  @media (max-width: 800px) {
    .t-card {
      grid-template-columns: 1fr;
    }
    .t-foto {
      width: 140px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-testimonios]').forEach((sec) => {
    const carril = sec.querySelector<HTMLElement>('[data-carril]')!;
    const contador = sec.querySelector<HTMLElement>('[data-t-contador]');
    const total = carril.children.length;
    carril.addEventListener(
      'scroll',
      () => {
        if (!contador) return;
        const i = Math.round(carril.scrollLeft / carril.clientWidth) + 1;
        contador.textContent = `${Math.min(i, total)} / ${total}`;
      },
      { passive: true }
    );
    sec.querySelectorAll<HTMLButtonElement>('[data-t-mover]').forEach((b) =>
      b.addEventListener('click', () =>
        carril.scrollBy({
          left: Number(b.dataset.tMover) * carril.clientWidth,
          behavior: 'smooth',
        })
      )
    );
  });
</script>
