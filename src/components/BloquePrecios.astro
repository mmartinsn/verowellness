---
import PriceCard from './PriceCard.astro';
import { continuidad, listaCiclos } from '../data/oferta';

interface Props {
  oscuro?: boolean;
}
const { oscuro = false } = Astro.props;
---

<div class:list={['bloque-precios', { oscuro }]}>
  <div class="bp-columnas">
    {listaCiclos.map((c) => <PriceCard ciclo={c} />)}
  </div>
  <aside class="bp-continuidad">
    <span class="bp-tag">{continuidad.etiqueta}</span>
    <p class="bp-titulo">{continuidad.titulo}</p>
    <p class="bp-texto">{continuidad.texto}</p>
  </aside>
</div>

<style>
  .bp-columnas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .bp-columnas {
      grid-template-columns: 1fr;
    }
  }
  .bp-continuidad {
    margin-top: 24px;
    padding: 26px 32px;
    border-radius: var(--radius-lg);
    border: 1px solid rgb(48 47 42 / 0.14);
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(231 183 160 / 0.22), transparent 60%),
      var(--color-ivory);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 22px;
    row-gap: 6px;
    align-items: baseline;
  }
  .bp-tag {
    grid-row: span 2;
    align-self: center;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--color-charcoal);
    color: var(--color-bone);
    white-space: nowrap;
  }
  .bp-titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.15;
  }
  .bp-texto {
    font-size: 16px;
    line-height: 1.6;
    color: rgb(48 47 42 / 0.78);
  }
  @media (max-width: 640px) {
    .bp-continuidad {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .bp-tag {
      grid-row: auto;
      justify-self: start;
    }
  }
  .oscuro .bp-continuidad {
    background: rgb(251 250 246 / 0.06);
    border-color: rgb(251 250 246 / 0.16);
  }
  .oscuro .bp-titulo,
  .oscuro .bp-texto {
    color: var(--color-bone);
  }
  .oscuro .bp-tag {
    background: var(--color-clay);
    color: var(--color-charcoal);
  }
</style>
