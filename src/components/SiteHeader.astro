---
/**
 * Sticky site header: wordmark · nav · CTA · hamburger, plus the full-screen mobile menu.
 * One component, two looks: the editorial sand bar by default, and the Stitch treatment
 * (translucent, small uppercase links, dark pill CTA) when <html data-theme="stitch">.
 */
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav, cta } from '../data/site';
import { href, isCurrent } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <Wordmark class="header-wordmark" />

    <nav class="header-nav" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={href(item.path)}
            aria-current={isCurrent(current, item.path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a href={href(cta.path)} class="btn btn-primary header-cta">{cta.label}</a>
      <button
        class="hamburger"
        id="hamburgerBtn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span class="hamburger-bars" aria-hidden="true"
          ><span></span><span></span><span></span></span
        >
        <Icon name="menu" size={26} class="hamburger-icon hamburger-icon-open" />
        <Icon name="close" size={26} class="hamburger-icon hamburger-icon-close" />
      </button>
    </div>
  </div>
</header>

<nav class="mobile-menu" id="mobileMenu" aria-label="Navegación móvil">
  {
    nav.map((item, i) => (
      <a href={href(item.path)} class="mobile-link" style={`--i:${i}`}>
        {item.label}
      </a>
    ))
  }
  <a
    href={href(cta.path)}
    class="btn btn-primary mobile-link mobile-cta"
    style={`--i:${nav.length}`}>{cta.label}</a
  >
</nav>

<style>
  /* ── Editorial (default) ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-sand);
    height: 76px;
    display: flex;
    align-items: center;
    transition:
      box-shadow 0.3s ease,
      height 0.3s var(--ease-out-soft),
      background 0.3s ease;
  }
  /* Once the page scrolls the bar gets lower and translucent, and casts a soft shadow. */
  .site-header.scrolled {
    height: 64px;
    background: rgb(239 231 217 / 0.86);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 18px rgb(48 47 42 / 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 24px;
  }
  .header-nav {
    display: none;
    align-items: center;
    gap: 32px;
  }
  .header-nav a {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-charcoal);
    position: relative;
    padding: 4px 0;
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--color-clay-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .header-nav a:hover::after,
  .header-nav a:focus-visible::after,
  .header-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .header-cta {
    display: none;
  }

  .hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: none;
    border: 0;
    color: var(--color-charcoal);
    z-index: 120;
  }
  .hamburger-bars {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .hamburger-bars span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.25s ease;
  }
  .hamburger[aria-expanded='true'] .hamburger-bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] .hamburger-bars span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] .hamburger-bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .hamburger :global(.hamburger-icon) {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-nav {
      display: flex;
    }
    .header-cta {
      display: inline-flex;
    }
    .hamburger {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--color-sand);
    z-index: 110;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding: 0 32px;
    transform: translateX(100%);
    transition: transform 0.35s ease;
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .mobile-menu .mobile-link {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 26px;
    opacity: 0;
    transform: translateY(14px);
  }
  /* Links enter one after another once the panel has slid in. */
  .mobile-menu.open .mobile-link {
    animation: menu-link-in 0.55s var(--ease-out-soft) forwards;
    animation-delay: calc(0.18s + var(--i, 0) * 70ms);
  }
  @keyframes menu-link-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mobile-menu .mobile-cta {
    margin-top: 10px;
    align-self: flex-start;
    font-size: 14px;
  }

  /* ── Stitch look (home page) ── */
  :global(html[data-theme='stitch']) .site-header {
    height: 80px;
    background: rgb(253 249 242 / 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(0 0 0 / 0.06);
  }
  :global(html[data-theme='stitch']) .site-header.scrolled {
    height: 66px;
    background: rgb(253 249 242 / 0.82);
    box-shadow: 0 8px 30px -18px rgb(35 34 30 / 0.25);
  }
  :global(html[data-theme='stitch']) .header-wordmark {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  :global(html[data-theme='stitch']) .header-nav {
    gap: 36px;
  }
  :global(html[data-theme='stitch']) .header-nav a {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.6);
    padding-bottom: 2px;
  }
  :global(html[data-theme='stitch']) .header-nav a::after {
    bottom: 0;
    height: 1px;
  }
  :global(html[data-theme='stitch']) .header-nav a:hover,
  :global(html[data-theme='stitch']) .header-nav a[aria-current='page'] {
    color: var(--color-charcoal);
  }
  :global(html[data-theme='stitch']) .header-nav a[aria-current='page'] {
    font-weight: 700;
  }
  :global(html[data-theme='stitch']) .header-cta {
    background: var(--color-charcoal);
    color: var(--color-bone);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 24px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }
  :global(html[data-theme='stitch']) .header-cta:hover {
    background: var(--color-clay-deep);
    color: var(--color-white);
  }
  @media (min-width: 640px) {
    :global(html[data-theme='stitch']) .header-cta {
      display: inline-flex;
    }
  }
  :global(html[data-theme='stitch']) .hamburger-bars {
    display: none;
  }
  :global(html[data-theme='stitch']) .hamburger :global(.hamburger-icon-open) {
    display: block;
  }
  :global(html[data-theme='stitch'])
    .hamburger[aria-expanded='true']
    :global(.hamburger-icon-open) {
    display: none;
  }
  :global(html[data-theme='stitch'])
    .hamburger[aria-expanded='true']
    :global(.hamburger-icon-close) {
    display: block;
  }
  :global(html[data-theme='stitch']) .mobile-menu {
    background: var(--color-surface-warm);
    padding: 120px 32px 32px;
    justify-content: flex-start;
  }
  :global(html[data-theme='stitch']) .mobile-menu .mobile-link {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
  }
  :global(html[data-theme='stitch']) .mobile-menu .mobile-cta {
    background: var(--color-charcoal);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: stretch;
  }
</style>

<script>
  // Mobile menu toggle + shadow on scroll. Runs once per page.
  const header = document.getElementById('siteHeader');
  const hamburger = document.getElementById('hamburgerBtn');
  const menu = document.getElementById('mobileMenu');

  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (hamburger && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    hamburger.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
