---
/**
 * Sticky site header: wordmark · nav · CTA · hamburger, plus the full-screen mobile menu.
 * One component, three looks: the editorial sand bar by default, the first Stitch treatment
 * (translucent, small uppercase links, dark pill CTA) under <html data-theme="stitch">, and the
 * home's (translucent bone, sentence-case links, menu dropping from the top) under "inicio".
 */
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav, cta } from '../data/site';
import { href, isCurrent } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <Wordmark class="header-wordmark" />

    <nav class="header-nav" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={href(item.path)}
            aria-current={isCurrent(current, item.path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a href={href(cta.path)} class="btn btn-primary header-cta">{cta.label}</a>
      <button
        class="hamburger"
        id="hamburgerBtn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span class="hamburger-bars" aria-hidden="true"
          ><span></span><span></span><span></span></span
        >
        <Icon name="menu" size={26} class="hamburger-icon hamburger-icon-open" />
        <Icon name="close" size={26} class="hamburger-icon hamburger-icon-close" />
      </button>
    </div>
  </div>
</header>

<nav class="mobile-menu" id="mobileMenu" aria-label="Navegación móvil" inert>
  {
    nav.map((item, i) => (
      <a href={href(item.path)} class="mobile-link" style={`--i:${i}`}>
        {item.label}
      </a>
    ))
  }
  <a
    href={href(cta.path)}
    class="btn btn-primary mobile-link mobile-cta"
    style={`--i:${nav.length}`}>{cta.label}</a
  >
</nav>

<style>
  /* ── Editorial (default) ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-sand);
    height: 76px;
    display: flex;
    align-items: center;
    transition:
      box-shadow 0.3s ease,
      height 0.3s var(--ease-out-soft),
      background 0.3s ease;
  }
  /* Once the page scrolls the bar gets lower and translucent, and casts a soft shadow. */
  .site-header.scrolled {
    height: 64px;
    background: rgb(239 231 217 / 0.86);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 18px rgb(48 47 42 / 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 24px;
  }
  .header-nav {
    display: none;
    align-items: center;
    /* Eight links and the CTA share the bar: the gap gives way before anything wraps. */
    gap: clamp(14px, 1.7vw, 32px);
  }
  .header-nav a {
    white-space: nowrap;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-charcoal);
    position: relative;
    padding: 4px 0;
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--color-clay-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .header-nav a:hover::after,
  .header-nav a:focus-visible::after,
  .header-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .header-cta {
    display: none;
  }

  .hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: none;
    border: 0;
    color: var(--color-charcoal);
    z-index: 120;
  }
  .hamburger-bars {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .hamburger-bars span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.25s ease;
  }
  .hamburger[aria-expanded='true'] .hamburger-bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] .hamburger-bars span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] .hamburger-bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .hamburger :global(.hamburger-icon) {
    display: none;
  }

  /* Narrow desktops: a smaller menu so the links and the CTA still fit on one line. */
  @media (min-width: 1024px) and (max-width: 1179px) {
    .header-nav a {
      font-size: 13.5px;
    }
  }
  @media (min-width: 1024px) {
    .header-nav {
      display: flex;
    }
    .header-cta {
      display: inline-flex;
    }
    .hamburger {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--color-sand);
    z-index: 110;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding: 0 32px;
    transform: translateX(100%);
    transition: transform 0.35s ease;
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .mobile-menu .mobile-link {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 26px;
    opacity: 0;
    transform: translateY(14px);
  }
  /* Links enter one after another once the panel has slid in. */
  .mobile-menu.open .mobile-link {
    animation: menu-link-in 0.55s var(--ease-out-soft) forwards;
    animation-delay: calc(0.18s + var(--i, 0) * 70ms);
  }
  @keyframes menu-link-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mobile-menu .mobile-cta {
    margin-top: 10px;
    align-self: flex-start;
    font-size: 14px;
  }

  /* ── Stitch look (home page) ── */
  :global(html[data-theme='stitch']) .site-header {
    height: 80px;
    background: rgb(253 249 242 / 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(0 0 0 / 0.06);
  }
  :global(html[data-theme='stitch']) .site-header.scrolled {
    height: 66px;
    background: rgb(253 249 242 / 0.82);
    box-shadow: 0 8px 30px -18px rgb(35 34 30 / 0.25);
  }
  :global(html[data-theme='stitch'] .header-wordmark) {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  :global(html[data-theme='stitch']) .header-nav {
    gap: 36px;
  }
  :global(html[data-theme='stitch']) .header-nav a {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.6);
    padding-bottom: 2px;
  }
  :global(html[data-theme='stitch']) .header-nav a::after {
    bottom: 0;
    height: 1px;
  }
  :global(html[data-theme='stitch']) .header-nav a:hover,
  :global(html[data-theme='stitch']) .header-nav a[aria-current='page'] {
    color: var(--color-charcoal);
  }
  :global(html[data-theme='stitch']) .header-nav a[aria-current='page'] {
    font-weight: 700;
  }
  :global(html[data-theme='stitch']) .header-cta {
    background: var(--color-charcoal);
    color: var(--color-bone);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 24px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }
  :global(html[data-theme='stitch']) .header-cta:hover {
    background: var(--color-clay-deep);
    color: var(--color-white);
  }
  @media (min-width: 640px) {
    :global(html[data-theme='stitch']) .header-cta {
      display: inline-flex;
    }
  }
  :global(html[data-theme='stitch']) .hamburger-bars {
    display: none;
  }
  :global(html[data-theme='stitch']) .hamburger :global(.hamburger-icon-open) {
    display: block;
  }
  :global(html[data-theme='stitch'])
    .hamburger[aria-expanded='true']
    :global(.hamburger-icon-open) {
    display: none;
  }
  :global(html[data-theme='stitch'])
    .hamburger[aria-expanded='true']
    :global(.hamburger-icon-close) {
    display: block;
  }
  :global(html[data-theme='stitch']) .mobile-menu {
    background: var(--color-surface-warm);
    padding: 120px 32px 32px;
    justify-content: flex-start;
  }
  :global(html[data-theme='stitch']) .mobile-menu .mobile-link {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
  }
  :global(html[data-theme='stitch']) .mobile-menu .mobile-cta {
    background: var(--color-charcoal);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: stretch;
  }

  /* ── Home look (data-theme="inicio") ── */
  :global(html[data-theme='inicio']) .site-header {
    height: 84px;
    background: rgb(251 250 246 / 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgb(35 34 30 / 0.06);
  }
  :global(html[data-theme='inicio']) .site-header.scrolled {
    height: 84px;
    background: rgb(251 250 246 / 0.96);
    box-shadow: 0 10px 30px rgb(35 34 30 / 0.04);
  }
  :global(html[data-theme='inicio'] .header-wordmark) {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.04em;
    gap: 12px;
  }
  :global(html[data-theme='inicio'] .header-wordmark .wordmark-mark) {
    width: 22px;
    height: 22px;
    transition: transform 0.5s var(--ease-out-soft);
  }
  :global(html[data-theme='inicio'] .header-wordmark:hover .wordmark-mark) {
    transform: rotate(180deg) scale(1.1);
  }
  :global(html[data-theme='inicio']) .header-nav {
    gap: 36px;
  }
  :global(html[data-theme='inicio']) .header-nav a {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(35 34 30 / 0.7);
    padding: 6px 0;
    transition: color 0.2s ease;
  }
  :global(html[data-theme='inicio']) .header-nav a:hover,
  :global(html[data-theme='inicio']) .header-nav a[aria-current='page'] {
    color: var(--color-charcoal);
  }
  :global(html[data-theme='inicio']) .header-nav a::after {
    bottom: 0;
    height: 1.5px;
  }
  /* The design's header button is written with an inline @media that browsers drop, so its
     preview shows no button in the bar; kept that way. The CTA lives in the page and the
     phone bar. */
  :global(html[data-theme='inicio']) .header-cta {
    display: none;
  }
  :global(html[data-theme='inicio']) .hamburger-bars {
    gap: 6px;
  }
  :global(html[data-theme='inicio']) .hamburger-bars span {
    width: 26px;
    height: 1.5px;
    border-radius: 0;
  }
  :global(html[data-theme='inicio'])
    .hamburger[aria-expanded='true']
    .hamburger-bars
    span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  :global(html[data-theme='inicio'])
    .hamburger[aria-expanded='true']
    .hamburger-bars
    span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }
  :global(html[data-theme='inicio']) .mobile-menu {
    z-index: 99;
    background: var(--color-sand-light);
    justify-content: flex-start;
    gap: 24px;
    padding: 100px 32px 40px;
    transform: translateY(-100%);
    transition: transform 0.4s var(--ease-out-soft);
  }
  :global(html[data-theme='inicio']) .mobile-menu.open {
    transform: translateY(0);
  }
  :global(html[data-theme='inicio']) .mobile-menu .mobile-link {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 32px;
  }
  :global(html[data-theme='inicio']) .mobile-menu .mobile-cta {
    margin-top: 20px;
    align-self: stretch;
    font-family: var(--font-sans);
    font-size: 13px;
  }
</style>

<script>
  // Mobile menu toggle + shadow on scroll. Runs once per page.
  const header = document.getElementById('siteHeader');
  const hamburger = document.getElementById('hamburgerBtn');
  const menu = document.getElementById('mobileMenu');

  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (hamburger && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      // A closed menu is off-screen, not gone: keep its links out of the keyboard order.
      menu.inert = !open;
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    hamburger.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
