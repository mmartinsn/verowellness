---
/**
 * "Cinco Layers. Un solo mapa." — the five Layers as glass sheets in 3D (MapaLuz) and the five
 * expandable Layer cards, the whole section on the dark brown ground (Mari, 2026-09-23). Content
 * from data/layers.
 */
import { layers, type Layer } from '../../data/layers';
import MapaLuz from './MapaLuz.astro';

// Card colours follow Mari's page (Layer 01 sits on charcoal there, not clay).
const cardColor: Record<Layer['num'], string> = {
  '01': 'charcoal',
  '02': 'clay',
  '03': 'sage-deep',
  '04': 'rose',
  '05': 'olive',
};
const oscuro = (num: Layer['num']) => num === '01' || num === '05';
---

<section id="layers" class="capas-oscura">
  <div class="wrap">
    <span class="eyebrow">The Layer Method</span>
    <h2 class="layers-intro">Cinco Layers. Un solo mapa.</h2>
    <p class="lede">
      Cada capa observa una parte distinta de tu bienestar — pero ninguna existe aislada de las
      demás. Lo que ocurre en una puede sentirse en otra. Por eso no se recorren en orden: se
      exploran como territorios de un mismo terreno.
    </p>

    <div class="layers-legend">
      <MapaLuz />
      <p class="legend-note">
        Cinco territorios que se superponen y se leen en conjunto — no una secuencia de pasos.
      </p>
    </div>
  </div>
</section>

<!-- The five cards on their own light ground, a section apart from the dark map (Mari, 2026-09-23). -->
<section class="capas-tarjetas" aria-label="Las cinco Layers">
  <div class="wrap">
    <span class="eyebrow">Explora cada Layer</span>
    <div class="layer-map" id="layerMap">
      {
        layers.map((l) => (
          <article
            class:list={['layer-card', { oscuro: oscuro(l.num) }]}
            style={`background:var(--color-${cardColor[l.num]});`}
            data-open="false"
          >
            <button
              type="button"
              class="lc-toggle-btn"
              aria-expanded="false"
              aria-label={`Expandir Layer ${l.num} ${l.nombre}`}
            />
            <span class="lc-num">{l.num}</span>
            <h3 class="lc-title">{l.nombre}</h3>
            <p class="lc-q">{l.pregunta}</p>
            <div class="lc-toggle" aria-hidden="true">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </div>
            <div class="lc-detail">
              <div class="lc-detail-inner">
                <p class="lc-quote">"{l.cita}"</p>
                <div>
                  <div class="lc-detail-label">Qué observa esta Layer</div>
                  <ul class="lc-bullets">
                    {l.observa.map((o) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 64px 0;
  }
  @media (max-width: 640px) {
    section {
      padding: 36px 0;
    }
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  /* The whole section on the dark brown ground, edge to edge. */
  .capas-oscura {
    padding: clamp(80px, 9vw, 130px) 0;
    background: radial-gradient(ellipse 80% 55% at 50% 30%, #34322c 0%, #1f1e1b 60%, #161512 100%);
    color: var(--color-bone);
  }
  .capas-oscura .eyebrow {
    color: var(--color-clay);
  }
  .capas-oscura .layers-intro {
    color: var(--color-bone);
  }
  .capas-oscura .lede {
    color: rgb(248 246 241 / 0.78);
  }
  .capas-oscura .legend-note {
    color: rgb(248 246 241 / 0.88);
  }
  /* Cards section: a light, warm ground with a soft clay/sage wash. */
  .capas-tarjetas {
    padding: clamp(72px, 8vw, 110px) 0;
    background:
      radial-gradient(ellipse 60% 70% at 12% 0%, rgb(231 183 160 / 0.28), transparent 70%),
      radial-gradient(ellipse 55% 60% at 90% 100%, rgb(207 215 196 / 0.4), transparent 70%),
      var(--color-bone);
  }
  .capas-tarjetas .eyebrow {
    display: block;
    text-align: center;
    margin-bottom: 28px;
  }
  .layers-intro {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.4vw, 46px);
    line-height: 1.1;
    max-width: 680px;
    margin-bottom: 8px;
  }
  .lede {
    font-size: 19px;
    line-height: 1.65;
    color: rgb(48 47 42 / 0.72);
    max-width: 620px;
    font-weight: 500;
    margin-top: 18px;
  }

  /* The light map is its own dark panel; no frame around it. */
  .layers-legend {
    margin: 36px 0 44px;
  }
  /* The key idea of the map, set large (Verónica, change 23: «es clave»). */
  .legend-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(24px, 2.8vw, 36px);
    line-height: 1.3;
    max-width: 820px;
    margin: 34px auto 0;
    color: rgb(48 47 42 / 0.75);
    text-align: center;
  }

  .layer-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    align-items: start;
  }
  /* Five cards in two columns leave the last one alone: centre it instead of an empty half. */
  @media (min-width: 641px) {
    .layer-card:last-child:nth-child(odd):not([data-open='true']) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - 10px);
    }
  }
  @media (max-width: 640px) {
    .layer-map {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
  .layer-card {
    position: relative;
    border-radius: var(--radius-lg);
    padding: 28px 26px;
    color: var(--color-charcoal);
    transition:
      transform 0.4s var(--ease-out-soft),
      box-shadow 0.4s var(--ease-out-soft);
  }
  .layer-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .layer-card[data-open='true'] {
    box-shadow: var(--shadow-lift);
  }
  .lc-toggle {
    transition:
      background 0.3s ease,
      transform 0.3s var(--ease-spring);
  }
  .layer-card:hover .lc-toggle {
    background: rgb(251 250 246 / 0.95);
    transform: scale(1.08);
  }
  .layer-card[data-open='true'] {
    grid-column: 1 / -1;
    transform: none;
  }
  .layer-card.oscuro {
    color: var(--color-bone);
  }
  .lc-toggle-btn {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
    border-radius: inherit;
  }
  .lc-toggle-btn:focus-visible {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 3px;
  }
  .lc-num {
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
    opacity: 0.72;
    display: block;
  }
  .lc-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 26px;
    margin-top: 6px;
  }
  .lc-q {
    font-weight: 600;
    font-size: 16px;
    opacity: 0.8;
    margin-top: 10px;
    line-height: 1.5;
    padding-right: 44px;
  }
  .lc-toggle {
    position: absolute;
    top: 26px;
    right: 24px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgb(251 250 246 / 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-charcoal);
    pointer-events: none;
  }
  .lc-toggle svg {
    transition: transform 0.35s var(--ease-spring);
  }
  .layer-card[data-open='true'] .lc-toggle svg {
    transform: rotate(45deg);
  }
  /* The detail unfolds: a 0fr → 1fr grid row animates height without knowing it in advance. */
  .lc-detail {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    padding-top: 0;
    border-top: 1px solid transparent;
    transition:
      grid-template-rows 0.5s var(--ease-out-soft),
      margin-top 0.5s var(--ease-out-soft),
      padding-top 0.5s var(--ease-out-soft),
      border-color 0.5s ease;
  }
  .layer-card[data-open='true'] .lc-detail {
    grid-template-rows: 1fr;
    margin-top: 26px;
    padding-top: 26px;
    border-top-color: rgb(48 47 42 / 0.16);
  }
  .oscuro[data-open='true'] .lc-detail {
    border-top-color: rgb(251 250 246 / 0.25);
  }
  .lc-detail-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s ease 0.1s;
  }
  .layer-card[data-open='true'] .lc-detail-inner {
    opacity: 1;
  }
  @media (max-width: 760px) {
    .lc-detail-inner {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
  .lc-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 27px;
    line-height: 1.45;
  }
  .lc-detail-label {
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 18px;
  }
  .lc-bullets {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lc-bullets li {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.35;
    padding: 15px 22px;
    border-radius: var(--radius-pill);
    background: rgb(251 250 246 / 0.6);
  }
  .oscuro .lc-bullets li {
    background: rgb(251 250 246 / 0.16);
  }
</style>

<script>
  // Layer cards: exclusive accordion, tap to toggle.
  const cards = document.querySelectorAll<HTMLElement>('#layerMap .layer-card');
  cards.forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('.lc-toggle-btn');
    btn?.addEventListener('click', () => {
      const wasOpen = card.dataset.open === 'true';
      cards.forEach((c) => {
        c.dataset.open = 'false';
        c.querySelector('.lc-toggle-btn')?.setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen) {
        card.dataset.open = 'true';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
