---
/**
 * The Method hero: faint layer lines behind, small wordmark, THE LAYER METHOD, the signature
 * line, the cellular-health quote and the CTA to the 1:1 process, next to the portrait.
 */
import { Image } from 'astro:assets';
import Wordmark from '../Wordmark.astro';
import retrato from '../../assets/fotos/veronica-riendo-sentada.jpg';
import { href } from '../../lib/url';
import { cta, marca } from '../../data/site';

const lineas = [
  { color: 'var(--color-charcoal)', width: '96%' },
  { color: 'var(--color-clay)', width: '78%' },
  { color: 'var(--color-sage-deep)', width: '60%' },
  { color: 'var(--color-rose)', width: '44%' },
  { color: 'var(--color-olive)', width: '28%' },
];
---

<section class="hero">
  <div class="wrap">
    <div class="hero-lines" aria-hidden="true">
      {
        lineas.map((l, i) => (
          <div class="bar" style={`background:${l.color};width:${l.width};--i:${i};`} />
        ))
      }
    </div>
    <div class="hero-grid">
      <div class="hero-content reveal-stagger">
        <Wordmark link={false} class="hero-wordmark" />
        <h1>THE LAYER METHOD</h1>
        <p class="hero-sub">Salud por capas.</p>
        <blockquote class="pq">
          El síntoma es el punto de partida. Sanar empieza por entender las capas detrás de lo que
          sientes.
        </blockquote>
        <div class="hero-actions">
          <a class="btn btn-primary" href={href('/asesorias')}>{cta.label}</a>
        </div>
      </div>
      <div class="hero-photo reveal-scale">
        <Image
          src={retrato}
          alt={`${marca.creadora}, creadora de The Layer Method`}
          widths={[420, 700, 900]}
          sizes="(min-width: 900px) 460px, 90vw"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 36px 0 56px;
    overflow: hidden;
  }
  .hero .wrap {
    position: relative;
  }
  .hero-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.1;
    pointer-events: none;
  }
  /* The faint layer lines sweep in from the left on load. */
  .hero-lines .bar {
    height: 12px;
    border-radius: 6px;
    margin-bottom: 22px;
    transform-origin: left center;
    animation: line-in 1.2s var(--ease-out-soft) both;
    animation-delay: calc(0.1s + var(--i, 0) * 110ms);
  }
  @keyframes line-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .hero-content {
    max-width: 700px;
  }
  .hero-wordmark {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-clay-deep);
    margin-bottom: 18px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(40px, 7vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(19px, 2.4vw, 24px);
    color: rgb(48 47 42 / 0.72);
    margin-top: 14px;
  }
  .pq {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 3.4vw, 34px);
    line-height: 1.3;
    max-width: 680px;
    padding-left: 26px;
    border-left: 3px solid var(--color-clay);
    margin-top: 28px;
  }
  .hero-actions {
    margin-top: 32px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-photo {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/5;
    background: var(--color-ivory);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep her laugh in frame when the 2:3 photo is cropped to 4:5. */
    object-position: 50% 30%;
    transition: transform 1.2s var(--ease-out-soft);
  }
  .hero-photo:hover :global(img) {
    transform: scale(1.04);
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px rgb(48 47 42 / 0.06);
  }
  @media (max-width: 900px) {
    .hero-photo {
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
