---
/**
 * Dark bridge from the methodology to the 1:1 process. Since 2026-10-03 (Verónica, change 27) it
 * breaks the process into the same step cards as the home and closes with the prices and the
 * private invitation for patients (shared components in components/oferta).
 */
import { href } from '../../lib/url';
import { cta } from '../../data/site';
import PasosProceso from '../oferta/PasosProceso.astro';
import BloquePrecios from '../oferta/BloquePrecios.astro';
---

<section id="bridge">
  <div class="wrap">
    <div class="bridge">
      <span class="eyebrow">De la metodología a tu proceso</span>
      <h2>ASESORÍAS</h2>
      <p class="lede">
        El proceso personalizado comienza mapeando tu contexto individual: no una plantilla, no un
        protocolo genérico.
      </p>

      <div class="bridge-pasos">
        <PasosProceso />
      </div>
      <BloquePrecios />

      <div class="bridge-actions">
        <a class="btn btn-primary" href={href('/asesorias')}>{cta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 0 0 64px;
  }
  .bridge {
    background: var(--color-charcoal);
    color: var(--color-bone);
    border-radius: var(--radius-lg);
    padding: 64px 48px;
    position: relative;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .bridge {
      padding: 44px 26px;
    }
  }
  .bridge .eyebrow {
    color: var(--color-clay);
    margin-bottom: 16px;
  }
  .bridge h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.4vw, 46px);
    line-height: 1.1;
    color: var(--color-bone);
  }
  .lede {
    font-size: 19px;
    line-height: 1.65;
    color: rgb(251 250 246 / 0.72);
    max-width: 620px;
    margin-top: 18px;
    font-weight: 500;
  }
  .bridge-pasos {
    margin: 40px 0 0;
  }
  .bridge-actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
  }
</style>
