---
/**
 * One test as a wide catalogue card, after the NutriWhite reference Mari sent (2026-10-03): name
 * and big price on top, the fact sheet's one-line hook, a link to the full sheet, and two buttons,
 * «Agregar» (to the selection) and «Solo este» (straight to the checkout with only this test).
 * Clicks are handled page-wide: sheet and selection by PorSintoma, «Solo este» by Catalogo.
 */
import { productoDe, type Examen } from '../../data/examenes';
import { fichas } from '../../data/fichas-examenes';
import { usd } from '../../lib/precio';

interface Props {
  e: Examen;
  color: string;
  grupo?: string;
  texto?: string;
  oculta?: boolean;
  /** Group name shown while searching. */
  nombreGrupo?: string;
  /** Position inside its group, for «Ver los N exámenes». */
  orden?: number;
}
const { e, color, grupo, texto, oculta = false, nombreGrupo, orden } = Astro.props;
const gancho = fichas[e.id]?.gancho ?? '';
---

<li
  class="tarjeta"
  data-fila
  data-grupo={grupo}
  data-texto={texto}
  data-orden={orden}
  hidden={oculta}
  style={`--tono:var(--color-${color})`}
>
  <div class="t-cab">
    <div>
      {nombreGrupo && <span class="t-grupo">{nombreGrupo}</span>}
      <h3 class="t-nombre">
        <button type="button" data-ficha={e.id}>{e.nombre}</button>
      </h3>
      {e.laboratorio && <span class="t-lab">{e.laboratorio}</span>}
    </div>
    <span class="t-precio">{usd(e.precio)}</span>
  </div>
  {gancho && <p class="t-texto">{gancho}</p>}
  <button type="button" class="t-ver" data-ficha={e.id}>Ver información completa →</button>
  <div class="t-botones">
    <button
      type="button"
      class="t-add"
      aria-pressed="false"
      data-add={productoDe(e)}
      aria-label={`Agregar ${e.nombre}`}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          class="mas"
          d="M3 4h2l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2M10 20h.01M17 20h.01"
        ></path>
        <path class="ok" d="M5 12.5l4.5 4.5L19 7.5"></path>
      </svg>
      <span class="no">Agregar</span>
      <span class="si">Agregado</span>
    </button>
    <button type="button" class="t-solo" data-solo={productoDe(e)}>Comprar solo este</button>
  </div>
</li>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.6vw, 32px);
    border-radius: 26px;
    background: var(--color-white);
    border: 1px solid rgb(48 47 42 / 0.06);
    box-shadow: 0 18px 40px -34px rgb(48 47 42 / 0.45);
    transition:
      transform 0.35s var(--ease-out-soft),
      box-shadow 0.35s var(--ease-out-soft);
  }
  .tarjeta[hidden] {
    display: none;
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -36px rgb(48 47 42 / 0.5);
  }
  .tarjeta:global(.elegido) {
    box-shadow:
      0 0 0 2px var(--color-sage-deep),
      0 30px 60px -36px rgb(48 47 42 / 0.5);
  }
  .t-cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
  }
  .t-grupo {
    display: none;
    margin-bottom: 8px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tono) 35%, white);
  }
  :global([data-buscando]) .t-grupo {
    display: inline-block;
  }
  .t-nombre {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.25;
    color: var(--color-charcoal);
  }
  .t-nombre button {
    all: unset;
    cursor: pointer;
  }
  .t-nombre button:hover,
  .t-nombre button:focus-visible {
    color: var(--color-clay-deep);
  }
  .t-lab {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    color: rgb(48 47 42 / 0.55);
  }
  .t-precio {
    flex-shrink: 0;
    font-family: var(--font-serif);
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 600;
    line-height: 1;
    color: var(--color-clay-rich);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .t-texto {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(48 47 42 / 0.75);
    flex: 1;
  }
  .t-ver {
    all: unset;
    cursor: pointer;
    align-self: flex-start;
    font-size: 13px;
    font-weight: 800;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(48 47 42 / 0.25);
    transition: border-color 0.2s;
  }
  .t-ver:hover,
  .t-ver:focus-visible {
    border-color: var(--color-charcoal);
  }
  .t-botones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 6px;
  }
  .t-add,
  .t-solo {
    font: inherit;
    font-size: 14.5px;
    font-weight: 800;
    padding: 15px 14px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition:
      background 0.25s,
      color 0.25s,
      transform 0.2s;
  }
  .t-add:hover,
  .t-solo:hover {
    transform: translateY(-1px);
  }
  .t-add {
    background: color-mix(in srgb, var(--color-sage) 30%, white);
    border: 1px solid rgb(48 47 42 / 0.14);
    color: var(--color-charcoal);
  }
  .t-add svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .t-add .ok,
  .t-add .si,
  .t-add[aria-pressed='true'] .mas,
  .t-add[aria-pressed='true'] .no {
    display: none;
  }
  .t-add[aria-pressed='true'] .ok,
  .t-add[aria-pressed='true'] .si {
    display: inline;
  }
  .t-add[aria-pressed='true'] {
    background: var(--color-sage-deep);
    border-color: var(--color-sage-deep);
  }
  .t-solo {
    background: var(--color-charcoal);
    border: 1px solid var(--color-charcoal);
    color: var(--color-bone);
  }
  .t-solo:hover {
    background: #1b1a17;
  }
</style>
