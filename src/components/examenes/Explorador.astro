---
/**
 * Exámenes · explorer — every test, grouped by area, with a sticky filter bar (live search,
 * area, sample type), a side-by-side comparison of up to three tests, and «Mi selección»: a
 * floating dock that adds up the chosen tests and hands them to /checkout/examenes/. Tax is shown
 * only at checkout (Mari, 2026-09-23).
 *
 * Progressive enhancement: the whole catalogue is server-rendered and readable without JS
 * (groups, names, prices, full descriptions). The script only adds filtering, the clamp on long
 * descriptions, the comparison dialog and the selection, which it keeps in localStorage under
 * `CLAVE_SELECCION` so the checkout can read it.
 */
import {
  areas,
  examenes,
  muestras,
  examenesDeArea,
  productoDe,
  CLAVE_SELECCION,
} from '../../data/examenes';
import type { Muestra } from '../../data/examenes';
import { usd } from '../../lib/precio';
import { href } from '../../lib/url';

/** Line icons for the sample types (24-unit grid, stroked). */
const iconoMuestra: Record<Muestra, string> = {
  heces: 'M5 9h14l-1.5 9.5a2 2 0 0 1-2 1.5h-7a2 2 0 0 1-2-1.5L5 9zM8 9V6a4 4 0 0 1 8 0v3',
  orina: 'M9 3h6M10 3v4l-4 9a4 4 0 0 0 3.6 5.7h4.8A4 4 0 0 0 18 16l-4-9V3M7.5 14h9',
  sangre: 'M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z',
  saliva: 'M8 3h8v5a4 4 0 0 1-8 0V3zM12 12v9M9 21h6',
  aliento: 'M3 9h11a3 3 0 1 0-3-3M3 14h15a3 3 0 1 1-3 3M3 19h7',
  hisopo: 'M5 19L17 7M17 7l2.5-2.5a1.5 1.5 0 0 1 2 2L19 9M5 19l-1 2 2-1',
  ambiente: 'M4 11l8-7 8 7M6 9.5V20h12V9.5M10 20v-5h4v5',
};

const grupos = areas.map((a) => ({ ...a, items: examenesDeArea(a.id) }));
const areaNombre = Object.fromEntries(areas.map((a) => [a.id, a.nombre]));
const muestrasUsadas = (Object.keys(muestras) as Muestra[]).filter((m) =>
  examenes.some((e) => e.muestras.includes(m))
);

const catalogo = examenes.map((e) => ({
  id: e.id,
  producto: productoDe(e),
  nombre: e.nombre,
  area: areaNombre[e.area],
  laboratorio: e.laboratorio ?? '',
  precio: e.precio,
  muestras: e.muestras.map((m) => muestras[m]),
  enCasa: e.enCasa,
  descripcion: e.descripcion,
}));
---

<section
  class="explorador"
  id="explorador"
  aria-labelledby="exp-titulo"
  data-catalogo={JSON.stringify(catalogo)}
  data-clave={CLAVE_SELECCION}
>
  <div class="wrap">
    <div class="exp-head reveal">
      <span class="eyebrow">El catálogo</span>
      <h2 id="exp-titulo">Encuentra tu examen</h2>
    </div>
  </div>

  <!-- Sticky filter bar (hidden without JS: there is nothing to filter then). -->
  <div class="filtros js-only" role="search">
    <div class="wrap filtros-inner">
      <label class="buscador">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg
        >
        <span class="sr-only">Buscar examen</span>
        <input
          type="search"
          id="exp-q"
          placeholder="Busca por nombre, síntoma o marcador…"
          autocomplete="off"
        />
      </label>
      <div class="chips" role="group" aria-label="Área">
        <button type="button" class="chip" data-area="" aria-pressed="true">Todas</button>
        {
          areas.map((a) => (
            <button
              type="button"
              class="chip"
              data-area={a.id}
              aria-pressed="false"
              style={`--tono: var(--color-${a.color})`}
            >
              <span class="chip-dot" aria-hidden="true" />
              {a.nombre}
            </button>
          ))
        }
      </div>
      <div class="chips chips-muestra" role="group" aria-label="Tipo de muestra">
        <button type="button" class="chip" data-muestra="" aria-pressed="true"
          >Cualquier muestra</button
        >
        {
          muestrasUsadas.map((m) => (
            <button type="button" class="chip" data-muestra={m} aria-pressed="false">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                <path d={iconoMuestra[m]} />
              </svg>
              {muestras[m]}
            </button>
          ))
        }
      </div>
      <p class="resultado" aria-live="polite">
        <span id="exp-cuenta">{examenes.length}</span> de {examenes.length} exámenes
        <button type="button" class="limpiar" id="exp-limpiar" hidden>Limpiar filtros</button>
      </p>
    </div>
  </div>

  <div class="wrap">
    {
      grupos.map((g) => (
        <section
          class="grupo"
          id={`area-${g.id}`}
          data-grupo={g.id}
          style={`--tono: var(--color-${g.color})`}
          aria-labelledby={`t-${g.id}`}
        >
          <header class="grupo-head">
            <h2 id={`t-${g.id}`}>{g.nombre}</h2>
            <span class="grupo-cuenta">
              {g.items.length} {g.items.length === 1 ? 'examen' : 'exámenes'}
            </span>
          </header>
          <div class="tarjetas">
            {g.items.map((e) => (
              <article
                class="tarjeta"
                data-id={e.id}
                data-area={e.area}
                data-muestras={e.muestras.join(' ')}
              >
                <div class="t-top">
                  <span class="t-area">{g.nombre}</span>
                  <span class="t-muestras">
                    {e.muestras.map((m) => (
                      <span class="t-muestra" title={`Muestra: ${muestras[m]}`}>
                        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                          <path d={iconoMuestra[m]} />
                        </svg>
                        {muestras[m]}
                      </span>
                    ))}
                    {e.enCasa && <span class="t-casa">Desde casa</span>}
                  </span>
                </div>
                <h3 class="t-nombre">{e.nombre}</h3>
                {e.laboratorio && <p class="t-lab">{e.laboratorio}</p>}
                {e.instructivo && (
                  <a class="t-instructivo" href={e.instructivo} target="_blank" rel="noopener">
                    Descargar instructivo
                  </a>
                )}
                <div class="t-desc-wrap">
                  <p class="t-desc">{e.descripcion}</p>
                  <button type="button" class="t-mas js-only" aria-expanded="false">
                    Leer más
                  </button>
                </div>
                <div class="t-pie">
                  <div class="t-precio">
                    <strong>{usd(e.precio)}</strong>
                    <span>USD</span>
                  </div>
                  <div class="t-acciones js-only">
                    <label class="t-comparar">
                      <input type="checkbox" data-comparar={e.id} />
                      <span>Comparar</span>
                    </label>
                    <button
                      type="button"
                      class="t-add"
                      data-add={productoDe(e)}
                      aria-pressed="false"
                    >
                      <span class="t-add-on">Añadido</span>
                      <span class="t-add-off">Añadir</span>
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <div class="vacio" id="exp-vacio" hidden>
      <p class="vacio-t">No hay exámenes con esos filtros.</p>
      <button type="button" class="btn btn-outline" data-limpiar>Limpiar filtros</button>
    </div>

    <aside class="ayuda reveal">
      <p class="ayuda-t">¿No sabes por dónde empezar?</p>
      <a class="btn btn-secondary" href={href('/1-1')}>Conoce The Layer Method™ 1:1</a>
    </aside>
  </div>

  <!-- Comparison tray + dialog -->
  <div class="comparar-bar js-only" id="cmp-bar" hidden>
    <span id="cmp-texto">0 para comparar</span>
    <button type="button" class="btn btn-primary btn-sm" id="cmp-abrir">Comparar</button>
    <button type="button" class="cmp-x" id="cmp-vaciar" aria-label="Quitar comparación">×</button>
  </div>
  <dialog class="cmp-dialog" id="cmp-dialog" aria-labelledby="cmp-titulo">
    <div class="cmp-head">
      <h2 id="cmp-titulo">Comparación</h2>
      <button type="button" class="cmp-cerrar" id="cmp-cerrar" aria-label="Cerrar">×</button>
    </div>
    <div class="cmp-cols" id="cmp-cols"></div>
  </dialog>

  <!-- «Mi selección» dock -->
  <div class="dock js-only" id="dock" hidden>
    <div class="dock-panel" id="dock-panel" hidden>
      <p class="dock-titulo">Mi selección</p>
      <ul class="dock-lista" id="dock-lista"></ul>
      <dl class="dock-totales">
        <div class="dock-total"><dt>Subtotal</dt><dd id="dock-sub">$0.00</dd></div>
      </dl>
      <p class="dock-nota">Los impuestos se calculan en el checkout.</p>
      <a class="btn btn-primary btn-block" href={href('/checkout/examenes')}
        >Continuar al checkout</a
      >
    </div>
    <button
      type="button"
      class="dock-btn"
      id="dock-btn"
      aria-expanded="false"
      aria-controls="dock-panel"
    >
      <span class="dock-n" id="dock-n">0</span>
      <span class="dock-lbl">Mi selección</span>
      <span class="dock-monto" id="dock-monto">$0.00</span>
    </button>
  </div>
</section>

<style>
  .explorador {
    position: relative;
    padding: 40px 0 140px;
    background: var(--color-bone);
  }
  .exp-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }
  .exp-head h2 {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5.2vw, 68px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
  }
  :global(html.no-js) .js-only {
    display: none !important;
  }

  /* ── Filter bar ── */
  .filtros {
    position: sticky;
    top: 84px;
    z-index: 30;
    background: rgb(251 250 246 / 0.9);
    backdrop-filter: blur(16px);
    border-block: 1px solid rgb(35 34 30 / 0.07);
    padding: 12px 0 10px;
    margin-bottom: 36px;
  }
  /* On phones a sticky bar would take a quarter of the screen; it scrolls away instead. */
  @media (max-width: 700px) {
    .filtros {
      position: relative;
      top: auto;
    }
  }
  .filtros-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
  /* Wide screens: search and sample types share the first row, areas and the count the second,
     so the sticky bar stays about 130 px tall. */
  @media (min-width: 1100px) {
    .filtros-inner {
      grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
      grid-template-areas: 'q muestra' 'area area' 'cuenta cuenta';
      column-gap: 20px;
    }
    .buscador {
      grid-area: q;
    }
    .chips-muestra {
      grid-area: muestra;
      align-self: center;
    }
    .chips:not(.chips-muestra) {
      grid-area: area;
    }
    .resultado {
      grid-area: cuenta;
    }
  }
  .buscador {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-white);
    border: 1.5px solid rgb(35 34 30 / 0.12);
    border-radius: var(--radius-pill);
    padding: 0 20px;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .buscador:focus-within {
    border-color: var(--color-clay-deep);
    box-shadow: 0 0 0 4px rgb(214 154 124 / 0.18);
  }
  .buscador svg {
    flex-shrink: 0;
    fill: none;
    stroke: rgb(35 34 30 / 0.55);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .buscador input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    padding: 12px 0;
    color: var(--color-charcoal);
  }
  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 0 -28px;
    padding: 2px 28px;
  }
  .chips::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 1100px) {
    .chips {
      margin: 0;
      padding: 2px 0;
      mask-image: linear-gradient(90deg, #000 92%, transparent);
    }
  }
  .chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 15px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(35 34 30 / 0.12);
    background: var(--color-white);
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.8);
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .chip svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chip:hover {
    border-color: rgb(35 34 30 / 0.35);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
    color: var(--color-bone);
  }
  .chip-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--tono);
    box-shadow: inset 0 0 0 1px rgb(35 34 30 / 0.12);
  }
  .chips-muestra .chip {
    font-weight: 600;
    min-height: 34px;
    font-size: 13px;
  }
  .resultado {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 600;
    color: rgb(35 34 30 / 0.7);
  }
  .resultado #exp-cuenta {
    font-weight: 800;
    color: var(--color-charcoal);
  }
  .limpiar {
    border: 0;
    background: none;
    font: inherit;
    font-weight: 800;
    color: var(--color-charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 6px 0;
  }

  /* ── Groups and cards ── */
  .grupo {
    scroll-margin-top: 250px;
    margin-bottom: 64px;
  }
  .grupo[hidden] {
    display: none;
  }
  .grupo-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 16px;
    margin-bottom: 22px;
    border-bottom: 1px solid rgb(35 34 30 / 0.1);
    position: relative;
  }
  .grupo-head::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 72px;
    height: 3px;
    border-radius: 3px;
    background: var(--tono);
  }
  .grupo-head h2 {
    font-family: var(--font-serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    color: var(--color-charcoal);
  }
  .grupo-cuenta {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.6);
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  @media (max-width: 400px) {
    .tarjetas {
      grid-template-columns: 1fr;
    }
  }
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 26px 22px;
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.09);
    border-radius: 26px;
    box-shadow: 0 10px 30px rgb(35 34 30 / 0.04);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out-soft),
      box-shadow 0.35s var(--ease-out-soft),
      border-color 0.35s ease;
  }
  .tarjeta::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 5px;
    background: var(--tono);
  }
  .tarjeta::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 220px;
    right: -110px;
    top: -110px;
    border-radius: 50%;
    background: var(--tono);
    opacity: 0.1;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  @media (hover: hover) {
    .tarjeta:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 48px rgb(35 34 30 / 0.1);
    }
    .tarjeta:hover::after {
      opacity: 0.2;
    }
  }
  .tarjeta.elegida {
    border-color: var(--color-charcoal);
    box-shadow:
      0 0 0 1px var(--color-charcoal),
      0 22px 48px rgb(35 34 30 / 0.12);
  }
  .tarjeta[hidden] {
    display: none;
  }
  .t-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .t-area {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.62);
  }
  .t-muestras {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .t-muestra,
  .t-casa {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-ivory);
    color: var(--color-charcoal);
  }
  .t-muestra svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .t-casa {
    background: rgb(207 215 196 / 0.55);
  }
  .t-nombre {
    font-family: var(--font-serif);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.12;
    color: var(--color-charcoal);
    margin-top: 6px;
  }
  .t-lab {
    font-size: 13px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.65);
  }
  .t-desc-wrap {
    flex: 1;
  }
  .t-desc {
    font-size: 14.5px;
    line-height: 1.62;
    color: rgb(35 34 30 / 0.82);
  }
  .tarjeta.clamp .t-desc {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .t-mas {
    margin-top: 6px;
    border: 0;
    background: none;
    padding: 6px 0;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    color: var(--color-charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .t-pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    margin-top: 6px;
    border-top: 1px solid rgb(35 34 30 / 0.07);
  }
  .t-precio {
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 440px) {
    .t-pie {
      flex-direction: column;
      align-items: stretch;
    }
    .t-acciones {
      justify-content: space-between;
    }
    .t-add {
      flex: 1;
    }
  }
  .t-precio strong {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    line-height: 1.1;
  }
  .t-precio span {
    font-size: 11.5px;
    font-weight: 600;
    color: rgb(35 34 30 / 0.62);
  }
  .t-acciones {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .t-comparar {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.75);
    cursor: pointer;
  }
  .t-comparar input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-charcoal);
  }
  .t-add {
    min-height: 44px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-charcoal);
    background: var(--color-charcoal);
    color: var(--color-bone);
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-out-soft);
  }
  @media (hover: hover) {
    .t-add:hover {
      background: var(--color-clay-deep);
      border-color: var(--color-clay-deep);
      color: var(--color-white);
    }
  }
  .t-add:active {
    transform: scale(0.96);
  }
  .t-add-on {
    display: none;
  }
  .t-add[aria-pressed='true'] {
    background: var(--color-white);
    color: var(--color-charcoal);
  }
  .t-add[aria-pressed='true'] .t-add-on {
    display: inline;
  }
  .t-add[aria-pressed='true'] .t-add-on::before {
    content: '✓ ';
  }
  .t-add[aria-pressed='true'] .t-add-off {
    display: none;
  }

  .vacio {
    text-align: center;
    padding: 60px 0;
  }
  .vacio-t {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 28px;
    margin-bottom: 18px;
  }
  .ayuda {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 36px 40px;
    border-radius: 32px;
    background:
      radial-gradient(circle at 90% 0%, rgb(255 255 255 / 0.45) 0%, transparent 55%),
      var(--color-sand);
  }
  .ayuda-t {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(26px, 3vw, 36px);
    color: var(--color-charcoal);
  }

  /* ── Compare ── */
  .comparar-bar {
    position: fixed;
    left: 50%;
    bottom: 96px;
    z-index: 60;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 20px;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.12);
    box-shadow: 0 18px 40px rgb(35 34 30 / 0.16);
    font-size: 13.5px;
    font-weight: 700;
    white-space: nowrap;
  }
  .comparar-bar[hidden] {
    display: none;
  }
  .cmp-x,
  .cmp-cerrar {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--color-ivory);
    font-size: 22px;
    line-height: 1;
    color: var(--color-charcoal);
  }
  .cmp-dialog {
    width: min(1100px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 32px;
    background: var(--color-bone);
    color: var(--color-charcoal);
    box-shadow: 0 40px 100px rgb(35 34 30 / 0.35);
  }
  .cmp-dialog::backdrop {
    background: rgb(35 34 30 / 0.45);
    backdrop-filter: blur(4px);
  }
  .cmp-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 28px;
    background: var(--color-bone);
    border-bottom: 1px solid rgb(35 34 30 / 0.08);
  }
  .cmp-head h2 {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 500;
  }
  .cmp-cols {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(240px, 1fr));
    gap: 16px;
    padding: 24px 28px 32px;
    overflow-x: auto;
  }
  .cmp-cols :global(.cmp-col) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 24px;
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.08);
  }
  .cmp-cols :global(.cmp-area) {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.62);
  }
  .cmp-cols :global(.cmp-nombre) {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.12;
  }
  .cmp-cols :global(.cmp-precio) {
    font-size: 28px;
    font-weight: 800;
  }
  .cmp-cols :global(dl) {
    display: grid;
    gap: 8px;
    font-size: 13.5px;
  }
  .cmp-cols :global(dt) {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.6);
  }
  .cmp-cols :global(dd) {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .cmp-cols :global(.cmp-col > .btn) {
    margin-top: auto;
  }
  .cmp-cols :global(.cmp-desc) {
    font-size: 14px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.82);
  }

  /* ── Selection dock ── */
  .dock {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 70;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .dock[hidden] {
    display: none;
  }
  @media (max-width: 640px) {
    .dock {
      left: 16px;
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom));
      align-items: stretch;
    }
    .comparar-bar {
      bottom: calc(92px + env(safe-area-inset-bottom));
    }
  }
  .dock-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 0 26px 0 10px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
    font: inherit;
    box-shadow: 0 20px 44px rgb(35 34 30 / 0.3);
    animation: dock-in 0.5s var(--ease-spring);
  }
  @keyframes dock-in {
    from {
      transform: translateY(24px) scale(0.9);
      opacity: 0;
    }
  }
  .dock-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-clay);
    color: var(--color-charcoal);
    font-weight: 800;
  }
  .dock-n.bump {
    animation: bump 0.4s var(--ease-spring);
  }
  @keyframes bump {
    50% {
      transform: scale(1.25);
    }
  }
  .dock-lbl {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dock-monto {
    margin-left: auto;
    font-size: 17px;
    font-weight: 800;
  }
  .dock-panel {
    width: min(400px, 100%);
    padding: 24px;
    border-radius: 28px;
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.1);
    box-shadow: 0 30px 70px rgb(35 34 30 / 0.22);
    animation: dock-in 0.35s var(--ease-out-soft);
  }
  .dock-panel[hidden] {
    display: none;
  }
  .dock-titulo {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .dock-lista {
    list-style: none;
    padding: 0;
    max-height: 38vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .dock-lista :global(li) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid rgb(35 34 30 / 0.07);
    font-size: 14px;
    font-weight: 600;
  }
  .dock-lista :global(.dock-quitar) {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--color-ivory);
    font-size: 18px;
    color: var(--color-charcoal);
  }
  .dock-totales {
    display: grid;
    gap: 6px;
    margin: 16px 0 18px;
    font-size: 14px;
  }
  .dock-totales div {
    display: flex;
    justify-content: space-between;
  }
  .dock-totales dt {
    color: rgb(35 34 30 / 0.7);
    font-weight: 600;
  }
  .dock-totales dd {
    font-weight: 700;
  }
  .dock-nota {
    margin: -8px 0 16px;
    font-size: 12.5px;
    font-weight: 600;
    color: rgb(35 34 30 / 0.65);
  }
  .t-instructivo {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 800;
    color: var(--color-charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dock-total {
    padding-top: 8px;
    border-top: 1px solid rgb(35 34 30 / 0.1);
    font-size: 17px;
  }
  .dock-total dt,
  .dock-total dd {
    color: var(--color-charcoal);
    font-weight: 800;
  }
  @media (prefers-reduced-motion: reduce) {
    .dock-btn,
    .dock-panel,
    .dock-n.bump {
      animation: none;
    }
  }
</style>

<script>
  import { usd } from '../../lib/precio';

  type Item = {
    id: string;
    /** Purchasable id: two cards can sell the same test. */
    producto: string;
    nombre: string;
    area: string;
    laboratorio: string;
    precio: number;
    muestras: string[];
    enCasa: boolean;
    descripcion: string;
  };

  const root = document.getElementById('explorador');
  if (root) {
    const catalogo: Item[] = JSON.parse(root.dataset.catalogo ?? '[]');
    const porId = new Map(catalogo.map((i) => [i.id, i]));
    // First card wins for a product listed twice; both cards toggle together.
    const porProducto = new Map<string, Item>();
    for (const i of catalogo) if (!porProducto.has(i.producto)) porProducto.set(i.producto, i);
    const CLAVE = root.dataset.clave ?? 'vw-examenes-seleccion';
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const tarjetas = [...root.querySelectorAll<HTMLElement>('.tarjeta')];
    const grupos = [...root.querySelectorAll<HTMLElement>('.grupo')];

    /* ── Filters ── */
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const texto = new Map(
      tarjetas.map((t) => {
        const i = porId.get(t.dataset.id!)!;
        return [t, norm(`${i.nombre} ${i.area} ${i.laboratorio} ${i.descripcion}`)];
      })
    );
    const filtro = { q: '', area: '', muestra: '' };

    const aplicar = () => {
      const palabras = norm(filtro.q).split(/\s+/).filter(Boolean);
      let visibles = 0;
      for (const t of tarjetas) {
        const ok =
          (!filtro.area || t.dataset.area === filtro.area) &&
          (!filtro.muestra || (t.dataset.muestras ?? '').split(' ').includes(filtro.muestra)) &&
          palabras.every((p) => texto.get(t)!.includes(p));
        t.hidden = !ok;
        if (ok) visibles++;
      }
      for (const g of grupos) g.hidden = !g.querySelector('.tarjeta:not([hidden])');
      $('exp-cuenta')!.textContent = String(visibles);
      $('exp-vacio')!.hidden = visibles > 0;
      $('exp-limpiar')!.hidden = !(filtro.q || filtro.area || filtro.muestra);
      root
        .querySelectorAll<HTMLButtonElement>('[data-area]:not(.tarjeta)')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === filtro.area)));
      root
        .querySelectorAll<HTMLButtonElement>('[data-muestra]')
        .forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.muestra === filtro.muestra))
        );
      document
        .querySelectorAll<HTMLButtonElement>('[data-filtro-area]')
        .forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.filtroArea === filtro.area))
        );
    };

    let debounce = 0;
    $<HTMLInputElement>('exp-q')?.addEventListener('input', (e) => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => {
        filtro.q = (e.target as HTMLInputElement).value;
        aplicar();
      }, 120);
    });
    root.querySelectorAll<HTMLButtonElement>('.chip[data-area]').forEach((b) =>
      b.addEventListener('click', () => {
        filtro.area = b.dataset.area ?? '';
        aplicar();
      })
    );
    root.querySelectorAll<HTMLButtonElement>('.chip[data-muestra]').forEach((b) =>
      b.addEventListener('click', () => {
        filtro.muestra = b.dataset.muestra ?? '';
        aplicar();
      })
    );
    // The hero's orbit nodes filter too, then bring the catalogue into view.
    document.querySelectorAll<HTMLButtonElement>('[data-filtro-area]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.filtroArea ?? '';
        filtro.area = filtro.area === id ? '' : id;
        aplicar();
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );
    const limpiar = () => {
      filtro.q = filtro.area = filtro.muestra = '';
      const q = $<HTMLInputElement>('exp-q');
      if (q) q.value = '';
      aplicar();
    };
    $('exp-limpiar')?.addEventListener('click', limpiar);
    root.querySelectorAll('[data-limpiar]').forEach((b) => b.addEventListener('click', limpiar));

    /* ── «Leer más» on long descriptions ── */
    for (const t of tarjetas) {
      const p = t.querySelector<HTMLElement>('.t-desc')!;
      const btn = t.querySelector<HTMLButtonElement>('.t-mas')!;
      t.classList.add('clamp');
      if (p.scrollHeight <= p.clientHeight + 2) {
        t.classList.remove('clamp');
        btn.remove();
        continue;
      }
      btn.addEventListener('click', () => {
        const abierto = t.classList.toggle('clamp') === false;
        btn.setAttribute('aria-expanded', String(abierto));
        btn.textContent = abierto ? 'Leer menos' : 'Leer más';
      });
    }

    /* ── Selection (persisted) ── */
    const leer = (): string[] => {
      try {
        const v = JSON.parse(localStorage.getItem(CLAVE) ?? '[]');
        return Array.isArray(v) ? v.filter((id) => porProducto.has(id)) : [];
      } catch {
        return [];
      }
    };
    const sel = new Set<string>(leer());
    const guardar = () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify([...sel]));
      } catch {
        // Private mode or blocked storage: the selection still works for this visit.
      }
    };

    const pintarSeleccion = (bump = false) => {
      for (const t of tarjetas) {
        const on = sel.has(porId.get(t.dataset.id!)!.producto);
        t.classList.toggle('elegida', on);
        t.querySelector('.t-add')?.setAttribute('aria-pressed', String(on));
      }
      const items = [...sel].map((id) => porProducto.get(id)!).filter(Boolean);
      const subtotal = Math.round(items.reduce((sum, i) => sum + i.precio, 0) * 100) / 100;
      $('dock')!.hidden = items.length === 0;
      if (items.length === 0) {
        $('dock-panel')!.hidden = true;
        $('dock-btn')!.setAttribute('aria-expanded', 'false');
      }
      $('dock-n')!.textContent = String(items.length);
      $('dock-monto')!.textContent = usd(subtotal);
      $('dock-sub')!.textContent = usd(subtotal);
      const lista = $('dock-lista')!;
      lista.replaceChildren(
        ...items.map((i) => {
          const li = document.createElement('li');
          const n = document.createElement('span');
          n.textContent = i.nombre;
          const p = document.createElement('span');
          p.textContent = usd(i.precio);
          const x = document.createElement('button');
          x.type = 'button';
          x.className = 'dock-quitar';
          x.textContent = '×';
          x.setAttribute('aria-label', `Quitar ${i.nombre}`);
          x.addEventListener('click', () => {
            sel.delete(i.producto);
            guardar();
            pintarSeleccion();
          });
          li.append(n, p, x);
          return li;
        })
      );
      if (bump) {
        const n = $('dock-n')!;
        n.classList.remove('bump');
        void n.offsetWidth;
        n.classList.add('bump');
      }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.add!;
        if (sel.has(id)) sel.delete(id);
        else sel.add(id);
        guardar();
        pintarSeleccion(true);
      })
    );
    $('dock-btn')?.addEventListener('click', () => {
      const panel = $('dock-panel')!;
      panel.hidden = !panel.hidden;
      $('dock-btn')!.setAttribute('aria-expanded', String(!panel.hidden));
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        $('dock-panel')!.hidden = true;
        $('dock-btn')?.setAttribute('aria-expanded', 'false');
      }
    });
    pintarSeleccion();

    /* ── Compare (max 3) ── */
    const cmp = new Set<string>();
    const MAX = 3;
    const checks = [...root.querySelectorAll<HTMLInputElement>('[data-comparar]')];
    const pintarCmp = () => {
      $('cmp-bar')!.hidden = cmp.size === 0;
      $('cmp-texto')!.textContent =
        cmp.size === MAX ? `${cmp.size} de ${MAX} (máximo)` : `${cmp.size} de ${MAX} para comparar`;
      $<HTMLButtonElement>('cmp-abrir')!.disabled = cmp.size < 2;
      for (const c of checks) {
        c.checked = cmp.has(c.dataset.comparar!);
        c.disabled = !c.checked && cmp.size >= MAX;
      }
    };
    checks.forEach((c) =>
      c.addEventListener('change', () => {
        if (c.checked) cmp.add(c.dataset.comparar!);
        else cmp.delete(c.dataset.comparar!);
        pintarCmp();
      })
    );
    $('cmp-vaciar')?.addEventListener('click', () => {
      cmp.clear();
      pintarCmp();
    });
    const dialog = $<HTMLDialogElement>('cmp-dialog')!;
    $('cmp-abrir')?.addEventListener('click', () => {
      const cols = $('cmp-cols')!;
      cols.style.setProperty('--n', String(cmp.size));
      cols.replaceChildren(
        ...[...cmp].map((id) => {
          const i = porId.get(id)!;
          const col = document.createElement('article');
          col.className = 'cmp-col';
          const fila = (dt: string, dd: string) => {
            const a = document.createElement('dt');
            a.textContent = dt;
            const b = document.createElement('dd');
            b.textContent = dd;
            return [a, b];
          };
          const area = Object.assign(document.createElement('span'), {
            className: 'cmp-area',
            textContent: i.area,
          });
          const nombre = Object.assign(document.createElement('h3'), {
            className: 'cmp-nombre',
            textContent: i.nombre,
          });
          const precio = Object.assign(document.createElement('p'), {
            className: 'cmp-precio',
            textContent: usd(i.precio),
          });
          const dl = document.createElement('dl');
          dl.append(
            ...fila('Laboratorio', i.laboratorio || '—'),
            ...fila('Muestra', i.muestras.join(' · ') || 'No indicada'),
            ...fila('Desde casa', i.enCasa ? 'Sí' : '—')
          );
          const desc = Object.assign(document.createElement('p'), {
            className: 'cmp-desc',
            textContent: i.descripcion,
          });
          const add = document.createElement('button');
          add.type = 'button';
          add.className = 'btn btn-primary btn-sm';
          const pintarAdd = () =>
            (add.textContent = sel.has(i.producto) ? '✓ En mi selección' : 'Añadir a mi selección');
          pintarAdd();
          add.addEventListener('click', () => {
            if (sel.has(i.producto)) sel.delete(i.producto);
            else sel.add(i.producto);
            guardar();
            pintarSeleccion(true);
            pintarAdd();
          });
          col.append(area, nombre, precio, dl, desc, add);
          return col;
        })
      );
      dialog.showModal();
    });
    $('cmp-cerrar')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    pintarCmp();
  }
</script>
