---
/**
 * Exámenes · hero — the title and a few measured facts on the left; on the right a
 * "constellation": the eleven areas orbit the total, each node a button that filters the
 * explorer below (the script lives in Explorador.astro, which listens for `[data-filtro-area]`).
 *
 * Every number here is computed from `src/data/examenes.ts`; nothing is typed by hand. Each
 * node stacks its label under the dot, so eleven of them fit on one ring without touching. Below 760 px the
 * orbit becomes a horizontal row of chips.
 */
import { areas, examenes, examenesDeArea } from '../../data/examenes';
import { usd } from '../../lib/precio';

const total = examenes.length;
const desde = Math.min(...examenes.map((e) => e.precio));
const tiposMuestra = new Set(examenes.flatMap((e) => e.muestras)).size;
/** Tones dark enough to need light text on the count. */
const oscuros = new Set(['charcoal', 'olive']);
const nodos = areas.map((a, i) => {
  const ang = ((2 * Math.PI) / areas.length) * i - Math.PI / 2;
  const r = 43;
  return {
    ...a,
    cuenta: examenesDeArea(a.id).length,
    x: (50 + r * Math.cos(ang)).toFixed(2),
    y: (50 + r * Math.sin(ang)).toFixed(2),
    oscuro: oscuros.has(a.color),
  };
});
---

<section class="ex-hero" aria-labelledby="ex-titulo">
  <div class="ex-hero-glow" aria-hidden="true"></div>
  <div class="wrap ex-hero-grid">
    <div class="ex-hero-copy reveal">
      <span class="eyebrow">Exámenes funcionales</span>
      <h1 id="ex-titulo" class="ex-titulo">Exámenes<span class="ex-punto">.</span></h1>
      <p class="ex-sub">
        {total} pruebas en {areas.length} áreas, con lo que incluye cada una y para quién es.
      </p>
      <dl class="ex-datos">
        <div>
          <dt>Pruebas</dt>
          <dd>{total}</dd>
        </div>
        <div>
          <dt>Áreas</dt>
          <dd>{areas.length}</dd>
        </div>
        <div>
          <dt>Tipos de muestra</dt>
          <dd>{tiposMuestra}</dd>
        </div>
        <div>
          <dt>Desde</dt>
          <dd>{usd(desde)}</dd>
        </div>
      </dl>
      <div class="ex-hero-ctas">
        <a class="btn btn-primary" href="#explorador">Explorar exámenes</a>
      </div>
    </div>

    <div class="orbita-wrap reveal-scale">
      <div class="orbita" role="group" aria-label="Filtrar por área">
        <svg class="orbita-anillos" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="48"></circle>
          <circle cx="50" cy="50" r="43"></circle>
          <circle cx="50" cy="50" r="24"></circle>
        </svg>
        <div class="orbita-centro" aria-hidden="true">
          <span class="orbita-num">{total}</span>
          <span class="orbita-lbl">exámenes</span>
        </div>
        {
          nodos.map((n, i) => (
            <button
              type="button"
              class:list={['nodo', { oscuro: n.oscuro }]}
              style={`left:${n.x}%; top:${n.y}%; --tono: var(--color-${n.color}); --i:${i}`}
              data-filtro-area={n.id}
              aria-pressed="false"
            >
              <span class="nodo-punto" aria-hidden="true">
                {n.cuenta}
              </span>
              <span class="nodo-nombre">{n.nombre}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ex-hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 96px;
    background:
      radial-gradient(ellipse 60% 55% at 80% 40%, rgb(231 183 160 / 0.2) 0%, transparent 70%),
      radial-gradient(ellipse 50% 45% at 10% 80%, rgb(207 215 196 / 0.28) 0%, transparent 65%),
      var(--color-bone);
  }
  .ex-hero-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    right: -120px;
    top: -160px;
    border-radius: 50%;
    background: var(--color-clay);
    filter: blur(110px);
    opacity: 0.22;
    pointer-events: none;
  }
  .ex-hero-grid {
    position: relative;
    display: grid;
    /* minmax(0, …): the scrollable chip row must not widen the column on phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  /* Two columns only once the orbit can keep ~560 px; below that it gets its own row. */
  @media (min-width: 1200px) {
    .ex-hero-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 48px;
    }
  }
  .ex-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .ex-titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(64px, 11vw, 148px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
  }
  .ex-punto {
    color: var(--color-clay-deep);
  }
  .ex-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.3;
    color: var(--color-charcoal);
    max-width: 520px;
  }
  .ex-datos {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 12px 36px;
    margin-top: 6px;
  }
  @media (max-width: 520px) {
    .ex-datos {
      grid-template-columns: repeat(2, auto);
    }
  }
  .ex-datos div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }
  .ex-datos dt {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.62);
  }
  .ex-datos dd {
    font-family: var(--font-serif);
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 500;
    line-height: 1;
    color: var(--color-charcoal);
  }
  .ex-hero-ctas {
    margin-top: 8px;
  }

  /* ── The orbit ── */
  .orbita-wrap {
    display: flex;
    justify-content: center;
  }
  .orbita {
    --r: 44%;
    position: relative;
    width: min(100%, 600px);
    aspect-ratio: 1;
  }
  .orbita-anillos {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: girar 140s linear infinite;
  }
  .orbita-anillos circle {
    fill: none;
    stroke: rgb(214 154 124 / 0.35);
    stroke-width: 0.25;
    stroke-dasharray: 0.8 1.4;
  }
  .orbita-anillos circle:nth-child(2) {
    stroke: rgb(159 169 141 / 0.45);
    stroke-dasharray: none;
  }
  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }
  .orbita-centro {
    position: absolute;
    inset: 36%;
    gap: 6px;
    border-radius: 50%;
    background: var(--color-charcoal);
    color: var(--color-bone);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 30px 70px rgb(35 34 30 / 0.28),
      0 0 0 10px rgb(35 34 30 / 0.05);
  }
  .orbita-num {
    font-family: var(--font-serif);
    font-size: clamp(48px, 5.6vw, 72px);
    line-height: 1;
  }
  .orbita-lbl {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .nodo {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-charcoal);
    white-space: nowrap;
    transform: translate(-50%, -24px);
    animation: nodo-in 0.8s var(--ease-out-soft) both;
    animation-delay: calc(0.25s + var(--i) * 60ms);
  }
  @keyframes nodo-in {
    from {
      opacity: 0;
    }
  }
  .nodo-punto {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tono);
    color: var(--color-charcoal);
    font-size: 14px;
    font-weight: 800;
    box-shadow:
      0 0 0 5px rgb(251 250 246 / 0.9),
      0 12px 26px rgb(35 34 30 / 0.16);
    transition:
      transform 0.35s var(--ease-spring),
      box-shadow 0.3s ease;
  }
  .nodo-nombre {
    font-size: 12.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.88);
    border: 1px solid rgb(35 34 30 / 0.08);
    backdrop-filter: blur(6px);
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }
  .nodo:hover .nodo-punto,
  .nodo:focus-visible .nodo-punto {
    transform: scale(1.12);
    box-shadow:
      0 0 0 5px rgb(251 250 246 / 0.9),
      0 0 0 7px var(--tono),
      0 16px 30px rgb(35 34 30 / 0.2);
  }
  .nodo[aria-pressed='true'] .nodo-nombre {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .nodo[aria-pressed='true'] .nodo-punto {
    box-shadow:
      0 0 0 5px rgb(251 250 246 / 0.9),
      0 0 0 8px var(--color-charcoal);
  }
  .nodo.oscuro .nodo-punto {
    color: var(--color-bone);
  }

  @media (max-width: 760px) {
    .orbita-wrap {
      display: block;
      margin: 0 -28px;
    }
    .orbita {
      width: auto;
      aspect-ratio: auto;
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 4px 28px 12px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }
    .orbita::-webkit-scrollbar {
      display: none;
    }
    .orbita-anillos,
    .orbita-centro {
      display: none;
    }
    .nodo {
      position: static;
      transform: none;
      left: auto;
      top: auto;
      flex-direction: row;
      gap: 8px;
      padding: 5px 12px 5px 5px;
      border-radius: var(--radius-pill);
      background: rgb(255 255 255 / 0.9);
      border: 1px solid rgb(35 34 30 / 0.1);
      flex-shrink: 0;
      scroll-snap-align: start;
    }
  }
  @media (max-width: 760px) {
    .nodo-punto {
      width: 30px;
      height: 30px;
      font-size: 12.5px;
      box-shadow: none;
    }
    .nodo-nombre {
      padding: 0;
      border: 0;
      background: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbita-anillos,
    .nodo {
      animation: none;
    }
  }
</style>
