---
/**
 * Exámenes · preguntas frecuentes — on the page's dark ground, the title on top and the
 * questions under it (Mari, 2026-09-24). Native
 * <details>, so it works without JS; the script only closes the others when one opens.
 * Questions: data/examenes `preguntasExamenes` (after NutriWhite's exam policy).
 */
import { preguntasExamenes } from '../../data/examenes';
import { href } from '../../lib/url';
---

<section class="fx" aria-labelledby="fx-titulo">
  <div class="wrap fx-grid">
    <div class="fx-cab">
      <span class="eyebrow">Antes de hacer tu pedido</span>
      <h2 id="fx-titulo" class="fx-h2">
        Respuestas a tus <em class="grad-text on-dark">preguntas</em>
      </h2>
      <p>
        ¿Tienes otra pregunta? Escríbenos antes de comprar. Si necesitas orientación para elegir un
        examen, podemos revisarlo en tu <a href={href('/asesorias')}>asesoría</a>.
      </p>
    </div>
    <div class="fx-lista" data-fx>
      {
        preguntasExamenes.map((p) => (
          <details class="fx-item">
            <summary>
              <span>{p.q}</span>
              <span class="fx-mas" aria-hidden="true" />
            </summary>
            <p>{p.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fx {
    padding: clamp(64px, 8vw, 110px) 0;
    background: linear-gradient(180deg, #1a1916 0%, #1f201b 100%);
    color: var(--color-bone);
    border-top: 1px solid rgb(248 246 241 / 0.08);
  }
  /* Title on top, centred; the questions below it in one readable column. */
  .fx-grid {
    display: grid;
    gap: 40px;
    max-width: 880px;
  }
  .fx-cab {
    text-align: center;
  }
  .fx .eyebrow {
    color: var(--color-clay);
  }
  .fx-h2 {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1.02;
    color: var(--color-bone);
  }
  .fx-h2 em {
    font-style: italic;
  }
  .fx-cab p {
    margin: 16px auto 0;
    max-width: 460px;
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(248 246 241 / 0.66);
  }
  .fx-cab a {
    color: var(--color-bone);
    border-bottom: 1px solid rgb(248 246 241 / 0.35);
  }
  .fx-lista {
    border-top: 1px solid rgb(248 246 241 / 0.12);
  }
  .fx-item {
    border-bottom: 1px solid rgb(248 246 241 / 0.12);
  }
  .fx-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.6vw, 22px);
    line-height: 1.3;
    color: var(--color-bone);
    transition: color 0.3s ease;
  }
  .fx-item summary::-webkit-details-marker {
    display: none;
  }
  .fx-item summary:hover {
    color: var(--color-clay);
  }
  .fx-item summary:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 2px;
    border-radius: 6px;
  }
  /* A plus that turns into a minus. */
  .fx-mas {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgb(248 246 241 / 0.3);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .fx-mas::before,
  .fx-mas::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
  }
  .fx-mas::after {
    rotate: 90deg;
    transition: rotate 0.3s ease;
  }
  .fx-item[open] .fx-mas {
    background: var(--color-clay);
    border-color: var(--color-clay);
    color: #1b1a17;
    transform: rotate(180deg);
  }
  .fx-item[open] .fx-mas::after {
    rotate: 0deg;
  }
  .fx-item p {
    padding: 0 48px 24px 4px;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgb(248 246 241 / 0.72);
    animation: fx-in 0.4s ease;
  }
  @keyframes fx-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-item p {
      animation: none;
    }
  }
</style>

<script>
  const lista = document.querySelector('[data-fx]');
  if (lista) {
    const items = [...lista.querySelectorAll<HTMLDetailsElement>('details')];
    items.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => o !== d && (o.open = false));
      })
    );
  }
</script>
