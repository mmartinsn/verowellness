---
/**
 * Exámenes · hero «la lupa que revela» (Mari, 2026-09-24): a dark screen with the headline; the
 * pointer is a round lens that shows what lies underneath — a slow microscopic world in darkfield
 * style (cells with nucleus and organelles, glassy bacteria with pili and flagella, diatom-like
 * spores, drifting specks, some out of focus), in the Layer colours, magnified a little and read
 * through a fine microscope reticle; drawn on a canvas clipped to the lens. On
 * touch screens, or when the pointer rests, the lens wanders on its own; on touch, a finger on the
 * lens drags it (Mari, 2026-09-24), and letting go hands it back to its wandering. The idea it carries is
 * the page's: what a routine check-up does not usually look at.
 * Reduced motion: the world stands still and the lens rests off-centre.
 */
---

<section class="lupa" data-lupa aria-labelledby="lupa-titulo">
  <div class="puntos" aria-hidden="true"></div>
  <canvas class="mundo" aria-hidden="true"></canvas>
  <div class="lente" aria-hidden="true"></div>

  <div class="wrap lupa-copy">
    <span class="eyebrow">Exámenes funcionales · Empieza por lo que sientes</span>
    <h1 id="lupa-titulo" class="lupa-h1">
      Tu bienestar empieza por <em class="grad-text on-dark">escucharte.</em>
    </h1>
    <p class="lupa-lede">
      Selecciona lo que más se parece a lo que sientes. Explora los exámenes disponibles, qué mide
      cada uno y cómo se toma la muestra.
    </p>
    <a class="lupa-cta" href="#sintomas">
      Elige lo que sientes <span aria-hidden="true">↓</span>
    </a>
    <p class="lupa-pista" aria-hidden="true">
      <span class="pista-fino">Mueve el cursor: mira lo que no se ve</span>
      <span class="pista-tactil">Toca la lupa y muévela</span>
    </p>
  </div>
</section>

<style>
  .lupa {
    --lr: 130px;
    position: relative;
    min-height: min(88vh, 860px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 60% at 50% 45%, #25241f 0%, #1b1a17 60%, #141412 100%);
    color: var(--color-bone);
    isolation: isolate;
  }
  /* The resting surface: a faint dot field, the world only hinted at. */
  .puntos {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(248 246 241 / 0.07) 1px, transparent 1.5px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 40%, transparent 100%);
    z-index: 0;
  }
  /* The hidden world: the canvas draws it only inside the lens (a clip, not a CSS mask, so
     moving the lens does not repaint the whole layer). */
  .mundo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  /* The glass rim of the lens. */
  /* Moved with transform (set in px by the script), so it rides on the compositor. */
  .lente {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--lr) * 2);
    height: calc(var(--lr) * 2);
    transform: translate3d(calc(70vw - var(--lr)), calc(50% - var(--lr)), 0);
    will-change: transform;
    border-radius: 50%;
    /* Under the copy (z 3, which lets touches through except on its links), so the button stays
       tappable. Touch: the lens can be grabbed and dragged; elsewhere the page keeps scrolling. */
    z-index: 2;
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
    box-shadow:
      inset 0 0 0 1.5px rgb(248 246 241 / 0.45),
      inset 0 0 40px rgb(248 246 241 / 0.08),
      0 0 0 1px rgb(0 0 0 / 0.4),
      0 30px 80px -20px rgb(214 154 124 / 0.35);
    background: radial-gradient(circle at 32% 26%, rgb(255 255 255 / 0.16), transparent 38%);
  }
  .lupa-copy {
    position: relative;
    z-index: 3;
    max-width: 900px;
    text-align: center;
    pointer-events: none;
  }
  .lupa-copy a {
    pointer-events: auto;
  }
  .lupa .eyebrow {
    color: var(--color-clay);
  }
  .lupa-h1 {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(46px, 7vw, 104px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    color: var(--color-bone);
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.55);
  }
  .lupa-h1 em {
    font-style: italic;
  }
  .lupa-lede {
    margin: 22px auto 0;
    max-width: 580px;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.65;
    color: rgb(248 246 241 / 0.78);
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.6);
  }
  .lupa-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    min-height: 54px;
    padding: 0 28px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f0c4ae, var(--color-clay-deep));
    color: var(--color-charcoal);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.35s ease;
  }
  .lupa-cta:hover {
    background: var(--color-white);
  }
  .lupa-pista {
    margin-top: 22px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(248 246 241 / 0.42);
  }
  .pista-tactil {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .pista-fino {
      display: none;
    }
    .pista-tactil {
      display: inline;
    }
  }
  @media (max-width: 640px) {
    .lupa {
      --lr: 96px;
      min-height: 80vh;
    }
  }
</style>

<script>
  const lupa = document.querySelector<HTMLElement>('[data-lupa]');
  if (lupa) {
    const canvas = lupa.querySelector<HTMLCanvasElement>('.mundo')!;
    const lente = lupa.querySelector<HTMLElement>('.lente')!;
    const ctx = canvas.getContext('2d')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fino = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const css = getComputedStyle(document.documentElement);
    const tonos = ['clay', 'sage', 'sage-deep', 'rose', 'olive', 'clay-rich', 'sand'].map(
      (t) => css.getPropertyValue(`--color-${t}`).trim() || '#d69a7c'
    );

    // Colour tokens as rgb triplets, so each organism can be drawn at any opacity.
    const rgb = (hex: string) => {
      const h = hex.replace('#', '');
      const n = parseInt(h.length === 3 ? h.replace(/./g, '$&$&') : h, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255].join(',');
    };
    const paleta = tonos.map(rgb);

    /** 0 cell · 1 bacterium · 2 spore (diatom-like ring) · 3 drifting speck */
    type Ser = {
      tipo: 0 | 1 | 2 | 3;
      x: number;
      y: number;
      r: number;
      /** depth: 1 in focus, lower = further away (fainter, smaller) */
      z: number;
      a: number;
      va: number;
      vx: number;
      vy: number;
      c: string;
      fase: number;
      organulos: [number, number, number][];
      pelos: number;
    };
    let W = 0;
    let H = 0;
    let seres: Ser[] = [];
    let R = 130;
    const M = 1.28; // the lens magnifies a little
    const azar = (a: number, b: number) => a + Math.random() * (b - a);

    const medir = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = lupa.clientWidth;
      H = lupa.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      R = parseFloat(getComputedStyle(lupa).getPropertyValue('--lr')) || 130;
      // dense enough that the magnified lens always holds a dozen or more
      const n = Math.round((W * H) / 1700);
      seres = Array.from({ length: n }, () => {
        const q = Math.random();
        const tipo = (q < 0.3 ? 0 : q < 0.58 ? 1 : q < 0.72 ? 2 : 3) as Ser['tipo'];
        const r =
          tipo === 0
            ? azar(16, 34)
            : tipo === 1
              ? azar(5, 8)
              : tipo === 2
                ? azar(7, 12)
                : azar(0.8, 1.8);
        return {
          tipo,
          x: azar(0, W),
          y: azar(0, H),
          r,
          z: tipo === 3 ? azar(0.4, 1) : Math.random() < 0.3 ? azar(0.45, 0.7) : azar(0.85, 1),
          a: azar(0, Math.PI * 2),
          va: azar(-0.003, 0.003),
          vx: azar(-0.16, 0.16),
          vy: azar(-0.12, 0.12),
          c: paleta[Math.floor(Math.random() * paleta.length)],
          fase: azar(0, Math.PI * 2),
          organulos: Array.from({ length: 5 }, () => [
            azar(-0.55, 0.55),
            azar(-0.5, 0.5),
            azar(0.05, 0.1),
          ]),
          pelos: Math.floor(azar(10, 18)),
        };
      });
    };

    /* ── One organism, darkfield style: luminous edges, translucent bodies ── */
    const celula = (s: Ser, r: number, t: number) => {
      const late = 1 + Math.sin(t * 0.0012 + s.fase) * 0.035;
      const rx = r * late;
      const ry = r * 0.88 * (2 - late);
      const cuerpo = ctx.createRadialGradient(-rx * 0.3, -ry * 0.35, r * 0.1, 0, 0, r * 1.05);
      cuerpo.addColorStop(0, `rgba(${s.c},0.34)`);
      cuerpo.addColorStop(0.7, `rgba(${s.c},0.14)`);
      cuerpo.addColorStop(1, `rgba(${s.c},0.03)`);
      ctx.fillStyle = cuerpo;
      ctx.beginPath();
      ctx.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2);
      ctx.fill();
      // double membrane, glowing
      ctx.shadowColor = `rgba(${s.c},0.9)`;
      ctx.shadowBlur = 10;
      ctx.strokeStyle = `rgba(${s.c},0.95)`;
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = `rgba(255,250,242,0.28)`;
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      ctx.ellipse(0, 0, rx * 0.9, ry * 0.9, 0, 0, Math.PI * 2);
      ctx.stroke();
      // organelles
      for (const [ox, oy, orr] of s.organulos) {
        ctx.fillStyle = `rgba(255,248,238,0.35)`;
        ctx.beginPath();
        ctx.arc(ox * rx, oy * ry, orr * r, 0, Math.PI * 2);
        ctx.fill();
      }
      // nucleus with its nucleolus
      const nx = rx * 0.16;
      const ny = -ry * 0.08;
      const nucleo = ctx.createRadialGradient(nx - r * 0.08, ny - r * 0.08, 0, nx, ny, r * 0.36);
      nucleo.addColorStop(0, `rgba(255,246,236,0.7)`);
      nucleo.addColorStop(0.55, `rgba(${s.c},0.55)`);
      nucleo.addColorStop(1, `rgba(${s.c},0.15)`);
      ctx.fillStyle = nucleo;
      ctx.beginPath();
      ctx.arc(nx, ny, r * 0.34, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = `rgba(${s.c},0.8)`;
      ctx.lineWidth = 0.8;
      ctx.stroke();
      ctx.fillStyle = `rgba(255,252,246,0.85)`;
      ctx.beginPath();
      ctx.arc(nx + r * 0.08, ny - r * 0.06, r * 0.07, 0, Math.PI * 2);
      ctx.fill();
    };

    const bacteria = (s: Ser, r: number, t: number) => {
      const l = r * 3.4;
      // fine pili around the body
      ctx.strokeStyle = `rgba(${s.c},0.35)`;
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      for (let k = 0; k < s.pelos; k++) {
        const u = (k / s.pelos) * Math.PI * 2;
        const px = Math.cos(u) * (l / 2);
        const py = Math.sin(u) * (r * 0.95);
        ctx.moveTo(px, py);
        ctx.lineTo(px * 1.18, py * 1.5);
      }
      ctx.stroke();
      // the glassy capsule
      const cuerpo = ctx.createLinearGradient(0, -r, 0, r);
      cuerpo.addColorStop(0, `rgba(255,248,238,0.55)`);
      cuerpo.addColorStop(0.35, `rgba(${s.c},0.6)`);
      cuerpo.addColorStop(1, `rgba(${s.c},0.25)`);
      ctx.fillStyle = cuerpo;
      ctx.shadowColor = `rgba(${s.c},0.85)`;
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.roundRect(-l / 2, -r, l, r * 2, r);
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = `rgba(${s.c},0.95)`;
      ctx.lineWidth = 0.9;
      ctx.stroke();
      // inner highlight
      ctx.strokeStyle = `rgba(255,252,246,0.55)`;
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(-l / 2 + r, -r * 0.45);
      ctx.lineTo(l / 2 - r, -r * 0.45);
      ctx.stroke();
      // a long, slow flagellum
      ctx.strokeStyle = `rgba(${s.c},0.55)`;
      ctx.lineWidth = 0.7;
      ctx.beginPath();
      ctx.moveTo(l / 2, 0);
      for (let k = 1; k <= 22; k++) {
        const fx = l / 2 + k * 1.9;
        ctx.lineTo(fx, Math.sin(k * 0.55 - t * 0.004 + s.fase) * (1.2 + k * 0.18));
      }
      ctx.stroke();
    };

    const espora = (s: Ser, r: number, t: number) => {
      // a diatom-like ring with a crown of beads
      ctx.shadowColor = `rgba(${s.c},0.8)`;
      ctx.shadowBlur = 6;
      ctx.strokeStyle = `rgba(${s.c},0.85)`;
      ctx.lineWidth = 0.9;
      ctx.beginPath();
      ctx.arc(0, 0, r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = `rgba(${s.c},0.4)`;
      ctx.beginPath();
      ctx.arc(0, 0, r * 0.62, 0, Math.PI * 2);
      ctx.stroke();
      const n = 14;
      ctx.fillStyle = `rgba(255,248,238,0.6)`;
      for (let k = 0; k < n; k++) {
        const u = (k / n) * Math.PI * 2 + t * 0.0002;
        ctx.beginPath();
        ctx.arc(Math.cos(u) * r * 0.81, Math.sin(u) * r * 0.81, r * 0.07, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = `rgba(${s.c},0.35)`;
      ctx.beginPath();
      ctx.arc(0, 0, r * 0.3, 0, Math.PI * 2);
      ctx.fill();
    };

    /* The fine reticle of a microscope, inside the lens rim. */
    const reticula = (cx: number, cy: number) => {
      ctx.strokeStyle = 'rgba(248,246,241,0.22)';
      ctx.lineWidth = 0.7;
      ctx.beginPath();
      ctx.arc(cx, cy, R - 12, 0, Math.PI * 2);
      ctx.stroke();
      ctx.beginPath();
      for (let k = 0; k < 72; k++) {
        const u = (k / 72) * Math.PI * 2;
        const largo = k % 6 === 0 ? 7 : 3;
        ctx.moveTo(cx + Math.cos(u) * (R - 12), cy + Math.sin(u) * (R - 12));
        ctx.lineTo(cx + Math.cos(u) * (R - 12 - largo), cy + Math.sin(u) * (R - 12 - largo));
      }
      ctx.stroke();
      // a faint crosshair that fades toward the centre
      ctx.strokeStyle = 'rgba(248,246,241,0.1)';
      ctx.beginPath();
      ctx.moveTo(cx - R + 20, cy);
      ctx.lineTo(cx - 14, cy);
      ctx.moveTo(cx + 14, cy);
      ctx.lineTo(cx + R - 20, cy);
      ctx.moveTo(cx, cy - R + 20);
      ctx.lineTo(cx, cy - 14);
      ctx.moveTo(cx, cy + 14);
      ctx.lineTo(cx, cy + R - 20);
      ctx.stroke();
    };

    const dibujar = (t: number, cx: number, cy: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.clip();
      // darkfield: a deep ground with a warm light from the upper left
      const fondo = ctx.createRadialGradient(cx - R * 0.35, cy - R * 0.4, R * 0.05, cx, cy, R);
      fondo.addColorStop(0, 'rgba(58,50,44,0.95)');
      fondo.addColorStop(0.6, 'rgba(30,27,24,0.96)');
      fondo.addColorStop(1, 'rgba(16,15,13,0.98)');
      ctx.fillStyle = fondo;
      ctx.fillRect(cx - R, cy - R, R * 2, R * 2);
      // far things first, so near ones sit on top
      const orden = [...seres].sort((p, q) => p.z - q.z);
      for (const s of orden) {
        if (!calm) {
          s.x = (s.x + s.vx * s.z + W + 80) % (W + 80);
          s.y = (s.y + s.vy * s.z + H + 80) % (H + 80);
          s.a += s.va;
        }
        // magnified position inside the lens
        const x = cx + (s.x - 40 - cx) * M;
        const y = cy + (s.y - 40 - cy) * M;
        const r = s.r * M * (0.55 + s.z * 0.45);
        if (Math.abs(x - cx) > R + r * 4 || Math.abs(y - cy) > R + r * 4) continue;
        ctx.save();
        ctx.globalAlpha = 0.35 + s.z * 0.65;
        ctx.translate(x, y);
        ctx.rotate(s.a);
        if (s.tipo === 0) celula(s, r, t);
        else if (s.tipo === 1) bacteria(s, r, t);
        else if (s.tipo === 2) espora(s, r, t);
        else {
          ctx.fillStyle = `rgba(255,246,236,${0.25 + s.z * 0.4})`;
          ctx.beginPath();
          ctx.arc(0, 0, r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }
      reticula(cx, cy);
      ctx.restore();
      ctx.globalAlpha = 1;
    };

    // The lens: follows the pointer smoothly, wanders by itself when idle or on touch.
    let lx = 0.7;
    let ly = 0.55;
    let tx = lx;
    let ty = ly;
    let ultimoMovimiento = -1e9;
    let visible = false;
    let arrastrando = false;
    // where the finger grabbed the lens, relative to its centre, so that point stays under it
    let agarreX = 0;
    let agarreY = 0;
    const apuntar = (e: PointerEvent) => {
      const r = lupa.getBoundingClientRect();
      const x = e.clientX - (arrastrando ? agarreX : 0);
      const y = e.clientY - (arrastrando ? agarreY : 0);
      tx = Math.min(1, Math.max(0, (x - r.left) / r.width));
      ty = Math.min(1, Math.max(0, (y - r.top) / r.height));
      ultimoMovimiento = performance.now();
      // reduced motion draws only on demand
      if (calm && visible) requestAnimationFrame(cuadro);
    };
    lupa.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' ? fino : arrastrando) apuntar(e);
    });
    // Touch: put a finger on the lens and play with it; let go and it wanders again.
    lente.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      const b = lente.getBoundingClientRect();
      agarreX = e.clientX - (b.left + b.width / 2);
      agarreY = e.clientY - (b.top + b.height / 2);
      arrastrando = true;
      lente.setPointerCapture(e.pointerId);
      lente.style.cursor = 'grabbing';
      apuntar(e);
    });
    lente.addEventListener('pointermove', (e) => {
      if (arrastrando) apuntar(e);
    });
    const soltar = () => {
      arrastrando = false;
      lente.style.cursor = '';
      ultimoMovimiento = performance.now();
    };
    lente.addEventListener('pointerup', soltar);
    lente.addEventListener('pointercancel', soltar);

    const cuadro = (t: number) => {
      if (!visible) return;
      if (!calm && !arrastrando && t - ultimoMovimiento > 2500) {
        // an unhurried figure-of-eight around the headline
        tx = 0.5 + Math.sin(t * 0.00032) * 0.3;
        ty = 0.52 + Math.sin(t * 0.00064) * 0.22;
      }
      const seguir = calm ? 1 : arrastrando ? 0.35 : 0.1;
      lx += (tx - lx) * seguir;
      ly += (ty - ly) * seguir;
      const cx = lx * W;
      const cy = ly * H;
      lente.style.transform = `translate3d(${(cx - R).toFixed(1)}px, ${(cy - R).toFixed(1)}px, 0)`;
      dibujar(t, cx, cy);
      if (!calm) requestAnimationFrame(cuadro);
    };

    medir();
    addEventListener('resize', medir);
    new IntersectionObserver((e) => {
      const antes = visible;
      visible = e[0].isIntersecting;
      if (visible && !antes) requestAnimationFrame(cuadro);
    }).observe(lupa);
  }
</script>
