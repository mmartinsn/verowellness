---
import { areas, areaPorId, examenes, examenesDeArea, muestras } from '../../data/examenes';
import { sintomasDeExamen } from '../../data/sintomas';
import { href } from '../../lib/url';
import FilaExamen from './FilaExamen.astro';
import { normalizar } from './buscar';

const grupos = areas
  .map((a) => ({ ...a, total: examenesDeArea(a.id).length }))
  .filter((a) => a.total > 0);
const inicial = grupos[0].id;

const textoBusqueda = (e: (typeof examenes)[number]) =>
  normalizar(
    [
      e.nombre,
      e.laboratorio ?? '',
      areaPorId.get(e.area)!.nombre,
      ...e.muestras.map((m) => muestras[m]),
      ...sintomasDeExamen(e.id).flatMap((s) => [s.titulo, s.descripcion]),
      e.descripcion,
    ].join(' ')
  );
---

<section
  class="cat"
  id="catalogo"
  data-catalogo
  data-inicial={inicial}
  aria-labelledby="cat-titulo"
>
  <div class="wrap">
    <div class="cat-cab reveal">
      <span class="eyebrow">Catálogo de exámenes</span>
      <h2 id="cat-titulo" class="cat-h2">Encuentra tu examen</h2>
      <label class="cat-buscar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4"></path>
        </svg>
        <span class="sr-only">Buscar un examen</span>
        <input
          type="search"
          data-buscar-input
          placeholder="Busca por nombre, laboratorio o síntoma…"
          autocomplete="off"
          enterkeyhint="search"
        />
        <button type="button" class="cat-limpiar" data-limpiar hidden aria-label="Borrar búsqueda">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </label>
    </div>

    <div class="cat-grupos" role="group" aria-label="Grupos de exámenes">
      {
        grupos.map((g) => (
          <button
            type="button"
            class="grupo"
            data-grupo={g.id}
            aria-pressed={g.id === inicial ? 'true' : 'false'}
            style={`--tono:var(--color-${g.color})`}
          >
            <span class="grupo-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path d={g.icono} />
              </svg>
            </span>
            <span class="grupo-n">{g.nombre}</span>
            <span class="grupo-c">{g.total}</span>
          </button>
        ))
      }
    </div>

    <p class="cat-estado" data-estado aria-live="polite"></p>

    <div class="cat-lista">
      {
        examenes.map((e) => (
          <FilaExamen examen={e} buscar={textoBusqueda(e)} oculto={e.area !== inicial} />
        ))
      }
    </div>

    <p class="cat-vacio" data-vacio hidden>
      No encontramos ese examen. Prueba con otra palabra, o <a href={href('/asesorias')}
        >pide ayuda para elegir</a
      >.
    </p>
  </div>
  <noscript>
    <style is:inline>
      [data-catalogo] [data-item][hidden] {
        display: grid !important;
      }
    </style>
  </noscript>
</section>

<style>
  .cat {
    padding: clamp(64px, 8vw, 104px) 0;
    background: var(--color-bone);
    scroll-margin-top: 70px;
  }
  .cat-cab {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px 40px;
    align-items: end;
  }
  @media (min-width: 900px) {
    .cat-cab {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    }
    .cat-cab .eyebrow {
      grid-column: 1 / -1;
    }
  }
  .cat .eyebrow {
    color: var(--color-clay-rich);
  }
  .cat-h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 1.02;
  }
  .cat-buscar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 58px;
    padding: 0 16px 0 20px;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.14);
    box-shadow: 0 16px 34px -26px rgb(35 34 30 / 0.45);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .cat-buscar:focus-within {
    border-color: var(--color-clay-deep);
    box-shadow:
      0 0 0 4px rgb(231 183 160 / 0.35),
      0 16px 34px -26px rgb(35 34 30 / 0.45);
  }
  .cat-buscar svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: rgb(35 34 30 / 0.55);
  }
  .cat-buscar input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 16px;
    color: var(--color-charcoal);
    outline: none;
  }
  .cat-buscar input::-webkit-search-cancel-button {
    display: none;
  }
  .cat-limpiar {
    all: unset;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    background: var(--color-sand-light);
  }
  .cat-limpiar[hidden] {
    display: none;
  }
  .cat-grupos {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 760px) {
    .cat-grupos {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: -28px;
      padding: 4px 28px 10px;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }
    .cat-grupos::-webkit-scrollbar {
      display: none;
    }
    .cat-grupos .grupo {
      flex: none;
      scroll-snap-align: start;
    }
  }
  .grupo {
    all: unset;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px 7px 8px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tono) 14%, var(--color-white));
    border: 1px solid color-mix(in srgb, var(--tono) 35%, transparent);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .grupo:hover {
    transform: translateY(-2px);
    border-color: var(--tono);
  }
  .grupo:focus-visible {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 2px;
  }
  .grupo[aria-pressed='true'] {
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
    color: var(--color-bone);
  }
  .grupo-ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--tono) 45%, var(--color-white));
    color: color-mix(in srgb, var(--tono) 45%, var(--color-charcoal));
  }
  .grupo[aria-pressed='true'] .grupo-ico {
    background: var(--tono);
    color: var(--color-charcoal);
  }
  .grupo-ico svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .grupo-c {
    min-width: 24px;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: rgb(35 34 30 / 0.08);
    font-size: 12px;
    text-align: center;
  }
  .grupo[aria-pressed='true'] .grupo-c {
    background: rgb(253 249 242 / 0.16);
  }
  .cat-estado {
    margin-top: 26px;
    font-size: 14px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.6);
  }
  .cat-estado:empty {
    display: none;
  }
  .cat-lista {
    margin-top: 16px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @media (min-width: 980px) {
    .cat-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cat-vacio {
    margin-top: 20px;
    font-size: 15px;
    color: rgb(35 34 30 / 0.7);
  }
  .cat-vacio a {
    border-bottom: 1px solid rgb(35 34 30 / 0.35);
    font-weight: 700;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { normalizar } from './buscar';

  const raiz = document.querySelector<HTMLElement>('[data-catalogo]');
  if (raiz) {
    const input = raiz.querySelector<HTMLInputElement>('[data-buscar-input]')!;
    const limpiar = raiz.querySelector<HTMLButtonElement>('[data-limpiar]')!;
    const estado = raiz.querySelector<HTMLElement>('[data-estado]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    const grupos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-grupo]')];
    const items = [...raiz.querySelectorAll<HTMLElement>('[data-item]')];
    let grupo = raiz.dataset.inicial!;

    const nombreGrupo = (id: string) =>
      grupos.find((g) => g.dataset.grupo === id)?.querySelector('.grupo-n')?.textContent ?? '';

    const pintar = () => {
      const q = normalizar(input.value);
      const palabras = q.split(/\s+/).filter(Boolean);
      let n = 0;
      items.forEach((it) => {
        const visible = palabras.length
          ? palabras.every((p) => it.dataset.buscar!.includes(p))
          : it.dataset.area === grupo;
        it.hidden = !visible;
        if (visible) n++;
      });
      grupos.forEach((g) =>
        g.setAttribute('aria-pressed', String(!palabras.length && g.dataset.grupo === grupo))
      );
      limpiar.hidden = !input.value;
      vacio.hidden = n > 0;
      estado.textContent = palabras.length
        ? `${n} ${n === 1 ? 'resultado' : 'resultados'} para «${input.value.trim()}»`
        : `${n} ${n === 1 ? 'examen' : 'exámenes'} en ${nombreGrupo(grupo)}`;
    };

    grupos.forEach((g) =>
      g.addEventListener('click', () => {
        grupo = g.dataset.grupo!;
        input.value = '';
        pintar();
      })
    );
    input.addEventListener('input', pintar);
    limpiar.addEventListener('click', () => {
      input.value = '';
      input.focus();
      pintar();
    });
    pintar();
  }
</script>
