---
/**
 * The full catalogue by group, as in Verónica's price list (change 36): one group at a time behind
 * pill tabs so the page stays short, and a search box over every test (change 37). On a light
 * ground, to lighten the page (her note: «se vuelve muy oscura»). Each row opens the test's fact
 * sheet and has the same «Agregar» as the symptom section; both live in PorSintoma's script, which
 * listens page-wide.
 */
import { areas, examenes, muestras } from '../../data/examenes';
import { sintomas, examenesDe } from '../../data/sintomas';
import { href } from '../../lib/url';
import FilaCatalogo from './FilaCatalogo.astro';
import { presentacionGrupo, caminosAlimentos, mideAlimentos } from '../../data/grupos-examenes';
import { productoDe, examenPorId } from '../../data/examenes';
import { usd } from '../../lib/precio';
import { listaCiclos, checkoutPath, precioCard } from '../../data/oferta';

/** Cards shown per group before «Ver los N exámenes». */
const VISIBLES = 4;
const caminos = caminosAlimentos.map((c) => ({
  ...c,
  paneles: c.ids.map((id) => {
    const e = examenPorId.get(id);
    if (!e) throw new Error(`grupos-examenes: «${id}» no existe`);
    return { e, m: mideAlimentos[id] ?? { mide: [] } };
  }),
}));
import { CLAVE_SELECCION } from '../../data/examenes';

const vistas = sintomas.map((s) => ({
  ...s,
  subgrupos: s.grupos.map((g) => ({ pregunta: g.pregunta, items: examenesDe(g) })),
}));

const grupos = areas
  .map((a) => ({ ...a, items: examenes.filter((e) => e.area === a.id) }))
  .filter((g) => g.items.length > 0);

const textoBusqueda = (e: (typeof examenes)[number]): string =>
  [e.nombre, e.laboratorio ?? '', e.descripcion, ...e.muestras.map((m) => muestras[m])]
    .join(' ')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');
---

<section class="catalogo" id="catalogo" data-catalogo>
  <div class="wrap">
    <div class="cab reveal">
      <span class="eyebrow">Catálogo completo</span>
      <h2>Exámenes por grupo</h2>
    </div>

    <div class="buscador reveal">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg
      >
      <input
        type="search"
        placeholder="Busca un examen por nombre, laboratorio o lo que mide"
        aria-label="Buscar un examen"
        data-buscar
        autocomplete="off"
      />
      <span class="contador" data-contador hidden></span>
    </div>

    <div class="pestanas" role="tablist" aria-label="Grupos de exámenes" data-pestanas>
      {
        grupos.map((g, i) => (
          <button
            type="button"
            role="tab"
            class:list={['pestana', { on: i === 0 }]}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-grupo={g.id}
            style={`--tono:var(--color-${g.color})`}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d={presentacionGrupo[g.id]?.icono} />
            </svg>
            {g.nombre}
          </button>
        ))
      }
    </div>

    {
      grupos.map((g, i) => (
        <div
          class="grupo-cab"
          data-cab={g.id}
          hidden={i !== 0}
          style={`--tono:var(--color-${g.color})`}
        >
          <span class="grupo-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28">
              <path d={presentacionGrupo[g.id]?.icono} />
            </svg>
          </span>
          <div>
            <h3 class="grupo-t">{g.nombre}</h3>
            <p class="grupo-d">{presentacionGrupo[g.id]?.descripcion}</p>
          </div>
        </div>
      ))
    }
    <!-- «Reacciones a alimentos» as a guided choice: four questions, each opening its panels. -->
    <div class="comparador" data-comparador hidden>
      <p class="guia-t">¿Qué quieres saber?</p>
      <div class="caminos" role="tablist" aria-label="¿Qué quieres saber?">
        {
          caminos.map((c, i) => (
            <button
              type="button"
              role="tab"
              class:list={['camino', { on: i === 0 }]}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-camino={c.id}
            >
              <span class="camino-n">0{i + 1}</span>
              <span class="camino-q">{c.pregunta}</span>
            </button>
          ))
        }
      </div>
      {
        caminos.map((c, i) => (
          <div class="camino-panel" data-camino-panel={c.id} hidden={i !== 0}>
            <p class="camino-ayuda">{c.ayuda}</p>
            <ul class="paneles">
              {c.paneles.map(({ e, m }) => (
                <li class="pa" data-comp-fila>
                  <div class="pa-top">
                    <button type="button" class="pa-nombre" data-ficha={e.id}>
                      {e.nombre}
                    </button>
                    <small>{e.laboratorio}</small>
                  </div>
                  {m.alimentos ? (
                    <div class="pa-cifra">
                      <strong>{m.alimentos}</strong>
                      <span>alimentos</span>
                      <div class="pa-barra" aria-hidden="true">
                        <span style={`--w:${(m.alimentos / 240).toFixed(3)}`} />
                      </div>
                    </div>
                  ) : (
                    <div class="pa-cifra">
                      <strong class="pa-esp">Panel específico</strong>
                      <span>gota de sangre</span>
                    </div>
                  )}
                  <button type="button" class="pa-ver" data-ficha={e.id}>
                    Ver información completa →
                  </button>
                  <ul class="pa-mide">
                    {m.mide.map((x) => (
                      <li
                        class:list={{
                          inmediata: x.startsWith('Alergia'),
                          gluten: /Celiaqu|gluten/i.test(x),
                        }}
                      >
                        {x}
                      </li>
                    ))}
                  </ul>
                  <div class="pa-pie">
                    <span class="pa-precio">{usd(e.precio)}</span>
                    <div class="pa-botones">
                      <button
                        type="button"
                        class="comp-add"
                        aria-pressed="false"
                        data-add={productoDe(e)}
                        aria-label={`Agregar ${e.nombre}`}
                      >
                        <span class="no">Agregar</span>
                        <span class="si">✓</span>
                      </button>
                      <button type="button" class="comp-solo" data-solo={productoDe(e)}>
                        Comprar solo este
                      </button>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <ul class="filas" data-filas data-clave={CLAVE_SELECCION}>
      {
        grupos.flatMap((g, gi) =>
          g.items.map((e, i) => (
            <FilaCatalogo
              e={e}
              color={g.color}
              grupo={g.id}
              texto={textoBusqueda(e)}
              oculta={gi !== 0 || i >= VISIBLES}
              nombreGrupo={g.nombre}
              orden={i}
            />
          ))
        )
      }
    </ul>

    <!-- One view per symptom card below: its sub-groups, shown here when a card is chosen. -->
    {
      vistas.map((v) => (
        <div
          class="vista"
          data-vista-sintoma={v.id}
          hidden
          style={`--tono:var(--color-${v.color})`}
        >
          <div class="vista-cab">
            <span class="vista-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <path d={v.icono} />
              </svg>
            </span>
            <div>
              <p class="vista-eyebrow">Lo que te trae aquí</p>
              <h3 class="vista-t">{v.titulo}</h3>
              <p class="vista-e">{v.ejemplos}</p>
            </div>
            <button type="button" class="vista-cerrar" data-cerrar-vista>
              ← Ver todos los grupos
            </button>
          </div>
          {v.orientacion && (
            <div class="consulta">
              <div class="consulta-texto">
                <span class="consulta-tag">Empieza por una consulta</span>
                <p class="consulta-t">En tu caso, lo ideal es elegir con orientación.</p>
                <p>
                  En tu asesoría revisamos tus síntomas, antecedentes y objetivos para seleccionar
                  los estudios pertinentes.
                </p>
              </div>
              <div class="consulta-opciones">
                {listaCiclos.map((c) => (
                  <a
                    class:list={['opcion-c', { rec: c.id === 'INITIAL_LAYER_CYCLE' }]}
                    href={href(checkoutPath(c))}
                  >
                    {c.id === 'INITIAL_LAYER_CYCLE' && <span class="opcion-rec">Recomendada</span>}
                    <span class="opcion-citas">{c.consultas}</span>
                    <span class="opcion-nombre">{c.nombre}</span>
                    <span class="opcion-precio">{precioCard(c)}</span>
                    <span class="opcion-ir">Reservar →</span>
                  </a>
                ))}
              </div>
            </div>
          )}
          {v.orientacion && <p class="ya-sabes">Si ya sabes qué quieres explorar:</p>}
          {v.subgrupos.map((sg) => (
            <>
              <p class="sub-q">{sg.pregunta}</p>
              <ul class="filas">
                {sg.items.map((e) => (
                  <FilaCatalogo e={e} color={v.color} />
                ))}
              </ul>
            </>
          ))}
        </div>
      ))
    }
    <div class="ver-mas-caja">
      <button type="button" class="ver-mas" data-ver-mas data-visibles={VISIBLES} hidden></button>
    </div>
    <p class="vacio" data-vacio hidden>
      No encontramos ese examen. Prueba con otra palabra o explora por síntoma más abajo.
    </p>
  </div>
</section>

<style>
  .catalogo {
    padding: clamp(56px, 7vw, 96px) 0;
    background:
      radial-gradient(ellipse 50% 60% at 100% 0%, rgb(231 183 160 / 0.25), transparent 70%),
      radial-gradient(ellipse 50% 60% at 0% 100%, rgb(207 215 196 / 0.35), transparent 70%),
      var(--color-bone);
  }
  .cab h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.05;
    margin-top: 10px;
  }
  .buscador {
    position: relative;
    margin-top: 26px;
    max-width: 640px;
  }
  .buscador svg {
    position: absolute;
    left: 20px;
    top: 50%;
    translate: 0 -50%;
    fill: none;
    stroke: rgb(48 47 42 / 0.5);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .buscador input {
    width: 100%;
    font: inherit;
    font-size: 16px;
    padding: 17px 120px 17px 52px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(48 47 42 / 0.14);
    background: var(--color-white);
    box-shadow: 0 14px 30px -24px rgb(48 47 42 / 0.5);
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .buscador input:focus {
    border-color: var(--color-clay-deep);
    box-shadow: 0 0 0 4px rgb(231 183 160 / 0.3);
  }
  .contador {
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    font-size: 13px;
    font-weight: 700;
    color: rgb(48 47 42 / 0.55);
  }
  .pestanas {
    margin: 30px auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 1060px;
  }
  .pestanas[data-oculto] {
    display: none;
  }
  .pestana {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    padding: 13px 22px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(48 47 42 / 0.06);
    background: var(--color-white);
    color: var(--color-charcoal);
    box-shadow: 0 10px 24px -20px rgb(48 47 42 / 0.5);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      box-shadow 0.25s,
      transform 0.25s var(--ease-out-soft);
  }
  .pestana svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pestana:hover {
    transform: translateY(-2px);
  }
  .pestana.on {
    background: var(--color-charcoal);
    color: var(--color-bone);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--tono) 80%, white),
      0 14px 28px -18px rgb(48 47 42 / 0.6);
  }
  .cab {
    text-align: center;
  }
  .buscador {
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .pestanas {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      margin-inline: -16px;
      padding: 4px 16px 10px;
      scrollbar-width: none;
    }
    .pestanas::-webkit-scrollbar {
      display: none;
    }
    .pestana {
      flex-shrink: 0;
      padding: 11px 18px;
      font-size: 14px;
    }
    .grupo-cab {
      gap: 14px;
    }
    .grupo-ico {
      width: 56px;
      height: 56px;
      border-radius: 18px;
    }
  }
  .grupo-cab {
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .grupo-cab[hidden] {
    display: none;
  }
  .grupo-ico {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    border-radius: 22px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--tono) 35%, white);
    color: var(--color-charcoal);
  }
  .grupo-ico svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .grupo-t {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.05;
  }
  .grupo-d {
    margin: 6px 0 0;
    font-size: 16px;
    color: rgb(48 47 42 / 0.7);
  }
  .filas {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 20px;
  }
  .vista {
    margin-top: 18px;
    padding: clamp(20px, 3vw, 30px);
    border-radius: var(--radius-xl);
    background: rgb(255 255 255 / 0.6);
    border: 1px solid color-mix(in srgb, var(--tono) 55%, transparent);
    animation: vista-in 0.5s var(--ease-out-soft);
  }
  @keyframes vista-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .vista-cab {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: start;
  }
  .vista-ico {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--tono) 40%, white);
  }
  .vista-ico svg {
    fill: none;
    stroke: var(--color-charcoal);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .vista-eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-clay-deep);
    margin: 0;
  }
  .vista-t {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
    margin: 4px 0 6px;
  }
  .vista-e {
    font-size: 14.5px;
    color: rgb(48 47 42 / 0.65);
    margin: 0;
  }
  .vista-cerrar {
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(48 47 42 / 0.2);
    background: var(--color-white);
    cursor: pointer;
    white-space: nowrap;
  }
  .sub-q {
    margin: 22px 0 10px;
    font-weight: 700;
    font-size: 15px;
  }
  .sub-q::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tono);
    margin-right: 10px;
    vertical-align: middle;
  }
  .orientacion {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px 18px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--tono) 20%, white);
  }
  .orientacion p {
    flex: 1 1 300px;
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
  }
  @media (max-width: 640px) {
    .vista-cab {
      grid-template-columns: auto 1fr;
    }
    .vista-cerrar {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
  .ver-mas-caja {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }
  .ver-mas {
    font: inherit;
    font-size: 14.5px;
    font-weight: 800;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-charcoal);
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }
  .ver-mas:hover {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .ver-mas[hidden] {
    display: none;
  }

  /* ── Food panels: a guided choice ── */
  .comparador {
    margin-top: 26px;
  }
  .comparador[hidden] {
    display: none;
  }
  .guia-t {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.4vw, 30px);
    text-align: center;
  }
  .caminos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .camino {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    text-align: left;
    font: inherit;
    padding: 18px 18px 20px;
    border-radius: 22px;
    border: 1px solid rgb(48 47 42 / 0.08);
    background: var(--color-white);
    color: var(--color-charcoal);
    cursor: pointer;
    box-shadow: 0 14px 30px -26px rgb(48 47 42 / 0.5);
    transition:
      transform 0.3s var(--ease-out-soft),
      background 0.3s,
      color 0.3s;
  }
  .camino:hover {
    transform: translateY(-3px);
  }
  .camino.on {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .camino-n {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--color-clay-deep);
  }
  .camino.on .camino-n {
    color: var(--color-clay);
  }
  .camino-q {
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.7vw, 22px);
    line-height: 1.2;
  }
  .camino-panel[hidden] {
    display: none;
  }
  .camino-ayuda {
    margin: 22px 0 14px;
    text-align: center;
    font-size: 15.5px;
    color: rgb(48 47 42 / 0.7);
  }
  .paneles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }
  .pa {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 26px;
    background: var(--color-white);
    border: 1px solid rgb(48 47 42 / 0.06);
    box-shadow: 0 18px 40px -34px rgb(48 47 42 / 0.45);
    animation: pa-in 0.5s var(--ease-out-soft) both;
  }
  .pa:nth-child(2) {
    animation-delay: 0.06s;
  }
  .pa:nth-child(3) {
    animation-delay: 0.12s;
  }
  .pa:nth-child(4) {
    animation-delay: 0.18s;
  }
  @keyframes pa-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .pa:global(.elegido) {
    box-shadow:
      0 0 0 2px var(--color-sage-deep),
      0 18px 40px -34px rgb(48 47 42 / 0.45);
  }
  .pa-top {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .pa-nombre {
    all: unset;
    cursor: pointer;
    font-weight: 800;
    font-size: 15.5px;
    line-height: 1.3;
  }
  .pa-nombre:hover,
  .pa-nombre:focus-visible {
    color: var(--color-clay-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pa-top small {
    font-size: 12px;
    color: rgb(48 47 42 / 0.55);
  }
  .pa-cifra {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 8px;
  }
  .pa-cifra strong {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 46px;
    line-height: 1;
    color: var(--color-charcoal);
  }
  .pa-cifra .pa-esp {
    font-size: 26px;
    grid-column: 1 / -1;
  }
  .pa-cifra span {
    font-size: 13px;
    font-weight: 700;
    color: rgb(48 47 42 / 0.6);
  }
  .pa-barra {
    grid-column: 1 / -1;
    margin-top: 10px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: rgb(48 47 42 / 0.07);
    overflow: hidden;
  }
  .pa-barra span {
    display: block;
    height: 100%;
    width: calc(var(--w) * 100%);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-clay), var(--color-clay-rich));
    animation: barra 1.1s var(--ease-out-soft) both 0.15s;
  }
  @keyframes barra {
    from {
      width: 0;
    }
  }
  .pa-ver {
    all: unset;
    cursor: pointer;
    align-self: flex-start;
    order: 1;
    font-size: 13px;
    font-weight: 800;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(48 47 42 / 0.25);
    transition: border-color 0.2s;
  }
  .pa-ver:hover,
  .pa-ver:focus-visible {
    border-color: var(--color-charcoal);
  }
  .pa-pie {
    order: 2;
  }
  .pa-mide {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pa-mide li {
    font-size: 12.5px;
    font-weight: 700;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-sage) 45%, white);
  }
  .pa-mide li.inmediata {
    background: color-mix(in srgb, var(--color-rose) 55%, white);
  }
  .pa-mide li.gluten {
    background: color-mix(in srgb, var(--color-sand) 80%, white);
  }
  .pa-pie {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgb(48 47 42 / 0.07);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pa-precio {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    color: var(--color-clay-rich);
  }
  .pa-botones {
    display: flex;
    gap: 8px;
  }
  .comp-add,
  .comp-solo {
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    white-space: nowrap;
  }
  .comp-add {
    min-width: 86px;
    border: 1px solid rgb(48 47 42 / 0.16);
    background: color-mix(in srgb, var(--color-sage) 30%, white);
    color: var(--color-charcoal);
  }
  .comp-add .si,
  .comp-add[aria-pressed='true'] .no {
    display: none;
  }
  .comp-add[aria-pressed='true'] {
    background: var(--color-sage-deep);
  }
  .comp-add[aria-pressed='true'] .si {
    display: inline;
  }
  .comp-solo {
    border: 1px solid var(--color-charcoal);
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  @media (max-width: 900px) {
    .caminos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pa,
    .pa-barra span {
      animation: none;
    }
  }
  .filas[hidden] {
    display: none;
  }
  /* Cases where Verónica asks to start with a consultation: the two options right here. */
  .consulta {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    align-items: center;
    padding: clamp(20px, 3vw, 30px);
    border-radius: 24px;
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(214 154 124 / 0.3), transparent 60%),
      linear-gradient(160deg, #2b2a25, #1b1a17);
    color: var(--color-bone);
  }
  .consulta-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(231 183 160 / 0.6);
    color: var(--color-clay);
  }
  .consulta-t {
    margin: 12px 0 6px;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.15;
    color: var(--color-bone);
  }
  .consulta-texto p:not(.consulta-t) {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgb(248 246 241 / 0.75);
  }
  .consulta-opciones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .opcion-c {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 16px 16px;
    border-radius: 18px;
    border: 1px solid rgb(248 246 241 / 0.18);
    background: rgb(248 246 241 / 0.05);
    color: var(--color-bone);
    text-decoration: none;
    transition:
      transform 0.25s,
      border-color 0.25s;
  }
  .opcion-c:hover {
    transform: translateY(-3px);
    border-color: var(--color-clay);
  }
  .opcion-c.rec {
    border-color: var(--color-clay);
    background: rgb(231 183 160 / 0.12);
  }
  .opcion-rec {
    position: absolute;
    top: -10px;
    left: 14px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: var(--color-clay);
    color: var(--color-charcoal);
  }
  .opcion-citas {
    font-size: 12px;
    color: rgb(248 246 241 / 0.6);
  }
  .opcion-nombre {
    font-weight: 800;
    font-size: 14px;
    color: var(--color-clay);
  }
  .opcion-precio {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.1;
  }
  .opcion-ir {
    margin-top: 6px;
    font-size: 12.5px;
    font-weight: 800;
  }
  .ya-sabes {
    margin: 26px 0 0;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(48 47 42 / 0.55);
  }
  @media (max-width: 860px) {
    .consulta {
      grid-template-columns: 1fr;
    }
  }
  .vacio {
    margin-top: 18px;
    font-size: 15px;
    color: rgb(48 47 42 / 0.65);
  }
  @media (max-width: 640px) {
    .buscador input {
      padding-right: 20px;
    }
    .contador {
      display: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-catalogo]');
  if (raiz) {
    const pestanas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-grupo].pestana')];
    // Only the group rows: the symptom views have their own rows, always visible.
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-filas] [data-fila]')];
    const lista = raiz.querySelector<HTMLElement>('[data-filas]')!;
    const barra = raiz.querySelector<HTMLElement>('[data-pestanas]')!;
    const input = raiz.querySelector<HTMLInputElement>('[data-buscar]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    let grupo = pestanas[0]?.dataset.grupo ?? '';
    const cabs = [...raiz.querySelectorAll<HTMLElement>('[data-cab]')];

    // «Solo este»: the selection becomes just this test, then straight to the checkout.
    raiz.querySelectorAll<HTMLButtonElement>('[data-solo]').forEach((b) =>
      b.addEventListener('click', () => {
        try {
          localStorage.setItem(lista.dataset.clave!, JSON.stringify([b.dataset.solo]));
        } catch {
          // Storage blocked: the checkout will say the selection is empty.
        }
        location.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/checkout/examenes/`;
      })
    );

    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const comparador = raiz.querySelector<HTMLElement>('[data-comparador]')!;
    const verMas = raiz.querySelector<HTMLButtonElement>('[data-ver-mas]')!;
    const VISIBLES = Number(verMas.dataset.visibles);
    const abiertos = new Set<string>();
    let enVista = false;

    const pintar = () => {
      const q = norm(input.value.trim());
      const buscando = q.length > 0;
      const tabla = !buscando && !enVista && grupo === 'alimentos';
      let vistos = 0;
      let delGrupo = 0;
      filas.forEach((f) => {
        let ok: boolean;
        if (buscando) ok = f.dataset.texto!.includes(q);
        else if (tabla || f.dataset.grupo !== grupo) ok = false;
        else {
          delGrupo++;
          ok = abiertos.has(grupo) || Number(f.dataset.orden) < VISIBLES;
        }
        f.hidden = !ok;
        if (ok) vistos++;
      });
      comparador.hidden = !tabla;
      lista.toggleAttribute('data-buscando', buscando);
      cabs.forEach((c) => (c.hidden = buscando || enVista || c.dataset.cab !== grupo));
      barra.toggleAttribute('data-oculto', buscando || enVista);
      contador.hidden = !buscando;
      contador.textContent = `${vistos} ${vistos === 1 ? 'resultado' : 'resultados'}`;
      vacio.hidden = !(buscando && vistos === 0);
      const hayMas = !buscando && !tabla && !enVista && delGrupo > VISIBLES;
      verMas.hidden = !hayMas;
      if (hayMas)
        verMas.textContent = abiertos.has(grupo) ? 'Ver menos' : `Ver los ${delGrupo} exámenes`;
    };

    // Food panels: choosing a question shows only its panels.
    const caminos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-camino]')];
    const paneles = [...raiz.querySelectorAll<HTMLElement>('[data-camino-panel]')];
    caminos.forEach((c) =>
      c.addEventListener('click', () => {
        caminos.forEach((o) => {
          const on = o === c;
          o.classList.toggle('on', on);
          o.setAttribute('aria-selected', String(on));
        });
        paneles.forEach((p) => (p.hidden = p.dataset.caminoPanel !== c.dataset.camino));
      })
    );

    verMas.addEventListener('click', () => {
      if (abiertos.has(grupo)) abiertos.delete(grupo);
      else abiertos.add(grupo);
      pintar();
    });

    const vistas = [...raiz.querySelectorAll<HTMLElement>('[data-vista-sintoma]')];
    const buscador = raiz.querySelector<HTMLElement>('.buscador')!;
    const verVista = (id: string | null) => {
      vistas.forEach((v) => (v.hidden = v.dataset.vistaSintoma !== id));
      enVista = !!id;
      if (enVista) input.value = '';
      lista.hidden = enVista;
      buscador.hidden = enVista;
      raiz.querySelector<HTMLElement>('.cab')!.hidden = enVista;
      pintar();
    };
    // A symptom card below sends its id here: show that view and bring the catalogue into sight.
    window.addEventListener('vw:sintoma', (ev) => {
      verVista((ev as CustomEvent<string>).detail);
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      raiz.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
    });
    raiz
      .querySelectorAll('[data-cerrar-vista]')
      .forEach((b) => b.addEventListener('click', () => verVista(null)));

    pestanas.forEach((p) =>
      p.addEventListener('click', () => {
        grupo = p.dataset.grupo!;
        pestanas.forEach((o) => {
          const on = o === p;
          o.classList.toggle('on', on);
          o.setAttribute('aria-selected', String(on));
        });
        p.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        pintar();
      })
    );
    input.addEventListener('input', pintar);
    pintar();
  }
</script>
