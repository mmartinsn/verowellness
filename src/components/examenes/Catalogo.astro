---
/**
 * The full catalogue by group, as in Verónica's price list (change 36): one group at a time behind
 * pill tabs so the page stays short, and a search box over every test (change 37). On a light
 * ground, to lighten the page (her note: «se vuelve muy oscura»). Each row opens the test's fact
 * sheet and has the same «Agregar» as the symptom section; both live in PorSintoma's script, which
 * listens page-wide.
 */
import { areas, examenes, muestras, productoDe } from '../../data/examenes';
import { usd } from '../../lib/precio';

const grupos = areas
  .map((a) => ({ ...a, items: examenes.filter((e) => e.area === a.id) }))
  .filter((g) => g.items.length > 0);

const textoBusqueda = (e: (typeof examenes)[number]) =>
  [e.nombre, e.laboratorio ?? '', e.descripcion, ...e.muestras.map((m) => muestras[m])]
    .join(' ')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');
---

<section class="catalogo" id="catalogo" data-catalogo>
  <div class="wrap">
    <div class="cab reveal">
      <span class="eyebrow">Catálogo completo</span>
      <h2>Exámenes por grupo</h2>
    </div>

    <div class="buscador reveal">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg
      >
      <input
        type="search"
        placeholder="Busca un examen por nombre, laboratorio o lo que mide"
        aria-label="Buscar un examen"
        data-buscar
        autocomplete="off"
      />
      <span class="contador" data-contador hidden></span>
    </div>

    <div class="pestanas" role="tablist" aria-label="Grupos de exámenes" data-pestanas>
      {
        grupos.map((g, i) => (
          <button
            type="button"
            role="tab"
            class:list={['pestana', { on: i === 0 }]}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-grupo={g.id}
            style={`--tono:var(--color-${g.color})`}
          >
            {g.nombre}
            <span class="n">{g.items.length}</span>
          </button>
        ))
      }
    </div>

    <ul class="filas" data-filas>
      {
        grupos.flatMap((g, gi) =>
          g.items.map((e) => (
            <li
              class="fila"
              data-fila
              data-grupo={g.id}
              data-texto={textoBusqueda(e)}
              hidden={gi !== 0}
              style={`--tono:var(--color-${g.color})`}
            >
              <button type="button" class="f-nombre" data-ficha={e.id}>
                <span class="f-t">{e.nombre}</span>
                <span class="f-meta">
                  {[e.laboratorio, e.muestras.map((m) => muestras[m]).join(' · ')]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </button>
              <span class="f-grupo">{g.nombre}</span>
              <span class="f-precio">{usd(e.precio)}</span>
              <button
                type="button"
                class="f-add"
                aria-pressed="false"
                data-add={productoDe(e)}
                aria-label={`Agregar ${e.nombre}`}
              >
                <span class="no">Agregar</span>
                <span class="si">✓</span>
              </button>
            </li>
          ))
        )
      }
    </ul>
    <p class="vacio" data-vacio hidden>
      No encontramos ese examen. Prueba con otra palabra o explora por síntoma más abajo.
    </p>
  </div>
</section>

<style>
  .catalogo {
    padding: clamp(56px, 7vw, 96px) 0;
    background:
      radial-gradient(ellipse 50% 60% at 100% 0%, rgb(231 183 160 / 0.25), transparent 70%),
      radial-gradient(ellipse 50% 60% at 0% 100%, rgb(207 215 196 / 0.35), transparent 70%),
      var(--color-bone);
  }
  .cab h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.05;
    margin-top: 10px;
  }
  .buscador {
    position: relative;
    margin-top: 26px;
    max-width: 640px;
  }
  .buscador svg {
    position: absolute;
    left: 20px;
    top: 50%;
    translate: 0 -50%;
    fill: none;
    stroke: rgb(48 47 42 / 0.5);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .buscador input {
    width: 100%;
    font: inherit;
    font-size: 16px;
    padding: 17px 120px 17px 52px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(48 47 42 / 0.14);
    background: var(--color-white);
    box-shadow: 0 14px 30px -24px rgb(48 47 42 / 0.5);
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .buscador input:focus {
    border-color: var(--color-clay-deep);
    box-shadow: 0 0 0 4px rgb(231 183 160 / 0.3);
  }
  .contador {
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    font-size: 13px;
    font-weight: 700;
    color: rgb(48 47 42 / 0.55);
  }
  .pestanas {
    margin-top: 22px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .pestanas[data-oculto] {
    display: none;
  }
  .pestana {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(48 47 42 / 0.12);
    background: var(--color-white);
    color: var(--color-charcoal);
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .pestana .n {
    font-size: 11.5px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tono) 30%, transparent);
  }
  .pestana:hover {
    border-color: var(--tono);
  }
  .pestana.on {
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
    color: var(--color-bone);
  }
  .pestana.on .n {
    background: var(--tono);
    color: var(--color-charcoal);
  }
  .filas {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .fila {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    align-items: center;
    gap: 18px;
    padding: 14px 14px 14px 22px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.85);
    border: 1px solid rgb(48 47 42 / 0.07);
    border-left: 4px solid var(--tono);
    transition:
      transform 0.25s var(--ease-out-soft),
      box-shadow 0.25s;
  }
  .fila[hidden] {
    display: none;
  }
  .fila:hover {
    transform: translateX(4px);
    box-shadow: 0 14px 30px -24px rgb(48 47 42 / 0.5);
  }
  .fila.elegido {
    background: color-mix(in srgb, var(--color-sage) 40%, white);
  }
  .f-nombre {
    all: unset;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .f-t {
    font-weight: 700;
    font-size: 15.5px;
    color: var(--color-charcoal);
  }
  .f-nombre:hover .f-t,
  .f-nombre:focus-visible .f-t {
    color: var(--color-clay-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .f-meta {
    font-size: 12.5px;
    color: rgb(48 47 42 / 0.55);
  }
  .f-grupo {
    display: none;
    font-size: 12px;
    font-weight: 700;
    color: rgb(48 47 42 / 0.6);
  }
  .filas[data-buscando] .f-grupo {
    display: inline;
  }
  .f-precio {
    font-weight: 800;
    font-size: 16px;
    color: var(--color-charcoal);
    font-variant-numeric: tabular-nums;
  }
  .f-add {
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    min-width: 96px;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-charcoal);
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
    transition: background 0.2s;
  }
  .f-add:hover {
    background: rgb(48 47 42 / 0.06);
  }
  .f-add .si,
  .f-add[aria-pressed='true'] .no {
    display: none;
  }
  .f-add[aria-pressed='true'] {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .f-add[aria-pressed='true'] .si {
    display: inline;
  }
  .vacio {
    margin-top: 18px;
    font-size: 15px;
    color: rgb(48 47 42 / 0.65);
  }
  @media (max-width: 640px) {
    .fila {
      grid-template-columns: 1fr auto;
      gap: 10px 14px;
    }
    .f-grupo {
      grid-column: 1 / -1;
      order: -1;
    }
    .f-precio {
      grid-column: 1;
    }
    .buscador input {
      padding-right: 20px;
    }
    .contador {
      display: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-catalogo]');
  if (raiz) {
    const pestanas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-grupo].pestana')];
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-fila]')];
    const lista = raiz.querySelector<HTMLElement>('[data-filas]')!;
    const barra = raiz.querySelector<HTMLElement>('[data-pestanas]')!;
    const input = raiz.querySelector<HTMLInputElement>('[data-buscar]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    let grupo = pestanas[0]?.dataset.grupo ?? '';

    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const pintar = () => {
      const q = norm(input.value.trim());
      const buscando = q.length > 0;
      let vistos = 0;
      filas.forEach((f) => {
        const ok = buscando ? f.dataset.texto!.includes(q) : f.dataset.grupo === grupo;
        f.hidden = !ok;
        if (ok) vistos++;
      });
      lista.toggleAttribute('data-buscando', buscando);
      barra.toggleAttribute('data-oculto', buscando);
      contador.hidden = !buscando;
      contador.textContent = `${vistos} ${vistos === 1 ? 'resultado' : 'resultados'}`;
      vacio.hidden = !(buscando && vistos === 0);
    };

    pestanas.forEach((p) =>
      p.addEventListener('click', () => {
        grupo = p.dataset.grupo!;
        pestanas.forEach((o) => {
          const on = o === p;
          o.classList.toggle('on', on);
          o.setAttribute('aria-selected', String(on));
        });
        pintar();
      })
    );
    input.addEventListener('input', pintar);
  }
</script>
