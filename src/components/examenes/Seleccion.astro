---
import { examenes, productoDe, CLAVE_SELECCION } from '../../data/examenes';
import { href } from '../../lib/url';

const precios = Object.fromEntries(examenes.map((e) => [productoDe(e), e.precio]));
---

<div
  class="dock"
  data-dock
  data-clave={CLAVE_SELECCION}
  data-precios={JSON.stringify(precios)}
  hidden
>
  <span class="dock-n"><strong data-dock-n>0</strong> <span data-dock-palabra>exámenes</span></span>
  <span class="dock-total" data-dock-total>$0.00</span>
  <a class="dock-btn" href={href('/checkout/examenes')}>Continuar →</a>
</div>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 10px 10px 24px;
    border-radius: var(--radius-pill);
    background: rgb(35 34 30 / 0.92);
    border: 1px solid rgb(214 154 124 / 0.45);
    box-shadow: 0 20px 40px -12px rgb(35 34 30 / 0.5);
    backdrop-filter: blur(12px);
    color: var(--color-bone);
    animation: dock-in 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .dock[hidden] {
    display: none;
  }
  @keyframes dock-in {
    from {
      opacity: 0;
      translate: -50% 20px;
    }
  }
  .dock-n {
    font-size: 14px;
  }
  .dock-total {
    font-family: var(--font-serif);
    font-size: 22px;
  }
  .dock-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f0c4ae, var(--color-clay-deep));
    color: var(--color-charcoal);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dock.bump {
    animation: dock-bump 0.4s ease;
  }
  @keyframes dock-bump {
    40% {
      scale: 1.05;
    }
  }
  @media (max-width: 640px) {
    .dock {
      left: 12px;
      right: 12px;
      translate: none;
      justify-content: space-between;
    }
    @keyframes dock-in {
      from {
        opacity: 0;
        translate: 0 20px;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock {
      animation: none;
    }
  }
</style>

<script>
  import { usd } from '../../lib/precio';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const CLAVE = dock.dataset.clave!;
    const precios: Record<string, number> = JSON.parse(dock.dataset.precios ?? '{}');

    const leer = (): string[] => {
      try {
        const v = JSON.parse(localStorage.getItem(CLAVE) ?? '[]');
        return Array.isArray(v) ? v.filter((id) => id in precios) : [];
      } catch {
        return [];
      }
    };
    const sel = new Set<string>(leer());
    const guardar = () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify([...sel]));
      } catch {
        return;
      }
    };

    const pintar = (bump = false) => {
      document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => {
        const on = sel.has(b.dataset.add!);
        b.setAttribute('aria-pressed', String(on));
        b.closest('[data-item]')?.classList.toggle('elegido', on);
      });
      const n = sel.size;
      const total = [...sel].reduce((s, id) => s + (precios[id] ?? 0), 0);
      dock.hidden = n === 0;
      dock.querySelector('[data-dock-n]')!.textContent = String(n);
      dock.querySelector('[data-dock-palabra]')!.textContent = n === 1 ? 'examen' : 'exámenes';
      dock.querySelector('[data-dock-total]')!.textContent = usd(total);
      if (bump) {
        dock.classList.remove('bump');
        void dock.offsetWidth;
        dock.classList.add('bump');
      }
    };

    document.addEventListener('click', (ev) => {
      const boton = (ev.target as Element).closest<HTMLButtonElement>('[data-add]');
      const id = boton?.dataset.add;
      if (!id) return;
      if (sel.has(id)) sel.delete(id);
      else sel.add(id);
      guardar();
      pintar(true);
    });
    document.addEventListener('vw:seleccion-pintar', () => pintar());
    pintar();
  }
</script>
