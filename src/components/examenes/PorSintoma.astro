---
import { sintomas, cierre, examenesDe, opcionesDe } from '../../data/sintomas';
import { href } from '../../lib/url';
import FilaExamen from './FilaExamen.astro';
---

<section class="ps" id="sintomas" data-por-sintoma aria-labelledby="ps-titulo">
  <div class="ps-luz" aria-hidden="true"></div>
  <div class="wrap">
    <div class="ps-cab reveal">
      <span class="eyebrow">Por lo que sientes</span>
      <h2 id="ps-titulo" class="ps-h2">¿No sabes qué examen podrías necesitar?</h2>
      <div class="ps-intro">
        <p class="ps-lede">
          ¿Qué se parece más a lo que sientes o buscas? Explora las categorías para conocer las
          opciones disponibles.
        </p>
        <p>
          Si te identificas con varias, podemos ayudarte a priorizar según tus síntomas,
          antecedentes y objetivos durante tu asesoría.
        </p>
      </div>
    </div>
    <p class="ps-nota">
      Los grupos siguientes organizan las opciones disponibles. La selección de un examen se
      individualiza según tus síntomas, antecedentes y objetivos.
    </p>

    <ol class="ps-grid reveal-stagger">
      {
        sintomas.map((s) => (
          <li>
            <button
              type="button"
              class="sint"
              data-abrir={s.id}
              aria-haspopup="dialog"
              style={`--tono:var(--color-${s.color})`}
            >
              <span class="sint-top">
                <span class="sint-num">{s.num}</span>
                <span class="sint-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22">
                    <path d={s.icono} />
                  </svg>
                </span>
              </span>
              <span class="sint-t">{s.titulo}</span>
              <span class="sint-d">{s.descripcion}</span>
              <span class="sint-btn">
                Explorar exámenes <span aria-hidden="true">→</span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <dialog class="panel" data-panel-dialog aria-label="Exámenes por síntoma">
    <div class="panel-caja">
      <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
          ><path d="M6 6l12 12M18 6L6 18"></path></svg
        >
      </button>
      {
        sintomas.map((s) => (
          <article
            class="panel-s"
            data-panel={s.id}
            hidden
            style={`--tono:var(--color-${s.color})`}
          >
            <header class="panel-cab">
              <span class="panel-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26">
                  <path d={s.icono} />
                </svg>
              </span>
              <p class="panel-num">
                {s.num} · {opcionesDe(s)} {opcionesDe(s) === 1 ? 'opción' : 'opciones'}
              </p>
              <h3 class="panel-t">{s.titulo}</h3>
              <p class="panel-d">{s.descripcion}</p>
            </header>
            {s.orientacionPrimero && (
              <div class="guia destacada">
                <p>
                  En tu caso, lo ideal es elegir con orientación: en tu asesoría revisamos tus
                  síntomas, antecedentes y objetivos para seleccionar los estudios pertinentes.
                </p>
                <a class="guia-btn" href={href('/asesorias')}>
                  Pide orientación en tu asesoría
                </a>
              </div>
            )}
            {s.subcategorias.map((sub) => (
              <div class="sub">
                <h4 class="sub-p">{sub.pregunta}</h4>
                {cierre(sub) && <p class="sub-c">{cierre(sub)}</p>}
                <div class="sub-lista">
                  {examenesDe(sub).map((e) => (
                    <FilaExamen examen={e} />
                  ))}
                </div>
              </div>
            ))}
            {!s.orientacionPrimero && (
              <div class="guia">
                <p>¿No sabes cuál elegir? Podemos ayudarte a priorizar durante tu asesoría.</p>
                <a class="guia-btn" href={href('/asesorias')}>
                  Pide ayuda para elegir
                </a>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </dialog>
</section>

<style>
  .ps {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 8vw, 110px) 0;
    background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-sand-light) 100%);
    scroll-margin-top: 70px;
  }
  .ps-luz {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 40% 35% at 90% 8%, rgb(207 215 196 / 0.55), transparent 70%),
      radial-gradient(ellipse 35% 30% at 4% 70%, rgb(231 183 160 / 0.45), transparent 70%),
      radial-gradient(ellipse 30% 25% at 60% 100%, rgb(226 183 178 / 0.4), transparent 70%);
  }
  .ps .wrap {
    position: relative;
  }
  .ps .eyebrow {
    color: var(--color-clay-rich);
  }
  .ps-cab {
    display: grid;
    gap: 16px 56px;
  }
  @media (min-width: 960px) {
    .ps-cab {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: end;
    }
    .ps-cab .eyebrow {
      grid-column: 1 / -1;
    }
  }
  .ps-h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 1.02;
  }
  .ps-intro {
    display: grid;
    gap: 10px;
    font-size: 16px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.72);
  }
  .ps-lede {
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: 600;
    color: var(--color-charcoal);
  }
  .ps-nota {
    margin-top: 28px;
    padding-left: 14px;
    border-left: 3px solid var(--color-clay);
    font-size: 14px;
    line-height: 1.55;
    color: rgb(35 34 30 / 0.62);
    max-width: 760px;
  }
  .ps-grid {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  @media (min-width: 760px) {
    .ps-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }
  @media (min-width: 1120px) {
    .ps-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .ps-grid li {
    display: flex;
  }
  .sint {
    all: unset;
    box-sizing: border-box;
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px 16px;
    border-radius: 20px;
    background: rgb(255 255 255 / 0.78);
    border: 1px solid rgb(35 34 30 / 0.08);
    box-shadow: 0 14px 30px -26px rgb(35 34 30 / 0.5);
    cursor: pointer;
    overflow: hidden;
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.45s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sint::after {
    content: '';
    position: absolute;
    inset: auto -30% -55% auto;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--tono), transparent 70%);
    opacity: 0.18;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .sint:hover {
    background: color-mix(in srgb, var(--tono) 16%, var(--color-white));
    border-color: color-mix(in srgb, var(--tono) 60%, transparent);
    box-shadow: 0 22px 40px -26px color-mix(in srgb, var(--tono) 80%, rgb(35 34 30 / 0.6));
    transform: translateY(-4px);
  }
  .sint:hover::after {
    opacity: 0.4;
  }
  .sint:focus-visible {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 3px;
  }
  .sint-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sint-num {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1;
    color: color-mix(in srgb, var(--tono) 55%, var(--color-charcoal));
  }
  .sint-ico {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tono) 30%, var(--color-white));
    color: color-mix(in srgb, var(--tono) 45%, var(--color-charcoal));
    transition: transform 0.45s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sint:hover .sint-ico {
    transform: rotate(-6deg) scale(1.06);
  }
  .sint-ico svg,
  .panel-ico svg,
  .panel-cerrar svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sint-t {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(19px, 1.5vw, 22px);
    line-height: 1.12;
    color: var(--color-charcoal);
  }
  .sint-d {
    font-size: 13px;
    line-height: 1.45;
    color: rgb(35 34 30 / 0.62);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sint-btn {
    margin-top: auto;
    padding-top: 4px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tono) 50%, var(--color-charcoal));
  }
  @media (max-width: 640px) {
    .sint {
      padding: 14px 14px 12px;
      gap: 8px;
    }
    .sint-t {
      font-size: 17px;
    }
    .sint-d {
      display: none;
    }
    .sint-ico {
      width: 36px;
      height: 36px;
    }
  }

  .panel {
    margin: 0 0 0 auto;
    width: min(680px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-bone);
    color: var(--color-charcoal);
    box-shadow: -30px 0 80px -30px rgb(35 34 30 / 0.5);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .panel::backdrop {
    background: rgb(35 34 30 / 0.4);
    backdrop-filter: blur(2px);
  }
  .panel[open] {
    animation: panel-in 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  @keyframes panel-in {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }
  .panel-caja {
    position: relative;
    padding: clamp(24px, 4vw, 44px) clamp(18px, 4vw, 40px) 120px;
  }
  .panel-cerrar {
    all: unset;
    position: sticky;
    top: 0;
    float: right;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    cursor: pointer;
    background: var(--color-white);
    box-shadow: 0 8px 20px -12px rgb(35 34 30 / 0.5);
  }
  .panel-cerrar:focus-visible,
  .guia-btn:focus-visible {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 2px;
  }
  .panel-s[hidden] {
    display: none;
  }
  .panel-cab {
    padding-bottom: 22px;
    border-bottom: 1px solid rgb(35 34 30 / 0.1);
  }
  .panel-ico {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--tono) 32%, var(--color-white));
    color: color-mix(in srgb, var(--tono) 45%, var(--color-charcoal));
  }
  .panel-num {
    margin-top: 16px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tono) 50%, var(--color-charcoal));
  }
  .panel-t {
    margin-top: 6px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.05;
  }
  .panel-d {
    margin-top: 10px;
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.72);
  }
  .sub {
    margin-top: 28px;
  }
  .sub-p {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(21px, 2vw, 24px);
    line-height: 1.2;
  }
  .sub-c {
    margin-top: 4px;
    font-size: 13.5px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.55);
  }
  .sub-lista {
    margin-top: 12px;
    display: grid;
    gap: 10px;
  }
  .guia {
    margin-top: 32px;
    padding: 20px 22px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-sage) 45%, var(--color-white));
    display: grid;
    gap: 12px;
    justify-items: start;
    font-size: 15px;
    line-height: 1.55;
  }
  .guia.destacada {
    margin-top: 24px;
    background: color-mix(in srgb, var(--color-clay) 40%, var(--color-white));
    border: 1px solid var(--color-clay-deep);
  }
  .guia-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .panel[open] {
      animation: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-por-sintoma]');
  const dialogo = raiz?.querySelector<HTMLDialogElement>('[data-panel-dialog]');
  if (raiz && dialogo) {
    const paneles = [...dialogo.querySelectorAll<HTMLElement>('[data-panel]')];
    let origen: HTMLElement | null = null;

    raiz.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.abrir!;
        paneles.forEach((p) => (p.hidden = p.dataset.panel !== id));
        const titulo = paneles
          .find((p) => p.dataset.panel === id)
          ?.querySelector('h3')?.textContent;
        dialogo.setAttribute('aria-label', titulo ?? 'Exámenes por síntoma');
        origen = b;
        dialogo.showModal();
        dialogo.scrollTop = 0;
      })
    );
    dialogo.querySelector('[data-cerrar]')!.addEventListener('click', () => dialogo.close());
    dialogo.addEventListener('click', (ev) => {
      if (ev.target === dialogo) dialogo.close();
    });
    dialogo.addEventListener('close', () => origen?.focus());
  }
</script>
