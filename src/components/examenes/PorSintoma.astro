---
/**
 * Exámenes por síntoma — the page's body under HeroLupa (Mari, 2026-09-24). A dark ground that
 * breaks from the rest of the site; the visitor starts from what she feels: ten symptom cards, and under
 * them the tests for the chosen one, each led by who it is for (its «Útil si…» line), then its
 * sample, price and an «Agregar» toggle. The selection is kept in localStorage under
 * `CLAVE_SELECCION` (the same list the checkout reads) and summed in a floating dock.
 *
 * Groups: data/sintomas. Tests, prices and descriptions: data/examenes (Verónica's price list).
 */
import { examenes, muestras, productoDe, CLAVE_SELECCION } from '../../data/examenes';
import { sintomas, examenesDe, totalExamenes } from '../../data/sintomas';
import { usd } from '../../lib/precio';
import { fichas } from '../../data/fichas-examenes';
import { href } from '../../lib/url';

const grupos = sintomas.map((s) => ({
  ...s,
  total: totalExamenes(s),
  subgrupos: s.grupos.map((g) => ({ pregunta: g.pregunta, items: examenesDe(g) })),
}));
const precios = Object.fromEntries(examenes.map((e) => [productoDe(e), e.precio]));

/* What the popup needs per test, sent once as JSON (tests repeat across symptoms). */
const datosFichas = Object.fromEntries(
  examenes.map((e) => [
    e.id,
    {
      nombre: e.nombre,
      laboratorio: e.laboratorio ?? '',
      precio: usd(e.precio),
      producto: productoDe(e),
      muestras: e.muestras.map((m) => muestras[m]),
      enCasa: e.enCasa,
      ...fichas[e.id],
    },
  ])
);
---

<section
  class="ps"
  id="sintomas"
  data-por-sintoma
  data-clave={CLAVE_SELECCION}
  data-precios={JSON.stringify(precios)}
>
  <div class="ps-aurora" aria-hidden="true"></div>

  <!-- The fifteen symptoms and interests (Verónica, change 38) -->
  <div class="wrap ps-cab">
    <h2 class="ps-titulo">¿No sabes qué examen podrías necesitar?</h2>
    <p class="ps-pregunta">
      ¿Qué se parece más a lo que sientes o buscas? Explora las categorías para conocer las opciones
      disponibles.
    </p>
    <p class="ps-ayuda">
      Si te identificas con varias, podemos ayudarte a priorizar según tus síntomas, antecedentes y
      objetivos durante tu asesoría.
    </p>
  </div>
  <div class="wrap carrusel" data-carrusel>
    <button type="button" class="flecha izq" data-mover="-1" aria-label="Ver síntomas anteriores">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><path d="M15 5l-7 7 7 7"></path></svg
      >
    </button>
    <button type="button" class="flecha der" data-mover="1" aria-label="Ver más síntomas">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><path d="M9 5l7 7-7 7"></path></svg
      >
    </button>
    <div class="ps-sintomas" role="list" aria-label="Elige lo que sientes o buscas">
      {
        grupos.map((g, i) => (
          <button
            type="button"
            role="listitem"
            class="sint"
            data-sintoma={g.id}
            style={`--tono:var(--color-${g.color});--i:${i}`}
          >
            <span class="sint-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24">
                <path d={g.icono} />
              </svg>
            </span>
            <span class="sint-t">{g.titulo}</span>
            <span class="sint-e">{g.ejemplos}</span>
            <span class="sint-c">Explorar exámenes →</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="wrap">
    <p class="ps-nota">
      ¿Tienes dudas sobre cuál elegir? En tu <a href={href('/asesorias')}>asesoría</a> revisamos juntas
      si necesitas un examen y cuál tiene sentido para ti. Los impuestos se calculan al finalizar la compra.
    </p>
  </div>

  <!-- The selection -->
  <div class="dock" data-dock hidden>
    <span class="dock-n"
      ><strong data-dock-n>0</strong> <span data-dock-palabra>exámenes</span></span
    >
    <span class="dock-total" data-dock-total>$0.00</span>
    <a class="dock-btn" href={href('/checkout/examenes')}>Continuar →</a>
  </div>
  <!-- One popup for every test, filled from data-fichas when a test is opened. -->
  <dialog
    class="ficha"
    data-ficha-dialog
    aria-labelledby="ficha-nombre"
    data-fichas={JSON.stringify(datosFichas)}
  >
    <div class="ficha-panel">
      <div class="ficha-glow" aria-hidden="true"></div>
      <button type="button" class="ficha-cerrar" data-ficha-cerrar aria-label="Cerrar">×</button>
      <header class="ficha-cab">
        <p class="ficha-lab" data-f="laboratorio"></p>
        <h2 class="ficha-nombre" id="ficha-nombre" data-f="nombre"></h2>
        <p class="ficha-gancho" data-f="gancho"></p>
        <div class="ficha-compra">
          <div>
            <span class="ficha-precio" data-f="precio"></span>
            <span class="ficha-muestra" data-f="muestra"></span>
          </div>
          <button type="button" class="ficha-add" data-ficha-add aria-pressed="false">
            <span class="ex-add-no">Agregar a mi selección</span>
            <span class="ex-add-si">Agregado ✓</span>
          </button>
        </div>
      </header>
      <div class="ficha-cuerpo">
        <section class="ficha-bloque">
          <h3 class="ficha-t">Qué mide</h3>
          <ul class="ficha-mide" data-lista="queMide"></ul>
        </section>
        <blockquote class="ficha-importa">
          <span class="ficha-t">Por qué importa</span>
          <p data-f="porQueImporta"></p>
        </blockquote>
        <div class="ficha-dos">
          <section class="ficha-bloque">
            <h3 class="ficha-t">Ideal si…</h3>
            <ul class="ficha-check" data-lista="ideal"></ul>
          </section>
          <section class="ficha-bloque">
            <h3 class="ficha-t">Lo que obtienes</h3>
            <ul class="ficha-check" data-lista="obtienes"></ul>
          </section>
        </div>
        <p class="ficha-nota">
          Contenido educativo. No diagnostica ni sustituye una evaluación médica; en tu asesoría
          revisamos si este examen tiene sentido para ti.
        </p>
      </div>
    </div>
  </dialog>
</section>

<style>
  /* ── The dark ground ── */
  .ps {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 6vw, 80px) 0 clamp(80px, 9vw, 120px);
    scroll-margin-top: 70px;
    background:
      radial-gradient(ellipse 60% 40% at 85% 0%, rgb(207 215 196 / 0.12), transparent 70%),
      radial-gradient(ellipse 55% 35% at 0% 30%, rgb(214 154 124 / 0.12), transparent 70%),
      linear-gradient(180deg, #1b1a17 0%, #20221d 55%, #1a1916 100%);
    color: var(--color-bone);
  }
  .ps-aurora {
    position: absolute;
    width: 700px;
    height: 700px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(214 154 124 / 0.18), transparent 65%);
    filter: blur(20px);
    animation: ps-aurora 20s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes ps-aurora {
    to {
      transform: translate(-80px, 60px) scale(1.15);
    }
  }
  .ps .eyebrow {
    color: var(--color-clay);
  }

  .ps-cab {
    position: relative;
  }
  .ps-titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1.05;
    color: var(--color-bone);
    max-width: 820px;
  }
  .ps-pregunta {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.3;
    color: var(--color-clay);
    max-width: 760px;
  }
  .ps-ayuda {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: rgb(248 246 241 / 0.62);
    max-width: 720px;
  }
  /* ── The symptom carousel: one row that slides sideways, arrows at the sides ── */
  .carrusel {
    position: relative;
    margin-top: 22px;
  }
  .ps-sintomas {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: 2px;
    padding: 10px 4px 34px;
    margin-bottom: -24px;
    scrollbar-width: none;
    /* the edges fade, hinting that more cards follow */
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .ps-sintomas::-webkit-scrollbar {
    display: none;
  }
  .carrusel.al-inicio .ps-sintomas {
    mask-image: linear-gradient(90deg, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 96%, transparent);
  }
  .carrusel.al-final .ps-sintomas {
    mask-image: linear-gradient(90deg, transparent, #000 4%);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%);
  }
  .flecha {
    all: unset;
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    translate: 0 -50%;
    background: rgb(27 26 23 / 0.9);
    border: 1px solid rgb(248 246 241 / 0.25);
    color: var(--color-bone);
    cursor: pointer;
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.6);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease,
      scale 0.3s ease;
  }
  .flecha svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flecha:hover {
    background: var(--color-clay);
    border-color: var(--color-clay);
    color: #1b1a17;
    scale: 1.06;
  }
  .flecha:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 3px;
  }
  .flecha.izq {
    left: -8px;
  }
  .flecha.der {
    right: -8px;
  }
  .flecha:disabled,
  .flecha[disabled] {
    opacity: 0;
    pointer-events: none;
  }
  @media (min-width: 1360px) {
    .flecha.izq {
      left: -64px;
    }
    .flecha.der {
      right: -64px;
    }
  }
  .sint {
    all: unset;
    flex: 0 0 clamp(230px, 22vw, 272px);
    scroll-snap-align: start;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 18px;
    border-radius: 20px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(248 246 241 / 0.1);
    cursor: pointer;
    overflow: hidden;
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      transform 0.45s cubic-bezier(0.19, 1, 0.22, 1);
    animation: sint-in 0.8s cubic-bezier(0.19, 1, 0.22, 1) calc(var(--i) * 0.05s) backwards;
  }
  @keyframes sint-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .sint::before {
    /* the symptom's colour, as a soft glow from the corner */
    content: '';
    position: absolute;
    inset: auto -40% -60% auto;
    width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--tono), transparent 70%);
    opacity: 0.16;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  /* Pointing at a card lights it with its symptom's tint — the chosen card's look
     (Mari, 2026-09-24: «que pase cuando se pasa el cursor, no solo cuando se hace clic»). */
  .sint:hover,
  .sint.on {
    background: color-mix(in srgb, var(--tono) 22%, #1b1a17);
    border-color: var(--tono);
  }
  .sint:hover {
    transform: translateY(-3px);
  }
  .sint:hover::before {
    opacity: 0.45;
  }
  .sint:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 3px;
  }
  /* The chosen one keeps the lit look, plus a soft halo, a slight lift and its icon filled. */
  .sint.on {
    box-shadow:
      0 0 0 1px var(--tono),
      0 18px 40px -18px color-mix(in srgb, var(--tono) 70%, transparent);
    transform: translateY(-4px);
  }
  .sint.on::before {
    opacity: 0.7;
  }
  .sint-ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tono) 18%, transparent);
    color: var(--tono);
    transition:
      background 0.35s ease,
      color 0.35s ease,
      transform 0.45s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sint-ico svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sint:hover .sint-ico {
    transform: rotate(-6deg) scale(1.06);
  }
  .sint.on .sint-ico {
    background: var(--tono);
    color: #1b1a17;
  }
  .sint-t {
    font-family: var(--font-serif);
    font-size: clamp(21px, 1.8vw, 25px);
    line-height: 1.12;
    color: var(--color-bone);
  }
  .sint-e {
    font-size: 13px;
    line-height: 1.45;
    color: rgb(248 246 241 / 0.6);
  }
  .sint-c {
    margin-top: auto;
    padding-top: 6px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tono);
  }

  /* ── Results ── */
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ex {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 40px;
    padding: 26px 0;
    border-bottom: 1px solid rgb(248 246 241 / 0.1);
    transition: background 0.3s ease;
  }
  @media (min-width: 820px) {
    .ex {
      grid-template-columns: minmax(0, 1fr) 200px;
      align-items: center;
    }
  }
  .ex.elegido {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--tono) 12%, transparent),
      transparent 70%
    );
  }
  .ex-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ex-lab {
    color: rgb(248 246 241 / 0.5);
  }
  .ex-nombre {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
    color: var(--color-bone);
  }
  .ex-para {
    margin-top: 8px;
    max-width: 720px;
    font-size: 16px;
    line-height: 1.6;
    color: rgb(248 246 241 / 0.8);
  }
  .ex-pie {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: center;
  }
  .ex-muestra {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: rgb(248 246 241 / 0.65);
  }
  .ex-muestra svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ex-nombre-btn {
    all: unset;
    cursor: pointer;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      background-size 0.35s var(--ease-out-soft),
      color 0.2s;
  }
  .ex-nombre-btn:hover,
  .ex-nombre-btn:focus-visible {
    color: var(--color-clay);
    background-size: 100% 1px;
  }
  .ex-ver {
    all: unset;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-clay);
    border-bottom: 1px solid rgb(214 154 124 / 0.4);
    transition: border-color 0.2s;
  }
  .ex-ver span {
    display: inline-block;
    transition: transform 0.25s var(--ease-out-soft);
  }
  .ex-ver:hover span,
  .ex-ver:focus-visible span {
    transform: translateX(4px);
  }
  .ex-ver:hover,
  .ex-ver:focus-visible {
    border-color: var(--color-clay);
  }

  /* ── The test popup ── */
  .ficha {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(880px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    margin: auto;
    color: var(--color-bone);
    overflow: visible;
  }
  .ficha::backdrop {
    background: rgb(20 19 16 / 0.62);
    backdrop-filter: blur(8px);
  }
  .ficha[open] {
    animation: ficha-in 0.45s var(--ease-out-soft);
  }
  .ficha[open]::backdrop {
    animation: ficha-fondo 0.45s ease;
  }
  @keyframes ficha-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }
  @keyframes ficha-fondo {
    from {
      opacity: 0;
    }
  }
  .ficha-panel {
    position: relative;
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: 32px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(214 154 124 / 0.22), transparent 55%),
      linear-gradient(170deg, #2b2a25 0%, #1b1a17 70%);
    border: 1px solid rgb(248 246 241 / 0.1);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.7);
  }
  .ficha-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -120px;
    top: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(231 183 160 / 0.28), transparent 65%);
    pointer-events: none;
    animation: ficha-latir 7s ease-in-out infinite;
  }
  @keyframes ficha-latir {
    50% {
      transform: scale(1.12);
      opacity: 0.7;
    }
  }
  .ficha-cerrar {
    position: sticky;
    float: right;
    top: 16px;
    margin: 16px 16px 0 0;
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(248 246 241 / 0.18);
    background: rgb(27 26 23 / 0.7);
    backdrop-filter: blur(6px);
    color: var(--color-bone);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .ficha-cerrar:hover {
    transform: rotate(90deg);
    background: rgb(248 246 241 / 0.12);
  }
  .ficha-cab {
    position: relative;
    padding: clamp(28px, 5vw, 52px) clamp(22px, 5vw, 52px) 28px;
    border-bottom: 1px solid rgb(248 246 241 / 0.08);
  }
  .ficha-lab {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-clay);
    background: rgb(214 154 124 / 0.12);
    border: 1px solid rgb(214 154 124 / 0.3);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
  }
  .ficha-lab:empty {
    display: none;
  }
  .ficha-nombre {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(32px, 4.6vw, 52px);
    line-height: 1.04;
    color: var(--color-bone);
    margin: 16px 0 12px;
    max-width: 680px;
  }
  .ficha-gancho {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.3;
    color: var(--color-clay);
    max-width: 640px;
  }
  .ficha-compra {
    margin-top: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .ficha-precio {
    display: block;
    font-size: clamp(30px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-bone);
  }
  .ficha-muestra {
    display: block;
    font-size: 13px;
    color: rgb(248 246 241 / 0.6);
    margin-top: 2px;
  }
  .ficha-add {
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 16px 30px;
    border-radius: var(--radius-pill);
    background: var(--color-clay);
    color: var(--color-charcoal);
    box-shadow: 0 14px 34px -14px rgb(231 183 160 / 0.7);
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .ficha-add:hover {
    transform: translateY(-2px);
  }
  .ficha-add[aria-pressed='true'] {
    background: var(--color-sage);
  }
  .ficha-add .ex-add-si,
  .ficha-add[aria-pressed='true'] .ex-add-no {
    display: none;
  }
  .ficha-add[aria-pressed='true'] .ex-add-si {
    display: inline;
  }
  .ficha-cuerpo {
    position: relative;
    padding: 30px clamp(22px, 5vw, 52px) clamp(28px, 5vw, 48px);
    display: grid;
    gap: 30px;
  }
  .ficha-t {
    display: block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(248 246 241 / 0.55);
    margin: 0 0 14px;
  }
  .ficha-mide {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px;
  }
  .ficha-mide :global(li) {
    position: relative;
    padding: 16px 16px 16px 46px;
    border-radius: 18px;
    background: rgb(248 246 241 / 0.05);
    border: 1px solid rgb(248 246 241 / 0.08);
    font-size: 14.5px;
    line-height: 1.45;
    color: rgb(248 246 241 / 0.9);
    opacity: 0;
    transform: translateY(10px);
    animation: ficha-item 0.5s var(--ease-out-soft) forwards;
    animation-delay: calc(0.12s + var(--i) * 0.06s);
  }
  .ficha-mide :global(li)::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 18px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-clay) 35%, rgb(214 154 124 / 0.25) 40%);
  }
  @keyframes ficha-item {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .ficha-importa {
    margin: 0;
    padding: 24px 26px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgb(214 154 124 / 0.18), rgb(207 215 196 / 0.08));
    border-left: 3px solid var(--color-clay);
  }
  .ficha-importa p {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.1vw, 25px);
    line-height: 1.35;
    color: var(--color-bone);
  }
  .ficha-dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }
  .ficha-check {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .ficha-check :global(li) {
    position: relative;
    padding-left: 28px;
    font-size: 15px;
    line-height: 1.5;
    color: rgb(248 246 241 / 0.85);
  }
  .ficha-check :global(li)::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-sage);
    font-weight: 800;
  }
  .ficha-nota {
    font-size: 12.5px;
    line-height: 1.55;
    color: rgb(248 246 241 / 0.45);
  }
  @media (max-width: 680px) {
    .ficha {
      width: 100vw;
      max-width: 100vw;
      max-height: 92dvh;
      margin: auto 0 0;
    }
    .ficha-panel {
      max-height: 92dvh;
      border-radius: 28px 28px 0 0;
    }
    .ficha[open] {
      animation-name: ficha-sube;
    }
    .ficha-dos {
      grid-template-columns: 1fr;
    }
    .ficha-compra {
      position: sticky;
      bottom: 0;
    }
  }
  @keyframes ficha-sube {
    from {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ficha[open],
    .ficha[open]::backdrop,
    .ficha-glow,
    .ficha-mide :global(li) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  .ex-compra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  @media (min-width: 820px) {
    .ex-compra {
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
    }
  }
  .ex-precio {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1;
    color: var(--color-bone);
  }
  .ex-add {
    all: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    min-height: 46px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(248 246 241 / 0.3);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-bone);
    cursor: pointer;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .ex-add:hover {
    border-color: var(--color-clay);
  }
  .ex-add:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 3px;
  }
  .ex-add-si {
    display: none;
  }
  .ex-add[aria-pressed='true'] {
    background: var(--color-clay);
    border-color: var(--color-clay);
    color: var(--color-charcoal);
  }
  .ex-add[aria-pressed='true'] .ex-add-no {
    display: none;
  }
  .ex-add[aria-pressed='true'] .ex-add-si {
    display: inline;
  }
  .ps-nota {
    margin-top: 32px;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgb(248 246 241 / 0.62);
  }
  .ps-nota a {
    color: var(--color-bone);
    border-bottom: 1px solid rgb(248 246 241 / 0.35);
  }

  /* ── The floating selection ── */
  .dock {
    position: fixed;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 10px 10px 24px;
    border-radius: var(--radius-pill);
    background: rgb(27 26 23 / 0.88);
    border: 1px solid rgb(214 154 124 / 0.45);
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.5);
    backdrop-filter: blur(12px);
    color: var(--color-bone);
    animation: dock-in 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .dock[hidden] {
    display: none;
  }
  @keyframes dock-in {
    from {
      opacity: 0;
      translate: -50% 20px;
    }
  }
  .dock-n {
    font-size: 14px;
  }
  .dock-total {
    font-family: var(--font-serif);
    font-size: 22px;
  }
  .dock-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f0c4ae, var(--color-clay-deep));
    color: var(--color-charcoal);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dock.bump {
    animation: dock-bump 0.4s ease;
  }
  @keyframes dock-bump {
    40% {
      scale: 1.05;
    }
  }

  @media (max-width: 640px) {
    .ps-sintomas {
      gap: 10px;
    }
    .sint {
      flex-basis: 68%;
      padding: 16px 14px 14px;
    }
    .flecha {
      display: none;
    }
    .sint-t {
      font-size: 18px;
    }
    .sint-e {
      font-size: 12px;
    }
    .dock {
      left: 12px;
      right: 12px;
      translate: none;
      justify-content: space-between;
    }
    @keyframes dock-in {
      from {
        opacity: 0;
        translate: 0 20px;
      }
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .ps-aurora,
    .sint,
    .panel,
    .dock {
      animation: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-por-sintoma]');
  if (raiz) {
    const CLAVE = raiz.dataset.clave!;
    const precios: Record<string, number> = JSON.parse(raiz.dataset.precios ?? '{}');
    /* ── Symptom cards: each one opens its view in the catalogue above (Verónica, 2026-10-03) ── */
    raiz.querySelectorAll<HTMLButtonElement>('.sint').forEach((t) =>
      t.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('vw:sintoma', { detail: t.dataset.sintoma }));
        history.replaceState(null, '', `#${t.dataset.sintoma}`);
      })
    );
    /* ── Carousel arrows ── */
    const carrusel = raiz.querySelector<HTMLElement>('[data-carrusel]')!;
    const pista = carrusel.querySelector<HTMLElement>('.ps-sintomas')!;
    const izq = carrusel.querySelector<HTMLButtonElement>('.flecha.izq')!;
    const der = carrusel.querySelector<HTMLButtonElement>('.flecha.der')!;
    const bordes = () => {
      const inicio = pista.scrollLeft <= 4;
      const fin = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
      izq.disabled = inicio;
      der.disabled = fin;
      carrusel.classList.toggle('al-inicio', inicio);
      carrusel.classList.toggle('al-final', fin);
    };
    carrusel.querySelectorAll<HTMLButtonElement>('[data-mover]').forEach((b) =>
      b.addEventListener('click', () => {
        const primera = pista.querySelector<HTMLElement>('.sint');
        const paso = ((primera?.getBoundingClientRect().width ?? 280) + 12) * 2;
        pista.scrollBy({ left: Number(b.dataset.mover) * paso });
      })
    );
    pista.addEventListener('scroll', bordes, { passive: true });
    addEventListener('resize', bordes);
    bordes();

    // A link to /examenes/#<symptom> opens that view once the catalogue is listening.
    const inicial = location.hash.slice(1);
    if (raiz.querySelector(`.sint[data-sintoma="${inicial}"]`))
      requestAnimationFrame(() =>
        window.dispatchEvent(new CustomEvent('vw:sintoma', { detail: inicial }))
      );

    /* ── Selection (persisted, shared with the checkout) ── */
    const leer = (): string[] => {
      try {
        const v = JSON.parse(localStorage.getItem(CLAVE) ?? '[]');
        return Array.isArray(v) ? v.filter((id) => id in precios) : [];
      } catch {
        return [];
      }
    };
    const sel = new Set<string>(leer());
    const guardar = () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify([...sel]));
      } catch {
        // Private mode or blocked storage: the selection still works for this visit.
      }
    };
    const dock = raiz.querySelector<HTMLElement>('[data-dock]')!;
    const pintar = (bump = false) => {
      // Every «Agregar» on the page (symptoms and the catalogue) shows the same selection.
      document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => {
        const on = sel.has(b.dataset.add!);
        b.setAttribute('aria-pressed', String(on));
        b.closest('.ex, [data-fila], [data-comp-fila]')?.classList.toggle('elegido', on);
      });
      const n = sel.size;
      const total = [...sel].reduce((s, id) => s + (precios[id] ?? 0), 0);
      dock.hidden = n === 0;
      dock.querySelector('[data-dock-n]')!.textContent = String(n);
      dock.querySelector('[data-dock-palabra]')!.textContent = n === 1 ? 'examen' : 'exámenes';
      dock.querySelector('[data-dock-total]')!.textContent = `$${total.toFixed(2)}`;
      if (bump) {
        dock.classList.remove('bump');
        void dock.offsetWidth;
        dock.classList.add('bump');
      }
    };
    document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.add!;
        if (sel.has(id)) sel.delete(id);
        else sel.add(id);
        guardar();
        pintar(true);
      })
    );
    pintar();

    /* ── The test popup ── */
    const dlg = raiz.querySelector<HTMLDialogElement>('[data-ficha-dialog]');
    if (dlg) {
      type Ficha = {
        nombre: string;
        laboratorio: string;
        precio: string;
        producto: string;
        muestras: string[];
        enCasa: boolean;
        gancho?: string;
        queMide?: string[];
        porQueImporta?: string;
        ideal?: string[];
        obtienes?: string[];
      };
      const datos: Record<string, Ficha> = JSON.parse(dlg.dataset.fichas ?? '{}');
      const addBtn = dlg.querySelector<HTMLButtonElement>('[data-ficha-add]')!;
      const panel = dlg.querySelector<HTMLElement>('.ficha-panel')!;
      let actual: Ficha | null = null;
      const texto = (k: string, v: string) => {
        const el = dlg.querySelector<HTMLElement>(`[data-f="${k}"]`);
        if (el) el.textContent = v;
      };
      const lista = (k: string, items: string[] = []) => {
        const ul = dlg.querySelector<HTMLElement>(`[data-lista="${k}"]`)!;
        ul.replaceChildren(
          ...items.map((t, i) => {
            const li = document.createElement('li');
            // «Ideal si…» is already the heading: drop the repeated lead-in from each item.
            const limpio = k === 'ideal' ? t.replace(/^ideal si\s+/i, '') : t;
            li.textContent = limpio.charAt(0).toUpperCase() + limpio.slice(1);
            li.style.setProperty('--i', String(i));
            return li;
          })
        );
        ul.closest('section')!.hidden = items.length === 0;
      };
      const estadoAdd = () => {
        if (actual) addBtn.setAttribute('aria-pressed', String(sel.has(actual.producto)));
      };
      const abrir = (id: string) => {
        const f = datos[id];
        if (!f) return;
        actual = f;
        texto('laboratorio', f.laboratorio);
        texto('nombre', f.nombre);
        texto('gancho', f.gancho ?? '');
        texto('precio', f.precio);
        texto(
          'muestra',
          [f.muestras.join(' · '), f.enCasa ? 'Kit en tu casa' : ''].filter(Boolean).join(' · ')
        );
        texto('porQueImporta', f.porQueImporta ?? '');
        dlg.querySelector<HTMLElement>('.ficha-importa')!.hidden = !f.porQueImporta;
        lista('queMide', f.queMide);
        lista('ideal', f.ideal);
        lista('obtienes', f.obtienes);
        estadoAdd();
        dlg.showModal();
        panel.scrollTop = 0;
      };
      document
        .querySelectorAll<HTMLButtonElement>('[data-ficha]')
        .forEach((b) => b.addEventListener('click', () => abrir(b.dataset.ficha!)));
      addBtn.addEventListener('click', () => {
        if (!actual) return;
        if (sel.has(actual.producto)) sel.delete(actual.producto);
        else sel.add(actual.producto);
        guardar();
        pintar(true);
        estadoAdd();
      });
      dlg.querySelector('[data-ficha-cerrar]')!.addEventListener('click', () => dlg.close());
      // A click on the backdrop (outside the panel) closes it too.
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
    }
  }
</script>
