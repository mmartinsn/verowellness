---
/**
 * Highlighted notice right under the hero (Verónica, change 35): tests are not required for the
 * advisory, and choosing them is part of it. Her sentence, in «tú».
 * Below it, the USA-only note (Mari, 2026-10-11): outside the USA, people write to Verónica. The
 * link is her Instagram DM (the site's contact link) until she decides on WhatsApp.
 */
import { href } from '../../lib/url';
import { cta } from '../../data/site';
import { bloque } from '../../lib/datos/bloques';

const contacto = bloque('sitio', 'continuidad').enlace as string;
---

<section class="aviso">
  <div class="wrap">
    <div class="caja reveal">
      <span class="sello" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26"
          ><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3zM9 12l2 2 4-4"></path></svg
        >
      </span>
      <div class="texto">
        <p class="titular">Los exámenes no son obligatorios para tus asesorías.</p>
        <p>
          Si no sabes cuál elegir o priorizar, no te preocupes: identificar si necesitas estudios y
          la prioridad de los mismos forma parte de tu asesoría.
        </p>
      </div>
      <a class="btn btn-primary" href={href('/asesorias')}>{cta.label}</a>
    </div>
    <p class="solo-usa reveal">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><circle cx="12" cy="12" r="9"></circle><path
          d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"
        ></path></svg
      >
      <span>
        <strong>Los exámenes son válidos solo para pago en USA.</strong> Si te encuentras en Latinoamérica,
        <a href={contacto} target="_blank" rel="noopener">comunícate conmigo</a>.
      </span>
    </p>
  </div>
</section>

<style>
  .aviso {
    padding: clamp(56px, 7vw, 88px) 0;
  }
  .caja {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: clamp(22px, 3vw, 32px) clamp(22px, 3.4vw, 40px);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(ellipse 70% 120% at 0% 0%, rgb(207 215 196 / 0.7), transparent 70%),
      linear-gradient(120deg, var(--color-ivory), rgb(231 183 160 / 0.35));
    border: 1px solid rgb(48 47 42 / 0.08);
    box-shadow: 0 24px 50px -36px rgb(48 47 42 / 0.45);
  }
  .sello {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-charcoal);
    color: var(--color-clay);
  }
  .sello svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .texto {
    flex: 1 1 380px;
  }
  .titular {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.15;
    color: var(--color-charcoal);
    margin: 0 0 6px;
  }
  .solo-usa {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 16px 0 0;
    padding: 14px 20px;
    border-radius: 16px;
    border: 1.5px dashed rgb(138 75 49 / 0.45);
    background: rgb(255 255 255 / 0.6);
    font-size: 15px;
    line-height: 1.55;
    color: rgb(48 47 42 / 0.85);
  }
  .solo-usa svg {
    flex-shrink: 0;
    margin-top: 2px;
    fill: none;
    stroke: #8a4b31;
    stroke-width: 1.6;
  }
  .solo-usa a {
    font-weight: 700;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(48 47 42 / 0.4);
  }
  .texto p:not(.titular) {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: rgb(48 47 42 / 0.8);
  }
</style>
