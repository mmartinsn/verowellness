---
import { Image } from 'astro:assets';
import foto from '../../assets/fotos/veronica-bata-horizontal.jpg';
import { marca } from '../../data/site';
import { href } from '../../lib/url';
---

<section class="aviso" aria-labelledby="aviso-titulo">
  <div class="wrap">
    <div class="aviso-caja reveal">
      <div class="aviso-foto">
        <Image
          src={foto}
          alt={`${marca.creadora} con bata blanca, sonriendo`}
          widths={[360, 540, 720]}
          sizes="(min-width: 900px) 340px, 90vw"
        />
      </div>
      <div class="aviso-copy">
        <span class="aviso-tag">Importante</span>
        <h2 id="aviso-titulo" class="aviso-h2">
          Los exámenes <em>no son obligatorios</em> para tus asesorías.
        </h2>
        <p>
          Si no sabes cuál elegir o priorizar, no te preocupes: identificar si necesitas estudios, y
          su prioridad, forma parte de tu asesoría.
        </p>
        <div class="aviso-acciones">
          <a class="aviso-btn" href={href('/asesorias')}>Conoce las asesorías</a>
          <a class="aviso-link" href="#catalogo"
            >Ver el catálogo <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aviso {
    position: relative;
    z-index: 4;
    background: linear-gradient(180deg, transparent 0 64px, var(--color-bone) 64px);
    margin-top: -64px;
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .aviso-caja {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: 30px;
    background:
      radial-gradient(ellipse 60% 80% at 100% 0%, rgb(207 215 196 / 0.7), transparent 70%),
      linear-gradient(135deg, #f6dccd 0%, var(--color-sand-light) 70%);
    border: 1px solid rgb(214 154 124 / 0.55);
    box-shadow: 0 40px 80px -46px rgb(35 34 30 / 0.55);
  }
  @media (min-width: 860px) {
    .aviso-caja {
      grid-template-columns: 340px minmax(0, 1fr);
    }
  }
  .aviso-foto {
    position: relative;
    min-height: 240px;
  }
  .aviso-foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 30%;
  }
  .aviso-copy {
    padding: clamp(26px, 4vw, 48px);
    display: grid;
    gap: 14px;
    align-content: center;
    justify-items: start;
  }
  .aviso-tag {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .aviso-h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.04;
    color: var(--color-charcoal);
    max-width: 620px;
  }
  .aviso-h2 em {
    font-style: italic;
    color: var(--color-clay-rich);
  }
  .aviso-copy p {
    max-width: 560px;
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
    color: rgb(35 34 30 / 0.78);
  }
  .aviso-acciones {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
  }
  .aviso-btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .aviso-btn:hover {
    transform: translateY(-2px);
  }
  .aviso-link {
    font-size: 14px;
    font-weight: 700;
    border-bottom: 1px solid rgb(35 34 30 / 0.35);
  }
  .aviso-btn:focus-visible,
  .aviso-link:focus-visible {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 3px;
  }
</style>
