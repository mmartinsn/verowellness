---
import { Image } from 'astro:assets';
import TextoRico from './TextoRico.astro';
import {
  type Libro,
  type Producto,
  esComprable,
  precioPorDefinir,
  precioTienda,
} from '../../data/tienda';

interface Props {
  libro: Producto | Libro;
  espejo?: boolean;
}
const { libro: p, espejo = false } = Astro.props;
const comprable = esComprable(p);
---

<article
  class:list={['capitulo', `tono-${p.tono}`, { espejo }]}
  id={p.id}
  aria-labelledby={`${p.id}-titulo`}
>
  <div class="wrap cap-grid">
    <div class="cap-libro-col">
      <div class="cap-libro reveal-scale">
        <Image
          src={p.portada}
          alt={`Portada de «${p.titulo}»`}
          widths={[360, 720]}
          sizes="(min-width: 1000px) 360px, 62vw"
        />
        {p.bestSeller && <span class="cap-sello">Best seller</span>}
      </div>
      <div class="cap-chips">
        <span class="chip-a">{p.formato}</span>
        <span class="chip-b">{comprable ? 'Descarga digital' : 'Próximamente'}</span>
      </div>
    </div>

    <div class="cap-texto">
      <div class="cap-top">
        <span class="cap-eyebrow">Capítulo {p.num}</span>
        <span class="cap-linea" aria-hidden="true"></span>
        <span class:list={['cap-precio', { pendiente: !comprable }]}>
          {comprable ? precioTienda(p.precio) : precioPorDefinir}
        </span>
      </div>
      <h2 id={`${p.id}-titulo`} class="cap-nombre">{p.titulo}</h2>
      <p class="cap-pregunta">{p.pregunta}</p>
      <p class="cap-parrafo"><TextoRico texto={p.parrafo} /></p>

      <div class="cap-indice">
        <span class="cap-label">Dentro encontrarás</span>
        <ol class="reveal-stagger">
          {
            p.incluye.map((t, i) => (
              <li>
                <span class="idx-n">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <TextoRico texto={t} />
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="cap-cierre"><mark>{p.cierre}</mark></p>

      {p.nota && <p class="cap-nota">{p.nota}</p>}

      <div class="cap-acciones">
        {
          comprable ? (
            <>
              <button
                type="button"
                class="btn btn-outline cap-add"
                data-tienda-add={p.id}
                aria-pressed="false"
              >
                <span class="add-off">Añadir a mi selección</span>
                <span class="add-on">✓ Añadido</span>
              </button>
              <button type="button" class="btn btn-primary" data-tienda-comprar={p.id}>
                {p.boton}
              </button>
            </>
          ) : (
            <span class="cap-pronto">Disponible muy pronto</span>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .capitulo {
    --acento: var(--color-clay-deep);
    --marcador: rgb(231 183 160 / 0.6);
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 8vw, 110px) 0;
    background: var(--color-bone);
    border-top: 1px solid rgb(35 34 30 / 0.08);
  }
  .tono-sage {
    --marcador: rgb(207 215 196 / 0.95);
    background: #efe9de;
  }
  .tono-rose {
    --marcador: rgb(226 183 178 / 0.75);
  }

  .cap-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .cap-grid {
      grid-template-columns: 400px minmax(0, 1fr);
      gap: 88px;
    }
    .espejo .cap-grid {
      grid-template-columns: minmax(0, 1fr) 400px;
    }
    .espejo .cap-libro-col {
      order: 2;
    }
  }

  .cap-libro-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    perspective: 1400px;
  }
  .cap-libro {
    position: relative;
    width: min(360px, 62vw);
    aspect-ratio: 360 / 500;
    border-radius: 3px 8px 8px 3px;
    box-shadow: 34px 44px 70px rgb(35 34 30 / 0.3);
    transform: rotateY(-8deg);
    transition: transform 1s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .cap-libro::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 16px;
    border-radius: 3px 0 0 3px;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.28),
      rgb(255 255 255 / 0.3) 60%,
      rgb(0 0 0 / 0.08)
    );
  }
  @media (hover: hover) {
    .cap-libro:hover {
      transform: rotateY(-2deg) rotateX(4deg) translateZ(24px);
    }
  }
  .cap-libro :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px 8px 8px 3px;
  }
  .cap-sello {
    position: absolute;
    top: -18px;
    right: -18px;
    z-index: 2;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12px;
    background: var(--color-charcoal);
    color: var(--color-clay);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
    box-shadow: 0 14px 30px rgb(35 34 30 / 0.3);
    transform: rotate(-10deg);
  }
  .cap-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .chip-a,
  .chip-b {
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .chip-a {
    background: var(--color-white);
  }
  .chip-b {
    border: 1px solid rgb(35 34 30 / 0.15);
    font-weight: 700;
  }

  .cap-texto {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cap-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cap-eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a4b31;
  }
  .cap-linea {
    flex: 1;
    height: 1px;
    background: rgb(35 34 30 / 0.15);
  }
  .cap-precio {
    font-family: var(--font-serif);
    font-size: clamp(32px, 3.2vw, 44px);
    line-height: 1;
    color: var(--color-charcoal);
  }
  .cap-precio.pendiente {
    font-style: italic;
    font-size: clamp(22px, 2.2vw, 28px);
    color: rgb(35 34 30 / 0.75);
  }
  .cap-nombre {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(36px, 3.9vw, 54px);
    line-height: 1.04;
    color: var(--color-charcoal);
  }
  .cap-pregunta {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.1vw, 28px);
    line-height: 1.3;
    color: var(--color-charcoal);
  }
  .cap-parrafo {
    font-size: clamp(16px, 1.25vw, 17.5px);
    line-height: 1.65;
    color: rgb(35 34 30 / 0.82);
  }
  .cap-parrafo :global(strong),
  .cap-indice :global(strong) {
    font-weight: 800;
    color: var(--color-charcoal);
  }
  .cap-label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.68);
    padding-bottom: 8px;
  }
  .cap-indice ol {
    list-style: none;
    padding: 0;
  }
  .cap-indice li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px dotted rgb(35 34 30 / 0.32);
    font-size: 14.5px;
    line-height: 1.55;
    font-weight: 500;
  }
  .idx-n {
    flex: 0 0 28px;
    font-family: var(--font-serif);
    font-size: 22px;
    color: #8a4b31;
  }
  .cap-cierre {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(21px, 2vw, 25px);
    line-height: 1.4;
  }
  .cap-cierre mark {
    color: inherit;
    padding: 0 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background: linear-gradient(
        transparent 58%,
        var(--marcador) 58%,
        var(--marcador) 92%,
        transparent 92%
      )
      no-repeat 0 0 / 0% 100%;
    transition: background-size 1.4s cubic-bezier(0.19, 1, 0.22, 1) 0.2s;
  }
  .capitulo:global(.visto) .cap-cierre mark {
    background-size: 100% 100%;
  }
  .cap-nota {
    font-size: 12.5px;
    line-height: 1.55;
    color: rgb(35 34 30 / 0.68);
    max-width: 640px;
  }
  .cap-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }
  .cap-add .add-on {
    display: none;
  }
  .cap-add[aria-pressed='true'] {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .cap-add[aria-pressed='true'] .add-on {
    display: inline;
  }
  .cap-add[aria-pressed='true'] .add-off {
    display: none;
  }
  .cap-pronto {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 28px;
    border-radius: var(--radius-pill);
    border: 1px dashed rgb(35 34 30 / 0.35);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.75);
  }
  @media (max-width: 600px) {
    .cap-sello {
      width: 76px;
      height: 76px;
      top: -14px;
      right: -10px;
      font-size: 9.5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cap-cierre mark {
      transition: none;
      background-size: 100% 100%;
    }
  }
  :global(html.no-js) .cap-cierre mark {
    background-size: 100% 100%;
  }
</style>
