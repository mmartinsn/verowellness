---
/**
 * Editorial home hero: the five coloured bars ("the layers") behind the title, the hook, the
 * signature line, the lede and the CTA, with Verónica's 3/4 portrait alongside.
 */
import { Image } from 'astro:assets';
import retrato from '../../assets/fotos/veronica-bata-frontal.jpg';
import { href } from '../../lib/url';
import { cta, marca } from '../../data/site';

const barras = [
  { top: 0, width: '92%', color: 'var(--color-clay)' },
  { top: 60, width: '74%', color: 'var(--color-rose)' },
  { top: 120, width: '58%', color: 'var(--color-sand)' },
  { top: 180, width: '42%', color: 'var(--color-sage)' },
  { top: 240, width: '28%', color: 'var(--color-olive)' },
];
---

<section class="hero" id="inicio">
  <div class="hero-bars" aria-hidden="true">
    {
      barras.map((b) => (
        <div class="bar" style={`top:${b.top}px;width:${b.width};background:${b.color};`} />
      ))
    }
  </div>
  <div class="wrap hero-grid">
    <div class="hero-content reveal">
      <h1 class="hero-title">The Layer Method<span class="tm">™</span></h1>
      <div class="hero-byline">by <span class="brand-coral">VERONICA WELLNESS</span></div>

      <p class="hero-hook">
        ¿Haces de todo por tu salud... y aún no sabes qué es lo que realmente funciona?
      </p>
      <p class="hero-signature">{marca.firma}</p>

      <p class="lede">
        Tu salud celular es la base invisible de tu energía, tu digestión, tu piel y tus hormonas:
        cuando tus células funcionan bien, tú funcionas bien. The Layer Method™ te ayuda a dejar de
        perseguir cada síntoma por separado y a entender, capa por capa, qué necesita atención
        primero.
      </p>

      <div class="cta-row">
        <a href={href(cta.path)} class="btn btn-primary">{cta.label}</a>
      </div>
      <a href={href('/el-metodo')} class="link-arrow"
        >Conoce The Layer Method™ <span class="arrow" aria-hidden="true">→</span></a
      >

      <p class="hero-note">
        Asesorías 100% online · Adaptadas a tu horario, en cualquier parte del mundo
      </p>
    </div>

    <div class="hero-photo reveal">
      <Image
        src={retrato}
        alt={`Retrato de cuerpo 3/4 de ${marca.creadora} con bata`}
        widths={[400, 680, 800]}
        sizes="(min-width: 900px) 400px, 90vw"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 40px 0 48px;
  }
  @media (min-width: 768px) {
    .hero {
      padding: 60px 0 68px;
    }
  }
  .hero-bars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-bars .bar {
    position: absolute;
    left: 0;
    height: 34px;
    border-radius: 0 17px 17px 0;
    opacity: 0.18;
  }
  @media (min-width: 768px) {
    .hero-bars .bar {
      height: 52px;
      border-radius: 0 26px 26px 0;
    }
  }
  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
    }
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }
  .hero-photo {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    order: -1;
  }
  @media (min-width: 900px) {
    .hero-photo {
      order: 0;
      justify-content: flex-end;
    }
  }
  .hero-photo :global(img) {
    width: 100%;
    max-width: 340px;
    height: auto;
    border-radius: 28px;
    object-fit: cover;
    aspect-ratio: 3/4;
    filter: saturate(0.94);
  }
  @media (min-width: 900px) {
    .hero-photo :global(img) {
      max-width: 400px;
    }
  }
  .hero-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(44px, 7.4vw, 88px);
    line-height: 1.02;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-charcoal);
    margin: 0;
  }
  .hero-title .tm {
    font-size: 0.4em;
    vertical-align: super;
  }
  .hero-byline {
    margin-top: 14px;
    font-weight: 700;
    font-size: 16px;
    color: rgb(48 47 42 / 0.72);
  }
  .brand-coral {
    color: var(--color-clay-deep);
    font-weight: 800;
  }
  .hero-hook {
    margin-top: 30px;
    font-weight: 800;
    color: var(--color-charcoal);
    font-size: clamp(23px, 3.1vw, 32px);
    line-height: 1.35;
    max-width: 620px;
  }
  .hero-signature {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 27px);
    color: var(--color-clay-deep);
  }
  .lede {
    margin-top: 20px;
    max-width: 580px;
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 500;
    line-height: 1.7;
    color: rgb(48 47 42 / 0.85);
  }
  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 32px;
  }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 15px;
    color: var(--color-charcoal);
    padding: 8px 0;
    margin-top: 6px;
  }
  .link-arrow .arrow {
    transition: transform 0.2s ease;
    color: var(--color-clay-deep);
  }
  .link-arrow:hover {
    color: var(--color-clay-deep);
  }
  .link-arrow:hover .arrow {
    transform: translateX(4px);
  }
  .hero-note {
    margin-top: 22px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: rgb(48 47 42 / 0.72);
    text-transform: uppercase;
  }
</style>
