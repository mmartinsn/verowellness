  .extra-bloque.lectura {
    position: relative;
    padding: 26px 28px 24px;
    border: 1.5px solid var(--color-clay-deep);
    background:
      linear-gradient(135deg, rgb(231 183 160 / 0.38), rgb(216 171 166 / 0.2) 70%),
