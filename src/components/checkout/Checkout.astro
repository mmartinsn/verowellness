      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .stepper li {
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .mobile-progress-fill {
    transition: width 0.5s var(--ease-out-soft);
  }
  .step-eyebrow {
    font-weight: 800;
    font-size: 13px;
