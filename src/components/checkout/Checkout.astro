  }
  .extra-opciones {
    margin-top: 16px;
    display: grid;
    gap: 10px;
  }
  .opcion {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid rgb(48 47 42 / 0.14);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .opcion {
    position: relative;
  }
  .opcion.recomendada {
    border-width: 1.5px;
    border-color: var(--color-clay-deep);
    background: linear-gradient(135deg, rgb(231 183 160 / 0.28), rgb(216 171 166 / 0.18));
    padding-top: 22px;
  }
  .opcion-badge {
    position: absolute;
    top: -11px;
    left: 14px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-clay);
  }
  .opcion:has(input:checked) {
    border-color: var(--color-clay-deep);
    background: rgb(231 183 160 / 0.16);
  }
  .opcion-cab {
    display: flex;
    gap: 6px;
    align-items: baseline;
    font-size: 15px;
  }
  .opcion-precio {
    margin-left: auto;
    font-weight: 800;
  }
  .opcion-texto {
    font-size: 13.5px;
    color: rgb(48 47 42 / 0.7);
  }
  .extra-aviso {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.55;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--color-ivory);
    color: rgb(48 47 42 / 0.8);
  }
  .guias {
    display: grid;
    gap: 10px;
  }
  .guia {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 14px;
    padding: 10px 14px 10px 10px;
    border-radius: 16px;
    border: 1px solid rgb(48 47 42 / 0.12);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .guia img {
    width: 44px;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 6px 14px -8px rgb(48 47 42 / 0.5);
  }
  .guia-nombre {
    font-size: 14.5px;
    font-weight: 700;
  }
  .guia-precio {
    font-weight: 800;
    font-size: 14.5px;
  }
  .guia-check {
    font-size: 12.5px;
    font-weight: 800;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-charcoal);
  }
  .guia-check .si,
  .guia:has(input:checked) .guia-check .no {
    display: none;
  }
  .guia:has(input:checked) .guia-check .si {
    display: inline;
  }
  .guia:has(input:checked) {
    border-color: var(--color-sage-deep);
    background: rgb(207 215 196 / 0.3);
  }
  .guia:has(input:checked) .guia-check {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  @media (max-width: 520px) {
    .guia {
      grid-template-columns: auto 1fr;
    }
  }
  /* Rows written by the script do not carry the scoped class: style them globally. */
  :global(.summary-line.extra),
  :global(.review-row.extra) {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 8px 0;
    font-size: 14.5px;
    color: var(--color-clay-rich);
    border-bottom: 1px solid rgb(48 47 42 / 0.08);
  }
  .summary-bonus {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgb(231 183 160 / 0.2);
  }

  /* ── Shop popup ── */
  .popup-guia {
    margin: auto;
    inset: 0;
    border: 0;
    border-radius: 28px;
    padding: 30px;
    width: min(460px, calc(100vw - 32px));
    background: var(--color-bone);
    color: var(--color-charcoal);
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.5);
  }
  .popup-guia::backdrop {
    background: rgb(20 19 16 / 0.5);
    backdrop-filter: blur(6px);
  }
  .popup-guia[open] {
    animation: pg-in 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  @keyframes pg-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }
  .pg-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-clay);
    margin: 0;
  }
  .pg-titulo {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.1;
    margin: 14px 0 18px;
  }
  .pg-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .pg-item img {
    width: 84px;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 12px 24px -12px rgb(48 47 42 / 0.6);
  }
  .pg-nombre {
    font-weight: 800;
    font-size: 16px;
    margin: 0 0 4px;
  }
  .pg-precios {
    margin: 0 0 6px;
  }
  .pg-precios s {
    color: rgb(48 47 42 / 0.5);
    margin-right: 6px;
  }
  .pg-precios strong {
    font-size: 22px;
    color: var(--color-clay-rich);
  }
  .pg-texto {
    font-size: 13.5px;
    color: rgb(48 47 42 / 0.7);
    margin: 0;
  }
  .pg-acciones {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 22px;
    flex-wrap: wrap;
  }
</style>

<script>
  /*
   * Checkout behaviour — a client-side prototype. Every `INTEGRATION POINT` comment marks where a
   * real system (CRM, Stripe, PayPal, Zelle verification, Calendly) plugs in.
   */
  import {
    productosDe,
    urlKlarna,
    urlPedido,
    type MapaProductos,
    type Seleccion,
  } from '../../lib/comercio/pedido';
  import {
    CODIGO_PAIS,
    cookieTraspaso,
    dominioCompartido,
    limpiarCupon,
  } from '../../lib/comercio/traspaso';
  import { aCentavos, desdeCentavos, impuestoCentavos } from '../../lib/precio';
  type Config = {
    cycle_type: string;
    cycle_label: string;
    subtotal: number;
    gravado: boolean;
    tax_rate: number;
    tax_amount: number;
    total: number;
    currency: string;
  };
  type Metodo = 'stripe' | 'apple_pay' | 'paypal' | 'klarna' | 'zelle';

  const root = document.getElementById('checkout');
  if (root) {
    const config: Config = JSON.parse(root.dataset.config ?? '{}');
    const usd = (n: number) => `$${n.toFixed(2)}`;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    /* ── Lab-test mode: the order is whatever the visitor picked on /examenes/ ── */
    let items: { id: string; nombre: string; precio: number; gravado: boolean }[] = [];
    if (root.dataset.carrito) {
      const carrito: {
        clave: string;
        volver: string;
        catalogo: { id: string; nombre: string; precio: number; gravado: boolean }[];
      } = JSON.parse(root.dataset.carrito);
      const porId = new Map(carrito.catalogo.map((i) => [i.id, i]));
      let ids: string[] = [];
      // A direct link (e.g. from a downloadable guide) can name the test: ?examen=<id>.
      const directo = new URLSearchParams(location.search).get('examen');
      if (directo && porId.has(directo)) {
        try {
          localStorage.setItem(carrito.clave, JSON.stringify([directo]));
        } catch {
          ids = [directo];
        }
      }
      if (!ids.length)
        try {
          const v = JSON.parse(localStorage.getItem(carrito.clave) ?? '[]');
          ids = Array.isArray(v) ? v : [];
        } catch {
          // Storage unavailable: the cart reads as empty and the page says so.
        }
      items = ids.map((id) => porId.get(id)).filter((i): i is NonNullable<typeof i> => !!i);
      config.subtotal = Math.round(items.reduce((sum, i) => sum + i.precio, 0) * 100) / 100;
      const lista = root.querySelector('[data-incluye]');
      lista?.replaceChildren(
        ...items.map((i) => {
          const li = document.createElement('li');
          li.className = 'item-quitable';
          const t = document.createElement('span');
          t.textContent = `${i.nombre} · ${usd(i.precio)}`;
          const x = document.createElement('button');
          x.type = 'button';
          x.className = 'item-quitar';
          x.textContent = '✕';
          x.dataset.quitarItem = i.id;
          x.setAttribute('aria-label', `Quitar ${i.nombre}`);
          li.append(t, x);
          return li;
        })
      );
      const n = items.length;
      root
        .querySelectorAll('[data-desc-corta]')
        .forEach((el) => (el.textContent = `${n} ${n === 1 ? 'examen' : 'exámenes'}`));
      const vacio = root.querySelector<HTMLElement>('[data-carrito-vacio]');
      if (vacio) vacio.hidden = n > 0;
      const enviar = root.querySelector<HTMLButtonElement>('#form-datos button[type="submit"]');
      if (enviar) enviar.disabled = n === 0;
    }

    // In-memory state. In production: client_id / order_id returned by the CRM API, kept in a
    // signed session, not client-side state.
    const state: {
      client: Record<string, string> | null;
      order: Record<string, unknown> | null;
      payment_method: Metodo | null;
    } = { client: null, order: null, payment_method: null };

    /* ── Extras: guides, the tests' reading appointment and the lab fee (changes 12, 39–41, 46) ── */
    type Linea = {
      id: string;
      nombre: string;
      precio: number;
      gravado: boolean;
      ref?: string;
      oferta?: boolean;
    };
    const extras: {
      guias?: {
        id: string;
        nombre: string;
        precio: number;
        portada?: string;
        gravado: boolean;
        ofertaGravada: boolean;
      }[];
      popupGuias?: { orden: string[]; descuento: number };
      lectura?: {
        id: string;
        rotulo: string;
        nombre: string;
        precio: number;
        texto: string;
        gravado: boolean;
      }[];
      feePorItem?: number;
    } | null = root.dataset.extras ? JSON.parse(root.dataset.extras) : null;
    let base = config.subtotal;
    const lineas: Linea[] = [];
    let fee = 0;
    const r2 = (n: number) => Math.round(n * 100) / 100;
    const recalc = () => {
      fee = r2((extras?.feePorItem ?? 0) * items.length);
      config.subtotal = r2(base + lineas.reduce((t, l) => t + l.precio, 0));
      const gravable = [...items, ...lineas]
        .filter((x) => x.gravado)
        .reduce((t, x) => t + x.precio, config.gravado ? base : 0);
      config.tax_amount = desdeCentavos(impuestoCentavos(aCentavos(gravable)));
      config.total = r2(config.subtotal + config.tax_amount + fee);
      root
        .querySelectorAll('[data-subtotal]')
        .forEach((el) => (el.textContent = usd(config.subtotal)));
      root
        .querySelectorAll('[data-impuesto]')
        .forEach((el) => (el.textContent = usd(config.tax_amount)));
      root
        .querySelectorAll<HTMLElement>('[data-fila-impuesto]')
        .forEach((el) => (el.hidden = config.tax_amount === 0));
      root.querySelectorAll('[data-total]').forEach((el) => (el.textContent = usd(config.total)));
      root
        .querySelectorAll<HTMLElement>('[data-fila-fee]')
        .forEach((el) => (el.hidden = fee === 0));
      root.querySelectorAll('[data-fee]').forEach((el) => (el.textContent = usd(fee)));
      root.querySelectorAll('[data-lineas-extra]').forEach((box) =>
        box.replaceChildren(
          ...lineas.map((l) => {
            const row = document.createElement('div');
            row.className = box.closest('.summary-card')
              ? 'summary-line extra'
              : 'review-row extra';
            const a = document.createElement('span');
            a.textContent = `+ ${l.nombre}`;
            const b = document.createElement('span');
            b.textContent = usd(l.precio);
            row.append(a, b);
            return row;
          })
        )
      );
      if (state.order) {
        Object.assign(state.order, {
          extras: lineas.map((l) => ({ id: l.id, price: l.precio })),
          lab_fee: fee,
          subtotal: config.subtotal,
          tax_amount: config.tax_amount,
          total: config.total,
        });
      }
    };
    const poner = (l: Linea) => {
      const i = lineas.findIndex((x) => x.id === l.id);
      if (i >= 0) lineas[i] = l;
      else lineas.push(l);
      recalc();
    };
    const quitar = (id: string) => {
      const i = lineas.findIndex((x) => x.id === id);
      if (i >= 0) lineas.splice(i, 1);
      recalc();
    };
    const guiaPorId = new Map((extras?.guias ?? []).map((g) => [g.id, g]));
    const checks = [...root.querySelectorAll<HTMLInputElement>('[data-guia]')];
    checks.forEach((c) =>
      c.addEventListener('change', () => {
        const g = guiaPorId.get(c.value)!;
        if (c.checked)
          poner({ id: `guia:${g.id}`, nombre: g.nombre, precio: g.precio, gravado: g.gravado });
        else quitar(`guia:${g.id}`);
      })
    );
    const bloqueLectura = root.querySelector<HTMLElement>('[data-lectura]');
    if (bloqueLectura && extras?.lectura) {
      const opciones = bloqueLectura.querySelector<HTMLElement>('[data-lectura-opciones]')!;
      const leer = () => {
        const si =
          bloqueLectura.querySelector<HTMLInputElement>('input[name="lectura-sino"]:checked')
            ?.value === 'si';
        opciones.hidden = !si;
        if (!si) return quitar('lectura');
        const id = bloqueLectura.querySelector<HTMLInputElement>(
          'input[name="lectura-opcion"]:checked'
        )?.value;
        const o = extras.lectura!.find((x) => x.id === id) ?? extras.lectura![0];
        poner({
          id: 'lectura',
          nombre: `Lectura: ${o.rotulo} · ${o.nombre}`,
          precio: o.precio,
          gravado: o.gravado,
          ref: o.id,
        });
      };
      bloqueLectura.querySelectorAll('input').forEach((i) => i.addEventListener('change', leer));
      // ?lectura=<consultation id> arrives with that reading appointment already added.
      const pedida = new URLSearchParams(location.search).get('lectura');
      const opcion = bloqueLectura.querySelector<HTMLInputElement>(
        `input[name="lectura-opcion"][value="${CSS.escape(pedida ?? '')}"]`
      );
      if (pedida && opcion) {
        bloqueLectura.querySelector<HTMLInputElement>(
          'input[name="lectura-sino"][value="si"]'
        )!.checked = true;
        opcion.checked = true;
        leer();
      }
    }
    // Shop: on arrival, offer one guide at a discount — the first in `orden` not already in the cart.
    const popup = root.querySelector<HTMLDialogElement>('[data-popup-guia]');
    if (popup && extras?.popupGuias && items.length > 0) {
      const enCarrito = new Set(items.map((i) => i.id));
      const cola = extras.popupGuias.orden
        .filter((id) => !enCarrito.has(id) && guiaPorId.has(id))
        .slice(0, 1);
      const desc = extras.popupGuias.descuento;
      let actual = '';
      const siguiente = () => {
        actual = cola.shift() ?? '';
        if (!actual) return popup.close();
        const g = guiaPorId.get(actual)!;
        const img = popup.querySelector<HTMLImageElement>('[data-pg-portada]')!;
        if (g.portada) img.src = g.portada;
        img.hidden = !g.portada;
        popup.querySelector('[data-pg-nombre]')!.textContent = g.nombre;
        popup.querySelector('[data-pg-antes]')!.textContent = usd(g.precio);
        popup.querySelector('[data-pg-ahora]')!.textContent = usd(r2(g.precio * (1 - desc)));
      };
      popup.querySelector('[data-pg-si]')!.addEventListener('click', () => {
        const g = guiaPorId.get(actual)!;
        poner({
          id: `guia:${g.id}`,
          nombre: `${g.nombre} (−${Math.round(desc * 100)}%)`,
          precio: r2(g.precio * (1 - desc)),
          gravado: g.ofertaGravada,
          oferta: true,
        });
        const c = checks.find((x) => x.value === g.id);
        if (c) {
          c.checked = true;
          c.disabled = true;
        }
        siguiente();
      });
      popup.querySelector('[data-pg-no]')!.addEventListener('click', () => popup.close());
      if (cola.length) {
        siguiente();
        setTimeout(() => popup.showModal(), 600);
      }
    }
    recalc();

    // Remove one item from the cart right here (Mari, 2026-10-04): storage, list, counts and totals.
    if (root.dataset.carrito) {
      const clave = (JSON.parse(root.dataset.carrito) as { clave: string }).clave;
      const palabra = (n: number) =>
        root.dataset.pedido?.includes('exámenes')
          ? `${n} ${n === 1 ? 'examen' : 'exámenes'}`
          : `${n} ${n === 1 ? 'guía' : 'guías'}`;
      root.addEventListener('click', (ev) => {
        const x = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-quitar-item]');
        if (!x) return;
        const id = x.dataset.quitarItem!;
        const i = items.findIndex((it) => it.id === id);
        if (i < 0) return;
        base = Math.round((base - items[i].precio) * 100) / 100;
        items.splice(i, 1);
        try {
          localStorage.setItem(clave, JSON.stringify(items.map((it) => it.id)));
        } catch {
          // Storage blocked: the change still applies to this page.
        }
        x.closest('li')?.remove();
        const n = items.length;
        root.querySelectorAll('[data-desc-corta]').forEach((el) => (el.textContent = palabra(n)));
        const vacio = root.querySelector<HTMLElement>('[data-carrito-vacio]');
        if (vacio) vacio.hidden = n > 0;
        if (state.order) state.order.items = items.map((it) => ({ id: it.id, price: it.precio }));
        recalc();
        if (n === 0) goToStep(1);
        const enviar = root.querySelector<HTMLButtonElement>('#form-datos button[type="submit"]');
        if (enviar) enviar.disabled = n === 0;
      });
    }

    /* ── Step navigation ── */
    const stepLabels: Record<number, string> = {
      1: 'Tus datos',
      2: 'Resumen',
      3: 'Consentimiento',
      4: 'Pago',
      5: 'Confirmar',
    };
    function goToStep(n: number | 'confirmation') {
      root!.querySelectorAll('.step').forEach((s) => s.classList.remove('active'));
      $(`step-${n}`)?.classList.add('active');
      root!.querySelectorAll<HTMLLIElement>('#stepper li').forEach((li) => {
        const s = Number(li.dataset.step);
        li.classList.remove('active', 'done');
        if (typeof n === 'number') {
          if (s < n) li.classList.add('done');
          if (s === n) li.classList.add('active');
        }
      });
      const progress = $('mobile-progress');
      if (typeof n === 'number') {
        $('mobile-progress-label')!.textContent = `Paso ${n} de 5 · ${stepLabels[n]}`;
        $('mobile-progress-fill')!.style.width = `${(n / 5) * 100}%`;
        progress?.removeAttribute('hidden');
      } else {
        progress?.setAttribute('hidden', '');
      }
      if (n === 5) prepareStep5();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((btn) => {
      btn.addEventListener('click', () => goToStep(Number(btn.dataset.goto)));
    });

    /* ── Step 1: exams only for the USA — the note shows as soon as another country is picked ── */
    const fueraDeUsa = () => {
      if (!('soloUsa' in root!.dataset)) return true;
      const pais = $<HTMLSelectElement>('pais')!;
      const ok = !pais.value || pais.value === 'Estados Unidos';
      $('pais-usa')!.hidden = ok;
      if (!ok) pais.classList.add('invalid');
      return ok;
    };
    $('pais')?.addEventListener('change', fueraDeUsa);

    /* ── Step 1: validate and (INTEGRATION POINT) upsert the CRM client ── */
    $('form-datos')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const required = ['nombre', 'apellido', 'email', 'telefono', 'pais', 'fuente'];
      let valid = true;
      for (const id of required) {
        const el = $<HTMLInputElement | HTMLSelectElement>(id)!;
        const empty = !el.value.trim();
        const badEmail =
          id === 'email' && !!el.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value);
        const bad = empty || badEmail;
        el.classList.toggle('invalid', bad);
        el.closest('.field')?.querySelector('.field-error')?.classList.toggle('show', bad);
        if (bad) valid = false;
      }
      if (!fueraDeUsa()) valid = false;
      if (!valid) return;

      state.client = {
        first_name: $<HTMLInputElement>('nombre')!.value.trim(),
        last_name: $<HTMLInputElement>('apellido')!.value.trim(),
        email: $<HTMLInputElement>('email')!.value.trim().toLowerCase(),
        phone: `${$<HTMLSelectElement>('cod_pais')!.value} ${$<HTMLInputElement>('telefono')!.value.trim()}`,
        country: $<HTMLSelectElement>('pais')!.value,
        acquisition_source: $<HTMLSelectElement>('fuente')!.value,
      };
      // INTEGRATION POINT: CRM_API.createOrUpdateClient(state.client) → client_id (upsert on email)
      console.info('[CRM] createOrUpdateClient', state.client);

      // The order is created as soon as the summary is reached ("checkout started").
      // INTEGRATION POINT: CRM_API.createOrder(state.order) → order_id
      state.order = {
        client_id: null,
        cycle_type: config.cycle_type,
        items: items.map((i) => ({ id: i.id, price: i.precio })),
        subtotal: config.subtotal,
        tax_rate: config.tax_rate,
        tax_amount: config.tax_amount,
        total: config.total,
        currency: config.currency,
        payment_method: null,
        payment_status: 'STARTED',
      };
      console.info('[CRM] createOrder (STARTED)', state.order);
      klarnaSegunPais(state.client.country);
      goToStep(2);
    });

    function klarnaSegunPais(pais: string) {
      const opcion = $('option-klarna');
      if (!opcion) return;
      const enUsa = pais === 'Estados Unidos';
      opcion.style.display = enUsa ? 'flex' : 'none';
      if (enUsa || state.payment_method !== 'klarna') return;
      opcion.classList.remove('selected');
      opcion.querySelector('input')!.checked = false;
      state.payment_method = null;
      $<HTMLButtonElement>('btn-pago-next')!.disabled = true;
    }

    /* ── Step 3: payment method ── */
    // Apple Pay only when the device can use it.
    // INTEGRATION POINT: replace with stripe.paymentRequest({...}).canMakePayment()
    try {
      const w = window as unknown as { ApplePaySession?: { canMakePayments?: () => boolean } };
      if (w.ApplePaySession?.canMakePayments?.()) $('option-apple_pay')!.style.display = 'flex';
    } catch {
      // Sandboxed contexts may throw when the API is touched; Apple Pay simply stays hidden.
    }
    root.querySelectorAll<HTMLLabelElement>('.pay-method').forEach((label) => {
      label.addEventListener('click', () => {
        const method = label.dataset.method as Metodo;
        root!.querySelectorAll('.pay-method').forEach((l) => l.classList.remove('selected'));
        root!.querySelectorAll('.pay-panel').forEach((p) => p.classList.remove('show'));
        label.classList.add('selected');
        label.querySelector('input')!.checked = true;
        $(`panel-${method}`)?.classList.add('show');
        state.payment_method = method;
        $<HTMLButtonElement>('btn-pago-next')!.disabled = false;
      });
    });

    /* ── Step 3: consent ── */
    const checkConsent = () => {
      const ok =
        $<HTMLInputElement>('consent-terms')!.checked &&
        $<HTMLInputElement>('consent-policy')!.checked;
      $<HTMLButtonElement>('btn-consent-next')!.disabled = !ok;
    };
    $('consent-terms')?.addEventListener('change', checkConsent);
    $('consent-policy')?.addEventListener('change', checkConsent);

    /* ── Step 5: confirm and pay (simulated) ── */
    const methodLabels: Record<Metodo, string> = {
      stripe: 'Tarjeta (Stripe)',
      apple_pay: 'Apple Pay',
      paypal: 'PayPal',
      klarna: 'Klarna',
      zelle: 'Zelle (verificación manual)',
    };
    let lastOutcome: 'paid' | 'pending' | null = null;

    function prepareStep5() {
      $('final-method')!.textContent = state.payment_method
        ? methodLabels[state.payment_method]
        : '—';
      $('step5-review')?.removeAttribute('hidden');
      $('step5-actions')?.removeAttribute('hidden');
      $('step5-success')?.setAttribute('hidden', '');
      $('step5-continue-actions')?.setAttribute('hidden', '');
      const btn = $<HTMLButtonElement>('btn-pay')!;
      btn.disabled = false;
      btn.textContent = `Confirmar y pagar ${usd(config.total)}`;
    }

    const webflow: { pago: string; mapa: MapaProductos } | null = root.dataset.webflow
      ? JSON.parse(root.dataset.webflow)
      : null;
    const seleccion = (): Seleccion => ({
      ...(root!.dataset.carrito ? {} : { ciclo: config.cycle_type }),
      items: items.map((i) => i.id),
      guias: lineas
        .filter((l) => l.id.startsWith('guia:'))
        .map((l) => ({ id: l.id.slice(5), oferta: !!l.oferta })),
      ...(lineas.find((l) => l.id === 'lectura')?.ref
        ? { lectura: lineas.find((l) => l.id === 'lectura')!.ref }
        : {}),
    });

    // Discount code: the site only carries it; Webflow's checkout checks and applies it.
    let cupon = '';
    const cuponForm = document.querySelector<HTMLFormElement>('[data-cupon-form]');
    const mostrarCupon = () => {
      cuponForm?.toggleAttribute('hidden', !!cupon);
      document.querySelector('[data-cupon-puesto]')?.toggleAttribute('hidden', !cupon);
      document.querySelector('[data-cupon-nota]')?.toggleAttribute('hidden', !cupon);
      const valor = document.querySelector('[data-cupon-valor]');
      if (valor) valor.textContent = cupon;
    };
    cuponForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const campo = cuponForm.querySelector<HTMLInputElement>('input')!;
      cupon = limpiarCupon(campo.value);
      campo.value = '';
      mostrarCupon();
    });
    document.querySelector('[data-cupon-quitar]')?.addEventListener('click', () => {
      cupon = '';
      mostrarCupon();
    });

    $('btn-pay')?.addEventListener('click', () => {
      const btn = $<HTMLButtonElement>('btn-pay')!;
      btn.disabled = true;
      btn.textContent = 'Procesando...';
      if (state.order) state.order.payment_method = state.payment_method;
      if (webflow && state.payment_method !== 'zelle') {
        // A code typed but not applied still counts: «Aplicar» is easy to skip.
        const pendiente = cuponForm?.querySelector<HTMLInputElement>('input')?.value ?? '';
        const valor = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? '';
        document.cookie = cookieTraspaso(
          {
            cupon: cupon || limpiarCupon(pendiente),
            email: valor('email'),
            nombre: `${valor('nombre')} ${valor('apellido')}`,
            pais: CODIGO_PAIS[valor('pais')],
          },
          dominioCompartido(location.hostname, new URL(webflow.pago).hostname)
        );
        const comercio = { modo: 'webflow' as const, pago: webflow.pago };
        const productos = productosDe(seleccion(), webflow.mapa);
        window.location.href =
          state.payment_method === 'klarna'
            ? urlKlarna(comercio, productos, location.pathname)
            : urlPedido(comercio, productos);
        return;
      }

      // INTEGRATION POINT — branch by provider:
      //   stripe / apple_pay → confirm PaymentIntent client-side, verify server-side via webhook
      //   paypal             → capture order via PayPal SDK, confirm via webhook
      //   zelle              → no live confirmation; order stays PENDING until verified by hand
      window.setTimeout(() => {
        if (state.payment_method === 'zelle') {
          if (state.order) state.order.payment_status = 'PENDING';
          lastOutcome = 'pending';
          $('step5-success-title')!.textContent = 'Solicitud registrada';
          $('step5-success-sub')!.textContent =
            'Verificaremos tu pago por Zelle en las próximas 24–48h y te contactaremos por email.';
        } else {
          if (state.order) state.order.payment_status = 'PAID';
          lastOutcome = 'paid';
          $('step5-success-title')!.textContent = 'Pago recibido';
          $('step5-success-sub')!.textContent = 'Tu pago fue procesado correctamente.';
        }
        console.info('[CRM] updateOrder', state.order);
        // The buyer sees the payment result before moving on — never auto-advance.
        $('step5-review')?.setAttribute('hidden', '');
        $('step5-actions')?.setAttribute('hidden', '');
        $('step5-success')?.removeAttribute('hidden');
        $('step5-continue-actions')?.removeAttribute('hidden');
      }, 900);
    });

    // The thank-you page reads what it needs from the query string (see src/pages/gracias).
    $('btn-continue-after-pay')?.addEventListener('click', () => {
      const q = new URLSearchParams();
      if (lastOutcome === 'pending') q.set('pago', 'zelle');
      const guias = [
        ...items.map((it) => it.id),
        ...lineas.filter((l) => l.id.startsWith('guia:')).map((l) => l.id.slice(5)),
      ];
      if (root!.dataset.gracias?.includes('/tienda')) q.set('guias', guias.join(','));
      if (lineas.some((l) => l.id === 'lectura')) q.set('lectura', '1');
      const query = q.toString();
      window.location.href = `${root!.dataset.gracias}${query ? `?${query}` : ''}`;
    });
  }
</script>
