---
/**
 * Five-step checkout: datos → resumen → consentimiento → pago → confirmar, then the confirmation
 * screen. It sells either one cycle (fixed price, booking embed on confirmation) or, with
 * `carrito`, the lab tests the visitor picked on /examenes/: the script then reads the selection
 * from localStorage and rewrites the summary and every amount on the page.
 *
 * This is the presentation prototype Mari designed. Payment providers, the CRM calls and the
 * Calendly widget are NOT wired: every place where a real integration mounts is marked
 * `INTEGRATION POINT` in the markup or the script, and the "payment" is simulated client-side.
 *
 * Amounts are rendered on the server from data/oferta so the page is correct without JS; the
 * script re-reads them from `data-config` for the dynamic bits (button label, Zelle total).
 */
import { zelle } from '../../data/oferta';
import { desglose, TAX_RATE, usd } from '../../lib/precio';
import { href } from '../../lib/url';
import { comercio, legal, marca } from '../../data/site';
import { mapaProductos, productoGravado } from '../../data/pedido-webflow';
import { terminos, casillas } from '../../data/terminos';
import { bloque } from '../../lib/datos/bloques';

/** What the checkout sells. A `Ciclo` from data/oferta satisfies it as is. */
export interface ProductoCheckout {
  id: string;
  nombre: string;
  etiqueta: string;
  descripcionCorta: string;
  subtotal: number;
  incluyeCheckout: string[];
  /** A gift shown in the summary (the Initial Layer Cycle's guide, on every sale). */
  bonus?: string;
  confirmacion: { titulo: string; texto: string; calendlyUrl?: string; calendlyEtiqueta?: string };
}

/** Lab-test mode: the catalogue (id → name, price) and where to send an empty cart. */
export interface CarritoCheckout {
  clave: string;
  volver: string;
  catalogo: { id: string; nombre: string; precio: number }[];
}

/** Copy that depends on what is sold; defaults are the cycles' (sessions, booking). */
export interface TextosCheckout {
  /** Subtitle of step 1. */
  datos?: string;
  /** Note on the confirmation screen when Zelle is pending. */
  zellePendiente?: string;
  /** How the order is named in the Zelle confirmation («tu …»). */
  pedido?: string;
}

/** A guide that can be added to the order before paying (Verónica, changes 12 and 46). */
export interface GuiaExtra {
  id: string;
  nombre: string;
  precio: number;
  portada?: string;
}

/** One way to book the reading of the tests (change 39): 1 or 2 appointments. */
export interface LecturaExtra {
  id: string;
  rotulo: string;
  nombre: string;
  precio: number;
  texto: string;
  /** Marked «Recomendada» and chosen by default (Verónica, 2026-10-03 voice note: the option
   * people should pick, a visual nudge towards the two appointments). */
  recomendada?: boolean;
}

/** What can be added on the summary step; every amount is recalculated live. */
export interface ExtrasCheckout {
  /** «¿Deseas adquirir alguna de nuestras guías?» */
  guias?: GuiaExtra[];
  /** Shop only: a popup on arrival suggesting the next guide, at this discount (0–1). */
  popupGuias?: { orden: string[]; descuento: number };
  /** Lab tests only: the Sí/No reading appointment and its two options. */
  lectura?: LecturaExtra[];
  /** Lab tests only: the lab's own fee per test, shown apart and without tax. */
  feePorItem?: number;
}

interface Props {
  ciclo: ProductoCheckout;
  carrito?: CarritoCheckout;
  extras?: ExtrasCheckout;
  textos?: TextosCheckout;
  /** Label of the product row in the reviews ("Programa" for cycles). */
  etiquetaProducto?: string;
}
const { ciclo, carrito, extras, textos = {}, etiquetaProducto = 'Programa' } = Astro.props;
// Verónica's terms show before paying in the 1:1 plans (no cart) and in the exams checkout, which
// can add a reading appointment (Mari, 2026-10-11). The shop keeps the plain checkboxes.
const conTerminos = !carrito || !!extras?.lectura;
// Exams are only paid in the USA (Mari, 2026-10-11): from any other country the buyer writes to
// Verónica on Instagram instead of going on.
const soloUsa = !!extras?.lectura;
const contactoDirecto = bloque('sitio', 'continuidad').enlace as string;
// After paying, each product has its own thank-you page (src/pages/gracias).
const gracias = href(
  `/gracias/${carrito ? (extras?.lectura ? 'examenes' : 'tienda') : ciclo.id.toLowerCase().replaceAll('_', '-')}/`
);
const cicloGravado = !carrito && productoGravado(mapaProductos.ciclos[ciclo.id]);
const p = desglose(ciclo.subtotal, cicloGravado ? TAX_RATE : 0);
const impuestoPct = Math.round(TAX_RATE * 100);

const config = {
  cycle_type: ciclo.id,
  cycle_label: ciclo.nombre,
  subtotal: p.subtotal,
  gravado: cicloGravado,
  tax_rate: TAX_RATE,
  tax_amount: p.impuesto,
  total: p.total,
  currency: 'USD',
};
const carritoDatos = carrito && {
  ...carrito,
  catalogo: carrito.catalogo.map((i) => ({
    ...i,
    gravado: productoGravado(mapaProductos.examenes[i.id] ?? mapaProductos.guias[i.id]?.producto),
  })),
};
const extrasDatos = extras && {
  ...extras,
  guias: extras.guias?.map((g) => ({
    ...g,
    gravado: productoGravado(mapaProductos.guias[g.id]?.producto),
    ofertaGravada: productoGravado(mapaProductos.guias[g.id]?.oferta),
  })),
  lectura: extras.lectura?.map((o) => ({
    ...o,
    gravado: productoGravado(mapaProductos.ciclos[o.id]),
  })),
};

const pasos = [
  { n: 1, label: 'Tus datos' },
  { n: 2, label: 'Resumen' },
  { n: 3, label: 'Consentimiento' },
  { n: 4, label: 'Pago' },
  { n: 5, label: 'Confirmar' },
];

const codigosPais = ['+1', '+52', '+34', '+57', '+54', '+56', '+51', '+593', '+58'];
const paises = [
  'Estados Unidos',
  'México',
  'España',
  'Colombia',
  'Argentina',
  'Chile',
  'Perú',
  'Ecuador',
  'Venezuela',
  'República Dominicana',
  'Otro',
];
const fuentes = ['Instagram', 'Referido', 'Google', 'Cliente anterior', 'Otro'];

const enWebflow = comercio.modo === 'webflow';
const metodos = [
  { id: 'stripe', label: 'Tarjeta', sub: 'Pago seguro procesado por Stripe', icon: 'STRIPE' },
  { id: 'apple_pay', label: 'Apple Pay', sub: 'Pago rápido con tu wallet de Apple', icon: '' },
  { id: 'paypal', label: 'PayPal', sub: 'Paga con tu cuenta de PayPal', icon: 'PAYPAL' },
  ...(enWebflow && comercio.klarna
    ? [{ id: 'klarna', label: 'Klarna', sub: 'Paga en cuotas', icon: 'KLARNA' }]
    : []),
  { id: 'zelle', label: 'Zelle', sub: 'Verificación manual · 24–48h', icon: 'ZELLE' },
];
const webflow = enWebflow ? { pago: comercio.pago, mapa: mapaProductos } : null;
---

<div
  class="checkout-shell"
  id="checkout"
  data-config={JSON.stringify(config)}
  data-carrito={carritoDatos ? JSON.stringify(carritoDatos) : undefined}
  data-pedido={textos.pedido}
  data-gracias={gracias}
  data-solo-usa={soloUsa ? '' : undefined}
  data-extras={extrasDatos ? JSON.stringify(extrasDatos) : undefined}
  data-webflow={webflow ? JSON.stringify(webflow) : undefined}
>
  <main class="checkout-main" id="main">
    <div class="mobile-progress" id="mobile-progress">
      <div class="mobile-progress-label" id="mobile-progress-label">Paso 1 de 5 · Tus datos</div>
      <div class="mobile-progress-track">
        <div class="mobile-progress-fill" id="mobile-progress-fill"></div>
      </div>
    </div>

    <ol class="stepper" id="stepper">
      {
        pasos.map((s) => (
          <li data-step={s.n} class:list={{ active: s.n === 1 }}>
            <span>{String(s.n).padStart(2, '0')}</span>
            {s.label}
          </li>
        ))
      }
    </ol>

    <!-- STEP 1 — TUS DATOS -->
    <section class="step active" id="step-1">
      <p class="step-eyebrow">Paso 1</p>
      <h1 class="step-title">Tus datos</h1>
      <p class="step-subtitle">
        {
          textos.datos ??
            `Esta información crea tu perfil como cliente de ${marca.nombre} y nos permite prepararte antes de tu primera sesión.`
        }
      </p>

      <form id="form-datos" novalidate>
        <div class="form-grid">
          <div class="field">
            <label for="nombre">Nombre *</label>
            <input type="text" id="nombre" name="nombre" required autocomplete="given-name" />
            <span class="field-error">Ingresa tu nombre.</span>
          </div>
          <div class="field">
            <label for="apellido">Apellido *</label>
            <input type="text" id="apellido" name="apellido" required autocomplete="family-name" />
            <span class="field-error">Ingresa tu apellido.</span>
          </div>
          <div class="field full">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
            <span class="field-error">Ingresa un email válido.</span>
          </div>
          <div class="field full">
            <label for="telefono">Teléfono *</label>
            <div class="phone-row">
              <select id="cod_pais" name="cod_pais" aria-label="Código de país">
                {codigosPais.map((c) => <option value={c}>{c}</option>)}
                <option value="+other">+ otro</option>
              </select>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                required
                placeholder="809 555 0101"
                autocomplete="tel-national"
              />
            </div>
            <span class="field-error">Ingresa un número de teléfono válido.</span>
          </div>
          <div class="field full">
            <label for="pais">País *</label>
            <select id="pais" name="pais" required>
              <option value="">Selecciona tu país</option>
              {paises.map((c) => <option>{c}</option>)}
            </select>
            <span class="field-error">Selecciona tu país.</span>
            {
              soloUsa && (
                <p class="solo-usa" id="pais-usa" hidden>
                  <strong>Los exámenes son válidos solo para pago en USA.</strong> Si te encuentras
                  en Latinoamérica,{' '}
                  <a href={contactoDirecto} target="_blank" rel="noopener">
                    comunícate conmigo.
                  </a>
                </p>
              )
            }
          </div>
          <div class="field full">
            <label for="fuente">¿Cómo conociste a {marca.nombre}? *</label>
            <select id="fuente" name="fuente" required>
              <option value="">Selecciona una opción</option>
              {fuentes.map((f) => <option>{f}</option>)}
            </select>
            <span class="field-error">Selecciona una opción.</span>
          </div>
        </div>

        <div class="step-actions">
          <span></span>
          <button type="submit" class="btn btn-primary">Continuar</button>
        </div>
      </form>
    </section>

    <!-- STEP 2 — RESUMEN -->
    <section class="step" id="step-2">
      <p class="step-eyebrow">Paso 2</p>
      <h1 class="step-title">Resumen de tu compra</h1>
      <p class="step-subtitle">
        Revisa los detalles de tu {ciclo.nombre} antes de continuar al pago.
      </p>

      <div class="review-card">
        <div class="review-row"><span>{etiquetaProducto}</span><span>{ciclo.nombre}</span></div>
        <p class="review-note" data-desc-corta>{ciclo.descripcionCorta}</p>
        <div data-lineas-extra></div>
        <div class="review-row">
          <span>Subtotal</span><span data-subtotal>{usd(p.subtotal)}</span>
        </div>
        <div class="review-row" data-fila-impuesto hidden={p.impuesto === 0}>
          <span>Impuesto ({impuestoPct}%)</span><span data-impuesto>{usd(p.impuesto)}</span>
        </div>
        <div class="review-row" data-fila-fee hidden>
          <span>Cargo del laboratorio (servicio y autorización)</span><span data-fee></span>
        </div>
        <div class="review-row"><span>Total</span><span data-total>{usd(p.total)}</span></div>
      </div>

      {
        extras?.lectura && (
          <div class="extra-bloque lectura" data-lectura>
            <div class="lectura-cab">
              <span class="lectura-icono" aria-hidden="true">
                <svg
                  viewBox="0 0 32 32"
                  width="28"
                  height="28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M8 4h11l5 5v9" />
                  <path d="M19 4v5h5" />
                  <path d="M8 4v24h9" />
                  <path d="M12 13h8M12 17h6M12 21h3" />
                  <circle cx="23" cy="23" r="4.5" />
                  <path d="m26.3 26.3 3.2 3.2" />
                </svg>
              </span>
              <p class="extra-titulo">¿Quieres agregar una cita para la lectura de tu examen?</p>
            </div>
            <div class="extra-sino" role="radiogroup" aria-label="Agregar cita de lectura">
              <label class="sino">
                <input type="radio" name="lectura-sino" value="no" checked />
                <span>No, por ahora</span>
              </label>
              <label class="sino">
                <input type="radio" name="lectura-sino" value="si" />
                <span>Sí, quiero agregarla</span>
              </label>
            </div>
            <div class="extra-opciones" data-lectura-opciones hidden>
              {extras.lectura.map((o, i) => (
                <label class:list={['opcion', { recomendada: o.recomendada }]}>
                  <input
                    type="radio"
                    name="lectura-opcion"
                    value={o.id}
                    checked={extras.lectura!.some((x) => x.recomendada) ? !!o.recomendada : i === 0}
                  />
                  {o.recomendada && <span class="opcion-badge">Recomendada</span>}
                  <span class="opcion-cab">
                    <strong>{o.rotulo}</strong> · {o.nombre}
                    <span class="opcion-precio">{usd(o.precio)}</span>
                  </span>
                  <span class="opcion-texto">{o.texto}</span>
                </label>
              ))}
              <p class="extra-aviso">
                <strong>Importante:</strong> se lee 1 examen por cita. Además de leer tu examen,
                escuchamos tu historia y analizamos tus formularios para crear tu plan de acción
                integral.
              </p>
            </div>
          </div>
        )
      }

      {
        extras?.guias && !extras.popupGuias && (
          <div class="extra-bloque" data-guias>
            <p class="extra-titulo">¿Deseas adquirir alguna de nuestras guías?</p>
            <div class="guias">
              {extras.guias.map((g) => (
                <label class="guia">
                  <input type="checkbox" value={g.id} data-guia />
                  {g.portada && (
                    <img src={g.portada} alt="" width="56" height="74" loading="lazy" />
                  )}
                  <span class="guia-nombre">{g.nombre}</span>
                  <span class="guia-precio">{usd(g.precio)}</span>
                  <span class="guia-check" aria-hidden="true">
                    <span class="no">Agregar</span>
                    <span class="si">Agregada ✓</span>
                  </span>
                </label>
              ))}
            </div>
          </div>
        )
      }

      <div class="step-actions">
        <button type="button" class="link-btn" data-goto="1">&larr; Editar mis datos</button>
        <button type="button" class="btn btn-primary" data-goto="3">Continuar</button>
      </div>
    </section>

    <!-- STEP 3 — CONSENTIMIENTO (Mari, 2026-10-11: between the summary and the payment) -->
    <section class="step" id="step-3">
      <p class="step-eyebrow">Paso 3</p>
      <h1 class="step-title">Consentimiento</h1>
      <p class="step-subtitle">Antes de continuar al pago.</p>

      <div class="consent-box">
        {
          conTerminos && (
            <div class="terminos" tabindex="0" aria-labelledby="terminos-t">
              <p class="terminos-t" id="terminos-t">
                Términos y políticas de las asesorías
              </p>
              {terminos.map((t) => (
                <>
                  {t.grupo && <p class="terminos-grupo">{t.grupo}</p>}
                  <h2 class="terminos-h">{t.titulo}</h2>
                  {t.parrafos.map((p) => (
                    <p>{p}</p>
                  ))}
                </>
              ))}
            </div>
          )
        }
        <div class="consent-check">
          <input type="checkbox" id="consent-terms" />
          <label for="consent-terms">
            {
              conTerminos ? (
                casillas[0]
              ) : (
                <>
                  He leído y acepto los{' '}
                  <a href={href(legal.terminos)} target="_blank" rel="noopener">
                    Términos de Servicio
                  </a>{' '}
                  y la{' '}
                  <a href={href(legal.privacidad)} target="_blank" rel="noopener">
                    Política de Privacidad
                  </a>{' '}
                  de {marca.nombre}.
                </>
              )
            }
          </label>
        </div>
        <div class="consent-check">
          <input type="checkbox" id="consent-policy" />
          <label for="consent-policy">
            {
              conTerminos
                ? casillas[1]
                : 'Entiendo la política de reactivación de 6 meses y las condiciones de reprogramación de sesiones.'
            }
          </label>
        </div>
        <p class="medical-disclaimer">
          {marca.nombre} ofrece orientación en nutrición funcional y bienestar celular. Esto no sustituye
          atención médica, diagnóstico ni tratamiento. Consulta siempre a tu médico para cualquier condición
          de salud. Ver <a href={href(legal.avisoMedico)} target="_blank" rel="noopener"
            >aviso médico completo</a
          >.
        </p>
      </div>

      <div class="step-actions">
        <button type="button" class="link-btn" data-goto="2">&larr; Atrás</button>
        <button type="button" class="btn btn-primary" id="btn-consent-next" data-goto="4" disabled>
          Continuar
        </button>
      </div>
    </section>

    <!-- STEP 4 — MÉTODO DE PAGO -->
    <section class="step" id="step-4">
      <p class="step-eyebrow">Paso 4</p>
      <h1 class="step-title">Método de pago</h1>
      <p class="step-subtitle">Elige cómo prefieres completar tu pago.</p>

      <div class="pay-methods" id="pay-methods">
        {
          metodos.map((m) => (
            <label class="pay-method" data-method={m.id} id={`option-${m.id}`}>
              <input type="radio" name="metodo_pago" value={m.id} />
              <span>
                <span class="pay-method-label">{m.label}</span>
                <br />
                <span class="pay-method-sub">{m.sub}</span>
              </span>
              <span class="pay-method-icon">{m.icon}</span>
            </label>
          ))
        }
      </div>

      <!-- Panels: real integrations mount here -->
      {
        !enWebflow && (
          <>
            <div class="pay-panel" id="panel-stripe">
              <div class="integration-placeholder">
                INTEGRATION POINT: Stripe Elements / Payment Element
                <br />
                stripe.elements().create('payment').mount('#panel-stripe')
              </div>
            </div>
            <div class="pay-panel" id="panel-apple_pay">
              <div class="integration-placeholder">
                INTEGRATION POINT: Stripe Payment Request Button (Apple Pay)
                <br />
                paymentRequestButton.mount('#panel-apple_pay')
              </div>
            </div>
            <div class="pay-panel" id="panel-paypal">
              <div class="integration-placeholder">
                INTEGRATION POINT: PayPal Buttons SDK
                <br />
                paypal.Buttons().render('#panel-paypal')
              </div>
            </div>
          </>
        )
      }
      <div class="pay-panel" id="panel-zelle">
        <div class="zelle-box">
          Envía tu pago por Zelle a:
          <strong class="addr-line">{zelle.titular}</strong>
          <strong class="addr-line">{zelle.correo}</strong>
          <div class="zelle-note">
            Monto exacto a enviar: <strong class="amount" data-total>{usd(p.total)}</strong>.<br
            /><br />
            Tu reserva quedará marcada como <em>pendiente de verificación</em> hasta que confirmemos tu
            pago manualmente (24–48h). Te contactaremos por email para agendar en cuanto se verifique.
          </div>
        </div>
      </div>

      <div class="step-actions">
        <button type="button" class="link-btn" data-goto="3">&larr; Atrás</button>
        <button type="button" class="btn btn-primary" id="btn-pago-next" data-goto="5" disabled>
          Continuar
        </button>
      </div>
    </section>

    <!-- STEP 5 — CONFIRMAR Y PAGAR -->
    <section class="step" id="step-5">
      <p class="step-eyebrow">Paso 5</p>
      <h1 class="step-title">Confirmar y pagar</h1>
      <p class="step-subtitle">Revisa una última vez antes de confirmar.</p>

      <div class="review-card" id="step5-review">
        <div class="review-row"><span>{etiquetaProducto}</span><span>{ciclo.nombre}</span></div>
        <div class="review-row"><span>Método de pago</span><span id="final-method">—</span></div>
        <div class="review-row">
          <span>Total a pagar</span><span data-total>{usd(p.total)}</span>
        </div>
      </div>

      <div class="step-actions" id="step5-actions">
        <button type="button" class="link-btn" data-goto="4">&larr; Atrás</button>
        <button type="button" class="btn btn-primary" id="btn-pay"
          >Confirmar y pagar {usd(p.total)}</button
        >
      </div>

      <div class="review-card pay-success" id="step5-success" hidden>
        <svg viewBox="0 0 40 40" fill="none" width="40" height="40" aria-hidden="true">
          <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="1.4"></circle>
          <path
            d="M12 21l5 5 11-12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <h2 class="pay-success-title" id="step5-success-title">Pago recibido</h2>
        <p class="pay-success-sub" id="step5-success-sub">Tu pago fue procesado correctamente.</p>
      </div>
      <div class="step-actions" id="step5-continue-actions" hidden>
        <span></span>
        <button type="button" class="btn btn-primary" id="btn-continue-after-pay">Continuar</button>
      </div>
    </section>

    <!-- CONFIRMACIÓN -->
  </main>

  <!-- RESUMEN (sticky) -->
  <aside class="summary-card" id="summary-card">
    <span class="summary-tag">{ciclo.etiqueta}</span>
    <h2 class="summary-title">{ciclo.nombre}</h2>
    <p class="summary-desc">{ciclo.descripcionCorta}</p>
    <div data-lineas-extra></div>
    <div class="summary-line">
      <span>Subtotal</span><span data-subtotal>{usd(p.subtotal)}</span>
    </div>
    <div class="summary-line" data-fila-impuesto hidden={p.impuesto === 0}>
      <span>Impuesto ({impuestoPct}%)</span><span data-impuesto>{usd(p.impuesto)}</span>
    </div>
    <div class="summary-line" data-fila-fee hidden>
      <span>Cargo del laboratorio</span><span data-fee></span>
    </div>
    <div class="summary-line total"><span>Total</span><span data-total>{usd(p.total)}</span></div>
    {
      enWebflow && (
        <div class="cupon" data-cupon>
          <form class="cupon-form" data-cupon-form>
            <label for="cupon-codigo">Código de descuento</label>
            <div class="cupon-fila">
              <input
                id="cupon-codigo"
                name="cupon"
                type="text"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                maxlength="64"
              />
              <button type="submit" class="cupon-btn">
                Aplicar
              </button>
            </div>
          </form>
          <div class="cupon-puesto" data-cupon-puesto hidden>
            <span>
              Código <strong data-cupon-valor />
            </span>
            <button type="button" class="link-btn" data-cupon-quitar>
              Quitar
            </button>
          </div>
          <p class="cupon-nota" data-cupon-nota hidden>
            El descuento se aplica en el último paso, al pagar con tarjeta, Apple Pay o PayPal.
          </p>
        </div>
      )
    }
    <ul class="summary-includes" data-incluye>
      {ciclo.incluyeCheckout.map((i) => <li>{i}</li>)}
    </ul>
    {
      ciclo.bonus && (
        <p class="summary-bonus">
          <strong>Bonus</strong> {ciclo.bonus}
        </p>
      )
    }
    {
      carrito && (
        <p class="summary-empty" data-carrito-vacio hidden>
          Tu selección está vacía. <a href={carrito.volver}>Elige tus exámenes</a>
        </p>
      )
    }
  </aside>

  {
    extras?.popupGuias && extras.guias && (
      <dialog class="popup-guia" data-popup-guia aria-labelledby="popup-guia-t">
        <p class="pg-eyebrow">Solo en este pedido</p>
        <p class="pg-titulo" id="popup-guia-t">
          ¿La sumas a tu pedido?
        </p>
        <div class="pg-item">
          <img data-pg-portada alt="" width="96" height="128" />
          <div>
            <p class="pg-nombre" data-pg-nombre />
            <p class="pg-precios">
              <s data-pg-antes /> <strong data-pg-ahora />
            </p>
            <p class="pg-texto">
              Precio especial con {Math.round(extras.popupGuias.descuento * 100)}% de descuento,
              válido solo ahora.
            </p>
          </div>
        </div>
        <div class="pg-acciones">
          <button type="button" class="btn btn-primary" data-pg-si>
            Agregar a mi pedido
          </button>
          <button type="button" class="link-btn" data-pg-no>
            No, gracias
          </button>
        </div>
      </dialog>
    )
  }
</div>

<style>
  .checkout-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 40px 120px;
    display: grid;
    grid-template-columns: 1fr 380px;
