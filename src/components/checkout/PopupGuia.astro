---
import { Image } from 'astro:assets';
import { DESCUENTO_GUIAS, conDescuento, usd, type LineaPedido } from '../../lib/precio';
import type { GuiaOferta } from './tipos';

interface Props {
  sugerencias: GuiaOferta[];
}
const { sugerencias } = Astro.props;
const pct = Math.round(DESCUENTO_GUIAS * 100);

const linea = (g: GuiaOferta): LineaPedido => ({
  id: g.id,
  nombre: g.nombre,
  precio: conDescuento(g.precio),
  precioLista: g.precio,
  tipo: 'guia',
  grupo: 'popup',
});
---

<dialog class="popup-guia" aria-labelledby="popup-guia-titulo" data-popup-guia>
  <form method="dialog" class="pg-cerrar-form">
    <button class="pg-cerrar" value="cerrar" aria-label="Cerrar">×</button>
  </form>
  <p class="pg-eyebrow">Solo en este pedido</p>
  <h2 class="pg-titulo" id="popup-guia-titulo">¿La sumas a tu pedido?</h2>
  {
    sugerencias.map((g) => (
      <article class="pg-item" data-candidato={JSON.stringify(linea(g))} hidden>
        <Image src={g.portada} alt={`Portada de ${g.nombre}`} width={240} class="pg-portada" />
        <div class="pg-cuerpo">
          <p class="pg-nombre">{g.nombre}</p>
          <p class="pg-precios">
            <s>{usd(g.precio)}</s>
            <strong>{usd(conDescuento(g.precio))}</strong>
          </p>
          <p class="pg-texto">Precio especial con {pct}% de descuento, válido solo ahora.</p>
        </div>
      </article>
    ))
  }
  <p class="pg-agregada" data-pg-agregada hidden>
    Listo, la agregamos a tu pedido. ¿Y esta también?
  </p>
  <div class="pg-acciones">
    <button type="button" class="btn btn-primary" data-pg-agregar autofocus
      >Agregar a mi pedido</button
    >
    <button type="button" class="pg-no" data-pg-no>No, gracias</button>
  </div>
</dialog>

<style>
  .popup-guia {
    margin: auto;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 34px 32px 28px;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-bone);
    color: var(--color-charcoal);
    box-shadow: 0 40px 80px -30px rgb(48 47 42 / 0.55);
  }
  .popup-guia[open] {
    animation: pg-entrar 0.35s var(--ease-out-soft);
  }
  .popup-guia::backdrop {
    background: rgb(35 34 30 / 0.55);
    backdrop-filter: blur(3px);
  }
  @keyframes pg-entrar {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  .pg-cerrar-form {
    position: absolute;
    top: 12px;
    right: 14px;
  }
  .pg-cerrar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgb(48 47 42 / 0.06);
    font-size: 22px;
    line-height: 1;
    color: var(--color-charcoal);
  }
  .pg-eyebrow {
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clay-rich);
    margin: 0 0 6px;
    padding-right: 44px;
  }
  .pg-titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.1;
    margin: 0 0 18px;
  }
  .pg-item:not([hidden]) {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 22px;
    align-items: center;
  }
  .pg-portada {
    width: 132px;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 14px 28px -14px rgb(48 47 42 / 0.55);
  }
  .pg-nombre {
    font-weight: 800;
    font-size: 17px;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .pg-precios {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin: 0 0 10px;
  }
  .pg-precios s {
    color: rgb(48 47 42 / 0.5);
  }
  .pg-precios strong {
    font-weight: 800;
    font-size: 22px;
  }
  .pg-texto {
    font-size: 14.5px;
    line-height: 1.55;
    color: rgb(48 47 42 / 0.75);
    margin: 0;
  }
  .pg-agregada {
    margin: 18px 0 0;
    font-weight: 700;
    font-size: 14px;
    color: var(--color-olive);
  }
  .pg-acciones {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .pg-no {
    background: none;
    border: 0;
    font-weight: 700;
    font-size: 14px;
    color: rgb(48 47 42 / 0.7);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 520px) {
    .popup-guia {
      padding: 30px 20px 22px;
    }
    .pg-item:not([hidden]) {
      grid-template-columns: 96px 1fr;
      gap: 16px;
    }
    .pg-portada {
      width: 96px;
    }
  }
</style>

<script>
  import type { LineaPedido } from '../../lib/precio';
  import {
    EVENTO_EXTRA,
    EVENTO_QUITADO,
    alCarrito,
    emitir,
    escuchar,
    type DetalleQuitado,
  } from './eventos';

  const VISTO = 'vw-popup-guia-visto';
  const dialogo = document.querySelector<HTMLDialogElement>('[data-popup-guia]');

  const yaVisto = () => {
    try {
      return sessionStorage.getItem(VISTO) === '1';
    } catch {
      return false;
    }
  };
  const marcarVisto = () => {
    try {
      sessionStorage.setItem(VISTO, '1');
    } catch {
      return;
    }
  };

  if (dialogo) {
    const items = [...dialogo.querySelectorAll<HTMLElement>('[data-candidato]')];
    const lineaDe = (el: HTMLElement): LineaPedido => JSON.parse(el.dataset.candidato ?? '{}');
    const aviso = dialogo.querySelector<HTMLElement>('[data-pg-agregada]')!;
    const agregadas: LineaPedido[] = [];
    let enCarrito = new Set<string>();
    let actual: HTMLElement | null = null;

    const siguiente = () =>
      items.find((el) => {
        const id = lineaDe(el).id;
        return !enCarrito.has(id) && !agregadas.some((l) => l.id === id);
      }) ?? null;

    const mostrar = (el: HTMLElement) => {
      items.forEach((i) => (i.hidden = i !== el));
      actual = el;
    };

    dialogo.querySelector('[data-pg-agregar]')?.addEventListener('click', () => {
      if (!actual) return;
      agregadas.push(lineaDe(actual));
      emitir(EVENTO_EXTRA, { grupo: 'popup', lineas: [...agregadas] });
      const otra = siguiente();
      if (otra) {
        mostrar(otra);
        aviso.hidden = false;
      } else {
        dialogo.close();
      }
    });
    dialogo.querySelector('[data-pg-no]')?.addEventListener('click', () => dialogo.close());
    dialogo.addEventListener('click', (e) => {
      if (e.target !== dialogo) return;
      const r = dialogo.getBoundingClientRect();
      const fuera =
        e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      if (fuera) dialogo.close();
    });
    dialogo.addEventListener('close', marcarVisto);

    escuchar<DetalleQuitado>(EVENTO_QUITADO, ({ grupo, id }) => {
      if (grupo !== 'popup') return;
      const i = agregadas.findIndex((l) => l.id === id);
      if (i >= 0) agregadas.splice(i, 1);
    });

    alCarrito((ids) => {
      enCarrito = new Set(ids);
      const primera = siguiente();
      if (!ids.length || !primera || yaVisto()) return;
      mostrar(primera);
      window.setTimeout(() => dialogo.showModal(), 600);
    });
  }
</script>
