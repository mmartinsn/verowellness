---
import { usd, type LineaPedido } from '../../lib/precio';
import type { OpcionLectura } from './tipos';

interface Props {
  opciones: OpcionLectura[];
}
const { opciones } = Astro.props;

const linea = (o: OpcionLectura): LineaPedido => ({
  id: o.id,
  nombre: `Lectura de examen · ${o.rotulo} (${o.nombre})`,
  precio: o.precio,
  tipo: 'cita',
  grupo: 'lectura',
});
---

<section class="lectura" aria-labelledby="lectura-titulo" data-lectura data-valida="false">
  <p class="lc-eyebrow">Antes de pagar</p>
  <h2 class="lc-titulo" id="lectura-titulo">
    ¿Quieres agregar una cita para la lectura de tu examen?
  </h2>

  <div class="lc-sino" role="radiogroup" aria-labelledby="lectura-titulo">
    <label class="lc-chip">
      <input type="radio" name="lectura" value="si" />
      <span>Sí</span>
    </label>
    <label class="lc-chip">
      <input type="radio" name="lectura" value="no" />
      <span>No</span>
    </label>
  </div>
  <p class="lc-error" role="alert" hidden>Marca si quieres agregar una cita para continuar.</p>

  <fieldset class="lc-opciones" data-lectura-opciones hidden>
    <legend class="sr-only">¿Cuántas citas?</legend>
    {
      opciones.map((o, i) => (
        <label class="lc-opcion">
          <input
            type="radio"
            name="lectura-citas"
            value={o.id}
            checked={i === 0}
            data-linea={JSON.stringify(linea(o))}
          />
          <span class="lc-cabeza">
            <span class="lc-rotulo">{o.rotulo}</span>
            <span class="lc-precio">{usd(o.precio)}</span>
          </span>
          <span class="lc-texto">{o.texto}</span>
        </label>
      ))
    }
  </fieldset>

  <p class="lc-aviso">
    <strong>Importante:</strong> se lee 1 examen por cita. Además de leer tu examen, escuchamos tu historia
    y analizamos tus formularios para crear tu plan de acción integral.
  </p>
</section>

<style>
  .lectura {
    margin-top: 8px;
    padding: 26px 28px;
    border-radius: var(--radius-lg);
    border: 1.5px dashed rgb(214 154 124 / 0.6);
    background: var(--color-surface-warm);
  }
  .lc-eyebrow {
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clay-deep);
    margin: 0 0 6px;
  }
  .lc-titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .lc-sino {
    display: flex;
    gap: 10px;
  }
  .lc-chip {
    position: relative;
    cursor: pointer;
  }
  .lc-chip input,
  .lc-opcion input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .lc-chip span {
    display: inline-block;
    min-width: 92px;
    text-align: center;
    font-weight: 800;
    font-size: 14px;
    padding: 11px 22px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-charcoal);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .lc-chip input:checked + span {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .lc-chip input:focus-visible + span,
  .lc-opcion:has(input:focus-visible) {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 3px;
  }
  .lc-error {
    margin: 10px 0 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-error);
  }
  .lc-opciones {
    border: 0;
    padding: 0;
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .lc-opciones[hidden] {
    display: none;
  }
  .lc-opcion {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    background: var(--color-white);
    border: 1.5px solid rgb(48 47 42 / 0.12);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .lc-opcion:has(input:checked) {
    border-color: var(--color-clay-deep);
    box-shadow: 0 0 0 1px var(--color-clay-deep) inset;
  }
  .lc-cabeza {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .lc-rotulo {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lc-precio {
    font-weight: 800;
    font-size: 18px;
  }
  .lc-texto {
    font-size: 14px;
    line-height: 1.5;
    color: rgb(48 47 42 / 0.75);
  }
  .lc-aviso {
    margin: 18px 0 0;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: rgb(231 183 160 / 0.22);
    font-size: 14px;
    line-height: 1.55;
  }
  .lc-aviso strong {
    font-weight: 800;
  }
  @media (max-width: 560px) {
    .lectura {
      padding: 22px 18px;
    }
    .lc-opciones {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import type { LineaPedido } from '../../lib/precio';
  import { EVENTO_EXTRA, emitir } from './eventos';

  const panel = document.querySelector<HTMLElement>('[data-lectura]');
  if (panel) {
    const opciones = panel.querySelector<HTMLElement>('[data-lectura-opciones]')!;
    const error = panel.querySelector<HTMLElement>('.lc-error')!;
    const elegida = (): LineaPedido | null => {
      const r = panel.querySelector<HTMLInputElement>('input[name="lectura-citas"]:checked');
      return r ? JSON.parse(r.dataset.linea ?? '{}') : null;
    };
    const publicar = () => {
      const si = panel.querySelector<HTMLInputElement>('input[name="lectura"]:checked')?.value;
      panel.dataset.valida = String(!!si);
      opciones.hidden = si !== 'si';
      if (si) error.hidden = true;
      const l = si === 'si' ? elegida() : null;
      emitir(EVENTO_EXTRA, { grupo: 'lectura', lineas: l ? [l] : [] });
    };
    panel
      .querySelectorAll<HTMLInputElement>('input[type="radio"]')
      .forEach((r) => r.addEventListener('change', publicar));
  }
</script>
