---
import { Image } from 'astro:assets';
import { DESCUENTO_GUIAS, conDescuento, usd, type LineaPedido } from '../../lib/precio';
import type { GuiaOferta } from './tipos';

interface Props {
  guias: GuiaOferta[];
}
const { guias } = Astro.props;
const pct = Math.round(DESCUENTO_GUIAS * 100);

const linea = (g: GuiaOferta): LineaPedido => ({
  id: g.id,
  nombre: g.nombre,
  precio: conDescuento(g.precio),
  precioLista: g.precio,
  tipo: 'guia',
  grupo: 'guias',
});
---

<section class="oferta-guias" aria-labelledby="oferta-guias-titulo" data-oferta-guias>
  <p class="og-eyebrow">Antes de pagar</p>
  <h2 class="og-titulo" id="oferta-guias-titulo">¿Deseas adquirir alguna de nuestras guías?</h2>
  <p class="og-sub">Agrégalas a tu pedido ahora, con {pct}% de descuento.</p>
  <ul class="og-lista">
    {
      guias.map((g) => (
        <li class="og-item">
          <Image src={g.portada} alt={`Portada de ${g.nombre}`} width={144} class="og-portada" />
          <div class="og-info">
            <span class="og-nombre">{g.nombre}</span>
            <span class="og-precios">
              <s>{usd(g.precio)}</s>
              <strong>{usd(conDescuento(g.precio))}</strong>
              <span class="og-pct">−{pct}%</span>
            </span>
          </div>
          <button
            type="button"
            class="og-toggle"
            aria-pressed="false"
            aria-label={`Agregar ${g.nombre} a mi pedido`}
            data-linea={JSON.stringify(linea(g))}
          >
            <span class="og-agregar">Agregar</span>
            <span class="og-agregada">Agregada ✓</span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .oferta-guias {
    margin-top: 8px;
    padding: 26px 28px;
    border-radius: var(--radius-lg);
    border: 1.5px dashed rgb(214 154 124 / 0.6);
    background: var(--color-surface-warm);
  }
  .og-eyebrow {
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clay-deep);
    margin: 0 0 6px;
  }
  .og-titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.15;
    margin: 0 0 6px;
  }
  .og-sub {
    font-size: 14.5px;
    color: rgb(48 47 42 / 0.7);
    margin: 0 0 18px;
  }
  .og-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .og-item {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 16px;
    align-items: center;
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 12px 16px 12px 12px;
    border: 1.5px solid transparent;
    transition: border-color 0.2s ease;
  }
  .og-item:has([aria-pressed='true']) {
    border-color: var(--color-clay-deep);
  }
  .og-portada {
    width: 56px;
    height: 72px;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 6px 14px -8px rgb(48 47 42 / 0.45);
  }
  .og-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .og-nombre {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
  }
  .og-precios {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
  }
  .og-precios s {
    color: rgb(48 47 42 / 0.5);
  }
  .og-precios strong {
    font-weight: 800;
  }
  .og-pct {
    font-weight: 800;
    font-size: 11.5px;
    color: var(--color-clay-rich);
  }
  .og-toggle {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-charcoal);
    background: transparent;
    color: var(--color-charcoal);
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .og-toggle:hover {
    background: rgb(48 47 42 / 0.06);
  }
  .og-toggle[aria-pressed='true'] {
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .og-agregada,
  .og-toggle[aria-pressed='true'] .og-agregar {
    display: none;
  }
  .og-toggle[aria-pressed='true'] .og-agregada {
    display: inline;
  }
  @media (max-width: 520px) {
    .oferta-guias {
      padding: 22px 18px;
    }
    .og-item {
      grid-template-columns: 48px 1fr;
    }
    .og-portada {
      width: 48px;
      height: 62px;
    }
    .og-toggle {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import type { LineaPedido } from '../../lib/precio';
  import { EVENTO_EXTRA, EVENTO_QUITADO, emitir, escuchar, type DetalleQuitado } from './eventos';

  const panel = document.querySelector<HTMLElement>('[data-oferta-guias]');
  if (panel) {
    const botones = [...panel.querySelectorAll<HTMLButtonElement>('.og-toggle')];
    const lineaDe = (b: HTMLButtonElement): LineaPedido => JSON.parse(b.dataset.linea ?? '{}');
    const publicar = () =>
      emitir(EVENTO_EXTRA, {
        grupo: 'guias',
        lineas: botones.filter((b) => b.getAttribute('aria-pressed') === 'true').map(lineaDe),
      });
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const activo = b.getAttribute('aria-pressed') === 'true';
        b.setAttribute('aria-pressed', String(!activo));
        publicar();
      })
    );
    escuchar<DetalleQuitado>(EVENTO_QUITADO, ({ grupo, id }) => {
      if (grupo !== 'guias') return;
      botones.find((b) => lineaDe(b).id === id)?.setAttribute('aria-pressed', 'false');
    });
  }
</script>
