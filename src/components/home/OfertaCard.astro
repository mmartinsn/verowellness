---
/**
 * Dark conversion block: THE LAYER METHOD™ 1:1 with the four-step chain and the Initial Layer
 * Cycle price module. Price comes from data/oferta; the button goes to the checkout.
 */
import { ciclos, checkoutPath } from '../../data/oferta';
import { href } from '../../lib/url';

const ciclo = ciclos.INITIAL_LAYER_CYCLE;
const cadena = ['The Layer Assessment™', 'The Layer Map™', 'Top 3 Priorities', 'The Layer Plan™'];
---

<section class="py-20 bg-bone" id="oferta">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div
      class="relative bg-charcoal text-bone rounded-[40px] p-8 sm:p-12 lg:p-16 overflow-hidden shadow-2xl"
    >
      <div
        class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-clay-deep/20 blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-sage-deep/10 blur-3xl pointer-events-none"
      >
      </div>
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 flex flex-col gap-6">
          <span class="text-clay text-xs font-bold uppercase tracking-[0.2em]"
            >Acompañamiento clínico personalizado</span
          >
          <h2 class="font-serif text-4xl sm:text-5xl font-light leading-tight">
            THE LAYER METHOD™ 1:1
          </h2>
          <p class="text-sm sm:text-base text-bone/70 font-light leading-relaxed max-w-xl">
            Tu mapa biológico individualizado. Sin plantillas genéricas. Analizamos tu caso en
            profundidad para diseñar un plan estructurado y medible.
          </p>
          <div class="flex flex-wrap items-center gap-2 pt-2">
            {
              cadena.map((paso, i) => (
                <>
                  {i > 0 && (
                    <span class="text-clay text-xs" aria-hidden="true">
                      →
                    </span>
                  )}
                  <span
                    class:list={[
                      'px-3.5 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-wider text-white',
                      paso === 'Top 3 Priorities'
                        ? 'bg-clay-deep/30 border border-clay-deep'
                        : 'bg-white/10',
                    ]}
                  >
                    {paso}
                  </span>
                </>
              ))
            }
          </div>
        </div>

        <div
          class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-8 border border-white/15 flex flex-col justify-between gap-8"
        >
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-clay"
              >{ciclo.nombre}</span
            >
            <div class="mt-3 flex items-baseline gap-2">
              <span class="font-serif text-5xl font-light text-white">${ciclo.subtotal}</span>
              <span class="text-xs text-white/60 font-medium">+ tax</span>
            </div>
            <p class="text-xs text-white/70 mt-3 leading-relaxed">
              Incluye evaluación clínica integral, estratigrafía de tus 5 capas, plan de acción a 60
              días y soporte directo.
            </p>
          </div>
          <div class="space-y-3">
            <a
              class="w-full py-4 text-center rounded-full bg-clay-deep hover:bg-white hover:text-charcoal text-white font-bold text-xs uppercase tracking-[0.16em] transition-all duration-300 block shadow-lg"
              href={href(checkoutPath(ciclo))}
            >
              Reservar evaluación 1:1
            </a>
            <p class="text-[11px] text-center text-white/50">
              Cupos mensuales estrictamente limitados
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
