---
/**
 * 07 · La oferta — The Layer Method 1:1: the four-step process, the two price cards and the
 * "continuum" of cycles (Initial → Next → Next when needed).
 *
 * Prices, tags, notes and deliverables come from `src/data/oferta.ts`; each card's button goes
 * to its checkout.
 */
import { ciclos, checkoutPrincipal } from '../../data/oferta';
import PasosProceso from '../oferta/PasosProceso.astro';
import BloquePrecios from '../oferta/BloquePrecios.astro';
import { href } from '../../lib/url';
import { cta } from '../../data/site';

const initial = ciclos.INITIAL_LAYER_CYCLE;
const next = ciclos.NEXT_LAYER_CYCLE;

const continuum = [
  {
    num: '01',
    fase: 'Fase Inicial',
    titulo: initial.nombre,
    texto: 'Mapeamos el panorama y construimos la estrategia inicial.',
    pie: 'Fundación celular',
    icono: '→',
    tono: 'clay',
  },
  {
    num: '02',
    fase: 'Profundización',
    titulo: next.nombre,
    texto: 'Seguimos evolucionando el plan y profundizamos en la siguiente prioridad.',
    pie: 'Evolución activa',
    icono: '→',
    tono: 'olive',
  },
  {
    num: '03',
    fase: 'Mantenimiento',
    titulo: next.nombre,
    texto: 'Cuando sea necesario.',
    pie: 'Resiliencia continua',
    icono: '✓',
    tono: 'rose',
  },
];
---

<section class="oferta" id="oferta">
  <div class="wrap">
    <div class="oferta-head reveal">
      <span class="eyebrow">La oferta</span>
      <h2 class="caps">Asesorías</h2>
      <p>
        Deja de adivinar qué hacer con tu salud. Aquí conectas todas las piezas y sales con un plan
        claro: qué priorizar, en qué orden, y por qué.
      </p>
      <p class="p-sm">Asesorías 100% online, adaptadas a los horarios de todas partes del mundo.</p>
    </div>

    <PasosProceso />

    <BloquePrecios />

    <div class="continuidad reveal">
      <div class="orbitas" aria-hidden="true">
        <div class="orbita orbita-1"></div>
        <div class="orbita orbita-2"></div>
        <div class="orbita orbita-3"></div>
      </div>
      <div class="cont-head">
        <span class="eyebrow">Evolución continua</span>
        <p class="pull">¿Completas tu primer ciclo?</p>
        <p class="pull pull-2">Ahora decidimos cuál es tu Next Layer con un segundo ciclo.</p>
        <p class="cont-sub">
          El proceso evoluciona por ciclos, a tu ritmo — sin membresías ni ataduras.
        </p>
      </div>
      <div class="cont-steps">
        <div class="riel" aria-hidden="true"><div class="riel-pulso"></div></div>
        <ol class="cont-grid">
          {
            continuum.map((c, i) => (
              <>
                {i > 0 && (
                  <li class="puente" aria-hidden="true">
                    ↓
                  </li>
                )}
                <li class:list={['nodo', 'spot', 'tilt-card', `tono-${c.tono}`]}>
                  <div>
                    <div class="nodo-top">
                      <div class="nodo-avatar">
                        <div class="nodo-halo" />
                        <div class="nodo-num">{c.num}</div>
                      </div>
                      <span class="nodo-fase">{c.fase}</span>
                    </div>
                    <div class="nodo-body">
                      <h3 class="nodo-titulo">{c.titulo}</h3>
                      <p class="nodo-texto">{c.texto}</p>
                    </div>
                  </div>
                  <div class="nodo-pie">
                    <span>{c.pie}</span>
                    <span class="nodo-flecha" aria-hidden="true">
                      {c.icono}
                    </span>
                  </div>
                </li>
              </>
            ))
          }
        </ol>
      </div>
      <div class="cont-cta">
        <a class="btn btn-primary" href={href(checkoutPrincipal)} data-magnet="0.25">{cta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .oferta {
    padding: 120px 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 10%, rgb(231 183 160 / 0.2) 0%, transparent 70%),
      var(--color-bone);
  }
  .oferta-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .caps {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .continuidad {
    position: relative;
    overflow: hidden;
    margin-top: 84px;
    border-radius: 40px;
    padding: 72px 36px 64px;
    background:
      radial-gradient(ellipse 65% 55% at 50% -10%, rgb(231 183 160 / 0.35) 0%, transparent 65%),
      radial-gradient(ellipse 45% 45% at 10% 90%, rgb(207 215 196 / 0.3) 0%, transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.85) 0%, rgb(247 244 236 / 0.92) 100%);
    border: 1.5px solid rgb(214 154 124 / 0.3);
    box-shadow:
      0 32px 80px rgb(35 34 30 / 0.06),
      0 1px 0 rgb(255 255 255 / 0.9) inset;
  }
  @media (min-width: 768px) {
    .continuidad {
      padding: 84px 64px 72px;
    }
  }
  @media (max-width: 520px) {
    .continuidad {
      padding: 56px 22px 48px;
    }
  }
  .orbitas {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 900px;
    height: 900px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.45;
  }
  .orbita {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px dashed rgb(214 154 124 / 0.35);
    animation: orbit 80s linear infinite;
  }
  .orbita-1 {
    width: 320px;
    height: 320px;
    border-style: dotted;
    border-color: rgb(207 215 196 / 0.5);
  }
  .orbita-2 {
    width: 540px;
    height: 540px;
    animation-duration: 110s;
    animation-direction: reverse;
  }
  .orbita-3 {
    width: 780px;
    height: 780px;
    border-color: rgb(231 183 160 / 0.25);
    animation-duration: 140s;
  }
  @keyframes orbit {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  .cont-head {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 780px;
    margin: 0 auto 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .cont-head .eyebrow {
    background: rgb(255 255 255 / 0.7);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(214 154 124 / 0.25);
    box-shadow: 0 4px 14px rgb(214 154 124 / 0.08);
  }
  .cont-head .pull {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.2vw, 44px);
    font-style: italic;
    color: var(--color-charcoal);
    line-height: 1.18;
  }
  .cont-head .pull-2 {
    font-style: normal;
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--color-clay-rich);
    margin-top: 6px;
  }
  .cont-head .cont-sub {
    font-size: 15px;
    font-weight: 600;
    color: rgb(35 34 30 / 0.7);
  }

  .cont-steps {
    position: relative;
    z-index: 2;
    max-width: 1040px;
    margin: 0 auto 52px;
  }
  .riel {
    display: none;
    position: absolute;
    top: 52px;
    left: 8%;
    right: 8%;
    height: 4px;
    background: rgb(35 34 30 / 0.08);
    border-radius: var(--radius-pill);
    z-index: 1;
    overflow: hidden;
  }
  .riel-pulso {
    position: absolute;
    top: 0;
    left: -35%;
    width: 40%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-clay-deep) 35%,
      var(--color-white) 60%,
      var(--color-rose-deep) 85%,
      transparent 100%
    );
    box-shadow: 0 0 16px rgb(214 154 124 / 0.95);
    animation: riel 3.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes riel {
    0% {
      left: -40%;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  .cont-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 900px) {
    .riel {
      display: block;
    }
    .cont-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }
  .puente {
    display: flex;
    justify-content: center;
    padding: 4px 0;
    color: var(--color-clay-deep);
    font-size: 20px;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(5px);
    }
  }
  /* The arrows only bridge the cards when they stack; side by side, the rail does that. */
  @media (min-width: 900px) {
    .puente {
      display: none;
    }
  }

  .nodo {
    --tono: var(--color-charcoal);
    --halo: var(--color-clay);
    --fase: var(--color-clay-deep);
    --fase-bg: rgb(231 183 160 / 0.2);
    --fase-borde: rgb(214 154 124 / 0.25);
    position: relative;
    overflow: hidden;
    background: rgb(255 255 255 / 0.85);
    border: 1.5px solid rgb(255 255 255 / 0.95);
    border-radius: 28px;
    padding: 34px 28px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow:
      0 12px 32px rgb(35 34 30 / 0.04),
      0 1px 2px rgb(35 34 30 / 0.02);
    transform-style: preserve-3d;
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }
  .tono-olive {
    --tono: var(--color-olive);
    --halo: var(--color-sage-deep);
    --fase: var(--color-olive);
    --fase-bg: rgb(207 215 196 / 0.35);
    --fase-borde: rgb(123 129 109 / 0.2);
  }
  .tono-rose {
    --tono: var(--color-rose-deep);
    --halo: var(--color-rose-deep);
    --fase: var(--color-rose-deep);
    --fase-bg: rgb(226 183 178 / 0.35);
    --fase-borde: rgb(201 140 134 / 0.3);
  }
  .nodo::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background: radial-gradient(circle at top right, rgb(231 183 160 / 0.25) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .nodo:hover {
    background: var(--color-white);
    border-color: var(--color-clay);
    box-shadow:
      0 24px 50px rgb(214 154 124 / 0.22),
      0 0 0 1px var(--color-clay-deep) inset;
  }
  .nodo:hover::before {
    opacity: 1;
  }
  .nodo-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .nodo-avatar {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nodo-halo {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid var(--halo);
    opacity: 0.4;
    animation: halo 3s ease-in-out infinite alternate;
  }
  .tono-olive .nodo-halo {
    animation-delay: -1.5s;
  }
  .tono-rose .nodo-halo {
    animation-delay: -3s;
  }
  @keyframes halo {
    0% {
      transform: scale(0.92);
      opacity: 0.3;
    }
    100% {
      transform: scale(1.15);
      opacity: 0.75;
    }
  }
  .nodo-num {
    position: relative;
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--tono);
    color: var(--color-bone);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgb(35 34 30 / 0.18);
    transition:
      background 0.35s var(--ease-out-soft),
      transform 0.35s var(--ease-out-soft);
  }
  .nodo:hover .nodo-num {
    background: var(--color-clay-deep);
    color: var(--color-white);
    transform: scale(1.08);
  }
  .nodo-fase {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fase);
    background: var(--fase-bg);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--fase-borde);
  }
  .nodo-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 22px;
  }
  .nodo-titulo {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
  }
  .nodo-texto {
    font-size: 15px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.85);
    font-weight: 500;
  }
  .nodo-pie {
    padding-top: 18px;
    border-top: 1px solid rgb(35 34 30 / 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.7);
  }
  .nodo-flecha {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-sand);
    color: var(--color-charcoal);
    font-size: 12px;
    transition:
      background 0.3s var(--ease-out-soft),
      color 0.3s var(--ease-out-soft),
      transform 0.3s var(--ease-out-soft);
  }
  .nodo:hover .nodo-flecha {
    background: var(--color-charcoal);
    color: var(--color-bone);
    transform: translateX(4px);
  }
  .cont-cta {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbita,
    .riel-pulso,
    .puente,
    .nodo-halo {
      animation: none;
    }
  }
</style>
