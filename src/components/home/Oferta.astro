---
/**
 * 07 · La oferta — the asesorías: the four-step process, the two price cards (one
 * appointment and the Initial Layer Cycle), the invitation-only note for the Next Layer Cycle,
 * and the continuum of cycles (Initial, Next, Next when needed).
 *
 * Process, prices, tags, notes and deliverables come from src/data; each card goes to its checkout.
 */
import {
  ciclos,
  checkoutPath,
  checkoutPrincipal,
  continuidad,
  listaCiclos,
  precioCard,
  rotuloCitas,
} from '../../data/oferta';
import { pasosProceso } from '../../data/proceso';
import { cta } from '../../data/site';
import { href } from '../../lib/url';

const initial = ciclos.INITIAL_LAYER_CYCLE;
const next = ciclos.NEXT_LAYER_CYCLE;

const continuum = [
  {
    num: '01',
    fase: 'Fase Inicial',
    titulo: initial.nombre,
    texto: 'Mapeamos el panorama y construimos la estrategia inicial.',
    pie: 'Fundación celular',
    icono: '→',
    tono: 'clay',
  },
  {
    num: '02',
    fase: 'Profundización',
    titulo: next.nombre,
    texto: 'Seguimos evolucionando el plan y profundizamos en la siguiente prioridad.',
    pie: 'Evolución activa',
    icono: '→',
    tono: 'olive',
  },
  {
    num: '03',
    fase: 'Mantenimiento',
    titulo: next.nombre,
    texto: 'Cuando sea necesario.',
    pie: 'Resiliencia continua',
    icono: '✓',
    tono: 'rose',
  },
];

const check =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
---

<section class="oferta" id="oferta">
  <div class="wrap">
    <div class="oferta-head reveal">
      <span class="eyebrow">La oferta</span>
      <h2 class="caps">Asesorías</h2>
      <p>
        Deja de adivinar qué hacer con tu salud. Aquí conectas todas las piezas y sales con un plan
        claro: qué priorizar, en qué orden, y por qué.
      </p>
      <p class="p-sm">Asesorías 100% online, adaptadas a los horarios de todas partes del mundo.</p>
    </div>

    <div class="reveal">
      <span class="eyebrow proceso-label">Así funciona el proceso:</span>
      <ol class="proceso">
        {
          pasosProceso.map((p, i) => (
            <li class="paso spot">
              <div class="paso-num">{i + 1}</div>
              <div class="paso-titulo">
                {p.titulo}
                {p.dur && <span class="paso-dur">{p.dur}</span>}
              </div>
              <div class="paso-marca">{p.marca ?? ' '}</div>
              <div class="paso-texto">{p.texto}</div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="precios reveal">
      {
        listaCiclos.map((c) => (
          <article class:list={['tier', 'tilt-card', c.destacado ? 'destacado grad-ring' : 'spot']}>
            <div>
              <span class:list={['ptag', { 'ptag-sand': !c.destacado }]}>{c.etiqueta}</span>
              <h3 class="pname">{c.nombre}</h3>
              <p class="pprecio">
                <span class="pval">{precioCard(c)}</span>
                <span class="pcitas">{rotuloCitas(c)}</span>
              </p>
              {c.etiquetaNota && <p class="pnota">{c.etiquetaNota}</p>}
              <p class="pdesc">{c.descripcion}</p>
              <ul class="incluye">
                {c.incluye.map((item) => (
                  <li>
                    <Fragment set:html={check} />
                    {item}
                  </li>
                ))}
              </ul>
              {c.bonus && (
                <p class="bonus">
                  <span class="bonus-tag">Bonus</span>
                  {c.bonus}
                </p>
              )}
            </div>
            <a
              class:list={['btn', 'btn-block', c.destacado ? 'btn-primary' : 'btn-outline']}
              href={href(checkoutPath(c))}
              aria-label={`Reservar ${c.nombre}`}
            >
              {cta.label}
            </a>
          </article>
        ))
      }
    </div>

    <aside class="exclusivo reveal">
      <span class="exclusivo-tag">{continuidad.etiqueta}</span>
      <div>
        <p class="exclusivo-titulo">{continuidad.titulo}</p>
        <p class="exclusivo-texto">{continuidad.texto}</p>
      </div>
    </aside>

    <div class="continuidad reveal">
      <div class="orbitas" aria-hidden="true">
        <div class="orbita orbita-1"></div>
        <div class="orbita orbita-2"></div>
        <div class="orbita orbita-3"></div>
      </div>
      <div class="cont-head">
        <span class="eyebrow">Evolución continua</span>
        <p class="pull">¿Completas tu primer ciclo?</p>
        <p class="cont-sub">Ahora decidimos cuál es tu Next Layer con un segundo ciclo.</p>
      </div>
      <div class="cont-steps">
        <div class="riel" aria-hidden="true"><div class="riel-pulso"></div></div>
        <ol class="cont-grid">
          {
            continuum.map((c, i) => (
              <>
                {i > 0 && (
                  <li class="puente" aria-hidden="true">
                    ↓
                  </li>
                )}
                <li class:list={['nodo', 'spot', 'tilt-card', `tono-${c.tono}`]}>
                  <div>
                    <div class="nodo-top">
                      <div class="nodo-avatar">
                        <div class="nodo-halo" />
                        <div class="nodo-num">{c.num}</div>
                      </div>
                      <span class="nodo-fase">{c.fase}</span>
                    </div>
                    <div class="nodo-body">
                      <h3 class="nodo-titulo">{c.titulo}</h3>
                      <p class="nodo-texto">{c.texto}</p>
                    </div>
                  </div>
                  <div class="nodo-pie">
                    <span>{c.pie}</span>
                    <span class="nodo-flecha" aria-hidden="true">
                      {c.icono}
                    </span>
                  </div>
                </li>
              </>
            ))
          }
        </ol>
      </div>
      <div class="cont-cta">
        <a class="btn btn-primary" href={href(checkoutPrincipal)} data-magnet="0.25">{cta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .oferta {
    padding: 120px 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 10%, rgb(231 183 160 / 0.2) 0%, transparent 70%),
      var(--color-bone);
  }
  .oferta-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .caps {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Block and without the dot, as in the design. */
  .proceso-label {
    display: block;
    margin-bottom: 18px;
  }
  .proceso-label::before {
    display: none;
  }
  .proceso {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    margin-bottom: 64px;
    list-style: none;
    padding: 0;
  }
  .paso {
    background: var(--color-white);
    border: 1px solid rgb(35 34 30 / 0.12);
    border-radius: 22px;
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 8px 24px rgb(35 34 30 / 0.03);
    transition:
      transform 0.3s var(--ease-out-soft),
      border-color 0.3s ease;
  }
  .paso:hover {
    transform: translateY(-5px);
    border-color: var(--color-clay);
  }
  .paso-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-clay);
    color: var(--color-charcoal);
    font-weight: 800;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .paso-titulo {
    font-weight: 800;
    font-size: 17px;
    color: var(--color-charcoal);
  }
  .paso-dur {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-sand);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    margin-left: 6px;
  }
  .paso-marca {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-clay-deep);
    min-height: 18px;
  }
  .paso-texto {
    font-size: 14.5px;
    color: rgb(35 34 30 / 0.7);
    line-height: 1.5;
  }

  .precios {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    max-width: 1060px;
    margin: 0 auto;
  }
  @media (min-width: 860px) {
    .precios {
      grid-template-columns: 0.95fr 1.05fr;
      align-items: start;
    }
  }
  .pprecio {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 14px;
  }
  .pprecio .pval {
    margin-bottom: 0;
  }
  .pcitas {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(35 34 30 / 0.08);
    color: var(--color-charcoal);
  }
  .exclusivo {
    max-width: 1060px;
    margin: 28px auto 0;
    padding: 26px 32px;
    border-radius: 28px;
    background:
      radial-gradient(ellipse 60% 120% at 0% 0%, rgb(231 183 160 / 0.28) 0%, transparent 70%),
      var(--color-charcoal);
    color: var(--color-bone);
    display: flex;
    align-items: center;
    gap: 24px;
    box-shadow: 0 20px 50px rgb(35 34 30 / 0.16);
  }
  .exclusivo-tag {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-clay);
    color: var(--color-charcoal);
  }
  .exclusivo-titulo {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.15;
    margin-bottom: 4px;
    color: var(--color-bone);
  }
  .exclusivo-texto {
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(253 249 242 / 0.82);
  }
  @media (max-width: 640px) {
    .exclusivo {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
      gap: 14px;
    }
  }
  .tier {
    border-radius: 32px;
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    border: 1px solid rgb(35 34 30 / 0.12);
    background: var(--color-white);
    box-shadow: 0 16px 40px rgb(35 34 30 / 0.06);
    transform-style: preserve-3d;
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.3s ease;
  }
  @media (max-width: 520px) {
    .tier {
      padding: 36px 26px;
    }
  }
  .tier:hover {
    box-shadow: 0 24px 60px rgb(35 34 30 / 0.12);
  }
  .tier.destacado {
    background:
      radial-gradient(circle at 90% 10%, rgb(255 255 255 / 0.45) 0%, transparent 60%),
      var(--color-clay);
    border-color: rgb(35 34 30 / 0.15);
    box-shadow: 0 20px 50px rgb(214 154 124 / 0.3);
  }
  .ptag {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    background: rgb(255 255 255 / 0.6);
    border-radius: var(--radius-pill);
    margin-bottom: 12px;
  }
  .ptag-sand {
    background: var(--color-sand);
  }
  .pname {
    font-size: clamp(28px, 3.4vw, 36px);
    margin-bottom: 8px;
  }
  .pval {
    display: block;
    font-size: 38px;
    font-weight: 800;
    color: var(--color-charcoal);
    margin-bottom: 14px;
  }
  .pnota {
    font-size: 13.5px;
    line-height: 1.5;
    color: rgb(35 34 30 / 0.7);
    font-style: italic;
  }
  .pdesc {
    margin: 20px 0 24px;
    font-weight: 600;
  }
  .pdesc.pdesc-nota {
    font-size: 14.5px;
    font-weight: 450;
    color: rgb(35 34 30 / 0.7);
    font-style: italic;
  }
  .incluye {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    padding: 0;
  }
  .incluye li {
    font-size: 16px;
    font-weight: 650;
    color: var(--color-charcoal);
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .bonus {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 22px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.55);
    border: 1px dashed rgb(35 34 30 / 0.25);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-charcoal);
  }
  .bonus-tag {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .incluye li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .continuidad {
    position: relative;
    overflow: hidden;
    margin-top: 84px;
    border-radius: 40px;
    padding: 72px 36px 64px;
    background:
      radial-gradient(ellipse 65% 55% at 50% -10%, rgb(231 183 160 / 0.35) 0%, transparent 65%),
      radial-gradient(ellipse 45% 45% at 10% 90%, rgb(207 215 196 / 0.3) 0%, transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.85) 0%, rgb(247 244 236 / 0.92) 100%);
    border: 1.5px solid rgb(214 154 124 / 0.3);
    box-shadow:
      0 32px 80px rgb(35 34 30 / 0.06),
      0 1px 0 rgb(255 255 255 / 0.9) inset;
  }
  @media (min-width: 768px) {
    .continuidad {
      padding: 84px 64px 72px;
    }
  }
  @media (max-width: 520px) {
    .continuidad {
      padding: 56px 22px 48px;
    }
  }
  .orbitas {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 900px;
    height: 900px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.45;
  }
  .orbita {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px dashed rgb(214 154 124 / 0.35);
    animation: orbit 80s linear infinite;
  }
  .orbita-1 {
    width: 320px;
    height: 320px;
    border-style: dotted;
    border-color: rgb(207 215 196 / 0.5);
  }
  .orbita-2 {
    width: 540px;
    height: 540px;
    animation-duration: 110s;
    animation-direction: reverse;
  }
  .orbita-3 {
    width: 780px;
    height: 780px;
    border-color: rgb(231 183 160 / 0.25);
    animation-duration: 140s;
  }
  @keyframes orbit {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  .cont-head {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 780px;
    margin: 0 auto 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .cont-head .eyebrow {
    background: rgb(255 255 255 / 0.7);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(214 154 124 / 0.25);
    box-shadow: 0 4px 14px rgb(214 154 124 / 0.08);
  }
  .cont-head .pull {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.2vw, 44px);
    font-style: italic;
    color: var(--color-charcoal);
    line-height: 1.18;
  }
  .cont-head .cont-sub {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.25;
    color: var(--color-clay-rich);
  }

  .cont-steps {
    position: relative;
    z-index: 2;
    max-width: 1040px;
    margin: 0 auto 52px;
  }
  .riel {
    display: none;
    position: absolute;
    top: 52px;
    left: 8%;
    right: 8%;
    height: 4px;
    background: rgb(35 34 30 / 0.08);
    border-radius: var(--radius-pill);
    z-index: 1;
    overflow: hidden;
  }
  .riel-pulso {
    position: absolute;
    top: 0;
    left: -35%;
    width: 40%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-clay-deep) 35%,
      var(--color-white) 60%,
      var(--color-rose-deep) 85%,
      transparent 100%
    );
    box-shadow: 0 0 16px rgb(214 154 124 / 0.95);
    animation: riel 3.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes riel {
    0% {
      left: -40%;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  .cont-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 900px) {
    .riel {
      display: block;
    }
    .cont-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }
  .puente {
    display: flex;
    justify-content: center;
    padding: 4px 0;
    color: var(--color-clay-deep);
    font-size: 20px;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(5px);
    }
  }
  /* The arrows only bridge the cards when they stack; side by side, the rail does that. */
  @media (min-width: 900px) {
    .puente {
      display: none;
    }
  }

  .nodo {
    --tono: var(--color-charcoal);
    --halo: var(--color-clay);
    --fase: var(--color-clay-deep);
    --fase-bg: rgb(231 183 160 / 0.2);
    --fase-borde: rgb(214 154 124 / 0.25);
    position: relative;
    overflow: hidden;
    background: rgb(255 255 255 / 0.85);
    border: 1.5px solid rgb(255 255 255 / 0.95);
    border-radius: 28px;
    padding: 34px 28px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow:
      0 12px 32px rgb(35 34 30 / 0.04),
      0 1px 2px rgb(35 34 30 / 0.02);
    transform-style: preserve-3d;
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }
  .tono-olive {
    --tono: var(--color-olive);
    --halo: var(--color-sage-deep);
    --fase: var(--color-olive);
    --fase-bg: rgb(207 215 196 / 0.35);
    --fase-borde: rgb(123 129 109 / 0.2);
  }
  .tono-rose {
    --tono: var(--color-rose-deep);
    --halo: var(--color-rose-deep);
    --fase: var(--color-rose-deep);
    --fase-bg: rgb(226 183 178 / 0.35);
    --fase-borde: rgb(201 140 134 / 0.3);
  }
  .nodo::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background: radial-gradient(circle at top right, rgb(231 183 160 / 0.25) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .nodo:hover {
    background: var(--color-white);
    border-color: var(--color-clay);
    box-shadow:
      0 24px 50px rgb(214 154 124 / 0.22),
      0 0 0 1px var(--color-clay-deep) inset;
  }
  .nodo:hover::before {
    opacity: 1;
  }
  .nodo-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .nodo-avatar {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nodo-halo {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid var(--halo);
    opacity: 0.4;
    animation: halo 3s ease-in-out infinite alternate;
  }
  .tono-olive .nodo-halo {
    animation-delay: -1.5s;
  }
  .tono-rose .nodo-halo {
    animation-delay: -3s;
  }
  @keyframes halo {
    0% {
      transform: scale(0.92);
      opacity: 0.3;
    }
    100% {
      transform: scale(1.15);
      opacity: 0.75;
    }
  }
  .nodo-num {
    position: relative;
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--tono);
    color: var(--color-bone);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgb(35 34 30 / 0.18);
    transition:
      background 0.35s var(--ease-out-soft),
      transform 0.35s var(--ease-out-soft);
  }
  .nodo:hover .nodo-num {
    background: var(--color-clay-deep);
    color: var(--color-white);
    transform: scale(1.08);
  }
  .nodo-fase {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
