---
/**
 * "Cinco Layers. Un solo mapa." — the exploded 3D render on the left, the interactive stack
 * of five Layer cards on the right (clicking a card highlights it). Content from data/layers.
 */
import { Image } from 'astro:assets';
import render3d from '../../assets/layers-3d.jpg';
import { layers } from '../../data/layers';

// Stitch lists the stack top-down (05 → 01) so it reads like the render next to it.
const stack = [...layers].reverse();

// Pin colours / card accents per Layer, as in the Stitch page.
const badge: Record<string, string> = {
  clay: 'bg-clay-deep text-white',
  sage: 'bg-clay-deep text-white', // Stitch painted Layer 02 in clay on the home stack
  'sage-deep': 'bg-sage-deep text-charcoal',
  rose: 'bg-rose-deep text-white',
  olive: 'bg-olive text-white',
  charcoal: 'bg-charcoal text-bone',
};
const numBox: Record<string, string> = {
  '01': 'bg-charcoal text-bone',
  '02': 'bg-clay-deep text-white',
  '03': 'bg-sage-deep text-charcoal',
  '04': 'bg-rose-deep text-white',
  '05': 'bg-olive text-white',
};
const pill: Record<string, string> = {
  '01': 'bg-charcoal/10 text-charcoal',
  '02': 'bg-clay-deep/20 text-clay-deep',
  '03': 'bg-sage-deep/30 text-charcoal',
  '04': 'bg-rose-deep/15 text-rose-deep',
  '05': 'bg-olive/15 text-olive',
};
// Pins over the render, top-down like the slices; `num` ties each pin to its stack card.
const pins = [
  { num: '05', label: 'L5', cls: 'bg-olive text-white', side: 'justify-end' },
  { num: '04', label: 'L4', cls: 'bg-clay-deep text-white', side: 'justify-start' },
  { num: '03', label: 'L3', cls: 'bg-sage-deep text-charcoal', side: 'justify-end' },
  { num: '02', label: 'L2', cls: 'bg-rose-deep text-white', side: 'justify-start' },
  { num: '01', label: 'L1', cls: 'bg-charcoal text-white', side: 'justify-end' },
];
void badge;
---

<section class="py-24 bg-surface-low border-y border-black/5" id="cartografia">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mx-auto text-center mb-16 reveal-stagger">
      <span class="text-clay-deep text-[11px] font-bold tracking-[0.2em] uppercase"
        >The Layer Method™</span
      >
      <h2 class="font-serif text-4xl sm:text-5xl font-light text-charcoal mt-2">
        Cinco Layers. Un solo mapa.
      </h2>
      <p class="text-sm sm:text-base text-black/60 mt-3 max-w-xl mx-auto leading-relaxed">
        Cada Layer observa una parte distinta de tu bienestar — pero ninguna existe aislada de las
        demás. Lo que ocurre en una puede sentirse en otra. Por eso no se recorren en orden: se
        exploran como territorios de un mismo terreno.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5 relative flex justify-center reveal-scale">
        <div
          class="relative w-full max-w-md bg-white rounded-[32px] p-6 shadow-xl border border-black/5 float-slow"
        >
          <div class="overflow-hidden rounded-2xl relative">
            <Image
              src={render3d}
              alt="Las cinco Layers representadas como capas superpuestas"
              widths={[512]}
              sizes="(min-width: 1024px) 400px, 90vw"
              class="w-full h-auto object-contain"
            />
            <div
              class="absolute inset-0 flex flex-col justify-between py-6 px-4 pointer-events-none"
              aria-hidden="true"
            >
              {
                pins.map((p) => (
                  <div class:list={['flex', p.side]}>
                    <span
                      class:list={[
                        'pin text-[10px] font-extrabold px-2.5 py-1 rounded-full shadow-md',
                        p.cls,
                        { 'pin-active': p.num === '02' },
                      ]}
                      data-pin={p.num}
                    >
                      {p.label}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="text-center text-[11px] uppercase tracking-widest text-black/40 font-bold mt-4">
            Estratificación tridimensional dinámica
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-3 reveal-stagger" id="layersStack">
        {
          stack.map((layer) => (
            <button
              type="button"
              class:list={[
                'layer-item text-left p-5 sm:p-6 rounded-2xl bg-white/70 border border-black/[0.07] cursor-pointer',
                { active: layer.num === '02' },
              ]}
              data-layer={layer.num}
              aria-pressed={layer.num === '02' ? 'true' : 'false'}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-start gap-4">
                  <span
                    class:list={[
                      'w-10 h-10 rounded-xl flex items-center justify-center font-serif font-bold text-sm shrink-0 mt-0.5',
                      numBox[layer.num],
                    ]}
                  >
                    {layer.num}
                  </span>
                  <div>
                    <div class="flex items-center gap-3">
                      <h3 class="font-serif text-xl text-charcoal font-medium">{layer.nombre}</h3>
                      <span
                        class:list={[
                          'text-[10px] font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full sm:hidden',
                          pill[layer.num],
                        ]}
                      >
                        {layer.rol}
                      </span>
                    </div>
                    <p class="font-serif italic text-sm text-charcoal/90 mt-1 leading-snug">
                      {layer.pregunta}
                    </p>
                    <p class="text-xs text-black/60 mt-2 leading-relaxed">
                      “{layer.cita}” {layer.observaTexto}
                    </p>
                  </div>
                </div>
                <span
                  class:list={[
                    'text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full hidden sm:inline-block shrink-0',
                    pill[layer.num],
                  ]}
                >
                  {layer.rol}
                </span>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .layer-item {
    transition:
      transform 0.4s var(--ease-out-soft),
      box-shadow 0.4s var(--ease-out-soft),
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  .layer-item:hover {
    transform: translateX(4px);
    border-color: rgb(35 34 30 / 0.18);
    background-color: rgb(255 255 255 / 0.9);
  }
  .layer-item.active {
    background-color: var(--color-white);
    border-color: rgb(35 34 30 / 0.22);
    box-shadow: 0 16px 36px rgb(35 34 30 / 0.08);
    transform: translateX(8px);
  }
  @media (max-width: 768px) {
    .layer-item:hover,
    .layer-item.active {
      transform: translateY(-2px);
    }
  }
  /* The pin of the selected Layer grows and glows on the render. */
  .pin {
    transition:
      transform 0.45s var(--ease-spring),
      box-shadow 0.45s ease,
      opacity 0.3s ease;
    opacity: 0.75;
  }
  .pin.pin-active {
    opacity: 1;
    transform: scale(1.3);
    box-shadow:
      0 0 0 4px rgb(255 255 255 / 0.9),
      0 10px 24px -8px rgb(35 34 30 / 0.4);
  }
</style>

<script>
  // One card highlighted at a time; its pin lights up on the render.
  const items = document.querySelectorAll<HTMLButtonElement>('#layersStack .layer-item');
  const pins = document.querySelectorAll<HTMLElement>('#cartografia .pin');
  items.forEach((item) => {
    item.addEventListener('click', () => {
      items.forEach((i) => {
        i.classList.remove('active');
        i.setAttribute('aria-pressed', 'false');
      });
      item.classList.add('active');
      item.setAttribute('aria-pressed', 'true');
      pins.forEach((p) => p.classList.toggle('pin-active', p.dataset.pin === item.dataset.layer));
    });
  });
</script>
