---
/**
 * «El estante de Vero» — five white porcelain bottles with Layer-coloured labels on a shelf, one per Layer, in the Method's order
 * (Mari, 2026-09-24: «tips o suplementos que Vero recomienda… hazla original»). Pointing at a
 * bottle (or tapping it) lifts it and shows its card: what Verónica reviews in that Layer before
 * supplementing, her line for the Layer as the tip, and her picks.
 *
 * Every word is Verónica's (data/layers, the FAQ answer). The picks live in data/suplementos
 * `recomendaciones` (from NutriWhite's list, placed by Layer; pending Verónica's confirmation).
 */
import { layers } from '../../data/layers';
import { recomendaciones, tipOrden } from '../../data/suplementos';

// Bottle heights vary a little, like a real shelf.
const altos = ['188px', '206px', '176px', '198px', '184px'];
---

<section class="estante-sec" aria-labelledby="estante-titulo">
  <div class="wrap">
    <div class="e-cabeza">
      <span class="eyebrow">El estante de Vero</span>
      <h2 id="estante-titulo" class="e-h2">El orden <em class="grad-text">importa.</em></h2>
      <p class="e-tip">{tipOrden}</p>
    </div>

    <div class="estante" data-estante>
      <div class="frascos" role="group" aria-label="Un frasco por Layer">
        {
          layers.map((l, i) => (
            <button
              type="button"
              class:list={['frasco', { activo: i === 0 }]}
              data-num={l.num}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls={`ficha-${l.num}`}
              style={`--tono:var(--color-${l.color});--h:${altos[i]};--i:${i}`}
            >
              <span class="tapa" aria-hidden="true" />
              <span class="cuerpo" aria-hidden="true">
                <span class="brillo" />
                <span class="etiqueta">
                  <span class="e-marca">The Layer Method</span>
                  <span class="e-num">{l.num}</span>
                  <span class="e-nom">{l.nombre}</span>
                </span>
              </span>
              <span class="sr-only">
                Layer {l.num}, {l.nombre}
              </span>
            </button>
          ))
        }
      </div>
      <div class="repisa" aria-hidden="true"></div>

      <div class="fichas">
        {
          layers.map((l, i) => {
            const picks = recomendaciones[l.num];
            return (
              <article
                id={`ficha-${l.num}`}
                class:list={['ficha', { visible: i === 0 }]}
                data-ficha={l.num}
                style={`--tono:var(--color-${l.color})`}
              >
                <div class="f-izq">
                  <span class="f-eyebrow">
                    Layer {l.num} · {l.nombre}
                  </span>
                  <p class="f-cita">"{l.cita}"</p>
                  <p class="f-label">Antes de suplementar, reviso:</p>
                  <ul class="f-chips">
                    {l.observa.map((o) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                </div>
                <div class="f-der">
                  <p class="f-label">Mis recomendaciones</p>
                  {picks.length > 0 ? (
                    <ul class="f-picks">
                      {picks.map((p) => (
                        <li>
                          <span class="p-nom">{p.nombre}</span>
                          <span class="p-marca">{p.marca}</span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="f-vacio">
                      Se definen en tu Layer Plan, según lo que muestre esta Layer.{' '}
                      <a href="#acceso">Cómo acceder →</a>
                    </p>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .estante-sec {
    padding: clamp(64px, 8vw, 110px) 0;
    background:
      radial-gradient(ellipse 55% 60% at 85% 10%, rgb(207 215 196 / 0.35), transparent 70%),
      radial-gradient(ellipse 50% 55% at 10% 90%, rgb(231 183 160 / 0.28), transparent 70%);
  }
  .e-cabeza {
    max-width: 780px;
  }
  .e-h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(38px, 4.8vw, 66px);
    line-height: 1.02;
    margin-top: 14px;
  }
  .e-h2 em {
    font-style: italic;
  }
  .e-tip {
    margin-top: 18px;
    font-size: clamp(16px, 1.3vw, 18.5px);
    line-height: 1.65;
    color: rgb(35 34 30 / 0.78);
  }

  /* ── The shelf ── */
  .estante {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .frascos {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(18px, 3.4vw, 54px);
    padding: 34px 8px 0;
    min-height: 260px;
  }
  .frasco {
    all: unset;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: clamp(78px, 9vw, 118px);
    cursor: pointer;
    transition:
      transform 0.6s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.4s ease,
      filter 0.4s ease;
    animation: frasco-in 0.9s cubic-bezier(0.19, 1, 0.22, 1) calc(var(--i) * 0.08s) backwards;
  }
  @keyframes frasco-in {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
  .frasco:focus-visible {
    outline: 2px solid var(--color-clay-deep);
    outline-offset: 8px;
    border-radius: 12px;
  }
  /* White porcelain bottles; the label carries the Layer's colour (Mari's pick, 2026-09-24). */
  .tapa {
    width: 66%;
    height: 28px;
    border-radius: 10px 10px 3px 3px;
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.04) 0 1px, transparent 1px 5px),
      linear-gradient(90deg, #e4ddd0, #f7f3ec 45%, #d9d1c3);
  }
  .cuerpo {
    position: relative;
    width: 100%;
    height: var(--h);
    margin-top: 2px;
    border-radius: 20px 20px 24px 24px;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.07), transparent 28%, transparent 66%, rgb(0 0 0 / 0.1)),
      linear-gradient(180deg, #ffffff, #f3f0ea);
    box-shadow:
      0 30px 34px -22px rgb(35 34 30 / 0.35),
      inset 0 0 0 1px rgb(35 34 30 / 0.05),
      inset 0 2px 0 rgb(255 255 255 / 1);
    overflow: hidden;
    transition: box-shadow 0.5s ease;
  }
  .brillo {
    position: absolute;
    left: 12%;
    top: 7%;
    width: 8%;
    height: 80%;
    border-radius: 99px;
    background: linear-gradient(180deg, rgb(255 255 255 / 1), rgb(255 255 255 / 0));
  }
  .etiqueta {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    padding: 12px 6px 14px;
    background: var(--tono);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    color: var(--color-charcoal);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      inset 0 -1px 0 rgb(0 0 0 / 0.08);
    transition: transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  /* The two darker Layer colours (03 sage-deep, 05 olive) take light text. */
  .frasco:nth-child(3) .etiqueta,
  .frasco:nth-child(5) .etiqueta {
    color: var(--color-bone);
  }
  .e-marca {
    font-size: 6.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.72;
  }
  .e-num {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.8vw, 36px);
    line-height: 1;
  }
  .e-nom {
    font-size: clamp(8px, 0.78vw, 9.5px);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
    padding-inline: 4px;
  }
  .frascos:has(.activo) .frasco:not(.activo) {
    opacity: 0.72;
    filter: saturate(0.75);
  }
  .frasco.activo {
    transform: translateY(-20px) rotate(-3deg);
  }
  .frasco.activo .etiqueta {
    transform: translateY(-3px);
  }
  .frasco.activo .cuerpo {
    box-shadow:
      0 44px 42px -22px rgb(35 34 30 / 0.4),
      0 0 0 2px var(--tono),
      inset 0 2px 0 rgb(255 255 255 / 1);
  }
  .repisa {
    height: 18px;
    margin: 0 auto;
    max-width: 900px;
    border-radius: 4px;
    background: linear-gradient(180deg, #ece6dc, #d8cfc1);
    box-shadow: 0 18px 30px -14px rgb(35 34 30 / 0.3);
  }

  /* ── The cards: only the current one is laid out, so each is as tall as its Layer needs ── */
  .fichas {
    max-width: 980px;
    margin: 32px auto 0;
  }
  .ficha {
    display: none;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 22px 40px;
    padding: clamp(22px, 2.6vw, 34px);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.65);
    border: 1px solid rgb(35 34 30 / 0.08);
    border-top: 4px solid var(--tono);
  }
  .ficha.visible {
    display: grid;
    animation: ficha-in 0.45s cubic-bezier(0.19, 1, 0.22, 1);
  }
  @keyframes ficha-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (min-width: 900px) {
    .ficha {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
    .f-der {
      padding-left: 36px;
      border-left: 1px solid rgb(35 34 30 / 0.1);
    }
  }
  .f-eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(35 34 30 / 0.6);
  }
  .f-cita {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.2;
    color: var(--color-charcoal);
  }
  .f-label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-clay-deep);
  }
  .f-label + * {
    margin-top: 10px;
  }
  .f-cita + .f-label {
    margin-top: 20px;
  }
  .f-chips,
  .f-picks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .f-chips li {
    font-size: 13px;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tono) 26%, transparent);
    color: var(--color-charcoal);
  }
  .f-picks li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--color-charcoal);
    color: var(--color-bone);
  }
  .p-nom {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.2;
  }
  .p-marca {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .f-vacio {
    font-size: 15px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.72);
  }
  .f-vacio a {
    font-weight: 700;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(35 34 30 / 0.3);
  }

  /* Phones: the shelf scrolls sideways, one tap per bottle. */
  @media (max-width: 640px) {
    .frascos {
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 34px 20px 0;
      margin-inline: -20px;
      gap: 22px;
      scrollbar-width: none;
    }
    .frasco {
      flex: none;
      scroll-snap-align: center;
    }
    .etiqueta {
      padding-inline: 3px;
    }
    .e-nom {
      font-size: 7.5px;
      letter-spacing: 0.03em;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .frasco,
    .ficha,
    .ficha.visible {
      transition: none;
      animation: none;
    }
    .frasco.activo {
      transform: none;
    }
  }
</style>

<script>
  const estante = document.querySelector<HTMLElement>('[data-estante]');
  if (estante) {
    const frascos = [...estante.querySelectorAll<HTMLButtonElement>('.frasco')];
    const fichas = [...estante.querySelectorAll<HTMLElement>('.ficha')];
    const elegir = (num: string) => {
      frascos.forEach((f) => {
        const si = f.dataset.num === num;
        f.classList.toggle('activo', si);
        f.setAttribute('aria-pressed', String(si));
      });
      fichas.forEach((c) => c.classList.toggle('visible', c.dataset.ficha === num));
    };
    const fino = matchMedia('(hover: hover) and (pointer: fine)').matches;
    frascos.forEach((f) => {
      f.addEventListener('click', () => elegir(f.dataset.num!));
      if (fino) f.addEventListener('pointerenter', () => elegir(f.dataset.num!));
    });
  }
</script>
