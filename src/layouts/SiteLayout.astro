---
/**
 * Layout for the public pages: header, <main>, footer, optional sticky mobile CTA, the
 * one-time scroll-reveal observer that powers `.reveal` / `.reveal-stagger`, and the motion
 * system (split headings, pointer light, magnetic buttons — src/scripts/motion.ts).
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCta from '../components/StickyCta.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  theme?: 'editorial' | 'stitch' | 'inicio';
  /** Structured data for this page (see BaseLayout). */
  jsonLd?: Record<string, unknown>[];
  stickyCta?: { label?: string; path?: string } | false;
}

const { title, description, noindex, theme = 'editorial', stickyCta = {}, jsonLd } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  theme={theme}
  jsonLd={jsonLd}
  bodyClass={stickyCta ? 'has-sticky-cta' : undefined}
>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <SiteHeader />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  {stickyCta && <StickyCta {...stickyCta} />}
</BaseLayout>

<style is:global>
  body.has-sticky-cta {
    padding-bottom: 78px;
  }
  @media (min-width: 1024px) {
    body.has-sticky-cta {
      padding-bottom: 96px;
    }
  }
</style>

<script>
  import { initMotion } from '../scripts/motion';

  // Reveal-on-scroll: add `.in` the first time an element enters the viewport. The motion system
  // (split headings) registers its elements through the same observer.
  const els = document.querySelectorAll<HTMLElement>(
    '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-stagger'
  );
  let observe: (el: Element) => void = (el) => el.classList.add('in');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    observe = (el) => io.observe(el);
  }
  els.forEach((el) => observe(el));
  initMotion(observe);
</script>
