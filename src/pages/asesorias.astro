---
/**
 * Asesorías (was «1:1» until 2026-10-03) — the offer page: what the Initial Layer Cycle is (told once, in four
 * steps), what you leave with, the two prices and the CTA into the checkout (the «lo que no es» box left on 2026-09-24, Mari).
 * Shortened from ~11 screens to about half (Mari, 2026-09-23).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero11 from '../components/uno-a-uno/Hero11.astro';
import Reconocimiento from '../components/uno-a-uno/Reconocimiento.astro';
import Insight from '../components/Insight.astro';
import Proceso from '../components/uno-a-uno/Proceso.astro';
import Entregables from '../components/uno-a-uno/Entregables.astro';
import Precios from '../components/uno-a-uno/Precios.astro';
import KlarnaCuotas from '../components/oferta/KlarnaCuotas.astro';
import Testimonios from '../components/Testimonios.astro';
import CtaFinal from '../components/uno-a-uno/CtaFinal.astro';
import { marca } from '../data/site';
import { ciclos, checkoutPrincipal } from '../data/oferta';
import { TAX_RATE, redondear } from '../lib/precio';
import { href } from '../lib/url';
import { testimoniosAsesorias } from '../data/testimonios';
import { grafoSitio, grafoServicio } from '../lib/schema';

const initial = ciclos.INITIAL_LAYER_CYCLE;
const conImpuesto = redondear(initial.subtotal * (1 + TAX_RATE));
---

<SiteLayout
  title="Asesoría nutricional online para ti | Veronica Wellness"
  jsonLd={[...grafoSitio(Astro.site), grafoServicio(Astro.site)]}
  description="Elige tu asesoría nutricional online con Verónica Dudamell. Compara las opciones, conoce qué incluye cada consulta y da el primer paso para trabajar juntas."
  mobileCta={{ path: '/asesorias#cta' }}
>
  <Hero11 />
  <Reconocimiento />
  <Insight a="No necesitas hacer más." b="Necesitas saber qué priorizar." />
  <Proceso />
  <Entregables />
  <Testimonios
    eyebrow="Testimonios"
    titulo="Quienes ya empezaron, en sus palabras."
    ids={testimoniosAsesorias}
  />
  <Precios />
  <KlarnaCuotas
    eyebrow="Klarna en Estados Unidos"
    titulo="Dale espacio a tu bienestar. Paga en cuotas."
    texto="Si estás en Estados Unidos, puedes solicitar el pago en cuotas con Klarna para tu asesoría conmigo. En el paso de pago del sitio, con Estados Unidos como país, elige Klarna para consultar las opciones disponibles para ti."
    chips={['Solo Estados Unidos', 'Opciones de cuotas', 'Elige al pagar']}
    monto={initial.subtotal}
    ejemplo={`${initial.nombre}: ${initial.subtotal} USD + ${Math.round(TAX_RATE * 100)} % de impuesto = ${conImpuesto.toFixed(2)} USD; si Klarna te ofrece 4 pagos sin intereses, serían aproximadamente ${redondear(conImpuesto / 4).toFixed(2)} USD por pago.`}
    nota="Sujeto a aprobación de Klarna; las opciones dependen de tu perfil, el monto y tu estado, y los 4 pagos no están disponibles en Nuevo México ni Hawái."
    boton={{ label: 'Quiero reservar mi asesoría', href: href(checkoutPrincipal) }}
  />
  <CtaFinal />
  <p class="lema">{marca.lema}</p>
</SiteLayout>

<style>
  .lema {
    text-align: center;
    padding: 40px 0 24px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 18px;
    color: rgb(48 47 42 / 0.72);
  }
</style>
