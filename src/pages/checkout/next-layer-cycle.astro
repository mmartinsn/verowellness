---
/** Checkout — Next Layer Cycle (returning clients). Content and prices come from data/oferta. */
import CheckoutLayout from '../../layouts/CheckoutLayout.astro';
import Checkout from '../../components/checkout/Checkout.astro';
import { ciclos } from '../../data/oferta';

const ciclo = ciclos.NEXT_LAYER_CYCLE;
---

<CheckoutLayout
  title={`Reserva tu ${ciclo.nombre} — Veronica Wellness`}
  description="Reserva tu Next Layer Cycle con Veronica Wellness. Dos sesiones privadas de 90 min para seguir profundizando y redefinir prioridades."
>
  <Checkout ciclo={ciclo} />
</CheckoutLayout>
