---
/** Checkout — Initial Layer Cycle. Content and prices come from data/oferta. */
import CheckoutLayout from '../../layouts/CheckoutLayout.astro';
import Checkout from '../../components/checkout/Checkout.astro';
import { ciclos } from '../../data/oferta';
import { guiasEnOferta } from '../../components/checkout/tipos';

const ciclo = ciclos.INITIAL_LAYER_CYCLE;
---

<CheckoutLayout
  title={`Reserva tu ${ciclo.nombre} — Veronica Wellness`}
  description="Reserva tu Initial Layer Cycle con Veronica Wellness. Dos sesiones privadas de 90 min: The Layer Assessment, The Layer Map y tu Layer Plan."
>
  <Checkout ciclo={ciclo} guias={guiasEnOferta()} />
</CheckoutLayout>
