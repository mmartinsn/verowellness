---
/**
 * Suplementos — short page: why Verónica recommends supplements the way she does, and how to buy
 * them on Wholescripts (she recommends, she does not sell; Mari, 2026-09-23, after
 * nutriwhitesalud.com/supplement). The hero is Verónica's photo; the «Información del criterio»
 * label sits, full size, beside the three access steps;
 * «El estante de Vero» (one bottle per Layer) holds her tips and picks (2026-09-24).
 * Registration link and code live in data/suplementos (pending from Verónica).
 */
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import Etiqueta from '../components/suplementos/Etiqueta.astro';
import fotoSuplementos from '../assets/fotos/veronica-suplementos.png';
import Estante from '../components/suplementos/Estante.astro';
import { wholescripts, principios, avisoSuplementos } from '../data/suplementos';
import { grafoSitio } from '../lib/schema';
import { marca } from '../data/site';
import { href } from '../lib/url';

const tonos = ['clay-deep', 'sage-deep', 'rose-deep'];
---

<SiteLayout
  title="Suplementos recomendados por Verónica Dudamell | Veronica Wellness"
  description="Cómo recomienda Verónica Dudamell los suplementos dentro de The Layer Method: primero el mapa, calidad de grado profesional y revisión en cada ciclo. Compra directa en Wholescripts."
  theme="inicio"
  stickyCta={false}
  jsonLd={grafoSitio(Astro.site)}
>
  <section class="s-hero" aria-labelledby="s-titulo">
    <div class="s-aurora" aria-hidden="true"></div>
    <div class="wrap s-hero-grid">
      <div class="s-copy">
        <span class="eyebrow">Suplementos</span>
        <h1 id="s-titulo" class="s-titulo" data-split>
          Un suplemento no es una estrategia. <em class="grad-text"
            >Es una herramienta dentro de una.</em
          >
        </h1>
        <p class="s-bajada">
          No vendo suplementos. Cuando uno tiene sentido para tu contexto, te lo recomiendo — y lo
          compras directamente en Wholescripts.
        </p>
        <div class="s-ctas">
          <a class="btn btn-primary" href="#acceso" data-magnet="0.25">Cómo acceder</a>
          <a class="s-link" href={href('/asesorias')}>¿No sabes cuáles necesitas? →</a>
        </div>
      </div>
      <!-- Verónica presenting two of the shelf's bottles. Photo made with Codex from her own
           photos, with her permission (Mari, 2026-09-24). -->
      <div class="s-visual">
        <figure class="s-foto">
          <Image
            src={fotoSuplementos}
            alt={`${marca.creadora} con bata blanca, sosteniendo dos frascos blancos de The Layer Method`}
            widths={[480, 760, 1122]}
            sizes="(min-width: 1000px) 460px, 88vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="s-principios" aria-labelledby="s-por-que">
    <div class="wrap">
      <span class="eyebrow">Por qué los recomiendo así</span>
      <h2 id="s-por-que" class="s-h2">Menos frascos. Más criterio.</h2>
      <ol class="p-lista">
        {
          principios.map((p, i) => (
            <li class="p-item sd-lift" style={`--tono:var(--color-${tonos[i]});`}>
              <span class="p-num">{`0${i + 1}`}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Estante />

  <section id="acceso" class="s-acceso aurora" aria-labelledby="s-acceso-t">
    <div class="wrap s-acceso-grid">
      <div class="a-izq">
        <span class="eyebrow">Cómo acceder</span>
        <h2 id="s-acceso-t" class="s-h2">
          Tres pasos, <em class="grad-text on-dark">directo a casa.</em>
        </h2>
        <div class="a-panel">
          <ol class="a-pasos">
            <li>
              <span class="a-n">1</span>
              <div>
                <strong>Regístrate en Wholescripts</strong>
                <p>
                  Crea tu cuenta con el enlace de abajo{
                    wholescripts.codigo && (
                      <>
                        {' '}
                        y el código de referido <code>{wholescripts.codigo}</code>
                      </>
                    )
                  }{
                    wholescripts.apellido && (
                      <>
                        . Apellido de la profesional: <code>{wholescripts.apellido}</code>
                      </>
                    )
                  }.
                </p>
              </div>
            </li>
            <li>
              <span class="a-n">2</span>
              <div>
                <strong>Busca lo que está en tu plan</strong>
                <p>Compra solo lo que definimos juntas en tu Layer Plan.</p>
              </div>
            </li>
            <li>
              <span class="a-n">3</span>
              <div>
                <strong>Recíbelo en casa</strong>
                <p>El pago y el envío los gestiona Wholescripts.</p>
              </div>
            </li>
          </ol>
          <a
            class="a-btn"
            href={wholescripts.registro}
            target="_blank"
            rel="noopener"
            data-magnet="0.2"
          >
            Registrarme en Wholescripts <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <!-- The criterion label, at full size where it can be read (Mari, 2026-09-24). -->
      <div class="a-etq">
        <Etiqueta />
      </div>
    </div>
  </section>

  <section class="s-aviso">
    <div class="wrap">
      <p>{avisoSuplementos}</p>
    </div>
  </section>
</SiteLayout>

<style>
  /* ── Hero ── */
  .s-hero {
    position: relative;
    overflow: hidden;
    padding: 48px 0 88px;
  }
  .s-aurora {
    position: absolute;
    width: 820px;
    height: 820px;
    right: -180px;
    top: -120px;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 40% 40%, rgb(231 183 160 / 0.5), transparent 70%),
      radial-gradient(closest-side at 70% 65%, rgb(207 215 196 / 0.55), transparent 70%);
    filter: blur(30px);
    animation: s-aurora 22s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes s-aurora {
    to {
      transform: translate(50px, -30px) scale(1.1) rotate(8deg);
    }
  }
  .s-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .s-hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      min-height: calc(100vh - 200px);
    }
  }
  /* ── The photo with the label floating over its lower corner ── */
  .s-visual {
    position: relative;
    justify-self: center;
    width: min(460px, 88vw);
  }
  .s-foto {
    margin: 0;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 40px 60px -30px rgb(35 34 30 / 0.35);
  }
  .s-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .s-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .s-titulo {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    text-wrap: balance;
  }
  .s-titulo em {
    font-style: italic;
  }
  .s-bajada {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.65;
    color: rgb(35 34 30 / 0.82);
    max-width: 500px;
  }
  .s-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }
  .s-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
    border-bottom: 1px solid rgb(35 34 30 / 0.3);
    padding-bottom: 2px;
    transition: border-color 0.3s ease;
  }
  .s-link:hover {
    border-color: var(--color-clay-deep);
  }

  /* ── Principles ── */
  .s-principios {
    padding: clamp(64px, 8vw, 110px) 0;
  }
  .s-h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 1.02;
    margin-top: 14px;
  }
  .p-lista {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  @media (min-width: 900px) {
    .p-lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }
  .p-item {
    position: relative;
    padding: 30px 28px 32px;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.6);
    border: 1px solid rgb(35 34 30 / 0.08);
    overflow: hidden;
  }
  .p-item::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--tono);
  }
  .p-num {
    font-family: var(--font-serif);
    font-size: 44px;
    line-height: 1;
    color: var(--tono);
  }
  .p-item h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.1;
    margin-top: 14px;
  }
  .p-item p {
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.75);
    margin-top: 10px;
  }

  /* ── Access ── */
  .s-acceso {
    background: radial-gradient(circle at 20% 10%, #3e3d36 0%, #1f1e1b 70%);
    color: var(--color-bone);
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .s-acceso-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .s-acceso-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 80px;
    }
  }
  .a-izq .a-panel {
    margin-top: 32px;
  }
  .a-etq {
    display: grid;
    justify-items: center;
  }
  .s-acceso .eyebrow {
    color: var(--color-clay);
  }
  .s-acceso .s-h2 {
    color: var(--color-bone);
  }
  .a-panel {
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(231 183 160 / 0.3);
    border-radius: 32px;
    padding: clamp(26px, 3vw, 40px);
    backdrop-filter: blur(6px);
  }
  .a-pasos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 22px;
  }
  .a-pasos li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .a-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(231 183 160 / 0.6);
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--color-clay);
  }
  .a-pasos strong {
    font-size: 17px;
    font-weight: 700;
  }
  .a-pasos p {
    font-size: 15px;
    line-height: 1.55;
    color: rgb(248 246 241 / 0.75);
    margin-top: 4px;
  }
  .a-pasos code {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-clay);
  }
  .a-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    min-height: 56px;
    padding: 0 30px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f0c4ae, var(--color-clay-deep));
    color: var(--color-charcoal);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.35s ease;
  }
  .a-btn:hover {
    background: var(--color-white);
  }

  /* ── Note ── */
  .s-aviso {
    padding: 36px 0 56px;
  }
  .s-aviso p {
    max-width: 820px;
    font-size: 13px;
    line-height: 1.65;
    color: rgb(35 34 30 / 0.62);
  }
  @media (prefers-reduced-motion: reduce) {
    .s-aurora {
      animation: none;
    }
  }
</style>
