<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  const bar = document.getElementById('scrollProgress');
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  if (fine && !calm) {
    document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const rx = -((e.clientY - r.top - r.height / 2) / (r.height / 2)) * 4;
        const ry = ((e.clientX - r.left - r.width / 2) / (r.width / 2)) * 4;
        card.style.transform = `perspective(1000px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
      });
      card.addEventListener('mouseleave', () => (card.style.transform = ''));
    });
  }

  // Counters count up once when they come into view; the final number is already in the HTML.
  const box = document.querySelector('[data-contadores]');
  if (box && calm) box.classList.add('encendida');
  if (box && !calm) {
    const nums = [...box.querySelectorAll<HTMLElement>('[data-cuenta]')];
    nums.forEach((el) => (el.textContent = '0'));
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      box.classList.add('encendida');
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1600);
        const ease = 1 - Math.pow(1 - k, 3);
        nums.forEach((el) => {
          const n = Math.round(Number(el.dataset.cuenta) * ease);
          // 5.000 with a dot, as in Spanish (es-ES does not group four digits).
          el.textContent =
            'miles' in el.dataset ? String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.') : String(n);
        });
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }).observe(box);
  }
</script>
