---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroTienda from '../components/tienda/HeroTienda.astro';
import Capitulo from '../components/tienda/Capitulo.astro';
import Seleccion from '../components/tienda/Seleccion.astro';
import SiguientePaso from '../components/tienda/SiguientePaso.astro';
import {
  productos,
  libros,
  avisoLegal,
  esComprable,
  precioPorDefinir,
  precioTienda,
} from '../data/tienda';
import { grafoSitio } from '../lib/schema';
import { href } from '../lib/url';

const productosLd = productos.map((p) => ({
  '@type': 'Product',
  name: p.titulo,
  description: p.pregunta,
  brand: { '@type': 'Brand', name: 'Veronica Wellness' },
  offers: {
    '@type': 'Offer',
    price: p.precio.toFixed(2),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: Astro.site ? new URL(href(`/tienda#${p.id}`), Astro.site).href : href(`/tienda#${p.id}`),
  },
}));
---

<SiteLayout
  title="Ebooks y recetas de Verónica Dudamell | Veronica Wellness"
  description="Explora los ebooks de Verónica Dudamell: antojos, 30 desayunos y una guía educativa sobre GLP-1 y retatrutida. Descarga digital en PDF."
  theme="inicio"
  stickyCta={false}
  jsonLd={[...grafoSitio(Astro.site), ...productosLd]}
>
  <HeroTienda />

  <nav class="indice" id="indice" aria-label="Índice de la tienda">
    <div class="wrap indice-inner">
      <h2 class="indice-titulo" data-nosplit>Índice</h2>
      <ol>
        {
          libros.map((p) => (
            <li>
              <a href={`#${p.id}`}>
                <span class="i-num">{p.num}</span>
                <span class="i-nombre">{p.nombre}</span>
                <span class="i-precio">
                  {esComprable(p) ? precioTienda(p.precio) : precioPorDefinir}
                </span>
                {p.bestSeller && <span class="i-best">Best seller</span>}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  {libros.map((p, i) => <Capitulo libro={p} espejo={i % 2 === 1} />)}

  <SiguientePaso />

  <div class="wrap legal">
    <p>{avisoLegal}</p>
  </div>

  <Seleccion />
</SiteLayout>

<style>
  .indice {
    padding: 8px 0 40px;
  }
  .indice-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgb(35 34 30 / 0.12);
  }
  .indice-titulo {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(44px, 5vw, 64px);
    line-height: 1;
  }
  .indice ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
  }
  .indice a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    min-height: 44px;
    padding: 10px 0;
    font-size: 14px;
    font-weight: 700;
    color: rgb(35 34 30 / 0.78);
    transition: color 0.25s ease;
  }
  .indice a:hover {
    color: #8a4b31;
  }
  .i-num {
    font-family: var(--font-serif);
    font-size: 20px;
    color: #8a4b31;
  }
  .i-precio {
    font-weight: 600;
    color: rgb(35 34 30 / 0.6);
  }
  .i-best {
    align-self: center;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-charcoal);
    color: var(--color-clay);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .legal {
    padding-top: 48px;
    padding-bottom: 72px;
  }
  .legal p {
    max-width: 820px;
    font-size: 13px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.68);
  }
</style>
