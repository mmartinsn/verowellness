---
/**
 * The Layer Method™ 1:1 — the offer page: what the Initial Layer Cycle is, session by session,
 * what you leave with, the two prices, who it is for, and the CTA into the checkout.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero11 from '../components/uno-a-uno/Hero11.astro';
import Reconocimiento from '../components/uno-a-uno/Reconocimiento.astro';
import Ciclo from '../components/uno-a-uno/Ciclo.astro';
import Flecha from '../components/uno-a-uno/Flecha.astro';
import Sesion01 from '../components/uno-a-uno/Sesion01.astro';
import Entregables from '../components/uno-a-uno/Entregables.astro';
import Sesiones from '../components/uno-a-uno/Sesiones.astro';
import Precios from '../components/uno-a-uno/Precios.astro';
import ParaQuien from '../components/uno-a-uno/ParaQuien.astro';
import CtaFinal from '../components/uno-a-uno/CtaFinal.astro';
import { marca } from '../data/site';
---

<SiteLayout
  title="The Layer Method™ 1:1 — Veronica Wellness"
  description="Un proceso 1:1 para organizar tu contexto, identificar prioridades y construir una estrategia personalizada con The Layer Method™. Initial Layer Cycle: dos sesiones privadas de 90 minutos."
  mobileCta={{ label: 'Agenda conmigo', path: '/1-1#cta' }}
>
  <Hero11 />
  <Reconocimiento />
  <Ciclo />
  <Flecha />
  <Sesion01 />
  <Flecha />
  <Entregables />
  <Flecha />
  <Sesiones />
  <Flecha size={28} />
  <Precios />
  <ParaQuien />
  <CtaFinal />
  <p class="lema">{marca.lema}</p>
</SiteLayout>

<style>
  .lema {
    text-align: center;
    padding: 40px 0 24px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 18px;
    color: rgb(48 47 42 / 0.72);
  }
</style>
