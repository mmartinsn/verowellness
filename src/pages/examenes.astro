---
/**
 * Exámenes (order since 2026-10-03, Verónica's changes 35–42: hero, the «not required» notice,
 * the order-to-results steps, the catalogue by group with search, the fifteen symptoms, why, FAQ)
 * — the functional lab tests (data/examenes.ts, from Verónica's price list of 2026-09),
 * presented by symptom on a dark ground (Mari, 2026-09-24): HeroLupa (the lens hero), PorSintoma (hero, the ten symptoms,
 * the tests of the chosen one and the selection dock → /checkout/examenes/), then Proceso, the
 * «¿Por qué estos exámenes?» (PorQue), the logistics after nutriwhitesalud.com/exam, and the FAQ after its exam policy. The earlier orbit + explorer (Constelacion,
 * Explorador) stay in components/examenes, unused, until Mari confirms this version.
 *
 * Same visual system as the home (`data-theme="inicio"`: Cormorant Garamond + Plus Jakarta Sans).
 * The selection dock replaces the sticky mobile CTA on this page.
 */
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroLupa from '../components/examenes/HeroLupa.astro';
import PorSintoma from '../components/examenes/PorSintoma.astro';
import AvisoAsesoria from '../components/examenes/AvisoAsesoria.astro';
import Catalogo from '../components/examenes/Catalogo.astro';
import PorQue from '../components/examenes/PorQue.astro';
import Proceso from '../components/examenes/Proceso.astro';
import FaqExamenes from '../components/examenes/FaqExamenes.astro';
import { preguntasExamenes } from '../data/examenes';
import { grafoSitio } from '../lib/schema';

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: preguntasExamenes.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
const description =
  'Explora los exámenes funcionales por categoría. Consulta qué mide cada prueba, cómo se toma la muestra y su precio. Si tienes dudas, revísalas en tu asesoría.';
---

<SiteLayout
  title="Exámenes funcionales: catálogo | Veronica Wellness"
  description={description}
  theme="inicio"
  mobileCta={false}
  jsonLd={[...grafoSitio(Astro.site), faqLd]}
>
  <HeroLupa />
  <AvisoAsesoria />
  <Proceso />
  <Catalogo />
  <PorSintoma />
  <PorQue />
  <FaqExamenes />
</SiteLayout>
