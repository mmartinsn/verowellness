---
/**
 * Exámenes — the functional lab tests (data/examenes, from Verónica's price list of 2026-09).
 * The magnifier hero stays dark; the rest of the page is light (Verónica, 2026-10-02): the notice
 * that tests are not required for the asesorías, the steps from order to results, the catalogue by
 * group with its search, her fifteen symptom cards (data/sintomas), «¿Por qué estos exámenes?» and
 * the FAQ. One ficha dialog serves every exam; the selection dock replaces the sticky CTA.
 */
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroLupa from '../components/examenes/HeroLupa.astro';
import AvisoAsesoria from '../components/examenes/AvisoAsesoria.astro';
import Proceso from '../components/examenes/Proceso.astro';
import Catalogo from '../components/examenes/Catalogo.astro';
import PorSintoma from '../components/examenes/PorSintoma.astro';
import PorQue from '../components/examenes/PorQue.astro';
import FaqExamenes from '../components/examenes/FaqExamenes.astro';
import FichaExamen from '../components/examenes/FichaExamen.astro';
import Seleccion from '../components/examenes/Seleccion.astro';
import { examenes, preguntasExamenes } from '../data/examenes';
import { grafoSitio } from '../lib/schema';

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: preguntasExamenes.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
const description = `${examenes.length} exámenes funcionales por grupo y por síntoma —digestión, hormonas, alimentos, cansancio, moho y más— con qué mide cada uno, su muestra y su precio. Kit en tu casa.`;
---

<SiteLayout
  title="Exámenes funcionales — Veronica Wellness"
  description={description}
  theme="inicio"
  jsonLd={[...grafoSitio(Astro.site), faqLd]}
>
  <HeroLupa />
  <AvisoAsesoria />
  <Proceso />
  <Catalogo />
  <PorSintoma />
  <PorQue />
  <FaqExamenes />
  <FichaExamen />
  <Seleccion />
</SiteLayout>
