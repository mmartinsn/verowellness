---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroMetodo from '../components/metodo/HeroMetodo.astro';
import Intro from '../components/metodo/Intro.astro';
import CincoLayersMapa from '../components/metodo/CincoLayersMapa.astro';
import ReframeMetodo from '../components/metodo/ReframeMetodo.astro';
import Bridge from '../components/metodo/Bridge.astro';
---

<SiteLayout
  title="Mi método: The Layer Method, tu salud por capas | Veronica Wellness"
  description="Mi método, The Layer Method: un mapa de cinco capas interconectadas para entender tu salud. Deja de perseguir cada síntoma por separado y descubre qué merece atención primero."
  stickyCta={{ path: '/asesorias#cta' }}
>
  <HeroMetodo />
  <CincoLayersMapa />
  <Intro />
  <ReframeMetodo />
  <Bridge />
</SiteLayout>
