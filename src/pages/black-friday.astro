---
/**
 * Black Friday 2026 — a campaign landing, on purpose outside the site's palette (Mari,
 * 2026-10-28: «sálte del catálogo de colores, que quede grabada»): black, bone and one loud
 * coral. Three tests at −20 %, the reading at $150 and the recipe book free. Copy by Codex
 * (src/data/black-friday.ts). Each «Lo quiero» leaves that test as the selection and opens the
 * exams checkout with the code already applied; Webflow is what honours it (DECISIONES).
 */
import '@fontsource/archivo-black/latin-400.css';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import retrato from '../assets/fotos/veronica-bata-recorte.png';
import recetario from '../assets/tienda/portada-recetario.jpg';
import { examenes, CLAVE_SELECCION, FEE_LABORATORIO } from '../data/examenes';
import { bf, campana } from '../data/black-friday';
import { usd } from '../lib/precio';
import { href } from '../lib/url';

const precios = campana.examenes.map((id) => {
  const e = examenes.find((x) => x.id === id);
  if (!e) throw new Error(`Black Friday: no existe el examen ${id}`);
  const final = Math.round(e.precio * (100 - campana.descuento)) / 100;
  return { ...e, final, ahorro: e.precio - final, copy: bf.examenes[id] };
});
const checkout = `${href('/checkout/examenes/')}?cupon=${campana.codigo}`;
const cinta = [...bf.ticker, ...bf.ticker];
---

<SiteLayout
  title="Black Friday −20 % en exámenes | Veronica Wellness"
  description={bf.meta}
  noindex
  mobileCta={{ label: bf.ctaPrincipal, path: '/black-friday#examenes' }}
>
  <div class="bf" data-clave={CLAVE_SELECCION} data-checkout={checkout} data-fin={campana.fin}>
    <!-- HERO -->
    <section class="hero">
      <div class="tape tape-a" aria-hidden="true">
        <div class="tape-track">{cinta.map((t) => <span>{t}</span>)}</div>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span class="dot"></span>{bf.kicker}</p>
          <h1 class="hero-title">
            <span class="bf-word">Black</span>
            <span class="bf-word outline">Friday</span>
          </h1>
          <p class="hero-claim">{bf.titulo}</p>
          <p class="hero-sub">{bf.sub}</p>
          <div class="hero-actions">
            <a class="btn-bf" href="#examenes">{bf.ctaPrincipal}<span aria-hidden="true">→</span></a
            >
            <p class="code">Código <strong>{campana.codigo}</strong> · se aplica solo</p>
          </div>
          <div class="clock" data-clock aria-label={bf.urgencia}>
            <p class="clock-label">{bf.urgencia}</p>
            <div class="clock-cells">
              <span><b data-d>--</b>días</span>
              <span><b data-h>--</b>horas</span>
              <span><b data-m>--</b>min</span>
              <span><b data-s>--</b>seg</span>
            </div>
          </div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <span class="big-20">20</span>
          <span class="big-pct">%<i>off</i></span>
          <Image
            src={retrato}
            alt=""
            class="hero-photo"
            widths={[360, 560, 760]}
            sizes="(min-width: 1024px) 460px, 70vw"
            loading="eager"
          />
          <span class="sticker">Todo<br />noviembre<br /><em>+ Cyber Monday</em></span>
        </div>
      </div>
      <div class="tape tape-b" aria-hidden="true">
        <div class="tape-track rev">{cinta.map((t) => <span>{t}</span>)}</div>
      </div>
    </section>

    <!-- PROBLEMA -->
    <section class="dolor wrap-bf">
      <h2 class="h2">{bf.problemaTitulo}</h2>
      <ol class="dolor-list">
        {
          bf.problema.map((l, i) => (
            <li>
              <span>0{i + 1}</span>
              {l}
            </li>
          ))
        }
      </ol>
    </section>

    <!-- EXAMENES -->
    <section class="examenes wrap-bf" id="examenes">
      <p class="eyebrow">−{campana.descuento} % · solo en Black Friday</p>
      <h2 class="h2">{bf.examenesTitulo}</h2>
      <div class="cards">
        {
          precios.map((e, i) => (
            <article class="card" style={`--i:${i}`}>
              <div class="card-tag">−{campana.descuento}%</div>
              <p class="card-lab">{e.laboratorio}</p>
              <h3 class="card-name">{e.copy.nombre}</h3>
              <p class="card-hook">{e.copy.gancho}</p>
              <ul class="card-for">
                {e.copy.paraTi.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <div class="card-price">
                <s>{usd(e.precio)}</s>
                <strong>{usd(e.final)}</strong>
                <span class="save">Ahorras {usd(e.ahorro)}</span>
              </div>
              <button class="btn-bf block" type="button" data-comprar={e.id}>
                {e.copy.cta}
                <span aria-hidden="true">→</span>
              </button>
              <p class="card-note">
                + recetario gratis · cargo de laboratorio {usd(FEE_LABORATORIO)}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ADD-ON + BONUS -->
    <section class="extras wrap-bf">
      <div class="addon">
        <p class="eyebrow">Add-on</p>
        <h3 class="h3">{bf.addonTitulo}</h3>
        <p>{bf.addonTexto}</p>
        <p class="addon-price">
          <s>{usd(campana.lecturaNormal)}</s>
          <strong>{usd(campana.lectura)}</strong>
        </p>
      </div>
      <div class="bonus">
        <div class="bonus-badge">Gratis</div>
        <Image
          src={recetario}
          alt="Portada del recetario 30 desayunos antiinflamatorios express"
          class="bonus-cover"
          widths={[240, 480]}
          sizes="200px"
        />
        <div>
          <p class="eyebrow">Bonus</p>
          <h3 class="h3">{bf.bonusTitulo}</h3>
          <p>{bf.bonusTexto}</p>
          <p class="addon-price"><s>{usd(campana.recetarioNormal)}</s> <strong>$0</strong></p>
        </div>
      </div>
    </section>

    <!-- PASOS -->
    <section class="pasos wrap-bf">
      <h2 class="h2">Así de simple</h2>
      <ol class="steps">
        {
          bf.pasos.map((p, i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- FAQ -->
    <section class="faq-bf wrap-bf">
      <h2 class="h2">Lo que te estás preguntando</h2>
      {
        bf.faq.map((f) => (
          <details class="qa">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <!-- CIERRE -->
    <section class="final">
      <div class="tape tape-c" aria-hidden="true">
        <div class="tape-track">{cinta.map((t) => <span>{t}</span>)}</div>
      </div>
      <div class="final-inner">
        <p class="final-20" aria-hidden="true">−20%</p>
        <h2 class="final-title">{bf.finalTitulo}</h2>
        <p class="final-sub">{bf.finalSub}</p>
        <a class="btn-bf big" href="#examenes">{bf.ctaPrincipal}<span aria-hidden="true">→</span></a
        >
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  const raiz = document.querySelector<HTMLElement>('.bf')!;

  // «Lo quiero»: the test becomes the whole selection and the checkout opens with the code.
  raiz.querySelectorAll<HTMLButtonElement>('[data-comprar]').forEach((b) =>
    b.addEventListener('click', () => {
      try {
        localStorage.setItem(raiz.dataset.clave!, JSON.stringify([b.dataset.comprar]));
      } catch {
        /* private mode: the checkout will show an empty cart and its link back */
      }
      location.href = raiz.dataset.checkout!;
    })
  );

  // Countdown to the end of Cyber Monday.
  const fin = new Date(raiz.dataset.fin!).getTime();
  const reloj = raiz.querySelector('[data-clock]')!;
  const pon = (sel: string, n: number) => {
    const el = reloj.querySelector(sel);
    if (el) el.textContent = String(n).padStart(2, '0');
  };
  const tic = () => {
    const r = Math.max(0, fin - Date.now());
    pon('[data-d]', Math.floor(r / 864e5));
    pon('[data-h]', Math.floor(r / 36e5) % 24);
    pon('[data-m]', Math.floor(r / 6e4) % 60);
    pon('[data-s]', Math.floor(r / 1e3) % 60);
  };
  tic();
  setInterval(tic, 1000);
</script>

<style>
  .bf {
    --bf-black: #0a0a0a;
    --bf-ink: #141414;
    --bf-bone: #f6f1e7;
    --bf-hot: #ff4f2b;
    --bf-hot-ink: #1a0600;
    --bf-line: rgb(246 241 231 / 0.14);
    --bf-display: 'Archivo Black', 'Arial Black', Impact, sans-serif;
    background: var(--bf-black);
    color: var(--bf-bone);
    overflow-x: clip;
    font-family: var(--font-sans);
  }
  .wrap-bf {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(72px, 10vw, 128px) 20px 0;
  }
  .eyebrow {
    color: var(--bf-hot);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 13px;
    margin: 0 0 14px;
  }
  .h2 {
    font-family: var(--bf-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(34px, 6vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 40px;
    max-width: 16ch;
  }
  .h3 {
    font-family: var(--bf-display);
    text-transform: uppercase;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1;
    margin: 0 0 12px;
  }

  /* Button: hard-edged, hot, with a black offset shadow that collapses on press. */
  .btn-bf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--bf-hot);
    color: var(--bf-hot-ink);
    font-family: var(--bf-display);
    text-transform: uppercase;
    font-size: 18px;
    letter-spacing: 0.02em;
    padding: 18px 28px;
    border: 2px solid var(--bf-hot);
    border-radius: 0;
    box-shadow: 6px 6px 0 var(--bf-bone);
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  .btn-bf:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--bf-bone);
  }
  .btn-bf:active {
    transform: translate(6px, 6px);
    box-shadow: 0 0 0 var(--bf-bone);
  }
  .btn-bf span {
    transition: transform 0.2s;
  }
  .btn-bf:hover span {
    transform: translateX(4px);
  }
  .btn-bf.block {
    width: 100%;
  }
  .btn-bf.big {
    font-size: clamp(18px, 2.4vw, 24px);
    padding: 22px 40px;
  }
  .btn-bf:focus-visible {
    outline: 3px solid var(--bf-bone);
    outline-offset: 4px;
  }

  /* Caution tape: the image that stays. */
  .tape {
    position: relative;
    z-index: 3;
    background: var(--bf-hot);
    color: var(--bf-hot-ink);
    font-family: var(--bf-display);
    text-transform: uppercase;
    font-size: clamp(14px, 1.6vw, 20px);
    letter-spacing: 0.04em;
    padding: 12px 0;
    white-space: nowrap;
    overflow: hidden;
    width: 120%;
    margin-left: -10%;
  }
  .tape-a {
    transform: rotate(-2.5deg);
    margin-top: 8px;
  }
  .tape-b {
    transform: rotate(2deg);
    background: var(--bf-bone);
    margin-top: -24px;
  }
  .tape-c {
    transform: rotate(-1.5deg);
  }
  .tape-track {
    display: inline-flex;
    animation: marquee 32s linear infinite;
  }
  .tape-track.rev {
    animation-direction: reverse;
  }
  .tape-track span::after {
    content: '✕';
    margin: 0 22px;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* HERO */
  .hero {
    padding-top: 12px;
  }
  .hero-grid {
    max-width: 1180px;
    margin: 0 auto;
    padding: 48px 20px 0;
    display: grid;
    gap: 24px;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      padding-top: 56px;
    }
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 13px;
    margin: 0 0 18px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bf-hot);
    animation: pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
      transform: scale(0.7);
    }
  }
  .hero-title {
    font-family: var(--bf-display);
    text-transform: uppercase;
    font-size: clamp(64px, 13vw, 168px);
    line-height: 0.82;
    letter-spacing: -0.04em;
    margin: 0 0 24px;
  }
  .bf-word {
    display: block;
  }
  .outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--bf-bone);
  }
  .hero-claim {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.05;
    color: var(--bf-hot);
    margin: 0 0 14px;
    max-width: 20ch;
  }
  .hero-sub {
    font-size: 18px;
    line-height: 1.5;
    opacity: 0.82;
    max-width: 46ch;
    margin: 0 0 30px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 24px;
  }
  .code {
    margin: 0;
    font-size: 14px;
    opacity: 0.8;
  }
  .code strong {
    font-family: ui-monospace, Menlo, monospace;
    border: 1px dashed var(--bf-hot);
    padding: 3px 8px;
    color: var(--bf-hot);
    opacity: 1;
  }
  .clock {
    margin: 36px 0 56px;
  }
  .clock-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.7;
    margin: 0 0 10px;
  }
  .clock-cells {
    display: flex;
    gap: 8px;
  }
  .clock-cells span {
    display: grid;
    justify-items: center;
    min-width: 66px;
    padding: 10px 6px;
    border: 1px solid var(--bf-line);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.9;
  }
  .clock-cells b {
    font-family: var(--bf-display);
    font-size: 30px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .hero-art {
    position: relative;
    min-height: 460px;
    display: grid;
    place-items: end end;
  }
  .big-20 {
    position: absolute;
    left: -2%;
    top: 4%;
    font-family: var(--bf-display);
    font-size: clamp(260px, 42vw, 460px);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--bf-hot);
    z-index: 0;
  }
  .big-pct {
    position: absolute;
    right: 0;
    top: 0;
    font-family: var(--bf-display);
    font-size: clamp(64px, 9vw, 110px);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 2px var(--bf-bone);
    z-index: 2;
    display: grid;
  }
  .big-pct i {
    font-style: normal;
    font-size: 0.4em;
    color: var(--bf-bone);
    -webkit-text-stroke: 0;
    text-transform: uppercase;
  }
  .hero-photo {
    position: relative;
    z-index: 1;
    width: min(58vw, 340px);
    height: auto;
    filter: grayscale(1) contrast(1.08);
    margin-bottom: -2px;
  }
  .sticker {
    position: absolute;
    right: 46%;
    bottom: 34%;
    z-index: 2;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--bf-bone);
    color: var(--bf-black);
    display: grid;
    place-content: center;
    text-align: center;
    font-family: var(--bf-display);
    text-transform: uppercase;
    font-size: 15px;
    line-height: 1.05;
    transform: rotate(-12deg);
    animation: spin-in 0.9s var(--ease-spring) both 0.3s;
  }
  .sticker em {
    font-style: normal;
    color: var(--bf-hot);
    font-size: 11px;
    margin-top: 4px;
  }
  @keyframes spin-in {
    from {
      transform: rotate(-90deg) scale(0);
    }
  }

  /* DOLOR */
  .dolor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    border-top: 1px solid var(--bf-line);
  }
  .dolor-list li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    padding: 26px 0;
    border-bottom: 1px solid var(--bf-line);
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.15;
  }
  .dolor-list span {
    font-family: var(--bf-display);
    color: var(--bf-hot);
    font-size: 16px;
    padding-top: 8px;
  }

  /* CARDS */
  .cards {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    position: relative;
    background: var(--bf-ink);
    border: 1px solid var(--bf-line);
    padding: 32px 24px 24px;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .card:hover {
    border-color: var(--bf-hot);
    transform: translateY(-4px);
  }
  .card-tag {
    position: absolute;
    top: -18px;
    right: 18px;
    background: var(--bf-hot);
    color: var(--bf-hot-ink);
    font-family: var(--bf-display);
    font-size: 22px;
    padding: 6px 12px;
    transform: rotate(4deg);
  }
  .card-lab {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.6;
    margin: 0 0 8px;
  }
  .card-name {
    font-family: var(--bf-display);
    text-transform: uppercase;
    font-size: 26px;
    line-height: 1;
    margin: 0 0 12px;
  }
  .card-hook {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 21px;
    line-height: 1.2;
    margin: 0 0 18px;
    color: var(--bf-hot);
  }
  .card-for {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 15px;
    opacity: 0.86;
  }
  .card-for li {
    padding-left: 22px;
    position: relative;
  }
  .card-for li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 2px;
    background: var(--bf-hot);
  }
  .card-price {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 18px;
  }
  .card-price s {
    opacity: 0.5;
    font-size: 18px;
  }
  .card-price strong {
    font-family: var(--bf-display);
    font-size: 44px;
    line-height: 1;
  }
  .save {
    flex-basis: 100%;
    font-size: 13px;
    font-weight: 800;
    color: var(--bf-hot);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .card-note {
    font-size: 12px;
    opacity: 0.6;
    margin: 12px 0 0;
    text-align: center;
  }

  /* EXTRAS */
  .extras {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .extras {
      grid-template-columns: 1fr 1.3fr;
    }
  }
  .addon,
  .bonus {
    border: 1px solid var(--bf-line);
    padding: 32px 26px;
    line-height: 1.5;
  }
  .addon p,
  .bonus p {
    margin: 0;
  }
  .addon-price {
    margin-top: 16px !important;
  }
  .addon-price s {
    opacity: 0.5;
  }
  .addon-price strong {
    font-family: var(--bf-display);
    font-size: 32px;
    color: var(--bf-hot);
    margin-left: 6px;
  }
  .bonus {
    position: relative;
    display: grid;
    gap: 22px;
    background: var(--bf-bone);
    color: var(--bf-black);
  }
  @media (min-width: 560px) {
    .bonus {
      grid-template-columns: 150px 1fr;
      align-items: center;
    }
  }
  .bonus .eyebrow {
    color: #c23614;
  }
  .bonus .addon-price strong {
    color: #c23614;
  }
  .bonus-cover {
    width: 150px;
    height: auto;
    transform: rotate(-5deg);
    box-shadow: 10px 10px 0 var(--bf-black);
  }
  .bonus-badge {
    position: absolute;
    top: -16px;
    left: 20px;
    background: var(--bf-black);
    color: var(--bf-bone);
    font-family: var(--bf-display);
    text-transform: uppercase;
    padding: 6px 14px;
    transform: rotate(-4deg);
  }

  /* PASOS */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
