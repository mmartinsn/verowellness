---
/**
 * Pacientes — a private page Verónica sends by link to her current patients: their price, the
 * Next Layer Cycle (2 control sessions, USD 210), straight to its checkout (Mari, 2026-10-11).
 * A standalone landing (Mari: «es externa, no iría en la página»): no site menu or footer, not
 * in the sitemap or search (noindex). Plan data: Asesorías › Next Layer Cycle;
 * headline: Textos de sección › asesorias › pacientes (copy: Codex).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { ciclos } from '../data/oferta';
import { bloque } from '../lib/datos/bloques';
import { marca } from '../data/site';
import { href } from '../lib/url';
import retrato from '../assets/fotos/veronica-bata-laptop.jpg';

const c = ciclos.NEXT_LAYER_CYCLE;
const texto = bloque('asesorias', 'pacientes');
const precio = `USD ${Number.isInteger(c.subtotal) ? c.subtotal : c.subtotal.toFixed(2)}`;
---

<BaseLayout
  title={`${c.nombre} para pacientes — ${marca.nombre}`}
  description={c.descripcionCorta}
  noindex
>
  <header class="pac-header">
    <BrandMark size={22} />
    <span class="pac-marca">{marca.nombre}</span>
  </header>
  <section class="pac">
    <div class="wrap pac-grid">
      <div class="pac-copy">
        <span class="eyebrow">{c.etiqueta}</span>
        <h1>{texto.titulo}</h1>
        <p class="pac-intro">{texto.texto}</p>

        <article class="pac-card">
          <div class="pac-top">
            <div>
              <p class="pac-nombre">{c.nombre}</p>
              <p class="pac-consultas">{c.consultas}</p>
            </div>
            <p class="pac-precio">{precio}</p>
          </div>
          <p class="pac-desc">{c.descripcion}</p>
          <ul class="pac-incluye">
            {c.incluye.map((i) => <li>{i}</li>)}
          </ul>
          <a class="btn btn-primary pac-btn" href={href(`/checkout/${c.slug}/`)}>
            {texto.enlaceTexto}
            <span aria-hidden="true">→</span>
          </a>
          {c.notaPie && <p class="pac-nota">{c.notaPie}</p>}
        </article>
      </div>
      <figure class="pac-foto">
        <Image
          src={retrato}
          alt={`${marca.creadora} con bata y laptop`}
          widths={[440, 660, 880, 1024]}
          sizes="(min-width: 960px) 420px, 90vw"
          quality={90}
          loading="eager"
        />
      </figure>
    </div>
  </section>
  <footer class="pac-footer">
    Pago seguro · Tus datos están protegidos. {marca.nombre} no almacena datos de tarjeta.
  </footer>
</BaseLayout>

<style>
  .pac-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 22px 20px;
    color: var(--color-charcoal);
  }
  .pac-marca {
    font-family: var(--font-serif);
    font-size: 20px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pac-footer {
    padding: 24px 20px 40px;
    text-align: center;
    font-size: 12.5px;
    color: rgb(35 34 30 / 0.55);
  }
  .pac {
    padding: clamp(40px, 6vw, 88px) 0 96px;
    background:
      radial-gradient(ellipse 50% 60% at 90% 10%, rgb(231 183 160 / 0.35), transparent 70%),
      radial-gradient(ellipse 45% 55% at 5% 95%, rgb(207 215 196 / 0.35), transparent 70%);
  }
  .pac-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .pac-grid {
      grid-template-columns: minmax(0, 1fr) 420px;
      gap: 72px;
    }
  }
  .pac-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 5.2vw, 68px);
    line-height: 1.02;
    text-wrap: balance;
  }
  .pac-intro {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: rgb(35 34 30 / 0.8);
    max-width: 560px;
  }
  .pac-card {
    margin-top: 8px;
    padding: 26px 28px;
    border-radius: 24px;
    background: var(--color-white);
    border: 1.5px solid var(--color-clay-deep);
    box-shadow: 0 22px 50px rgb(138 75 49 / 0.14);
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 560px;
  }
  .pac-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .pac-nombre {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.1;
  }
  .pac-consultas {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a4b31;
  }
  .pac-precio {
    font-family: var(--font-serif);
    font-size: clamp(34px, 3.4vw, 44px);
    line-height: 1;
    white-space: nowrap;
  }
  .pac-desc {
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(35 34 30 / 0.8);
  }
  .pac-incluye {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .pac-incluye li {
    position: relative;
    padding-left: 26px;
    font-size: 15px;
    font-weight: 600;
  }
  .pac-incluye li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #8a4b31;
    font-weight: 800;
  }
  .pac-btn {
    align-self: flex-start;
    margin-top: 6px;
  }
  .pac-nota {
    font-size: 13px;
    line-height: 1.55;
    color: rgb(35 34 30 / 0.65);
  }
  .pac-foto {
    margin: 0;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 24px 60px rgb(35 34 30 / 0.14);
  }
  .pac-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  /* The original has a lot of white wall: come closer to her on wide screens. */
  @media (min-width: 960px) {
    .pac-foto :global(img) {
      transform: scale(1.45);
      transform-origin: 58% 72%;
    }
  }
  @media (max-width: 959px) {
    .pac-foto {
      order: -1;
      max-width: 420px;
      aspect-ratio: 1 / 1;
    }
  }
</style>
